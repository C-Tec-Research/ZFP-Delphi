implementation

{$R *.DFM}

procedure TAboutBox.ShowVersion(const iFile: tZFPFile);
var
  iNode : tZFPNode;
  iLoop : tLoop;
  PanelID, ProtocolID : integer;
  Version : string;
  RC : boolean;
begin
  RC := FALSE;
  PanelID := 0;
  while (RC = FALSE) And (PanelID <= iFile.NodeList.Max) do
  begin
    iNode := iFile.NodeList.Node[PanelID];
    iLoop := iNode.LoopList.Loop[2];
    if assigned(iLoop) then
    begin
      RC := TRUE;
      ProtocolID := iLoop.Protocol.ProtocolMap.ValueAsInt;
      Version := iLoop.Protocol.DeviceMapVersion.Value;
      if ProtocolID = 0 then
      begin
        lblConfigVersion.Caption := 'Apollo Database Version: ' + Version.ToUpper;
      end
      else if ProtocolID = 1 then
      begin
        lblConfigVersion.Caption := 'CAST Database Version: ' + Version.ToUpper;
      end
      else
      begin
        lblConfigVersion.Caption := '';
      end;
    end
    else
    begin
      PanelID := PanelID + 1;
    end;
  end;
end;

function TAboutBox.FindResourceString( const ResourceStream : TResourceStream; const pResource: string): string;
var
  NextChar : WideChar;
  i, iMatchLen : integer;
begin
  iMatchLen := 1;
  Result := '';
  ResourceStream.Seek( 0,soFromBeginning );
  for i := 1 to ResourceStream.size do
  begin
    ResourceStream.Read( NextChar, 2 );
    if Nextchar = pResource[ iMatchLen ] then
    begin
      if iMatchLen = Length( pResource ) then
      begin
        ResourceStream.Read( NextChar, 2 );
        while NextChar = WideChar(0) do
          ResourceStream.Read( NextChar, 2 );
        while NextChar <> WideChar(0) do
        begin
          Result := Result + NextChar;
          ResourceStream.Read( NextChar, 2 );
        end;
      end
      else
      begin
        iMatchLen := iMatchLen + 1;
      end;
    end
    else
    begin
      iMatchLen := 1;
    end;
  end;
end;

procedure TAboutBox.FormCreate(Sender: TObject);
var
  ResourceStream : TResourceStream;
  iVersion : string;
  iPos : integer;
begin
  { update version info }
  ResourceStream := TResourceStream.CreateFromID( HInstance, 1, RT_VERSION );
  ProductName.Caption := FindResourceString( ResourceStream, 'InternalName' );
  iVersion := FindResourceString( ResourceStream, 'FileVersion' );
  Version.Caption := 'Version: ' + iVersion;
  Copyright.Caption := FindResourceString( ResourceStream, 'LegalCopyright' );
  Comments.Caption := FindResourceString( ResourceStream, 'FileDescription' );
  ProgramIcon.Picture.Assign( Application.Icon );
  ResourceStream.Free;
  iPos := Pos( '.', iVersion );
  if iPos > 0 then
  begin
    fMajor := StrToIntDef( Copy( iVersion, 1, iPos - 1 ), 0);
    iVersion := Copy( iVersion, iPos + 1 );
    iPos := Pos( '.', iVersion );
    if iPos > 0 then
    begin
      fMinor := StrToIntDef( Copy( iVersion, 1, iPos - 1 ), 0 );
      iVersion := Copy( iVersion, iPos + 1 );
      iPos := Pos( '.', iVersion );
      if iPos > 0 then
      begin
        fRelease := StrToIntDef( Copy( iVersion, 1, iPos - 1), 0 );
        fBuild := StrToIntDef( Copy( iVersion, iPos + 1), 0 );
      end;
    end;
  end;
end;

