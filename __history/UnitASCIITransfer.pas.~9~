procedure TFormASCIITransfer.OnSendFail( const pMode : string; const ReasonCode: DWord);
var
  iFailText : string;
begin
  if Visible then
  begin
    iFailText := Translate( pMode ) +' - ';
    case ReasonCode of
      ERROR_INVALID_HANDLE: // 6
      begin
        iFailText := iFailText + Translate( 'Invalid Handle' );
      end;
      ERROR_BAD_COMMAND:
      begin
        iFailText := iFailText + Translate( 'Bad Command' );
      end;
      ERROR_GEN_FAILURE:  // 31
      begin
        iFailText := iFailText + Translate( 'General Failure' );
      end;
      WAIT_TIMEOUT:
      begin
        iFailText := iFailText + Translate( 'USB Timeout' );
      end;
      ERROR_INVALID_PARAMETER:
      begin
        iFailText := iFailText + Translate( 'ReadFile Invalid Parameter' );
      end;
      ERROR_ACCESS_DENIED:
      begin
        iFailText := iFailText + Translate( 'USB Access Denied' );
      end;
      ERROR_IO_INCOMPLETE:
      begin
        iFailText := iFailText + Translate( 'USB IO Incomplete' );
      end;
      else
      begin
        iFailText := iFailText + IntToStr( ReasonCode );
      end;
    end;
    StopTimers;
    fASCIIExtraInfo.Stop;
    AbortButtonVisible := FALSE;
    fErrors.Add( es_Error, 0, 0, iFailText );
    //Hide;
    raise ExceptionZFPTransfer.Create( iFailText );
  end;
end;

procedure TFormASCIITransfer.OnSendRcvFail(const ReasonCode: DWord);
begin
  case ReasonCode of
    NO_ERROR:
    begin
      exit;
    end;
    ERROR_BAD_COMMAND:
    begin
      // if retry count is less than three try reselecting
      if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
      begin
        fASCIIExtraInfo.Stop;
        CheckForDevices;
        fASCIIExtraInfo.Start;
        RetryCount := RetryCount + 1;
        //fASCIIExtraInfo.ResendLastRec;
      end
      else
      begin
        // otherwise give up - abort transmission
        OnSendFail( 'Rcv Failed', ReasonCode );
      end;
    end;
    ERROR_IO_INCOMPLETE:
    begin
      // ignore and wait for further time out
    end;
    ERROR_ACCESS_DENIED:
    begin
      if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
      begin
        fASCIIExtraInfo.CurrentSendStatus.RetryCount := fASCIIExtraInfo.CurrentSendStatus.RetryCount + 1;
        RetryCount := RetryCount + 1;
      end
      else
      begin
        // otherwise give up - abort transmission
        OnSendFail( 'Rcv Failed', ReasonCode );
      end;
    end;
    else
    begin
      OnSendFail( 'Rcv Failed', ReasonCode );
    end;
  end;
end;

