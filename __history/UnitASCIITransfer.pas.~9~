procedure TFormASCIITransfer.ExportASCIIFile( const pBaseName: string;
  const pPanelIndex: integer; const pDataName: string;
  const pCSVData: tStrings);
var
  pFileName : string;
begin
  pFilename := ChangeFileExt( pBaseName, '' );
  pFileName := pFileName + '(' + IntToStr( pPanelIndex ) + ')' + pDataName + '.csv';
  pCSVData.SaveToFile( pFileName );
  //fASCIISend.AppendStrings( pCSVData );
  fASCIISend.Add( pFileName, '' );
  //fASCIIFiles.Add( pFileName );
end;

