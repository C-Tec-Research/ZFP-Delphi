procedure TFormASCIITransfer.TimerGetWhoAMITimer(Sender: TObject);
begin
  if Visible then
  begin
    //Application.ProcessMessages;
    inc( fTicks );
    LabelTicks.Caption := IntToStr( fTicks ) + ' ticks';
    LabelChars.Caption := IntToStr( fChars ) + ' chars';
    LabelRecords.Caption := IntToStr( fRecCount ) + ' records';

    dec( fTimeout );
    if fTimeout <= 0 then
    begin
      GaugeWait.Visible := FALSE;
      LabelWaiting.Visible := FALSE;
      if fWHORUState <> wru_Timeout then
      begin
        fWHORUState := wru_Timeout;
        TimerGetWhoAMI.Enabled := FALSE;
        //TimerCommon.Enabled := FALSE;
        if FormRemoteLoginNotSupported.Execute then
        begin
          fTimeOut := fRepeatTimeout;
          TimerGetWhoAMI.Enabled := TRUE;
          TimerCommon.Enabled := TRUE;
          exit;
        end
        else
        begin
          StopTimers;
          ModalResult := mrCancel;
          exit;
        end;
      end
      else if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
      begin
        RetryCount := RetryCount + 1;
        if fASCIIExtraInfo.ResendLastRec then
        begin
          fTimeOut := fRepeatTimeout;
          exit; // OK
        end
      end;
      // if either retry count exceded or a failure then
      // abort info
      fASCIIExtraInfo.Stop;
      TimerGetWhoAMI.Enabled := FALSE;
      TimerCommon.Enabled := FALSE;
      AbortButtonVisible := FALSE;
      //Hide;
      raise ExceptionZFPTransfer.Create(Translate('Timed out'));
    end
    else if GaugeWait.Visible then
    begin
      GaugeWait.Progress := fTimeout;
    end;
  end
  else
  begin
    StopTimers;
  end;

end;

