procedure TFormASCIITransfer.ProcessWhoAreYouRecAck(const pRec: string;
  const pStatus: tASCIIXIRxObject);
var
  iID, iPanel, iChecksum : integer;
  iSendRecStatus : tASCIIXITxObject;
  iVersion : string;
  iText : string;
begin
  if Visible then
  begin
    if not pStatus.ChecksumOK then
    begin
      // can't trust answer, ask to retry
      if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
      begin
        RetryCount := RetryCount + 1;
        fASCIIExtraInfo.ResendLastRec;
      end
      else
      begin
        // otherwise give up - abort transmission
        iText := Translate( 'Retry Count Exceeded' );
        fErrors.Add( es_Error, 0, 0, iText, nil);
        //Hide;
        raise ExceptionZFPTransfer.Create(iText);
      end;
    end
    else
    begin
      // Is this the answer to our current send?
      iSendRecStatus := fASCIIExtraInfo.CurrentSendStatus;
      case ParseZFPRec( pRec, fList, iID, iPanel, iChecksum ) of
        rrt_IAM:
        begin
          iPanel := StrToIntDef( fList[ 2], -1);
          iVersion := fList[ 3 ];
          if fList[ 4 ] = '0' then
          begin
            fWHORUState := wru_WrongPIN;
          end
          else if fList[ 4 ] = '1' then
          begin
            fWHORUState := wru_CorrectPIN;
