function TFormASCIITransfer.AdvancedSendData2HasRecType( const pRecType: integer) : boolean;
var
  j, k : integer;
  iAdvancedTransfer : tAdvancedTransfer;
  iAdvancedTransferItem : tAdvancedTransferItem;
begin
  with FormAdvancedTransferSelector.CheckListBoxAMFileSets do
  begin
    for j := 0 to Items.Count - 1 do
    begin
      if Checked[ j ] then
      begin
        iAdvancedTransfer := Items.Objects[ j ] as tAdvancedTransfer;
        for k := 0 to iAdvancedTransfer.TransferItems.Max do
        begin
          iAdvancedTransferItem := iAdvancedTransfer.TransferItems.AdvancedTransferItem[ k ];
          if iAdvancedTransferItem.TransferType = at_Internal then
          begin
            if iAdvancedTransferItem.ItemType.ValueAsInt = pRecType then
            begin
              Result := TRUE;
              exit;
            end;
          end;
        end;
      end;
    end;
  end;
  // else
  Result := FALSE;
end;

