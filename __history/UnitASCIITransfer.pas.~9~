procedure TFormASCIITransfer.AddFileRcvRequest(const pPanel: tZFPNode;
  const pBaseName, pRecID: string);
var
  iFileName : string;
begin
  with pPanel do
  begin
    //PageControlASCIIEdit.ActivePage := TabSheetRetrieveData;
    iFileName := ZFPFile.FileName;

    ImportASCIIFile( iFileName, ID, pBaseName, pRecID + ',REQUEST,' + IntToStr( pPanel.ID ) );
  end;
end;

procedure TFormASCIITransfer.AddFileRcvRequest(const pPanel: tZFPNode;
  const pBaseName: string; pRecIDs: tStringList);
var
  i: Integer;
begin
  for i := 0 to pRecIDs.Count - 1 do
  begin
    AddFileRcvRequest( pPanel, pBaseName, pRecIDs[ i ] );
  end;
end;

procedure TFormASCIITransfer.AskWhoAreYou;
begin
  RetryCount := 0;
  fErrors.Clear;
  fRecCount := 0;
  fASCIIExtraInfo.UseWaitForSingleObject := em_Check_USB_Status in ExpertModes;
  fASCIIExtraInfo.UseThreading := em_Use_Threading in ExpertModes;;

  ClearASCIISendFileList;
  // WHORU record
  fWHORUFile.Clear;
  fWHORUFile.Add( '200,WHORU,0,' + FormLogin.Password+','+ IntToStr( AboutBox.Major )
                  + ',' + IntToStr( AboutBox.Minor ) + ',' + IntToStr( AboutBox.Release )
                  + ',' + IntToStr( AboutBox.Build ) );
  fASCIISend.AppendStrings( fWHORUFile );

end;

procedure TFormASCIITransfer.BitBtnAbortXFERClick(Sender: TObject);
begin
  if Visible then
  begin
    StopTimers;
    GaugeWait.Visible := FALSE;
    LabelWaiting.Visible := FALSE;
    fASCIIExtraInfo.Stop;
    AbortButtonVisible := FALSE;
    LabelRecords.Visible := FALSE;
    BitBtnOK.Visible := TRUE;
    SetupVisualInterface;
    //Hide;
    raise ExceptionZFPTransfer.Create(Translate('Transfer Aborted by user'));
  end;
end;

procedure TFormASCIITransfer.BitBtnTestClick(Sender: TObject);
var
  iID, iChecksum : integer;
  iResult : tRecvRecType;
begin
  iID := -1;
  iChecksum := -1;
  iResult := ParseZFPRec( EditDebugText.Text, MemoDebugResult.Lines, iID, fPanel, iChecksum );
  case iResult of
    rrt_ACK,
    rrt_REQUEST,
    rrt_END,
    rrt_Other,
    rrt_BEGIN,
    rrt_NAK,
    rrt_CSFAIL,
    rrt_TIMEOUT,
    rrt_Error:
    begin
      RadioGroupDebugResult.ItemIndex := Ord( iResult );
    end;
    else
    begin
      RadioGroupDebugResult.ItemIndex := RadioGroupDebugResult.Items.Count - 1;
    end;
  end;
  EditDebugID.Text := IntToStr( iID );
  EditDebugCS.Text := IntToStr( iChecksum );
  EditDebugPanel.Text := IntToStr( fPanel );
end;

procedure TFormASCIITransfer.BuildSDCardFiles(const pPanel: tZFPNode;
  const pErrors: tErrorList);
var
  iStrings : tStringList;
  iTempFile : tZFPTempTextFile;
  iFileName : string;
begin
  fErrors := pErrors;
  fErrors.Clear;
  fPanel := pPanel.ID;
  fCurrPanel := pPanel;
  fRecCount := 0;
  SetupVisualSDCardPrep;
  with pPanel do
  begin
    PageControlASCIIEdit.ActivePage := TabSheetEdit;

    if not ZFPFile.SaveAs( 'd.zft' ) then
    begin
      // we save in the SDCard subdirectory of the main file, so we NEED a file name
      exit;
    end;
    iStrings := tStringList.Create;
    iFileName := ExtractFilePath( ZFPFile.FileName ) + 'SD Card';
    ForceDirectories( iFileName );
    iFileName := iFileName + '\d';
    try

      //--------------- Phase 1 - shares and name data
      //   2 – Device Names
      ExportNamesFile( iStrings, fErrors );
      ExportASCIIFile( iFileName, ID, 'Names', iStrings );

      //---------------- Phase 2 ----------------------

      //  80 – Panel data
      GeneralProperties.ExportFile( iStrings );
      ExportASCIIFile( iFileName, ID, 'Panel Config', iStrings );

      //  17 – Input Group and Trigger Share Data
      with ZFPFile.CauseAndEffects.InputGroups do
      begin
        //ExportShareFile( pPanel, ExportShareStrings );
        ZFPFile.ExportInputGroupsShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'IG Shares', iStrings );
      end;

      //  18 – Output Group Share Data
      with ZFPFile.CauseAndEffects.OutputGroups do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'OG Shares', iStrings );
      end;

      //  19 – Output Supergroups Share Data
      with ZFPFile.SuperGroupList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'OSG Shares', iStrings );
      end;

      //  81 – Mode Share Data
      with ZFPFile.ModeList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Mode Shares', iStrings );
      end;

      // 151 – Input Supergroup Share Data
      with ZFPFile.InputSuperGroupList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'ISG Shares', iStrings );
      end;

      // 152 – Sequence Share Data
      with ZFPFile.SequenceList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Seq Shares', iStrings );
      end;

      // 153 – Pulse Pattern Share Data
      with ZFPFile.PulsePatternList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Pulse Patt Shares', iStrings );
      end;

      // 160 – Group Action Share Data
      with ZFPFile.GroupActionList do
      begin
        iStrings.Clear;
        ExportShareFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Group Action Shares', iStrings );
      end;

      //--------------- Phase 3 - other data
      //  14 – Input Group and Trigger Data
      iStrings.Clear;
      ZFPFile.ExportInputGroupsConfigFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Input Groups', iStrings );

      //  15 – Output Groups
      iStrings.Clear;
      ZFPFile.ExportOutputGroupsConfigFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Output Groups', iStrings );

      //  16 – Output Supergroup
      iStrings.Clear;
      ZFPFile.ExportSuperGroupsConfigFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Supergroups', iStrings );

      //  20 – Device Data
      ExportDeviceFieldsFile( iStrings, fErrors );
      ExportASCIIFile( iFileName, ID, 'Device Fields', iStrings );

      //  30 – Cause and Effects Matrix (not used by PC)
      iStrings.Clear;
      ZFPFile.ExportCausesFile( pPanel, iStrings, fErrors ); // nil for now
      ExportASCIIFile( iFileName, ID, 'CE Matrix', iStrings );

      //  40 – Sequences
      ZFPFile.ExportEffectsFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Sequences', iStrings );

      //  60 – Pulse Patterns
      ZFPFile.ExportPulseSeqFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Pulse Pattern', iStrings );

      //  161 – Group Actions
      ZFPFile.ExportGroupActionFile( pPanel, iStrings );
      ExportASCIIFile( iFileName, ID, 'Group Actions', iStrings );

      //  90 – Comments
      iStrings.Clear;
      PanelNotes.ExportFile( iStrings );
      ExportASCIIFile( iFileName, ID, 'Comments', iStrings );

      // 100 – Zone Data
      with ZonesFile do
      begin
        iStrings.Clear;
        ExportFile( iStrings );
        ExportASCIIFile( iFileName, ID, 'Zones', iStrings );
      end;

      // 120 - Network data
      iStrings.Clear;
      ZFPFile.ExportNetworkCfgFile( pPanel, iStrings, fErrors );
      ExportASCIIFile( iFileName, ID, 'Network File', iStrings );

      // 150 – Cause and Effects Tree (not used by panel)
      with ZFPFile.CauseAndEffects do
      begin
        iStrings.Clear;
        ExportTreeFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Tree File', iStrings );
      end;

      // 154 – Input Supergroups
      with ZFPFile.InputSuperGroupList do
      begin
        iStrings.Clear;
        ExportConfigFile( pPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Input Supergroups', iStrings );
      end;

      iTempFile := tZFPTempTextFile.Create;
      try
        ZFPFile.Client.Save( iTempFile );
        iTempFile.FileName := '\Client.txt';
        iTempFile.ExportFile( fPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Client', iStrings );
      finally
        iTempFile.Free;
      end;

      iTempFile := tZFPTempTextFile.Create;
      try
        ZFPFile.Installer.Save( iTempFile );
        iTempFile.FileName := '\Installr.txt';
        iTempFile.ExportFile( fPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'Installer', iStrings );
      finally
        iTempFile.Free;
      end;

      iTempFile := tZFPTempTextFile.Create;
      try
        ZFPFile.SiteNotes.Save( iTempFile );
        iTempFile.FileName := '\SNotes.txt';
        iTempFile.ExportFile( fPanel, iStrings );
        ExportASCIIFile( iFileName, ID, 'SiteNotes', iStrings );
      finally
        iTempFile.Free;
      end;

      SetupRadioGroupASCIIFiles;
    finally
      iStrings.Free;
    end;
    if (fErrors.ErrorCount = 0) or (em_Show_Advanced_Send_Rcv in ExpertModes) or (ErrorReportingLevel = el_None) then
    begin
      ShowModal;
      exit;
    end;
    //Hide;
    raise ExceptionZFPErrors.Create( fm_FileCreate );
  end;
end;

procedure TFormASCIITransfer.CheckForDevices;
var
  i: Integer;
  iCount : integer;
begin
  RadioGroupDevicesConnected.Items.Clear;
  LabelNoDevicesFound.Visible := FALSE;
  iCount := fASCIIExtraInfo.CheckForDevices;
  for i := 0 to iCount - 1 do
  begin
    RadioGroupDevicesConnected.Items.Add( fASCIIExtraInfo.ConnectionName[ i ] );
  end;
  if iCount > 0 then
  begin
    RadioGroupDevicesConnected.ItemIndex := 0;
    fASCIIExtraInfo.ActivePortIndex := RadioGroupDevicesConnected.ItemIndex;
 end
  else
  begin
    LabelNoDevicesFound.Visible := TRUE;
    fASCIIExtraInfo.ActivePortIndex := -1;
  end;
end;

