    PanelXFerSimpleMode.Align := alClient;
    PanelXFerSimpleMode.Visible := TRUE;
  end;
  if (fErrors.ErrorCount > 0) and (ErrorReportingLevel <> el_None) then
  begin
    //Hide;
    raise ExceptionZFPErrors.Create( fm_Transfer );
  end;
end;

procedure TFormASCIITransfer.SendNextRcvRec;
var
  iTime : string;
begin
  if fASCIIRequests.TransferComplete then
  begin
    TimerRetrieve.Enabled := FALSE;
    TimerCommon.Enabled := FALSE;
    DateTimeToString( iTime, 'n:ss.zzz', fStartTime - Now );
    LabelRetrieveResult.Caption := 'Transfer complete in ' + iTime + ' seconds';
    LabelRetrieveResult.Visible := TRUE;
    fASCIIExtraInfo.Stop;
    SetupVisualInterface;
    if fExitOnCompletion then
    begin
      fExitOnCompletion := FALSE;
      ModalResult := mrOK;
      exit;
    end;
    if not (em_Show_Advanced_Send_Rcv in ExpertModes) then
    begin
      ModalResult := mrOK;
      exit;
    end;
  end
  else if fASCIIExtraInfo.SendString( fASCIIRequests.NextString ) then
  begin
    fTimeout := SigSpinEditRetrieveTimeout.Value div integer(TimerRetrieve.Interval);
    fRepeatTimeout := fTimeout;
    GaugeWait.Visible := FALSE;
    LabelWaiting.Visible := FALSE;
  end;
end;

procedure TFormASCIITransfer.SendNextSendRec;
var
  iTime : string;
begin
  if fASCIISend.TransferComplete then
  begin
    TimerTransfer.Enabled := FALSE;
    TimerCommon.Enabled := FALSE;
    DateTimeToString( iTime, 'n:ss.zzz', fStartTime - Now );
    LabelResult.Caption := 'Transfer complete in ' + iTime + ' seconds';
    LabelResult.Visible := TRUE;
    SetupVisualInterface;
    fASCIIExtraInfo.Stop;
    AbortButtonVisible := FALSE;
    LabelProgress.Caption := 'Complete';
    LabelRecords.Visible := FALSE;
    if not (em_Show_Advanced_Send_Rcv in ExpertModes) or (fPanel = 0) or (fExitOnCompletion ) then
    begin
      ModalResult := mrOK;
      fExitOnCompletion := FALSE;
    end;
  end
  else if fASCIIExtraInfo.SendString( fASCIISend.NextString ) then
  begin
    fTimeout := SigSpinEditTimeOut.Value div integer(TimerTransfer.Interval);
    fRepeatTimeout := fTimeout;
  end;
  GaugeWait.Visible := FALSE;
  LabelWaiting.Visible := FALSE;
end;

