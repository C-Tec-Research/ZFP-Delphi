    else
    begin
      // Is this the answer to our current send?
      iSendRecStatus := fASCIIExtraInfo.CurrentSendStatus;
      case ParseZFPRec( pRec, fList, iID, iPanel, iChecksum ) of
        rrt_IAM:
        begin
          if not fBeginReceived then  // probably valid
