procedure TFormASCIITransfer.GetFile3(pPanel: integer; pVersion: string);
var
  iStrings : tStringList;
  iVersion : tCTecVersion;
  iTempFile : tZFPDiskFile;
begin
  // performed as result of WHORU request.
  iStrings := tStringList.Create;
  //StopTimers;
  iVersion := pVersion;
  case fWHORUState of
    wru_Pending,
    wru_Timeout:
    begin
      // should not get these results
      fErrors.Add( es_Error, 0, 0, 'Internal Transfer Error 001 - Transfer aborted');
      ModalResult := mrCancel;
      StopTimers;
      exit;
    end;
    wru_WrongPIN:
    begin
      if not FormLogin.Execute( TRUE ) then
      begin
        ModalResult := mrCancel;
        exit;
      end;
      // else
      AbortButtonVisible := FALSE;
      LabelRecords.Visible := FALSE;
      LabelProgress.Visible := FALSE;
      SpeedButtonStartSimpleTransferRcvClick( self );
      exit;
    end;
    wru_Blank,
    wru_CorrectPIN: ; // carry on
  end;
  begin
    try
      ClearASCIIRetrieveFileList;

      fASCIIRequests.TransferStrings.Clear;

      if iVersion >= '9A28' then
      begin
        iTempFile := tZFPDiskFile.Create( 'Temp File', nil );
        try
          fASCIIRequests.AppendString( iTempFile.ImportFileRequest( pPanel, fPanelFileName ));
        finally
          iTempFile.Free;
        end;
      end;
      with fASCIISend do
      begin
        //ProgressBar := nil;
        ProgressLabel := nil;
      end;
      with fASCIIRequests do
      begin
        //ProgressBar := self.ProgressBar;
        ProgressLabel := self.LabelProgress;
        if fASCIIExtraInfo.SendString( FirstString ) then
        begin
          fASCIIExtraInfo.OnRcvRec := ProcessRcvRec;     //<<<<<<<<<<<<<<<<<<<<<<<<<<<
          fTimeout := SigSpinEditRetrieveTimeout.Value div integer(TimerRetrieve.Interval);
          fRepeatTimeout := fTimeout;
          TimerRetrieve.Enabled := TRUE;
          TimerCommon.Enabled := TRUE;
          // errors handled separately
        end;
      end;
      PanelXferExpertMode.Visible := FALSE;
      PanelXFerSimpleMode.Align := alClient;
      PanelXFerSimpleMode.Visible := TRUE;

    finally
      iStrings.Free;
    end;
  end;
end;

