procedure TFormASCIITransfer.SendAllData(const pPanel: tZFPNode; const pErrors : tErrorList;
          const pVerifying: boolean);
var
  iStrings : tStringList;
  iTempFile : tZFPTempTextFile;
  iFailMode : TExceptionZFPErrorsFailMode;
begin
  RetryCount := 0;
  fErrors := pErrors;
  //fErrors.Clear;
  fPanel := pPanel.ID;
  fCurrPanel := pPanel;
  CheckForDevices;
  fASCIIExtraInfo.UseWaitForSingleObject := em_Check_USB_Status in ExpertModes;
  fASCIIExtraInfo.UseThreading := em_Use_Threading in ExpertModes;;
  fRecCount := 0;
  SetupVisualInterface;
  fVerifying := pVerifying;
  if pVerifying then
  begin
    SpeedButtonStartTransfer.Visible := FALSE;
    iFailMode := fm_Verify;
  end
  else
  begin
    iFailMode := fm_Transfer;
    if not FormLogin.Execute then
    begin
      exit;
    end;
    SpeedButtonStartTransfer.Visible := TRUE;
  end;
  with pPanel do
  begin
    if em_Show_Advanced_Send_Rcv in ExpertModes then
    begin

      PageControlASCIIEdit.ActivePage := TabSheetTransfer;

      if ZFPFile.FileName = '' then
      begin
        if not ZFPFile.Save then
        begin
          // we save in same directory as main file, so we NEED a file name
          exit;
        end;
      end;
      iStrings := tStringList.Create;
      try

        ClearASCIISendFileList;
        // WHORU record
        fWHORUFile.Clear;
        fWHORUFile.Add( '200,WHORU,0,' + FormLogin.Password + ','+ IntToStr( AboutBox.Major )
                  + ',' + IntToStr( AboutBox.Minor ) + ',' + IntToStr( AboutBox.Release )
                  + ',' + IntToStr( AboutBox.Build ) );
        ExportASCIIFile( ZFPFile.FileName, ID, 'WHORU', fWHORUFile );

        //--------------- Phase 1 - shares and name data
        //   2 – Device Names
        ExportNamesFile( iStrings, fErrors );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Names', iStrings );

        //---------------- Phase 2 ----------------------

        //  80 – Panel data
        GeneralProperties.ExportFile( iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Panel Config', iStrings );

        //  17 – Input Group and Trigger Share Data
        with ZFPFile.CauseAndEffects.InputGroups do
        begin
          //ExportShareFile( pPanel, ExportShareStrings );
          ZFPFile.ExportInputGroupsShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'IG Shares', iStrings );
        end;

        //  18 – Output Group Share Data
        with ZFPFile.CauseAndEffects.OutputGroups do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'OG Shares', iStrings );
        end;

        //  19 – Output Supergroups Share Data
        with ZFPFile.SuperGroupList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'OSG Shares', iStrings );
        end;

        //  81 – Mode Share Data
        with ZFPFile.ModeList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Mode Shares', iStrings );
        end;

        // 151 – Input Supergroup Share Data
        with ZFPFile.InputSuperGroupList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'ISG Shares', iStrings );
        end;

        // 152 – Sequence Share Data
        with ZFPFile.SequenceList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Seq Shares', iStrings );
        end;

        // 153 – Pulse Pattern Share Data
        with ZFPFile.PulsePatternList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Pulse Patt Shares', iStrings );
        end;

        // 160 – Group Action Share Data
        with ZFPFile.GroupActionList do
        begin
          iStrings.Clear;
          ExportShareFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Group Action Shares', iStrings );
        end;

        //--------------- Phase 3 - other data
        //  14 – Input Group and Trigger Data
        iStrings.Clear;
        ZFPFile.ExportInputGroupsConfigFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Input Groups', iStrings );

        //  15 – Output Groups
        iStrings.Clear;
        ZFPFile.ExportOutputGroupsConfigFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Output Groups', iStrings );

        //  16 – Output Supergroup
        iStrings.Clear;
        ZFPFile.ExportSuperGroupsConfigFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Supergroups', iStrings );

        //  20 – Device Data
        ExportDeviceFieldsFile( iStrings, fErrors );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Device Fields', iStrings );

        //  30 – Cause and Effects Matrix (not used by PC)
        iStrings.Clear;
        ZFPFile.ExportCausesFile( pPanel, iStrings, fErrors );
        ExportASCIIFile( ZFPFile.FileName, ID, 'CE Matrix', iStrings );

        //  40 – Sequences
        ZFPFile.ExportEffectsFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Sequences', iStrings );

        //  60 – Pulse Patterns
        ZFPFile.ExportPulseSeqFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Pulse Pattern', iStrings );

        //  161 – Group Actions
        ZFPFile.ExportGroupActionFile( pPanel, iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Group Actions', iStrings );

        //  90 – Comments
        iStrings.Clear;
        PanelNotes.ExportFile( iStrings );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Comments', iStrings );

        // 100 – Zone Data
        with ZonesFile do
        begin
          iStrings.Clear;
          ExportFile( iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Zones', iStrings );
        end;

        // 120 - Network data
        iStrings.Clear;
        ZFPFile.ExportNetworkCfgFile( pPanel, iStrings, fErrors );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Network File', iStrings );

        // 150 – Cause and Effects Tree (not used by panel)
        with ZFPFile.CauseAndEffects do
        begin
          iStrings.Clear;
          ExportTreeFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Tree File', iStrings );
        end;

        // 154 – Input Supergroups
        with ZFPFile.InputSuperGroupList do
        begin
          iStrings.Clear;
          ExportConfigFile( pPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Input Supergroups', iStrings );
        end;

        // 300 - Logo

        if ZFPFile.LogoOversized.ValueAsBool then
        begin
          fErrors.Add( es_Warning, 0, Translate( 'Logo Oversized - not sent to panel' ), ZFPFile.Logo );
        end
        else
        begin
          with ZFPFile.Logo do
          begin
            ExportFile( ID, iStrings, '\Images\Logo.gif' );
            if iStrings.Count < 1 then
            begin
              fErrors.Add( es_Warning, 0, Translate( 'Logo not found - not sent to panel' ), ZFPFile.Logo );
            end
            else
            begin
              ExportASCIIFile( ZFPFile.FileName, ID, 'Logo', iStrings );
            end;
          end;
        end;

        iTempFile := tZFPTempTextFile.Create;
        try
          ZFPFile.Client.Save( iTempFile );
          iTempFile.FileName := '\Client.txt';
          //iTempFile.Add( 'Fred' );
          iTempFile.ExportFile( fPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Client', iStrings );
        finally
          iTempFile.Free;
        end;

        iTempFile := tZFPTempTextFile.Create;
        try
          ZFPFile.Installer.Save( iTempFile );
          iTempFile.FileName := '\Installr.txt';
          //iTempFile.Add( 'Fred' );
          iTempFile.ExportFile( fPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'Installer', iStrings );
        finally
          iTempFile.Free;
        end;

        iTempFile := tZFPTempTextFile.Create;
        try
          ZFPFile.SiteNotes.Save( iTempFile );
          iTempFile.FileName := '\SNotes.txt';
          //iTempFile.Add( 'Fred' );
          iTempFile.ExportFile( fPanel, iStrings );
          ExportASCIIFile( ZFPFile.FileName, ID, 'SiteNotes', iStrings );
        finally
          iTempFile.Free;
        end;

        fCSFile.Clear;
        fCSFile.Add( '9998,BEGIN,' + IntToStr( ID ) );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Complete Checksum', fCSFile );

        {
        fPartCSFile.Clear;
        fPartCSFile.Add( '9999,BEGIN,' + IntToStr( ID ) );
        ExportASCIIFile( ZFPFile.FileName, ID, 'Update Checksum', fPartCSFile );
        }

        SetupRadioGroupASCIIFiles;
      finally
        iStrings.Free;
      end;
    end
    else if pVerifying then
    begin
      SendAllData2( fPanel, '' );
    end
    else
    begin
//      BitBtnStartXFER.OnClick := SpeedButtonStartSimpleTransferClick;
      AbortButtonVisible := FALSE;
      LabelRecords.Visible := FALSE;
      LabelProgress.Visible := FALSE;
      SpeedButtonStartSimpleTransferClick( self );
    end;
    if (fErrors.ErrorCount = 0) or (em_Show_Advanced_Send_Rcv in ExpertModes) or (ErrorReportingLevel = el_None) then
    begin
      ShowModal;
      exit;
    end;
    //Hide;
    raise ExceptionZFPErrors.Create( iFailMode );
  end;
end;

