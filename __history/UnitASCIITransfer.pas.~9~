{ ExceptionUSB }

constructor ExceptionUSB.Create(ErrorIndex: integer);
var
  iText : string;
begin
  case ErrorIndex of
  ERROR_BAD_COMMAND:
    iText := 'ENVision USB Transfer Error Code: BAD COMMAND (' + IntToStr( ErrorIndex ) + ')';
  ERROR_GEN_FAILURE:
    iText := 'ENVision USB Transfer Error Code: GENERAL FAILURE (' + IntToStr( ErrorIndex ) + ')';
  else
    iText := 'ENVision USB Transfer Error Code: ' + IntToStr( ErrorIndex )
  end;
  inherited Create( iText );
end;

{ tASCIIRequest }

{ ExceptionZFPErrors }

constructor ExceptionZFPErrors.Create( const pMode : TExceptionZFPErrorsFailMode );
var
  iErrorText : string;
begin
  iErrorText := TFormASCIITransfer.Translate('Errors found' );

  case pMode of
    fm_Verify:
    begin
      iErrorText := iErrorText + ' - ' + TFormASCIITransfer.Translate('verification failed');
    end;
    fm_Transfer:
    begin
      iErrorText := iErrorText + ' - ' + TFormASCIITransfer.Translate('transfer aborted');
    end;
    fm_FileCreate:
    begin
      iErrorText := iErrorText + ' - ' + TFormASCIITransfer.Translate('file creation aborted');
    end;
    fm_Verified:
    begin
      iErrorText := TFormASCIITransfer.Translate('Verification succeeded');
    end;
  end;

  inherited Create( iErrorText );
end;

end.





