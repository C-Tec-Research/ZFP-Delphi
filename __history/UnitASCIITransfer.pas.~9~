            else
            begin
              iText := Translate( 'Unexpected internal WHORU record handled - aborted' );
              fErrors.Add( es_Error, 0, 0, iText, nil);
              //Hide;
              raise ExceptionZFPTransfer.Create(iText);
            end;
          end
          else
          begin
            // otherwise give up - abort transmission
            iText := Translate( 'Attempting to send data over network - aborted' );
            fErrors.Add( es_Error, 0, 0, iText, nil);
            //Hide;
            raise ExceptionZFPTransfer.Create(iText);
          end;
          // Otherwise wait for next record or time out
        end;
        rrt_WAIT:
        begin
          fTimeout := iChecksum div integer(TimerRetrieve.Interval);
          GaugeWait.MaxValue := fTimeout; // in this case a delay
          GaugeWait.Progress := fTimeout;
          GaugeWait.Visible := TRUE;
          LabelWaiting.Visible := TRUE;
          exit;
        end;
        rrt_ACK:
        begin
          // wait for next record or time out
        end;
        rrt_NAK, rrt_CSFAIL, rrt_TIMEOUT:
        begin
          if iSendRecStatus.Checksum = DWord(iChecksum) then
          begin
            // Retry
            if iSendRecStatus.RetryCount < 3 then
            begin
              RetryCount := RetryCount + 1;
              fASCIIExtraInfo.ResendLastRec;
            end
            else
            begin
              // otherwise give up - abort transmission
              iText := Translate( 'Retry Count Exceeded' );
              fErrors.Add( es_Error, 0, 0, iText, nil);
              //Hide;
              raise ExceptionZFPTransfer.Create(iText);
            end;
          end;
          // Otherwise wait for next record or time out
        end;
        rrt_Other, rrt_BEGIN, rrt_END, rrt_REQUEST, rrt_Error:
        begin
          // cannot be a valid response. Wait for next record or timeout
        end;
      end;
    end;
  end;
end;

