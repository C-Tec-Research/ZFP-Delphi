procedure TFormASCIITransfer.ProcessRcvRec(const pRec: string;
  const pStatus: tASCIIXIRxObject);
var
  iID, iPanel, iChecksum : integer;
  iText : string;
begin
  if Visible then
  begin
    // start parsing
    if not pStatus.ChecksumOK then
    begin
      // can't trust answer, ask to resend
      if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
      begin
        fASCIIExtraInfo.SendNotification( 'CSFAIL' );
        RetryCount := RetryCount + 1;
      end
      else
      begin
        // otherwise give up - abort transmission
        iText := Translate( 'Retry Count Exceeded' );
        fErrors.Add( es_Error, 0, 0, iText, nil);
        StopTimers;
        fASCIIExtraInfo.Stop;
        //Hide;
        raise ExceptionZFPTransfer.Create(iText );
      end;
    end
    else
    begin
      // Is this data?
      case ParseZFPRec( pRec, fList, iID, iPanel, iChecksum ) of
        rrt_ACK, rrt_Error, rrt_REQUEST:
        begin
          // Unexpected - ignore and wait for timeout
          exit;
        end;
        rrt_WAIT:
        begin
          fTimeout := iChecksum div integer(TimerRetrieve.Interval);
          GaugeWait.MaxValue := fTimeout; // in this case a delay
          GaugeWait.Progress := fTimeout;
          GaugeWait.Visible := TRUE;
          LabelWaiting.Visible := TRUE;
          exit;
        end;
        rrt_NAK, rrt_CSFAIL, rrt_TIMEOUT:
        begin
          // resend request
          if fASCIIExtraInfo.CurrentSendStatus.RetryCount < 3 then
          begin
            RetryCount := RetryCount + 1;
            fASCIIExtraInfo.ResendLastRec;
          end
          else
          begin
            // otherwise give up - abort transmission
            iText := Translate( 'Retry Count Exceeded' );
            fErrors.Add( es_Error, 0, 0, iText, nil);
            raise ExceptionZFPTransfer.Create(iText );
          end;
        end;
        rrt_BEGIN:
        begin
          // Save record and send ACK
          MemoRetrieve.Lines.Add( pRec );
          fASCIIExtraInfo.SendNotification( 'ACK' );
          fASCIIExtraInfo.CurrentSendStatus.RetryCount := 0;
          inc( fRecCount );
          fBeginReceived := TRUE;
          fTimeout := fRepeatTimeout;
        end;
        rrt_Other:
        begin
          if fBeginReceived then
          begin
            // Save record and send ACK
            MemoRetrieve.Lines.Add( pRec );
            fASCIIExtraInfo.SendNotification( 'ACK' );
            fASCIIExtraInfo.CurrentSendStatus.RetryCount := 0;
            inc( fRecCount );
            fTimeout := fRepeatTimeout;
          end;
        end;
        rrt_IAM:
        begin
          if not fBeginReceived then  // probably valid
          begin
            MemoRetrieve.Lines.Add( pRec );
            iPanel := StrToIntDef( fList[ 2], -1);
            //iVersion := fList[ 3 ];
            if fList[ 4 ] = '0' then
            begin
              fWHORUState := wru_WrongPIN;
            end
            else if fList[ 4 ] = '1' then
            begin
              fWHORUState := wru_CorrectPIN;
            end
            else if fList[ 4 ] = '' then
            begin
              fWHORUState := wru_Blank;
            end
            else
            begin
              // should no get here but treat as Wrong Pin
              fWHORUState := wru_WrongPIN;
            end;
            case fWHORUState of
              wru_Pending,
              wru_Timeout:
              begin
                // should not get these results
                ModalResult := mrCancel;
                StopTimers;
                raise ExceptionZFP.Create(Translate('Internal Transfer Error 001 - Transfer aborted'));
              end;
              wru_WrongPIN:
              begin
                ModalResult := mrCancel;
                StopTimers;
                raise ExceptionZFPTransfer.Create(Translate('Wrong PIN - Transfer aborted'));
              end;
              wru_Blank,
              wru_CorrectPIN: ; // carry on
            end;
            if StrToIntDef( fList[ 2], -1) = fPanel then
            begin
              // go on to next record
              SendNextRcvRec;
              fASCIIExtraInfo.CurrentSendStatus.RetryCount := 0;
              inc( fRecCount );
              fTimeout := fRepeatTimeout;
            end
            else if em_Allow_Cfg_from_remote_panels in ExpertModes then
            begin
              // go on to next record
              SendNextRcvRec;
              fASCIIExtraInfo.CurrentSendStatus.RetryCount := 0;
              inc( fRecCount );
              fTimeout := fRepeatTimeout;
            end
            else
            begin
              // otherwise give up - abort transmission
              iText := Translate('Wrong panel') + ' (' + fList[ 2] + ') ' + Translate( 'Detected' );
              fErrors.Add( es_Error, 0, 0, iText, nil);
              raise ExceptionZFP.Create(iText );
            end;
            // Ask for next entry, if any
          end;
        end;
        rrt_END:
        begin
          if fBeginReceived then
          begin
            MemoRetrieve.Lines.Add( pRec );
            // Ask for next entry, if any
            SendNextRcvRec;
            fASCIIExtraInfo.CurrentSendStatus.RetryCount := 0;
            fBeginReceived := FALSE;
            inc( fRecCount );
            fTimeout := fRepeatTimeout;
          end;
        end;
      end;
    end;
  end;
  //fTimeout := SigSpinEditRetrieveTimeout.Value div TimerRetrieve.Interval;
  //fTimeout := fRepeatTimeout;
end;

