          else if fList[ 4 ] = '' then
          begin
            fWHORUState := wru_Blank;
            {
            // debug
            if FormLogin.Password = '4444' then
            begin
              fWHORUState := wru_CorrectPIN;
            end
            else
            begin
              fWHORUState := wru_WrongPIN;
            end;
            // end debug
            }
          end
          else
          begin
            // should no get here but treat as Wrong Pin
            fWHORUState := wru_WrongPIN;
          end;
          if (iPanel = fPanel) or ( em_Allow_Cfg_from_remote_panels in ExpertModes ) or (fPanel = 0) then
          begin
            // go on to next record
            inc( fRecCount );
