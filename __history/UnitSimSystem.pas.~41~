procedure TFrameSimSystem.SimConversion(const iFile: tZFPFile);
var
  LoopID, DeviceAddress, iRow : integer;
  iPanel: tZFPNode;
  iLoop : tLoop;
  iDevice : tLoopDevice;
  iStrings : tStringList;
  MergePanels : boolean;
begin
  MergePanels := FALSE;
  for iRow := 1 to SigGeneralGridSimSystem.RowCount - 1 do
  begin
    iPanel := iFile.NodeList.Node[SigGeneralGridSimSystem.Cell[2, iRow].ToInteger - 1];
    if SigGeneralGridSimSystem.Cell[3, iRow] <> '0' then //0 = No File required
    begin
      if MergePanels = FALSE then
      begin
        iStrings := tStringList.Create;
        DoFileHeader(iStrings);
      end;
      for LoopID := 0 to iPanel.LoopList.Max do
      begin
        iLoop := iPanel.LoopList.Loop[LoopID];
        if iLoop.LoopType = ltNormal then
        begin
          case MergePanels of
            TRUE: //Merge is set when dealing with 2nd Panel in a 4+4. Add 4 to the Loop ID
            begin
              DoLoopHeader(iLoop.LoopAddress.ValueAsInt + 4, iStrings);
            end;
            FALSE:
            begin
              DoLoopHeader(iLoop.LoopAddress.ValueAsInt, iStrings);
            end;
          end;
          for DeviceAddress := 0 to iLoop.LoopDevices.Max do
          begin
            iDevice := iLoop.LoopDevices.LoopDevice[DeviceAddress];
            if iDevice.IOType <> sdt_Not_Fitted then
            begin
              if RadioButtonDefault.Checked then
              begin
                iStrings.Add('Device' + IntToStr(DeviceAddress + 1) + '=' +  ChangeTypeDefault(iDevice));
              end
              else if RadioButtonSounders.Checked then
              begin
                iStrings.Add('Device' + IntToStr(DeviceAddress + 1) + '=' +  ChangeTypeSounders(iDevice));
              end
              else if RadioButtonAllDevices.Checked then
              begin
                iStrings.Add('Device' + IntToStr(DeviceAddress + 1) + '=' +  ChangeTypeAllDevices(iDevice));
              end;
            end;
          end;
        end;
      end;
      if SigGeneralGridSimSystem.Cell[3, iRow] <> SigGeneralGridSimSystem.Cell[3, iRow + 1] then //Check for 4+4 Panel
      begin
        ExportFile(iPanel.ZFPFile.FileName, iPanel.ID, MergePanels, iStrings);
        MergePanels := FALSE;
      end
      else
      begin
        MergePanels := TRUE;
      end;
    end;
  end;
end;

procedure TFrameSimSystem.RefreshPanelTable(const iFile: tZFPFile);
var
  PanelID, iRow : integer;
  iPanel: tZFPNode;
begin
  with SigGeneralGridSimSystem do
  begin
    iRow := 0;
    ClearCells;
    for PanelID := 0 to iFile.NodeList.Max do
    begin
      inc( iRow );
      iPanel := iFile.NodeList.Node[PanelID];
      Cell[1, iRow] := iPanel.Name1.Value;
      Cell[2, iRow] := iPanel.ID.ToString;
      Cell[3, iRow] := '0';
      RowCount := iRow + 1;
    end;
  end;
end;

procedure TFrameSimSystem.ExportFile(const BaseName : string ; const PanelID : integer ; const MergePanels : boolean ; const ASYData: tStrings);
var
  FileName : string;
  FilePath : string;
begin
  FilePath := ChangeFileExt(BaseName, '');
  case MergePanels of
    TRUE: //Merge is set when dealing with 2nd Panel in a 4+4. Filename to include both Panel IDs
    begin
      FileName := FilePath + '(Panel ' + InttoStr(PanelID - 1) + '&' + InttoStr(PanelID) + ')' + '.ASY';
    end;
    FALSE:
    begin
      FileName := FilePath + '(Panel ' + InttoStr(PanelID) + ')' + '.ASY';
    end;
  end;
  ASYData.SaveToFile(FileName);
end;

procedure TFrameSimSystem.DoLoopHeader(const LoopID : integer ; const ASYData: tStrings);
begin
  ASYData.Add('[Loop' + IntToStr(LoopID) + ']');
  ASYData.Add('CableImpedance=1810');
  ASYData.Add('CableFirstRun=0');
  ASYData.Add('CableFirstLength=0');
  ASYData.Add('CableMaxRun=0');
  ASYData.Add('CableTotalLength=0');
  ASYData.Add('Calculation=0');
  ASYData.Add('MaxOutputs=126');
  ASYData.Add('DINLEDsDisabled=False');
  ASYData.Add('IgnoreIsolators=False');
end;

procedure TFrameSimSystem.DoFileHeader(const ASYData: tStrings);
begin
  ASYData.Add(';Configuration data for Apollo Discovery SimSystem');
  ASYData.Add('[SimSys]');
  ASYData.Add('DataFormat=1');
  ASYData.Add('CreatedDate=' + DatetoStr(date));
  ASYData.Add('ModifiedDate=' + DatetoStr(date));
  ASYData.Add('PanelType="Unknown Panel"');
end;

