procedure TFormMain.FrameGlobalDevicesSigGridEditorDevDisablementClick(
  Sender: TObject);
var
  iRow : integer;
  iObject : tZFPGlobalObject;
  iDevice : tLoopDevice;
begin
  with Sender as TSigGridEditor do
  begin
    iRow := CellRowBeingEdited;
  end;
  iDevice := FrameGlobalDevices.SigGeneralGridGlobalDevices.CellObject[ cColDevName, iRow ] as tLoopDevice;
  if assigned( iDevice ) then
  begin
    if iDevice.SupportsDisablementGroups then
    begin
      if not iDevice.HasMultipleDisablementGroups then
      begin
        iObject := iDevice.FirstDisablementGroup;
        iObject := fSigFile.CauseAndEffects.InputGroups.SelectFromList( TRUE, iObject, iDevice.OwnerPanel );
        iDevice.FirstDisablementGroup := iObject as tInputGroup;
        with FrameGlobalDevices.SigGeneralGridGlobalDevices do
        begin
          if assigned( iObject ) then
          begin
            Cell[ cColDisablement, iRow ] := iObject.Name;
          end
          else
          begin
            Cell[ cColDisablement, iRow ] := '';
          end;
        end;
      end;
    end;
  end;
end;

