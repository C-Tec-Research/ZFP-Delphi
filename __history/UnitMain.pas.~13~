procedure TFormMain.ImageLogoClick(Sender: TObject);
var
  iLogo : string;
  iInitDir : string;
  iFile : file of byte;
  iError : string;
begin
  with OpenPictureDialogLogo do
  begin
    iLogo := fSigFile.Logo.Value;
    iInitDir := ExtractFilePath( iLogo );
    InitialDir := iInitDir;
    FileName := ExtractFileName( iLogo );
    if Execute then
    begin
      fSigFile.Logo.LoadImage( FileName );
      ShowLogo;
      if assigned( ImageLogo.Picture ) then
      begin
        if (ImageLogo.Picture.Width > 150) or (ImageLogo.Picture.Height > 150) then
        begin
          fSigFile.LogoOversized.ValueAsBool := TRUE;
          raise Exception.Create('Warning - Logo exceeds specified dimensions of 150 x 150 pixels and will not be sent to panels');
        end
        else
        begin
          AssignFile( iFile, FileName );
          Reset( iFile );
          try
            if FileSize( iFile ) > 8192 then
            begin
              fSigFile.LogoOversized.ValueAsBool := TRUE;
              iError := Translate( 'Error' ) + ' - ' + Translate( 'Logo exceeds maximum file size of 8192 bytes and will not be sent to panels.' ) + ' '
                        + Translate( 'Try reducing size or number of colours.');
              raise Exception.Create( iError );
            end;
          finally
            CloseFile( iFile );
          end;
          fSigFile.LogoOversized.ValueAsBool := FALSE;
        end;
      end;
    end;
  end;
end;

