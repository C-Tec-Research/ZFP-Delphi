procedure TFormMain.ShowZoneDeviceSummary;
var
  i, j, z, s, f, iRow : integer;
  iPanel : tZFPNode;
  iLoop : tLoop;
  iDevice : tLoopDevice;
  iZone, sZone : tZFPZone;
  iSubDevices : string;
  iSubDevice : tLoopSubDevice;
  iField : tLoopSubDeviceField;
  iLastSD : integer;
  iFirstSD : integer;
const
  cColZoneName = 0;
  cColZoneID = cColZoneName + 1;
  cColLoopName = cColZoneID + 1;
  cColLoopID = cColLoopName + 1;
  cColDevAddress = cColLoopID + 1;
  cColDevSubAddresses = cColDevAddress + 1;
  cColDevType = cColDevSubAddresses + 1;
  cColDevImage = cColDevType + 1;
  cColDevName = cColDevImage + 1;
begin
  with FrameGlobalDevices.SigGeneralGridZonalSummary do
  begin
    ClearCells;
    iRow := 1;
    i := TabControlPanels.TabIndex;
    if i = -1 then
    begin
      if EditPanelName.Text <> '' then
      begin
        EditPanelName.Text := '';
      end;
      Visible := FALSE;
    end
    else
    begin
      //iPanel := TabControlPanels.Tabs.Objects[ i ] as tZFPNode;
      iPanel := fSigFile.NodeList.Node[ i ];
      for z := 0 to fSigFile.ZoneList.Max do
      begin
        iZone := fSigFile.ZoneList.Zone[ z ];
        for i := 0 to iPanel.LoopList.Max do
        begin
          iLoop := iPanel.LoopList.Loop[ i ];
          for j := 0 to iLoop.LoopDevices.Max do
          begin
            iDevice := iLoop.LoopDevices.LoopDevice[ j ];
            if iDevice.IOType <> sdt_Not_Fitted then
            begin
              iSubDevices := '';
              iLastSD := 0;
              iFirstSD := 0;
              for s := 1 to iDevice.SubDevices.Max do // ignore device
              begin
                iSubDevice := iDevice.SubDevices.SubDevice[ s ];
                sZone := nil;
                for f := 0 to iSubDevice.Fields.Max do
                begin
                  iField := iSubDevice.Fields.Field[ f ];
                  if iField.FieldDescriptor.DeviceFieldEditorStyle = es_Zone then
                  begin
                    sZone := iSubDevice.Field[ f ].Zone;
                    if not assigned( sZone ) then
                    begin
                      sZone := fSigFile.ZoneList.ObjectWithID(StrToIntDef( iSubDevice.Field[ f ].Value, 0 )) as tZFPZone;
                      iSubDevice.Field[ f ].Zone := sZone;
                    end
                    else
                    begin
                      iSubDevice.Field[ f ].PointerType1.PointerType := lf_Zone;
                    end;
                    break;
                  end;
                end;

                if sZone = iZone then
                begin
                  if iLastSD = 0 then
                  begin
                    iFirstSD := s;
                    iLastSD := s;
                  end
                  else if s = (iLastSD + 1 ) then
                  begin
                    iLastSD := s;
                  end
                  else
                  begin
                    if iSubDevices <> '' then
                    begin
                      iSubDevices := iSubDevices + ','
                    end;
                    iSubDevices := iSubDevices + IntToStr( iFirstSD );
                    if iLastSD <> iFirstSD then
                    begin
                      iSubDevices := iSubDevices + '-' + IntToStr( iLastSD );
                    end;
                    iFirstSD := s;
                    iLastSD := s;
                  end;
                end;
              end;
              // final flourish
              if iFirstSD <> 0 then
              begin
                if iSubDevices <> '' then
                begin
                  iSubDevices := iSubDevices + ','
                end;
                iSubDevices := iSubDevices + IntToStr( iFirstSD );
                if iLastSD <> iFirstSD then
                begin
                  iSubDevices := iSubDevices + '-' + IntToStr( iLastSD );
                end;
              end;
              if iSubDevices <> '' then
              begin
                inc( iRow );
                Cell[ cColZoneName, iRow ] := iZone.ExpandedName;
                Cell[ cColZoneID, iRow ] := IntToStr( iZone.ID.ValueAsInt );
                Cell[ cColLoopName, iRow ] := iLoop.VisibleName;
                Cell[ cColLoopID, iRow ] := iLoop.LoopAddress.Value;
                Cell[ cColDevAddress, iRow ] := IntToStr( j + 1 );
                Cell[ cColDevSubAddresses, iRow ] := iSubDevices;
                Cell[ cColDevType, iRow ] := iDevice.DeviceMap.ValueAsText;
                Cell[ cColDevImage, iRow ] := IntToStr( iDevice.DeviceImage );
                Cell[ cColDevName, iRow ] := iDevice.Name;
                CellObject[ cColDevName, iRow ] := iDevice;
              end;
            end;
          end;
        end;
      end;
      if iRow > 1 then
      begin
        Visible := TRUE;
        RowCount := iRow + 1;
      end
      else
      begin
        Visible := FALSE;
      end;
    end;

  end;
end;

procedure TFormMain.SigNETStringGridNodesDragOver(Sender, Source: TObject; X,
  Y: Integer; State: TDragState; var Accept: Boolean);
var
  iCellIndex, ACol, ARow, iCellIndex2, ACol2, ARow2 : integer;
begin
  with StringGridNodes do
  begin
    MouseToCell( X, Y, ACol, ARow );
    iCellIndex := ARow * ColCount + ACol + 1;
    Accept := (iCellIndex <> fDragStart );
    if iCellIndex <> fDragEnd then
    begin
      if fDragEnd <> -1 then
      begin
        iCellIndex2 := fDragEnd - 1;
        ARow2 := iCellIndex2 div ColCount;
        ACol2 := iCellIndex2 mod ColCount;
        InvalidateCell( ACol2, ARow2 );
      end;
      if Accept then
      begin
        fDragEnd := iCellIndex;
        InvalidateCell( ACol, ARow );
      end
      else
      begin
        fDragEnd := -1;
      end;
    end;
  end;
end;

procedure TFormMain.SigNETStringGridNodesDrawCell(Sender: TObject; ACol,
  ARow: Integer; Rect: TRect; State: TGridDrawState);
var
  iImageIndex, iCellIndex : integer;
  iSaveColour, iSavePenColour, iSaveFontColour : tColor;
  //iTextHt, iTextWidth : integer;
  iText : string;
  iX, iY : integer;
begin
  with StringGridNodes do
  begin
    iCellIndex := ARow * ColCount + ACol + 1; // Cell index refers to address on loop, not entry
    iImageIndex := fSigFile.NodeImage( iCellIndex );
    //if iCellIndex > Loop.MaxDevicesOnCurrentLoop then
    if iImageIndex = -1 then
    begin
      iSaveColour := Canvas.Brush.Color;
      iSavePenColour := Canvas.Pen.Color;
      Canvas.Brush.Color := clWhite;
      Canvas.Pen.Color := clWhite;
      Canvas.Rectangle( Rect.Left, Rect.Top, Rect.Right+1, Rect.Bottom+1 );
      Canvas.Brush.Color := iSaveColour;
      Canvas.Pen.Color := iSavePenColour;
    end
    else
    begin
      if iImageIndex < ImageListComponentPalette.Count then
      begin
        ImageListComponentPalette.Draw( Canvas, Rect.Left, Rect.Top, iImageIndex );
      end
      else
      begin
        iSaveColour := Canvas.Brush.Color;
        Canvas.Brush.Color := clSilver;
        Canvas.Rectangle( Rect.Left, Rect.Top, Rect.Right, Rect.Bottom );
        Canvas.Brush.Color := iSaveColour;
      end;
      iSaveColour := Canvas.Brush.Color;
      iSaveFontColour := Canvas.Font.Color;
      //if gdSelected in State then
      if iCellIndex = fDragStart then
      begin
        Canvas.Brush.Color := clGreen;
        Canvas.Font.Color := clWhite;
      end
      else if iCellIndex = fDragEnd then
      begin
        Canvas.Brush.Color := clBlue;
        Canvas.Font.Color := clWhite;
      end
      else if iCellIndex <= fNodeEditPending then
      begin
        if fNodeEditRemoving then
        begin
          Canvas.Brush.Color := clWhite;
          Canvas.Font.Color := clBlack;
        end
        else
        begin
          Canvas.Brush.Color := clBlack;
          Canvas.Font.Color := clWhite;
        end;
      end
      else if iCellIndex <= fNodeEditCurrent then
      begin
        Canvas.Brush.Color := clBlack;
        Canvas.Font.Color := clWhite;
      end
      else
      begin
        Canvas.Brush.Color := clWhite;
        Canvas.Font.Color := clBlack;
      end;
      iText := IntToStr( iCellIndex );
      Canvas.Rectangle( Rect.Left, Rect.Top + ImageListComponentPalette.Height, Rect.Right, Rect.Bottom);
      iY := (Rect.Top + ImageListComponentPalette.Height + Rect.Bottom - Canvas.TextHeight( iText )) div 2;
      iX := (Rect.Left + Rect.Right - Canvas.TextWidth( iText )) div 2;
      Canvas.TextOut( iX, iY, iText );
      Canvas.Brush.Color := iSaveColour;
      Canvas.Font.Color := iSaveFontColour;
    end;
  end;
end;

procedure TFormMain.SigNETStringGridNodesEndDrag(Sender, Target: TObject; X,
  Y: Integer);
var
  ARow, ACol : integer;
begin
  // swap values if drag successful
  if assigned( Target ) then
  begin
    with StringGridNodes do
    begin
      MouseToCell( X, Y, ACol, ARow );
      fDragEnd := ARow * ColCount + ACol + 1;
    end;
    if (fDragStart >= 0) and (fDragEnd >= 0) then
    begin
      if (fDragStart <> fDragEnd) then
      begin
        fSigFile.NodeList.Swap( fDragStart, fDragEnd );
      end;
    end;
  end;
  if fDragEnd <> -1 then
  begin
    fNodeEditCurrent := IntToStr( fDragEnd );
  end
  else if fDragStart <> -1 then
  begin
    fNodeEditCurrent := IntToStr( fDragStart );
  end;
  fDragStart := -1;
  fDragEnd := -1;
  fSigNETStringGridNodesDragging := FALSE;
  StringGridNodes.Invalidate;
end;

procedure TFormMain.SigNETStringGridNodesMouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  ACol, ARow : integer;
  iCellIndex : integer;
begin
  with StringGridNodes do
  begin
    MouseToCell( X, Y, ACol, ARow );
    iCellIndex := ARow * ColCount + ACol + 1;
    // If the Alt key (but not shift or Ctrl) and Left Mouse button
    // held down then we start the drag process to swap devices
    if Shift = [ ssAlt, ssLeft ] then
    begin
      fDragStart := iCellIndex;
      BeginDrag( TRUE );
    end
    else
    begin
      fNodeEditPending := iCellIndex;
      if not (ssCtrl in Shift) then
      begin
        // not adding
        if fNodeEditCurrent <> -1 then
        begin
          fNodeEditCurrent := '';
          fNodeEditRemoving := FALSE;
          Invalidate;
        end;
      end
      else
      begin
        fNodeEditRemoving := iCellIndex <= fNodeEditCurrent;
      end;
      fSigNETStringGridNodesMouseIsDown := TRUE;
    end;
  end;
end;

procedure TFormMain.SigNETStringGridNodesMouseMove(Sender: TObject;
  Shift: TShiftState; X, Y: Integer);
var
  ACol, ARow : integer;
  iCellIndex : integer;
  i: integer;
begin
  with StringGridNodes do
  begin
    MouseToCell( X, Y, ACol, ARow );
    iCellIndex := ARow * ColCount + ACol + 1;
    if fSigNETStringGridNodesDragging then
    begin
    end
    else if fSigNETStringGridNodesMouseIsDown then
    begin
      if fNodeEditPending.Finish > iCellIndex then
      begin
        for i := fNodeEditPending.Finish - 1 downto iCellIndex - 1 do
        begin
          ARow := i div ColCount;
          ACol := i mod ColCount;
          InvalidateCell( ACol, ARow );
        end;
        fNodeEditPending.Finish := iCellIndex;
      end
      else if fNodeEditPending.Finish < iCellIndex then
      begin
        for i := fNodeEditPending.Finish - 1 to iCellIndex - 1 do
        begin
          ARow := i div ColCount;
          ACol := i mod ColCount;
          InvalidateCell( ACol, ARow );
        end;
        fNodeEditPending.Finish := iCellIndex;
      end;
    end;
  end;
end;

procedure TFormMain.SigNETStringGridNodesMouseUp(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  i: Integer;
  iStart, iEnd : integer;
  iNodeEditPending : tDSMList;
  iCellIndex : integer;
  ARow, ACol : integer;
  iType : tNodalType;
  iNode : tZFPNode;
begin
  fSigFile.UndoRedo.GroupUndoActive := TRUE;
  try
    if fSigNETStringGridNodesDragging then
    begin
      with StringGridNodes do
      begin
        MouseToCell( X, Y, ACol, ARow );
        iCellIndex := ARow * ColCount + ACol + 1;
        fDragEnd := iCellIndex;
        if fDragStart = fDragEnd then
        begin
          EndDrag( FALSE );
        end
        else
        begin
          EndDrag( TRUE );
        end;
      end;
    end
    else
    begin
      fSigNETStringGridNodesMouseIsDown := FALSE;
      if (ssCtrl in Shift) then
      begin
        if fNodeEditRemoving then
        begin
          fNodeEditCurrent := fNodeEditCurrent - fNodeEditPending;
        end
        else
        begin
          fNodeEditCurrent := fNodeEditCurrent + fNodeEditPending;
        end;
      end
      else
      begin
        if fNodeEditCurrent <> fNodeEditPending then
        begin
          iNodeEditPending := fNodeEditPending;
          fNodeEditCurrent := iNodeEditPending;
          Invalidate;
        end;
      end;
      if ButtonGroupNodeTypePalette.ItemIndex >= 0 then
      begin
        iType := tNodalType( ButtonGroupNodeTypePalette.Items[ ButtonGroupNodeTypePalette.ItemIndex ].Data );
        if fNodeEditPending.Start >= 0 then
        begin
          if fNodeEditPending.Start <= fNodeEditPending.Finish then
          begin
            iStart := fNodeEditPending.Start;
            iEnd := fNodeEditPending.Finish;
          end
          else
          begin
            iStart := fNodeEditPending.Finish;
            iEnd := fNodeEditPending.Start;
          end;
          FormNodeChangeProblems.ClearIgnoredIncompatibilities;
          for i := iStart to iEnd do
          begin
            iNode := fSigFile.NodeList.NodeWithID( i );
            if not assigned( iNode ) then
            begin
              try
                iNode := fSigFile.NodeList.CreateNode( i, iType );
              except
                fNodeEditPending := -1;
                raise;
              end;
              fSigFile.OnAddNodeFull( iNode );
              //iNode.Name1.Value := Translate('Node ') + IntToStr( i );
            end
            else if FormNodeChangeProblems.Execute( iNode, iType ) then
            begin
              iNode.NodalType := iType;
            end
            else
            begin
              break; // abort sequence - there were problems and the user clicked cancel
            end;
          end;
        end;
      end;
      fNodeEditPending := -1;
    end;
  finally
    //UndoRedoNavigationHelper.CheckStatus;
    fSigFile.UndoRedo.GroupUndoActive := FALSE;
    StringGridNodes.Invalidate;
  end;
end;

