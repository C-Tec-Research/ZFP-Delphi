procedure TFormMain.PrintPrepareCETreePages;
var
  iText : string;
  iLeft : integer;
  i, j : integer;
  iSaveFont : tFont;
  iRect : tRect;
  iBarPos : integer;
  iTempBMP : tBitmap;
begin
  // Front Page
  iSaveFont := tFont.Create;
  //iCanvas.Lock;
  try
    with fPrintCols do
    begin
      PrintFooter;
      if not CalculatingPageCount then
      begin
        // Go one third way and print the title
        PrintPos := ((PrintPos + FooterTop) div 3);
        iSaveFont.Assign( Font );
        Font.Size := 2 * Font.Size;
        Font.Style := [ fsBold ];
        iText := Translate( 'C-Tec ENVision network' );
        iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
        TextOut( iLeft, PrintPos, iText );
        PrintPos := PrintPos + ( 2 * TextHeight( iText ));
        Font.Assign( iSaveFont );
        iText := Translate('Printed') + ': ' + DateToStr( Now );
        Font.Style := [ fsBold ];
        iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
        TextOut( iLeft, PrintPos, iText );

        {
        PrintPos := PrintPos + ( 5 * TextHeight( iText ));
        iW := PreviewPrinterMain.PageWidth div 3;
        iH := (iW * ImageLogo.Height) div ImageLogo.Width;
        iRect.Left := iW;
        iRect.Width := iW;
        iRect.Top := PrintPos;
        iRect.Height := iW;
        Printer.Canvas.StretchDraw( iRect, ImageLogo.Picture.Graphic);
        }

        Font.Assign( iSaveFont );

      end;
      // Now Summary Page
      PrintFooter;
      PrintHeader( Translate( 'Summary' ));
      PrintClient;
      PrintInstaller;
      iText := Translate( 'Node Count' ) + ': ' + IntToStr( fSigFile.NodeList.Count );
      SkipHalfLine;
      if fSigFile.SiteNotes.Lines.Count > 0 then
      begin
        Font.Style := [fsUnderline];
        TextOut( GroupBoxSiteNotes.Caption );
        Font.Style := [];
        for i := 0 to fSigFile.SiteNotes.Lines.Count - 1 do
        begin
          TextOut( fSigFile.SiteNotes.Lines[ i ] );
        end;
      end;
      // Now Loop Details
      ColumnCount := 1;
      iRect.Left := PreviewPrinterMain.OffsetX;
      iRect.Right := iRect.Left + PreviewPrinterMain.PageWidth;
      PreviewPrinterMain.Canvas.Font.Size := TreeViewCE1.Canvas.Font.Size; // * fCETreeScaleFactor; // * iScaleFactor div iFontFactor;
      PrintFooter;
      PrintHeader( Translate( 'Cause and Effects Tree' ));
      with TreeViewCE1.Items do
      begin
        for i := 0 to Count - 1 do
        begin
          if (PrintPos + fCETreeRowHeight  ) > FooterTop then
          begin
            PrintFooter;
            PrintHeader( Translate( 'Cause and Effects Tree' ));
          end;
          if not CalculatingPageCount then
          begin
            // print Node i.
            with TreeViewCE1.Items[ i ] do
            begin
              Printer.Canvas.Pen.Width := fCETreeScaleFactor;
              for j := 0 to Level - 2 do
              begin
                if MoreChildrenAtLevel( TreeViewCE1, j + 1, i ) then
                begin
                  // draw a vertical line from the middle bottom of image placing
                  iBarPos :=  Printer.OffsetX + (j*fCETreeIndent + (fCETreeImageWidth div 2)) - fCETreeScaleFactor div 2;
                  Printer.Canvas.MoveTo( iBarPos, PrintPos );
                  Printer.Canvas.LineTo( iBarPos, PrintPos + fCETreeRowHeight );
                end;
              end;
              // Now current entry
              if Level > 0 then
              begin
                iBarPos := Printer.OffsetX + ( (Level - 1) *fCETreeIndent + (fCETreeImageWidth div 2)) - fCETreeScaleFactor div 2;
                Printer.Canvas.MoveTo( iBarPos, PrintPos );
                if MoreChildrenAtLevel( TreeViewCE1, Level, i ) then
                begin
                  // full bar required
                  Printer.Canvas.LineTo( iBarPos, PrintPos + fCETreeRowHeight );
                end
                else
                begin
                  // Part bar required
                  Printer.Canvas.LineTo( iBarPos, PrintPos + fCETreeImageHeight div 2 );
                end;
                // Horizontal bar always required
                Printer.Canvas.MoveTo( iBarPos, PrintPos + fCETreeImageHeight div 2 );
                inc( iBarPos, fCETreeIndent - (fCETreeImageHeight div 2) );
                Printer.Canvas.LineTo( iBarPos, PrintPos + fCETreeImageHeight div 2 );
              end
              else
              begin
                iBarPos := Printer.OffsetX;
              end;
              // now draw the image
              if (ImageIndex >= 0) and (ImageIndex < TreeViewCE1.Images.Count ) then
              begin
                iTempBMP := tBitMap.Create;
                try
                  SetStretchBltMode( Printer.Canvas.Handle, HalfTone );
                  TreeViewCE1.Images.GetBitmap( ImageIndex, iTempBMP );
                  StretchBlt( Printer.Canvas.Handle, iBarPos, PrintPos, fCETreeImageWidth,
                              fCETreeImageHeight, iTempBMP.Canvas.Handle, 0, 0, iTempBMP.Width,
                              iTempBMP.Height, SRCCOPY );
                finally
                  iTempBMP.Free;
                end;
                // The text
                iLeft := iBarPos + fCETreeTextIndent; // where the text will start
                Printer.Canvas.TextOut( iLeft, PrintPos + (fCETreeImageHeight - Printer.Canvas.TextHeight( Text )) div 2, Text );
                // Now the small line underneath if required
                if HasChildren then
                begin
                  inc( iBarPos, (fCETreeImageWidth - fCETreeScaleFactor)  div 2 );
                  Printer.Canvas.MoveTo( iBarPos, PrintPos + fCETreeImageHeight );
                  Printer.Canvas.LineTo( iBarPos, PrintPos + fCETreeRowHeight );
                end;
              end
            end;
          end;
          PrintPos := PrintPos + fCETreeRowHeight;
        end;
      end;

      Font.Assign( iSaveFont );
    end;
  finally
    iSaveFont.Free;
    //iCanvas.Unlock;
  end;
end;

procedure TFormMain.PrintPrepareCurrentDevicePages;
var
  iText : string;
  iLeft, iMargin : integer;
  i, j, k : integer;
  iSaveFont : tFont;
  iHeaderRowCount : integer;
  iHeaderRowRequired : boolean;
  iRowHeight : integer;
  iCellWidth : integer;
  iRect : tRect;
  iDelta : integer;
  iScaleFactor : integer;
  iGrid : TSigGeneralGrid;
  //iFontSize : integer;
  //iW, iH : integer;
begin
  // Front Page
  iSaveFont := tFont.Create;
  //iCanvas.Lock;
  if FrameGlobalDevices.PageControlPanelDevices.ActivePage = FrameGlobalDevices.TabSheetZonalSummary then
  begin
    iGrid := FrameGlobalDevices.SigGeneralGridZonalSummary;
  end
  else
  begin
    iGrid := FrameGlobalDevices.SigGeneralGridGlobalDevices;
  end;
  try
    with fPrintCols do
    begin
      PrintFooter;
      if not CalculatingPageCount then
      begin
        // Go one third way up and print the title
        PrintPos := ((PrintPos + FooterTop) div 3);
        iSaveFont.Assign( Font );
        Font.Size := 2 * Font.Size;
        Font.Style := [ fsBold ];
        iText := Translate( 'C-Tec ENVision network' );
        iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
        TextOut( iLeft, PrintPos, iText );
        PrintPos := PrintPos + ( 2 * TextHeight( iText ));
        Font.Assign( iSaveFont );
        iText := Translate('Printed') + ': ' + DateToStr( Now );
        Font.Style := [ fsBold ];
        iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
        TextOut( iLeft, PrintPos, iText );

        {
        PrintPos := PrintPos + ( 5 * TextHeight( iText ));
        iW := PreviewPrinterMain.PageWidth div 3;
        iH := (iW * ImageLogo.Height) div ImageLogo.Width;
        iRect.Left := iW;
        iRect.Width := iW;
        iRect.Top := PrintPos;
        iRect.Height := iW;
        Printer.Canvas.StretchDraw( iRect, ImageLogo.Picture.Graphic);
        PrintPos := PrintPos + iH;
        }

        PrintPos := PrintPos + ( 5 * TextHeight( iText ));
        iText := 'For ' + TabControlPanels.Tabs[ TabControlPanels.TabIndex ];
        Font.Style := [ fsBold ];
        iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
        TextOut( iLeft, PrintPos, iText );

        Font.Assign( iSaveFont );
      end;
      // Now Summary Page
      PrintFooter;
      PrintHeader( Translate( 'Summary' ));
      PrintClient;
      PrintInstaller;
      iText := Translate( 'Node Count' ) + ': ' + IntToStr( fSigFile.NodeList.Count );
      SkipHalfLine;
      if fSigFile.SiteNotes.Lines.Count > 0 then
      begin
        Font.Style := [fsUnderline];
        TextOut( GroupBoxSiteNotes.Caption );
        Font.Style := [];
        SkipHalfLine;
        for i := 0 to fSigFile.SiteNotes.Lines.Count - 1 do
        begin
          TextOut( fSigFile.SiteNotes.Lines[ i ] );
        end;
      end;
      // Now Loop Details
      ColumnCount := 1;
      iHeaderRowCount := iGrid.FixedRows;
      j := iHeaderRowCount;
      iHeaderRowRequired := TRUE;
      iRect.Left := PreviewPrinterMain.OffsetX;
      iRect.Right := iRect.Left + PreviewPrinterMain.PageWidth;
      iGrid.GetPrintParms( PreviewPrinterMain.Canvas, iRect, iScaleFactor, iMargin );
      //PreviewPrinterMain.Canvas.Font.Size := Font.Size; // * iScaleFactor div iFontFactor;
      while j < iGrid.RowCount do
      begin
        iRowHeight := iGrid.PrintLineHeight( j, PreviewPrinterMain.Canvas, iScaleFactor);
        if (PrintPos + iRowHeight) > FooterTop then
        begin
          iHeaderRowRequired := TRUE;
        end;
        if iHeaderRowRequired then
        begin
          PrintFooter;
          if FrameGlobalDevices.PageControlPanelDevices.ActivePage = FrameGlobalDevices.TabSheetZonalSummary then
          begin
            PrintHeader( Translate( 'Devices by Zone' ));
          end
          else
          begin
            PrintHeader( Translate( 'Device Details' ));
          end;
          PrintSubHeader( 'For ' + TabControlPanels.Tabs[ TabControlPanels.TabIndex ] );
          PreviewPrinterMain.Canvas.Font.Assign( iGrid.Font );// * iScaleFactor div iFontFactor;
          //iFontSize := iGrid.Font.Size;
          //PreviewPrinterMain.Canvas.Font.Size := iFontSize;
          //PreviewPrinterMain.Canvas.Font.Size := Font.Size * iScaleFactor div iFontFactor;
          for i := 0 to iGrid.FixedRows - 1 do
          begin
            iRowHeight := iGrid.PrintLineHeight( i, PreviewPrinterMain.Canvas, iScaleFactor);
            if not CalculatingPageCount then
            begin
              iLeft := iMargin;
              for k := 0 to iGrid.ColCount - 1 do
              begin
                iCellWidth := iGrid.PrintColWidth( k, PreviewPrinterMain.Canvas, iScaleFactor);
                with iGrid do
                begin
                  iDelta := GridLineWidth * iScaleFactor;
                  iRect.Top := PrintPos;
                  iRect.Bottom := PrintPos + iRowHeight;
                  iRect.Left := iLeft;
                  iRect.Right := iRect.Left + iCellWidth;
                  PreviewPrinterMain.Canvas.Pen.Color := clBlack;
                  PreviewPrinterMain.Canvas.Pen.Width := iDelta;
                  PreviewPrinterMain.Canvas.Brush.Color := clSilver;
                  PreviewPrinterMain.Canvas.Rectangle( iRect );
                  inc( iRect.Top, iDelta );
                  dec( iRect.Bottom, iDelta );
                  inc( iRect.Left, iDelta );
                  dec( iRect.Right, iDelta );
                  iText := iGrid.Cell[ k, i ];
                  iGrid.Editor[ k ].PrintCell( PreviewPrinterMain.Canvas, k, i, iRect, iText );
                end;
                inc( iLeft, iCellWidth );
              end;
            end;
            PrintPos := PrintPos + iRowHeight;
          end;
          iHeaderRowRequired := FALSE;
        end;
        iRowHeight := iGrid.PrintLineHeight( j, PreviewPrinterMain.Canvas, iScaleFactor);
        if not CalculatingPageCount then
        begin
          iLeft := iMargin;
          for k := 0 to iGrid.ColCount - 1 do
          begin
            iCellWidth := iGrid.PrintColWidth( k, PreviewPrinterMain.Canvas, iScaleFactor);
            with iGrid do
            begin
              //PrintCell( k, i, iCanvas, iLeft, PrintPos, iRowHeight, iCellWidth, 1  );
              //iCanvas.Font.Assign( NormalFont );
              iDelta := GridLineWidth * iScaleFactor;
              iRect.Top := PrintPos;
              iRect.Bottom := PrintPos + iRowHeight;
              iRect.Left := iLeft;
              iRect.Right := iRect.Left + iCellWidth;
              PreviewPrinterMain.Canvas.Pen.Color := clBlack;
              PreviewPrinterMain.Canvas.Pen.Width := iDelta;
              PreviewPrinterMain.Canvas.Brush.Color := clWhite;
              PreviewPrinterMain.Canvas.Rectangle( iRect );
              inc( iRect.Top, iDelta );
              dec( iRect.Bottom, iDelta );
              inc( iRect.Left, iDelta );
              dec( irect.Right, iDelta );
              iText := iGrid.Cell[ k, j ];
              iGrid.Editor[ k ].PrintCell( PreviewPrinterMain.Canvas, k, j, iRect, iText );
            end;
            inc( iLeft, iCellWidth );
          end;
        end;
        PrintPos := PrintPos + iRowHeight;
        inc( j );
      end;
      Font.Assign( iSaveFont );
    end;
  finally
    iSaveFont.Free;
    //iCanvas.Unlock;
  end;
end;

procedure TFormMain.PrintPrepareCurrentLogPages;
var
  iText : string;
  iLeft : integer;
  i : integer;
  iSaveFont : tFont;
  iLogReport : tLogReport;
begin
  // Front Page
  iSaveFont := tFont.Create;
  try
  with fPrintCols do
  begin
    PrintFooter;
    if not CalculatingPageCount then
    begin
      // Go one third way and print the title
      PrintPos := ((PrintPos + FooterTop) div 3);
      iSaveFont.Assign( Font );
      Font.Size := 2 * Font.Size;
      Font.Style := [ fsBold ];
      iText := Translate( 'C-Tec ENVision network' );
      iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
      TextOut( iLeft, PrintPos, iText );
      PrintPos := PrintPos + ( 2 * TextHeight( iText ));
      Font.Assign( iSaveFont );
      iText := Translate('Printed') + ': ' + DateToStr( Now );
      Font.Style := [ fsBold ];
      iLeft := (PreviewPrinterMain.PageWidth - TextWidth( iText )) div 2;
      TextOut( iLeft, PrintPos, iText );

      {
      PrintPos := PrintPos + ( 5 * TextHeight( iText ));
      iW := PreviewPrinterMain.PageWidth div 3;
      iH := (iW * ImageLogo.Height) div ImageLogo.Width;
      iRect.Left := iW;
      iRect.Width := iW;
      iRect.Top := PrintPos;
      iRect.Height := iH;
      Printer.Canvas.StretchDraw( iRect, ImageLogo.Picture.Graphic);
      }

      Font.Assign( iSaveFont );

    end;
    // Now print client details
    // Now Summary Page
    PrintFooter;
    PrintHeader( Translate( 'Summary' ));
    PrintClient;
    PrintInstaller;
    iText := Translate( 'Node Count' ) + ': ' + IntToStr( fSigFile.NodeList.Count );
    Font.Style := [];
    SkipHalfLine;
    if fSigFile.SiteNotes.Lines.Count > 0 then
    begin
      Font.Style := [fsUnderline];
      TextOut( GroupBoxSiteNotes.Caption );
      Font.Style := [];
      for i := 0 to fSigFile.SiteNotes.Lines.Count - 1 do
      begin
        TextOut( fSigFile.SiteNotes.Lines[ i ] );
      end;
    end;
    // now the log pages
    with FrameLogFiles1.TabControlLogs do
    begin
      iLogReport := Tabs.Objects[ TabIndex ] as tLogReport;
    end;
    with iLogReport do
    begin
      i := 0;
      repeat
        PrintFooter;
        PrintHeader( Name );
        Printer.Canvas.Font.Assign( FrameLogFiles1.StringGridLog.Canvas.Font );
        fLogRect.Left := Printer.OffsetX;
        fLogRect.Right := Printer.PageWidth;
        fLogRect.Bottom := FooterTop;
        fLogRect.Top := PrintPos;
      until PrintPrepareLogFilePages( Printer.Canvas, fLogRect, fLogGridWidth, i, CalculatingPageCount );
    end;
  end;
  finally
    iSaveFont.Free;
  end;
end;

