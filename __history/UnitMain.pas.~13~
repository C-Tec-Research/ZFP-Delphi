function TFormMain.PrintFindCETreeLogicalWidth( const pCanvas : tCanvas; const pTree : tTreeView ) : integer;
var
  iWidth : integer;
  i: Integer;
begin
  fCETreeImageWidth := pTree.Images.Width;
  fCETreeImageHeight := pTree.Images.Height;
  fCETreeRowHeight := ( fCETreeImageHeight * 3) div 2;
  fCETreeIndent := pTree.Indent;
  fCETreeTextIndent := fCETreeIndent - fCETreeImageWidth;
  if fCETreeTextIndent <= 4 then
  begin
    fCETreeTextIndent := fCETreeImageWidth div 2;
  end;
  fCETreeTextIndent := fCETreeIndent + fCETreeImageWidth;
  Result := 0;
  for i := 0 to pTree.Items.Count - 1 do
  begin
    with pTree.Items[ i ] do
    begin
      iWidth := (Level * fCETreeIndent) + fCETreeTextIndent + pCanvas.TextWidth( Text );
      if iWidth > Result then
      begin
        Result := iWidth;
      end;
    end;
  end;
end;

