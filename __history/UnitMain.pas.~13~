procedure TFormMain.FormDestroy(Sender: TObject);
begin
  SigRegistry.WriteBoolean( 'Security Info In Reports', CheckBoxReportsIncludeSecurityInformation.Checked );
  SigRegistry.WriteBoolean( 'Show Config Tab', TabSheetConfiguration.TabVisible );
  SigRegistry.WriteBoolean( 'em_Show_Advanced_Send_Rcv', em_Show_Advanced_Send_Rcv in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Use_Full_Dictionaries', em_Use_Full_Dictionaries in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Allow_Cfg_from_remote_panels', em_Allow_Cfg_from_remote_panels in ExpertModes );
  SigRegistry.WriteBoolean( 'em_View_Log_as_Table', em_View_Log_as_Table in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Allow_File_Transfer', em_Allow_File_Transfer in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Show_Import_Export', em_Show_Import_Export in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Auto_Reload_Last_Saved_File', em_Auto_Reload_Last_Saved_File in ExpertModes );
  SigRegistry.WriteBoolean( 'em_Show_ValidationButtons', em_Show_ValidationButtons in ExpertModes );
  SigRegistry.WriteInteger( 'Error Reporting Level', Ord( ErrorReportingLevel ));

  XFP4PgmCfg.SaveIfDirty();
  XFP4PgmCfg.Free;

  fUndoRedo.Free;

  fErrors.Free;
  fErrorLists.Free;

  //FreeAndNil( fSigFile );
  FreeAndNil( fPrintCols );
end;

procedure TFormMain.FormShow(Sender: TObject);
begin
  if fFirstTime then
  begin
    fFirstTime := FALSE;

    //XFP4PgmCfg.Load();
    // make sure SigGrid events are kooked up - they seem to get lost sometimes
    FrameGlobalDevices.SigGeneralGridGlobalDevices.OnCellEditChange := FrameGlobalDevicesSigGeneralGridGlobalDevicesCellEditChange;
    FrameGlobalDevices.SigGeneralGridGlobalDevices.OnKeyPress := FrameGlobalDevicesSigGeneralGridGlobalDevicesKeyPress;
    FrameGlobalDevices.SigGeneralGridGlobalDevices.OnSelectCell := FrameGlobalDevicesSigGeneralGridGlobalDevicesSelectCell;

    FrameGlobalDevices.SigGeneralGridZonalSummary.OnCellEditChange := FrameGlobalDevicesSigGeneralGridZonalSummaryCellEditChange;
    FrameGlobalDevices.SigGeneralGridZonalSummary.OnKeyPress := FrameGlobalDevicesSigGeneralGridZonalSummaryKeyPress;

    if not FileExists( XFP4PgmCfg.FileName ) then
    begin
      MessageDlg( XFP4PgmCfg.FileName + ' not found. Program aborted.', mtError, [mbAbort], 0);
      Close;
    end;

    //fSigFile.BlockEditorUpdate := TRUE;
    TabSheetDebug.TabVisible := FALSE;
    TabSheetErrors.TabVisible := FALSE;
    TabSheetConfiguration.TabVisible := SigRegistry.ReadBoolean( 'Show Config Tab', FALSE );

    CheckBoxReportsIncludeSecurityInformation.Checked := SigRegistry.ReadBoolean( 'Security Info In Reports', TRUE );

    ShowExpertModes;

    XFP4PgmCfg.SigTranslation.TranslateWinComponent( self );

    SetupDevicePalette;
    FrameOutputGroupEditor.Setup;

    {
      Remove the following line if you don't want SigRegistry to remember widows last status
    }
    SigRegistry.RestoreMainWindowParms;

    {
      here you set up your file interactions
    }
    fSigFile.Editor := self;
    fSigFile.SaveDialog := SigSaveDialogMain;
    fSigFile.AboutForm := AboutBox;
    fSigFile.MainMenu := MainMenu;

    // set up Undo/Redo
    fSigFile.OnPrepareUndoableAction := fUndoRedo.PrepareUndoableActionTag;
    fSigFile.OnUndoableAction := self.OnUndoableChange;
    fSigFile.OnCompleteUndoableAction := fUndoRedo.CompleteUndoableActionTag;
    fSigFile.OnRedoableAction := self.OnRedoableChange;
    fSigFile.OnUndoClick := self.SpeedButtonUndoClick;
    fSigFile.OnRedoClick := self.SpeedButtonRedoClick;
    fSigFile.UndoRedoImageList := self.ImageListUndoRedo;
    fSigFile.OnLoadLine := FormLoadFile.OnLoadLine;
    fSigFile.CETreeErrorFrame := FrameErrorListCE;
    //fSigFile.OnErrorDblClick := self.OnErrorDblClick;
    fSigFile.OnErrorDblClick := self.OnFrameErrorList2DblClick; // unite 2 methods

    fSigFile.ShowOGTab := self.ShowOGTab;

    {
      if you use the printer set UsesPrinter to TRUE, else set it to FALSE
    }
    UsesPrinter := TRUE; // or false
    {
      you can fine tune printer usage here
    }
    if UsesPrinter then
    begin
      fSigFile.OnPrint := SpeedButtonPrintClick;
      fSigFile.OnPrintPreview := SpeedButtonPrintPreviewClick;
      fSigFile.OnPrinterSetup := SpeedButtonPrintSetupClick;
    end
    else
    begin
      SpeedButtonPrint.Visible := FALSE;
      SpeedButtonPrintPreview.Visible := FALSE;
      SpeedButtonPrintSetup.Visible := FALSE;
    end;

    {
      Here we add the temporary navigation objects to the file
    }

    UndoRedoNavigationHelper.RegisterObject( self );

    fSigFile.IsDirty := FALSE;
    fSigfile.OnLoad := OnLoad;
    fSigFile.OnNew := OnNew;
    // if parameter is passed, load it, otherwise create New file
    if ParamCount = 0 then
    begin
      if em_Auto_Reload_Last_Saved_File in ExpertModes then
      begin
        if SigRegistry.History[ 0 ] = '' then
        begin
          fSigFile.New;
        end
        else
        begin
          fSigFile.Load( SigRegistry.History[ 0 ] );
        end;
      end
      else
      begin
        fSigFile.New;
      end;
    end
    else
    begin
      fSigFile.Load( ParamStr( 1 ) );
    end;

    SetEditors;

    fUndoRedo.Clear;

    // Set up the Log screen tabs

    fSigFile.DeviceErrorFrame := FrameErrorListDevices;
    fSigFile.ObjectsImageList := ImageListCE;

    ErrorObjectList.ObjectTabList := TabControlImportedFiles;
    ErrorObjectList.SourceStrings := MemoImportedFiles.Lines;

    FrameErrorListSystem.ErrorList := nil;
    //FrameErrorList2.ErrorList := nil;
    //FrameErrorListOverview.ErrorList := nil;
    //FrameErrorListGeneralProperties.ErrorList := nil;

    PageControlPanelViewChange( self );

    FrameGlobalDevices.DeviceImageList := ImageListComponentPalette;

    //fSigFile.BlockEditorUpdate := FALSE;
    //FrameNetworkMain.NodeCount := fSigFile.NodeList.Max;
    fSigFile.RebuildEditors;

    FrameGlobalDevices.OnResize( self );
  end;
end;

procedure TFormMain.FrameGlobalDevicesSigGeneralGridGlobalDevicesCellEditChange(
  const Sender: TObject; const Col, Row: Integer; const Value: string);
var
  iDevice : tLoopDevice;
begin
  if Col = cColDevName then
  begin
    iDevice := FrameGlobalDevices.SigGeneralGridGlobalDevices.CellObject[ cColDevName, Row ] as tLoopDevice;
    if assigned( iDevice ) then
    begin
      iDevice.Name := Value;
    end;
  end;
end;

procedure TFormMain.FrameGlobalDevicesSigGeneralGridGlobalDevicesKeyPress(
  Sender: TObject; var Key: Char);
var
  iSel : tGridRect;
begin
  if Key = #13 then
  begin
    // CR - move selection down, if it exists
    iSel := FrameGlobalDevices.SigGeneralGridGlobalDevices.Selection;
    if iSel.Top < FrameGlobalDevices.SigGeneralGridGlobalDevices.RowCount - 1 then
    begin
      iSel.Top := iSel.Top + 1;
      iSel.Bottom := iSel.Top;
      FrameGlobalDevices.SigGeneralGridGlobalDevices.Selection := iSel;
      FrameGlobalDevices.SigGeneralGridGlobalDevices.SetFocus;
      //FrameGlobalDevices.SigGeneralGridGlobalDevices.Invalidate;
    end;
    Key := #0; // avoid 'beep'
  end;
end;

procedure TFormMain.FrameGlobalDevicesSigGeneralGridGlobalDevicesSelectCell(
  Sender: TObject; ACol, ARow: Integer; var CanSelect: Boolean);
var
  iDevice : tLoopDevice;
  iSubDevice : TLoopSubDevice;
  iNode : tZFPNode;
begin
  if ACol = cColDevImage then
  begin
    iDevice := FrameGlobalDevices.SigGeneralGridGlobalDevices.CellObject[ cColDevName, ARow ] as tLoopDevice;
    if assigned( iDevice ) then
    begin
      iSubDevice := iDevice.SubDevice[ 0 ];
      PageControlMain.ActivePage := TabSheetPanelView;
      PageControlPanelView.ActivePage := TabSheetLoops;
      iNode := iSubDevice.GetOwnerOfType( TZFPNode ) as TZFPNode;
      MakeNodeVisible( iNode );
      if PageControlPanelView.ActivePage <> TabSheetLoops then
      begin
        PageControlPanelView.ActivePage := TabSheetLoops;
        PageControlPanelViewChange( self );
      end;
      fSigFile.ShowSubDevice( iSubdevice );
    end;
  end;
end;

