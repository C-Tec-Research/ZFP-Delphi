procedure TFormMain.OnErrorDblClick(const Sender: TObject;
  const pError: tError);
var
  iOwner : tSigCompoundProperty;
  iNode : tZFPNode;
  iLoopDevice : tLoopDevice;
  iLoopSubDevice : tLoopSubDevice;
  pErrorObject : tObject;
  iLoop : tLoop;
  iGlobalObject : tZFPGlobalObject;
  iGlobalArray : tZFPGlobalArray;
begin
  if Sender is TFrameErrorList then
  begin
    fSigFile.SetHighlightedErrors( (Sender as TFrameErrorList).Highlighted );
    // Sender can also be TFrameErrorLists
  end;
  fUndoRedo.GroupUndoActive := TRUE;
  try
    pErrorObject := pError.ErrorObject;
    // locate the object through its owner list
    if assigned( pErrorObject ) then
    begin
      if pErrorObject is tSigCompoundProperty then
      begin
        iOwner := (pErrorObject as tSigCompoundProperty );
      end
      else if pErrorObject is tSigBaseProperty then
      begin
        iOwner := (pErrorObject as tSigBaseProperty).Owner;
      end
      else
      begin
        exit;
      end;
      while assigned( iOwner ) do
      begin
        if iOwner is tCETreeProperty then
        begin
          // go to tree view
          PageControlMain.ActivePage := TabSheetCauseAndEffects;
          with (iOwner as tCETreeProperty) do
          begin
            TreeNode1.Selected := TRUE;
          end;
          exit;
        end
        else if iOwner is tLoopDevice then
        begin
          PageControlMain.ActivePage := TabSheetPanelView;
          iLoopDevice := iOwner as tLoopDevice;
          iNode := iLoopDevice.OwnerPanel;
          fSigFile.NodeList.ActiveNode := iNode;
          PageControlPanelView.ActivePage := TabSheetLoops;
          iLoop := iLoopDevice.OwnerLoop;
          iNode.LoopList.ActiveLoop := iLoop;
          iLoop.LoopDevices.DeviceEditMode := demDeviceEntries;
          // we are now showing the right loop. Select the right device.
          iLoop.LoopDevices.SetErrorObject( iLoopDevice, nil );
          exit;
        end
        else if iOwner is tLoopSubDevice then
        begin
          PageControlMain.ActivePage := TabSheetPanelView;
          iLoopSubDevice := (iOwner as tLoopSubDevice);
          iLoopDevice := iLoopSubdevice.Device;
          iNode := iLoopDevice.OwnerPanel;
          fSigFile.NodeList.ActiveNode := iNode;
          PageControlPanelView.ActivePage := TabSheetLoops;
          iLoop := iLoopDevice.OwnerLoop;
          iNode.LoopList.ActiveLoop := iLoop;
          iLoop.LoopDevices.DeviceEditMode := demDeviceEntries;
          // we are now showing the right loop. Select the right device.
          iLoop.LoopDevices.SetErrorObject( iLoopDevice, iLoopSubdevice );
          exit;
        end
        else if iOwner is tZFPGlobalObject then
        begin
          PageControlMain.ActivePage := TabSheetNetworkView;
          iGlobalObject := iOwner as tZFPGlobalObject;
          iGlobalArray := iGlobalObject.OwnerAsZFPGlobalArray;
          if iGlobalArray.EditorFrame = FrameGlobalObjectEditorModes then
          begin
            PageControlNetworkView.ActivePage := TabSheetGlobalModes;
          end
          else if iGlobalArray.EditorFrame = FrameZoneEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetGlobalZoning;
          end
          else if iGlobalArray.EditorFrame = FrameInputGroupEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetGlobalInputGroups;
          end
          else if iGlobalArray.EditorFrame = FrameInputSupergroupEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetInputSuperGroups;
            FrameInputSupergroupEditor.PageControlProperties.ActivePage := FrameInputSupergroupEditor.TabSheetComponentGroups;
          end
          else if iGlobalArray.EditorFrame = FrameOutputGroupEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetGlobalOutputGroups;
          end
          else if iGlobalArray.EditorFrame = FrameSupergroupEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetSuperGroups;
            FrameSupergroupEditor.PageControlProperties.ActivePage := FrameSupergroupEditor.TabSheetComponentGroups;
          end
          else if iGlobalArray.EditorFrame = FrameSequenceEditor then
          begin
            PageControlNetworkView.ActivePage := TabSheetSequences;
          end
          else if iGlobalArray.EditorFrame = FrameGlobalObjectEditorPulsePatterns then
          begin
            PageControlNetworkView.ActivePage := TabSheetPulsePatterns;
          end
          else if iGlobalArray.EditorFrame = FrameGlobalObjectEditorGroupActions then
          begin
            PageControlNetworkView.ActivePage := TabSheetGroupActions;
          end;
          iGlobalArray.SetActiveChildObject( iGlobalObject );
          exit;
        end;
        iOwner := iOwner.Owner;
      end;
      raise Exception.Create('Internal Error 002');
    end;
  finally
    UndoRedoNavigationHelper.CheckStatus;
    UndoRedo.GroupUndoActive := FALSE;
  end;
end;

