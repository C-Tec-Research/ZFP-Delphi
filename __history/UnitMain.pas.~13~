procedure TFormMain.ImportLines(const pLines: tStrings; fErrorList : tErrorList);
var
  iIndex : integer;
  iRecType : integer;
  iDataFound : boolean;
  iColumns : tStringList;
  iPanel : integer;
  iErrText : string;
  iLineCount : integer;
  iNode : tZFPNode;
  iErrorObject : tErrorObject;
begin
  iErrorObject := tErrorObject.Create;
  iColumns := tStringList.Create;
  try
    // open the file to see what panel and record type we are dealing with

    iIndex := 0;
    iDataFound := FALSE;
    iErrorObject.FileName := OpenDialogCSV.Filename;
    iLineCount := pLines.Count;
    while iIndex < iLineCount do
    begin
      FormLoadFile.OnLoadLine( iIndex, iLineCount );
      CommaListToStringList( pLines[ iIndex ], iColumns, TRUE );
      if ( iColumns.Count > 2 ) and SameText( iColumns[ 1 ], 'BEGIN')  then
      begin
        iDataFound := TRUE;
        iPanel := fSigFile.NodeList.IndexOfNodeWithID( StrToInt( iColumns[ 2 ] ) );
        if iPanel < 0  then
        begin
          iPanel := fSigFile.NodeList.Max + 1;
          fSigFile.NodeList.Max := iPanel;
          fSigFile.NodeList.Node[ iPanel ].NetworkFile.PanelAddress.Address.ValueAsInt := StrToInt( iColumns[ 2 ] );
        end;
        iRecType := StrToInt( iColumns[ 0 ] );
        iNode := fSigFile.NodeList.Node[ iPanel ];
        case iRecType of
          // ------------ Phase 1 ------------
          // 120 - Network File
          120: iNode.ImportNetworkFile( pLines, iIndex, Errors, iErrorObject );
          // ------------ Phase 2 ------------
          //  80 - Panel Data
          80:  iNode.GeneralProperties.ImportFile( pLines, iIndex, Errors, iErrorObject );
          //  17 Shared input groups and triggers
          17:  iNode.ImportSharedInputGroups( pLines, iIndex, Errors, iErrorObject );
          //  18 - Shared Output Groups
          18:  iNode.ImportSharedOutputGroups( pLines, iIndex, Errors, iErrorObject );
          //  19 - Shared Output Super Groups
          19:  iNode.ImportSharedSuperGroups( pLines, iIndex, Errors, iErrorObject );
          //  81 - Mode Share Data
          81:  iNode.ImportSharedModes( pLines, iIndex, Errors, iErrorObject );
          //  90 - comments
          90:  iNode.PanelNotes.ImportFile( pLines, iIndex, Errors, iErrorObject );
          // 100 - Zone Data
          100: iNode.ImportZones( pLines, iIndex, Errors, iErrorObject );
          // 151 - Input Supergroup Share Data
          151: iNode.ImportSharedInputSuperGroups( pLines, iIndex, Errors, iErrorObject );
          // 152 - Sequence Share Data
          152: iNode.ImportSharedSequences( pLines, iIndex, Errors, iErrorObject );
          // 153 - Pulse Pattern Share Data
          153: iNode.ImportSharedPulsePatterns( pLines, iIndex, Errors, iErrorObject );
          // 160 - Group Action Share Data
          160: iNode.ImportSharedGroupActions( pLines, iIndex, Errors, iErrorObject );

          //  20 - Device Data
          20:  iNode.ImportDeviceFieldsFile( pLines, iIndex, Errors, iErrorObject );
          //  14 - Input groups and triggers
          14:  iNode.ImportInputGroups( pLines, iIndex, Errors, iErrorObject );
          //  15 - Output Groups
          15:  iNode.ImportOutputGroups( pLines, iIndex, Errors, iErrorObject );
          //  16 - Output supergroups
          16:  iNode.ImportOutputSuperGroups( pLines, iIndex, Errors, iErrorObject );
          //  40 - Sequences
          40:  iNode.ImportSequences( pLines, iIndex, Errors, iErrorObject );
          //  60 - Pulse sequences
          60:  iNode.ImportPulseSequences( pLines, iIndex, Errors, iErrorObject );
          //  161 - Group ACtions
          161: iNode.ImportGroupActions(  pLines, iIndex, Errors, iErrorObject );
          // 154 - Input supergroups
          154: iNode.ImportInputSuperGroups( pLines, iIndex, Errors, iErrorObject );
          //   2 - Device Names
          2:   iNode.ImportNamesFile( pLines, iIndex, Errors, iErrorObject );
          // 150 - CE Tree
          150: fSigFile.ImportCETree( pLines, iIndex, Errors, iErrorObject );
          // 300 - binary file - Logo?
          300:
          begin
            fSigFile.ImportBinaryFile( pLines, iIndex, Errors, iErrorObject );
            ShowLogo;
          end;
          301:
          begin
            fSigFile.ImportTextFile( pLines, iIndex, Errors, iErrorObject );
          end
          else
          begin
            if iNode.ImportLogFile( iRecType, pLines, iIndex, Errors, iErrorObject ) then
            begin
              PageControlMain.ActivePage := TabSheetPanelView;
              PageControlPanelView.ActivePage := TabSheetPanelLogs;
            end
            else
            begin
              iErrText := Translate( 'Unrecognised Record Type') + ' "' + iColumns[ 0 ] + '"';
              Errors.Add( tErrorSeverity.es_Error, iIndex, iErrText, self);
            end;
          end;
        end;
      end;
      inc( iIndex );
    end;
    if iDataFound then
    begin
      SigFile.ExecuteAfterLoadActions;
    end
    else
    begin
      // if we get here, no BEGIN record was found
      {
      iErrText := Translate( 'EOF before "BEGIN" found');
      Errors.Add( tErrorSeverity.es_Error, pLines.Count - 1, iErrText, self);
      }
    end;
    // update editors
    LoadPanelView;
  finally
    FormLoadFile.OnLoadLine( 100, 100 );
    if Errors.Count = 0 then
    begin
      FrameErrorListSystem.ErrorList := nil;
      iErrorObject.Free;
    end
    else
    begin
      if em_Show_Errors_Tab in ExpertModes then
      begin
        TabSheetErrors.TabVisible := TRUE;
        PageControlMain.ActivePage := TabSheetErrors;
        FrameErrorListSystem.ErrorList := Errors;
        FrameErrorListSystem.OnErrorDblClick := OnFrameErrorList1DblClick;
        //FrameErrorListDevices.OnErrorDblClick := self.OnErrorDblClick;
        iErrorObject.SourceStrings := pLines;
        ErrorObjectList.TabIndex := iErrorObject.TabIndex;
      end;
    end;
    iColumns.Free;
    ShowDeviceSummary;
    ShowZoneDeviceSummary;
    UndoRedoNavigationHelper.CheckStatus;
    fUndoRedo.Clear;  // cannot undo an import
  end;
end;

