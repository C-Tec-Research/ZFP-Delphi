procedure TFormMain.PrintCalculateCETree;
var
  iLogicalWidth, iPhysicalWidth : integer;
  iPrinterTextHeight, iScreenTextHeight : integer;
  iCETreeScaleFactor : integer;
  iSaveFont : tFont;
begin
  with fPrintCols do
  begin
    Printer := PreviewPrinterMain;
    ColumnCount := 1;
    PageCount := 0;
    CurrPageNo := 0;
    CalculatingPageCount := TRUE;
    with Column[ 0 ] do
    begin
      Wrap := TRUE;
      HangingIndent := (Right - Left) div 6;
    end;
  end;
  PrintSetup;
  iLogicalWidth := PrintFindCETreeLogicalWidth( TreeViewCE1.Canvas, TreeViewCE1 );
  iPhysicalWidth := PreviewPrinterMain.PageWidth;
  if iLogicalWidth = 0 then
  begin
    raise Exception.Create(Translate('Nothing to print'));
  end;
  // else
  fCETreeScaleFactor := iPhysicalWidth div iLogicalWidth;
  // update other factors
  // see if the text ratio version is smaller;
  iSaveFont := tFont.Create;
  iSaveFont.Assign( PreviewPrinterMain.Canvas.Font );
  PreviewPrinterMain.Canvas.Font.Assign( TreeViewCE1.Canvas.Font );
  iPrinterTextHeight := PreviewPrinterMain.Canvas.TextHeight( 'XX' );
  iScreenTextHeight := TreeViewCE1.Canvas.TextHeight( 'XX' );
  iCETreeScaleFactor := iPrinterTextHeight div iScreenTextHeight;
  PreviewPrinterMain.Canvas.Font.Assign( iSaveFont );
  iSaveFont.Free;
  if iCETreeScaleFactor < fCETreeScaleFactor then
  begin
    fCETreeScaleFactor := iCETreeScaleFactor;
  end;
  fCETreeRowHeight := fCETreeScaleFactor * fCETreeRowHeight;
  fCETreeImageWidth := fCETreeScaleFactor * fCETreeImageWidth;
  fCETreeImageHeight := fCETreeScaleFactor * fCETreeImageHeight;
  fCETreeIndent := fCETreeScaleFactor * fCETreeIndent;
  fCETreeTextIndent := fCETreeScaleFactor * fCETreeTextIndent;
  PrintPrepareCETreePages;
end;

