procedure TFormMain.ShowDeviceSummary;
var
  i, j, iRow : integer;
  iPanel : tZFPNode;
  iLoop : tLoop;
  iDevice : tLoopDevice;
  iCanRetry : boolean;
  iIG : tInputGroup;
  iOG : tOutputGroup;
  iZone : tZFPZone;
{
const
  cColLoopName = 0;
  cColLoopID = cColLoopName + 1;
  cColDevAddress = cColLoopID + 1;
  cColDevType = cColDevAddress + 1;
  cColDevImage = cColDevType + 1;
  cColDevName = cColDevImage + 1;
  cColZoneMain = cColDevName + 1;
  cColIGMain  = cColZoneMain + 1;
  cColOGMain  = cColIGMain + 1;
  cColDisablement = cColOGMain + 1;
  cColFault = cColDisablement + 1;
}
label
  Retry;
begin
  iCanRetry := TRUE;
Retry:
  with FrameGlobalDevices.SigGeneralGridGlobalDevices do
  begin
    ClearCells;
    iRow := 1;
    i := TabControlPanels.TabIndex;
    if i = -1 then
    begin
      Visible := FALSE;
    end
    else if not assigned( TabControlPanels.Tabs.Objects[ i ] ) then
    begin
      Visible := FALSE;
    end
    else
    begin
      //iPanel := TabControlPanels.Tabs.Objects[ i ] as tZFPNode;
      iPanel := fSigFile.NodeList.Node[ i ];
      if assigned( iPanel ) then
      begin
        for i := 0 to iPanel.LoopList.Max do
        begin
          iLoop := iPanel.LoopList.Loop[ i ];
          for j := 0 to iLoop.LoopDevices.Max do
          begin
            iDevice := iLoop.LoopDevices.LoopDevice[ j ];
            if iDevice.IOType <> sdt_Not_Fitted then
            begin
              inc( iRow );
              Cell[ cColLoopName, iRow ] := iLoop.VisibleName;
              Cell[ cColLoopID, iRow ] := iLoop.LoopAddress.Value;
              Cell[ cColDevAddress, iRow ] := IntToStr( j + 1 );
              Cell[ cColDevType, iRow ] := iDevice.DeviceMap.ValueAsText;
              Cell[ cColDevImage, iRow ] := IntToStr( iDevice.DeviceImage );
              Cell[ cColDevName, iRow ] := iDevice.Name;
              CellObject[ cColDevName, iRow ] := iDevice;
              iZone := iDevice.FirstZone;
              if assigned( iZone ) then
              begin
                if iDevice.HasMultipleZones then
                begin
                  Cell[ cColZoneMain, iRow ] := iZone.Name + '...';
                end
                else
                begin
                  Cell[ cColZoneMain, iRow ] := iZone.Name;
                end;
              end
              else
              begin
                Cell[ cColZoneMain, iRow ] := '';
              end;
              iIG := iDevice.FirstInputGroup;
              if assigned( iIG ) then
              begin
                if iDevice.HasMultipleInputGroups then
                begin
                  Cell[ cColIGMain, iRow ] := iIG.Name + '...';
                end
                else
                begin
                  Cell[ cColIGMain, iRow ] := iIG.Name;
                end;
              end
              else
              begin
                Cell[ cColIGMain, iRow ] := '';
              end;
              iOG := iDevice.FirstOutputGroup;
              if assigned( iOG ) then
              begin
                if iDevice.HasMultipleOutputGroups then
                begin
                  Cell[ cColOGMain, iRow ] := iOG.Name + '...';
                end
                else
                begin
                  Cell[ cColOGMain, iRow ] := iOG.Name;
                end;
              end
              else
              begin
                Cell[ cColOGMain, iRow ] := '';
              end;
              iIG := iDevice.FirstDisablementGroup;
              if assigned( iIG ) then
              begin
                if iDevice.HasMultipleDisablementGroups then
                begin
                  Cell[ cColDisablement, iRow ] := iIG.Name + '...';
                end
                else
                begin
                  Cell[ cColDisablement, iRow ] := iIG.Name;
                end;
              end
              else
              begin
                Cell[ cColDisablement, iRow ] := '';
              end;
              iIG := iDevice.FirstFaultGroup;
              if assigned( iIG ) then
              begin
                if iDevice.HasMultipleFaultGroups then
                begin
                  Cell[ cColFault, iRow ] := iIG.Name + '...';
                end
                else
                begin
                  Cell[ cColFault, iRow ] := iIG.Name;
                end;
              end
              else
              begin
                Cell[ cColFault, iRow ] := '';
              end;
            end;
          end;
        end;
        if iRow > 1 then
        begin
          Visible := TRUE;
          RowCount := iRow + 1;
        end
        else
        begin
          Visible := FALSE;
        end;
      end
      else if iCanRetry then
      begin
        iCanRetry := FALSE;
        LoadPanelView;
        goto Retry;
      end
      else
      begin
        Visible := FALSE;
      end;
    end;

  end;
end;

