procedure TFormMain.LoadPanelView;
var
  i, iSaveIndex : integer;
  iNode : tZFPNode;
begin
  iSaveIndex := TabControlPanels.TabIndex;
  with TabControlPanels.Tabs do
  begin
    if fSigFile.NodeList.Max < (Count - 1) then
    begin
      Clear;
    end;
    for i := 0 to fSigFile.NodeList.Max do
    begin
      iNode := fSigFile.NodeList.Node[ i ];
      if assigned( iNode.NodeType ) then
      begin
        if i >= Count then
        begin
        AddObject( '[' + IntToStr( iNode.ID ) + ']' + iNode.Name1.Value, iNode);
        end
        else
        begin
          Strings[ i ] := '[' + IntToStr( iNode.ID ) + ']' + iNode.Name1.Value;
          Objects[ i ] := iNode;
        end;
      end;
    end;
    if Count = 0 then
    begin
      TabControlPanels.Visible := FALSE;
    end
    else
    begin
      TabControlPanels.Visible := TRUE;
      if (iSaveIndex < 0) or (iSaveIndex >= Count) then
      begin
        TabControlPanels.TabIndex := 0;
      end
      else
      begin
        TabControlPanels.TabIndex := iSaveIndex;
      end;
      //VisibleNode := TabControlPanels.Tabs.Objects[ TabControlPanels.TabIndex ] as tZFPNode;
      VisibleNode := fSigFile.NodeList.Node[ TabControlPanels.TabIndex ];
      //VisibleNode.RefreshEditors; Not required. Done in SigFile.RefreshEditors
    end;
  end;
  SigFile.RefreshEditors;
  //SigFile.CauseAndEffects.RefreshEditors;
end;

procedure TFormMain.LocateDevices(const pPanel, pLoop: integer);
begin
  // first switch to panel view
  PageControlMain.ActivePage := TabSheetPanelView;
  // and on to the devices view
  PageControlPanelView.ActivePage := TabSheetLoops;
  // now set the active devices
  with fSigFile.NodeList do
  begin
    //DeviceEditMode := demSubDeviceEntries;
    DeviceEditMode := demDeviceEntries;
    ActiveChild := IndexOfNodeWithID( pPanel );
    if ActiveChild <> -1 then
    begin
      TabControlPanels.TabIndex := ActiveChild;
      with Node[ ActiveChild ].LoopList do
      begin
        ActiveChild := IndexOfLoopWithID( pLoop );
      end;
    end;
  end;
  UndoRedoNavigationHelper.CheckStatus;
end;

