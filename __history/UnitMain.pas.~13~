      PageControlMain.ActivePage := TabSheetNetworkView;
      ExecuteNotify( PageControlMain.OnChange, Sender );
      PageControlNetworkView.ActivePage := TabSheetSuperGroups;
      ExecuteNotify( PageControlNetworkView.OnChange, sender );
      FrameSupergroupEditor.PageControlProperties.ActivePage := FrameSupergroupEditor.TabSheetComponentGroups;
      ExecuteNotify( FrameSupergroupEditor.PageControlProperties.OnChange, sender );
      fSigFile.CauseAndEffects.OutputGroups.ActiveChildObject := iErrorObject as tZFPSuperGroup;
