  end;
end;

procedure TFormMain.ExportLines(const pLines: tStrings);
var
  iLogPageVisible : integer;
  iLogReport : tLogReport;
begin
  // Only export log files for now
  if PageControlMain.ActivePage = TabSheetPanelView then
  begin
    iLogPageVisible := LogPageVisible;
    if iLogPageVisible >= 0 then
    begin
      iLogReport := FrameLogFiles1.TabControlLogs.Tabs.Objects[ iLogPageVisible ] as tLogReport;
      iLogReport.ExportFile( pLines );
      if pLines.Count > 0 then
      begin
        with SaveDialogCSV do
        begin
          if Execute then
          begin
            pLines.SaveToFile( FileName );
          end;
        end;
      end;
    end;
  end;
end;

