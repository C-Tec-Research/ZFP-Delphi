procedure TFormMain.OnPanelSendAll(const pSender: integer; const pVerify, pIsSingle: boolean);
begin
  fErrorLists.ErrorList := nil;
  try
    if pIsSingle or (pSender = 0) then
    begin
      fSigFile.ClearReportedErrorFlags;
      Errors.Clear;
    end;
    try
      FormASCIITransfer.SendAllData( fSigFile.NodeList.Node[ pSender ], Errors, pVerify );
    except
      case ErrorReportingLevel of
        elErrors_Warnings_Hints:; //
        el_Errors_Warnings:
        begin
          Errors.ClearHints;
        end;
        el_Errors:
        begin
          Errors.ClearWarningsAndHints;
        end;
        el_None:
        begin
          Errors.Clear;
        end;
      end;
      {
      if pIsSingle and not (ErrorReportingLevel = el_None) then
      begin
        raise;
      end;
      // else ignore
      }
    end;
  finally
    if pIsSingle or (pSender = fSigFile.NodeList.Max) then
    begin
      if Errors.Count > 0 then
      begin
        fErrorLists.ErrorList := Errors;
      end;
      if Errors.ErrorCount > 0 then
      begin
        raise Exception.Create( Translate( 'Errors Found'));
      end
      else if Errors.WarningCount > 0 then
      begin
        MessageDlg( Translate('Warnings Found'), mtWarning, [mbOK], 0 );
      end
      else if Errors.HintCount > 0 then
      begin
        MessageDlg( Translate('Hints Found'), mtInformation, [mbOK], 0 );
      end
      else if pVerify then
      begin
        MessageDlg( Translate('Verification Complete'), mtInformation, [mbOK], 0 );
      end
      else
      begin
        MessageDlg( Translate('Transmission Complete'), mtInformation, [mbOK], 0 );
      end;
    end;
  end;
end;

