procedure TFormMain.ComboBoxMaintenanceMonthChange(Sender: TObject);
begin
  if ComboBoxMaintenanceMonth.ItemIndex <> -1 then
  begin
    if ComboBoxMaintenanceMonth.ItemIndex <> CalendarMaintenanceDate.Month-1 then
    begin
      try
        CalendarMaintenanceDate.Month := ComboBoxMaintenanceMonth.ItemIndex + 1;
      except
        // probably invalid day - set day to 1
        CalendarMaintenanceDate.Day := 1;
        CalendarMaintenanceDate.Month := ComboBoxMaintenanceMonth.ItemIndex + 1;
      end;
    end;
  end;
end;

