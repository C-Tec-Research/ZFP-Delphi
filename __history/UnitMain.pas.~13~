procedure TFormMain.AdvancedTransfer1Click(Sender: TObject);
begin
  case FormAdvancedTransferSelector.Execute( fSigFile, XFP4PgmCfg ) of
    mrSend:
    begin
      fErrorLists.ErrorList := nil;
      try
        FormASCIITransfer.AdvancedSendData( Errors );
      finally
        if Errors.Count > 0 then
        begin
          fErrorLists.ErrorList := Errors;
        end;
      end;
    end;
    mrRcv:
    begin
      FormASCIITransfer.AdvancedRcvData( Errors );
      if FormASCIITransfer.ModalResult = mrOK then
      begin
        ImportLines( FormASCIITransfer.RcvStrings, Errors );
      end;
    end;
  end;
end;

procedure TFormMain.BitBtn1Click(Sender: TObject);
begin
  MemoDebug.Lines.Clear;
  fSigFile.ListIfDirty( MemoDebug.Lines );
end;

procedure TFormMain.BuildSDCardfiles1Click(Sender: TObject);
var
  i : integer;
begin
  i := TabControlPanels.Tabs.Count;
  if i = 1 then
  begin
    i := 0;
  end
  else
  begin
    if PageControlMain.ActivePage = TabSheetPanelView then
    begin
      i := TabControlPanels.TabIndex;
    end
    else
    begin
      exit;
    end;
  end;
  if i <> -1 then
  begin
    PanelBuildSDCardFiles( i );
  end;
end;

procedure TFormMain.ButtonSimConvertClick(Sender: TObject);
begin
  FrameSimSystem.SimConversion(fSigFile);
end;

procedure TFormMain.CalendarMaintenanceDateChange(Sender: TObject);
begin
  if ComboBoxMaintenanceMonth.ItemIndex <> (CalendarMaintenanceDate.Month - 1) then
  begin
    ComboBoxMaintenanceMonth.ItemIndex := CalendarMaintenanceDate.Month - 1;
  end;
  if SigSpinEditMaintenanceYear.Value <> CalendarMaintenanceDate.Year then
  begin
    SigSpinEditMaintenanceYear.Value := CalendarMaintenanceDate.Year;
  end;
end;

procedure TFormMain.ChangeDefaultLogo1Click(Sender: TObject);
begin
  with FormChangeDefaultLogo do
  begin
    if Execute then
    begin
      ImageLogo.Picture.SaveToFile( 'Images\Logo.gif' );
      ShowLogo;
    end;
  end;
end;

