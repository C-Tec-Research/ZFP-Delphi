procedure TFormMain.RefreshPanelView;
var
  i: integer;
begin
  if assigned( TabControlPanels ) then
  begin
    if fSigFile.NodeList.Count <> TabControlPanels.Tabs.Count then
    begin
      with TabControlPanels do
      begin
        Tabs.Clear;
        for i := 0 to fSigFile.NodeList.Count - 1 do
        begin
          Tabs.Add( '[' + IntToStr( fSigFile.NodeList.Node[ i ].ID ) + ']' + fSigFile.NodeList.Node[ i ].Name1.Value );
        end;
      end;
    end
    else
    begin
      with TabControlPanels do
      begin
        for i := 0 to Tabs.Count - 1 do
        begin
          Tabs[ i ] := '[' + IntToStr( fSigFile.NodeList.Node[ i ].ID ) + ']' + fSigFile.NodeList.Node[ i ].Name1.Value;
        end;
      end;
    end;
  end;
end;

