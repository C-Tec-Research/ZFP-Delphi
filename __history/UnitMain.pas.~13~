  begin
    ExpertModes := ExpertModes + [ em_Allow_Cfg_from_remote_panels ];
  end;

  if SigRegistry.ReadBoolean( 'em_View_Log_as_Table', em_View_Log_as_Table in em_Simple ) then
  begin
    ExpertModes := ExpertModes + [ em_View_Log_as_Table ];
  end;
  if SigRegistry.ReadBoolean( 'em_Show_Import_Export', em_Show_Import_Export in em_Simple ) then
  begin
    ExpertModes := ExpertModes + [ em_Show_Import_Export ];
    Import1.Visible := TRUE;
    Export1.Visible := TRUE;
  end
  else
  begin
    Import1.Visible := FALSE;
    Export1.Visible := FALSE;
  end;
  if SigRegistry.ReadBoolean( 'em_Allow_File_Transfer', em_Allow_File_Transfer in em_Simple ) then
  begin
    ExpertModes := ExpertModes + [ em_Allow_File_Transfer ];
    GetFileFromPanel1.Visible := TRUE;
    SendFiletoPanel1.Visible := TRUE;
  end
  else
  begin
    GetFileFromPanel1.Visible := FALSE;
    SendFiletoPanel1.Visible := FALSE;
  end;
  if SigRegistry.ReadBoolean( 'em_Auto_Reload_Last_Saved_File', em_Auto_Reload_Last_Saved_File in em_Simple) then
  begin
    ExpertModes := ExpertModes + [em_Auto_Reload_Last_Saved_File];
  end
  else
  begin
    ExpertModes := ExpertModes - [em_Auto_Reload_Last_Saved_File];
  end;
