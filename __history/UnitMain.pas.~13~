    else if iErrorObject is TOutputGroup then
    begin
      PageControlMain.ActivePage := TabSheetNetworkView;
      ExecuteNotify( PageControlMain.OnChange, Sender );
      PageControlNetworkView.ActivePage := TabSheetGlobalOutputGroups;
      ExecuteNotify( PageControlNetworkView.OnChange, sender );
      FrameOutputGroupEditor.PageControlProperties.ActivePage :=  FrameOutputGroupEditor.TabSheetDevices;
      ExecuteNotify( FrameOutputGroupEditor.PageControlProperties.OnChange, sender );
      fSigFile.CauseAndEffects.OutputGroups.ActiveChildObject := iErrorObject as TOutputGroup;
    end
    else if iErrorObject is TZFPSegmentError then
    begin
      PageControlMain.ActivePage := TabSheetPanelView;
      SigSpinEditSegment.SetFocus;
    end
    else
    begin
      OnErrorDblClick( Sender, pErrorObject );
    end;
  end;
end;

