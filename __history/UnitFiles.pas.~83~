procedure tZFPGlobalObject.AddorUpdateExtraEditors2(
  pToEditor: TSigVariableEditorList; var pIndex : integer);
begin
  // may be called from add or update extra fields.
  if pToEditor <> fFieldEditor then
  begin
    fToEditor := pToEditor;
    fToIndex := pIndex;
    if CanBeDisabled then
    begin
      fToDisablementTriggerEditor := pToEditor.Editor[ pIndex ];
      if assigned( fToDisablementTriggerEditor ) then
      begin
        fToDisablementTriggerEditor.EditorStyle := vesButton;
      end
      else
      begin
        fToDisablementTriggerEditor := pToEditor.Add( vesButton );
      end;
      inc( pIndex );
      with fToDisablementTriggerEditor do
      begin
        LabelText := Translate( 'Disablement Activates') + ':';
        if assigned( fDisablementTrigger.InputGroup ) then
        begin
          EditorAsButton.Caption := fDisablementTrigger.InputGroup.ListName;
        end
        else
        begin
          EditorAsButton.Caption := ChevronText( 'Select' );
        end;
        OnChange := OnChangeDisablementTrigger;
        OnLabelClick := SelfOnDisablementLabelClick;
      end;
    end;
  end
  else
  begin
    if CanBeDisabled then
    begin
      fFieldDisablementTriggerEditor := pToEditor.Editor[ pIndex ];
      if assigned( fFieldDisablementTriggerEditor ) then
      begin
        fFieldDisablementTriggerEditor.EditorStyle := vesButton;
      end
      else
      begin
        fFieldDisablementTriggerEditor := pToEditor.Add( vesButton );
      end;
      inc( pIndex );
      with fFieldDisablementTriggerEditor do
      begin
        LabelText := Translate( 'Disablement Activates') + ':';
