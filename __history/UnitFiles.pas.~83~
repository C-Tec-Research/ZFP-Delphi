  iLoopList : tLoopList;
  i: Integer;
begin
  inherited;
  // add loop names, etc
  iLoopList := ZFPNode.LoopList;
  if ZFPNode.NodalType.MaxLoops.ValueAsInt = 0 then
  begin
    for i := 0 to iLoopList.Max do
    begin
      with iLoopList.Loop[ i ] do
      begin
        if LoopType = ltSystem then
        begin
          pFile.Add( '80,16,' + LoopAddress.Value + ',"' + VisibleName + '"' );
        end;
      end;
    end;
  end
  else
  begin
    for i := 0 to iLoopList.Max do
    begin
      with iLoopList.Loop[ i ] do
      begin
        pFile.Add( '80,16,' + LoopAddress.Value + ',"' + VisibleName + '"' );
        if SubloopAddress.ValueAsInt <> LoopAddress.ValueAsInt then
        begin
          pFile.Add( '80,16,' + SubLoopAddress.Value + ',"' + VisibleName + '"' ); // give loop and subloop same name.
        end;
      end;
    end;
  end;
end;

