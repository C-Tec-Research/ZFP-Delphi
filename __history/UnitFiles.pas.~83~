procedure tCETreeInputGroup.AutoIncInputs(const Offset : integer; const StopAtObject : TObject;
  var ListEnd: boolean);
var
  iPos : integer;
  iObjectAssigned : TObject;
begin
  inherited;
  iObjectAssigned := nil;
  case PointerType.PointerType of
    lf_None: ;
    lf_Zone: ;
    lf_Input:
    begin
      if assigned( InputGroupPointer.InputGroup ) then
      begin
        with ZFPFile.CauseAndEffects.InputGroups do
        begin
          iPos := Children.IndexOfItem( InputGroupPointer.InputGroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              InputGroupPointer.InputGroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;     // ok
            end
            else
            begin
              InputGroupPointer.InputGroup := InputGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              //iObjectAssigned := InputGroupPointer.InputGroup;
              if InputGroupPointer.InputGroup = StopAtObject then
              begin
                ListEnd := TRUE;
              end;
            end;
          end
          else
          begin
            InputGroupPointer.InputGroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_InputSupergroup:
    begin
      if assigned( InputSuperGroupPointer.SuperGroup ) then
      begin
        with ZFPFile.InputSuperGroupList do
        begin
          iPos := Children.IndexOfItem( InputSuperGroupPointer.SuperGroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              InputSuperGroupPointer.SuperGroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              InputSuperGroupPointer.InputSupergroup := InputSuperGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := InputSuperGroupPointer.InputSupergroup;
            end;
          end
          else
          begin
            InputSuperGroupPointer.SuperGroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_Output: ;
    lf_OutputSuperGroup: ;
    lf_Mode: ;
    lf_AccessLevel: ;
  end;
  if not ListEnd then
  begin
    if assigned( StopAtObject ) then
    begin
      if StopAtObject = iObjectAssigned then
      begin
        ListEnd := TRUE;
      end;
    end;
  end;
end;

