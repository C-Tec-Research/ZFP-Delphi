            end;
          end;
        end;
        demSubDeviceEntries:
        begin
          iSubDevice := fDeviceEditCurrent.First;
          iSubDeviceObject := VisibleLoopSubDevice[ iSubDevice ];
          if assigned( iSubDeviceObject ) then
          begin
            if fActualIOValue <> iActualIOValue then
