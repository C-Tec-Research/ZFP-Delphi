procedure tZFPGlobalArray.CheckSelections;
var
  i: Integer;
  iTestChild : tZFPGlobalObject;
begin
  ResetLabelFonts;
  if (ActiveChild >= 0) and assigned( fEditor ) then
  begin
    iTestChild := GlobalObject[ ActiveChild ];
    for i := 0 to Max do
    begin
      if i <> ActiveChild then
      begin
        if EditorRowSelected( i + 1 ) then
        begin
          if GlobalObject[ i ].CheckSelection( iTestChild ) then
          begin
            fEditor.Cell[ cColSel, i + 1 ] := '2';
          end
          else
          begin
            fEditor.Cell[ cColSel, i + 1 ] := '1';
          end;
        end;
      end;
    end;
  end;
end;

function tZFPGlobalArray.EditorRowSelected(iRow : integer): boolean;
var
  iVal : integer;
begin
  iVal := 0;
  if assigned( fEditor ) then
  begin
    iVal := StrToIntDef( fEditor.Cell[ cColSel, iRow ], 0 );
