procedure tCETreeOutputObject.ImportTreeData(const pList: tStringList;
  const iIndex: integer; pErrors: tErrorList; const pErrorObject: tObject);
var
  iVal : integer;
  iErrText : string;
begin
  try
    iVal := StrToInt( pList[ 5 ] );
  except
    iErrText := Translate( 'Missing or illegal value' );
    pErrors.Add( es_Error, iIndex, 5, iErrText, pErrorObject);
    exit;
  end;
  fPointerType.ValueAsInt := iVal;
  if pList[ 6 ] = '' then
  begin
    ActivePointer.GlobalObject := nil;
    exit;
  end;
  try
    iVal := StrToInt( pList[ 6 ] );
  except
    iErrText := Translate( 'Missing or illegal value');
    pErrors.Add( es_Error, iIndex, 6, iErrText, pErrorObject);
    exit;
  end;
  case fPointerType.PointerType of
    lf_None: ;          // legal, but pointers not updated
    lf_Zone:            fZonePointer.Zone := ZFPFile.ZoneList.ObjectWithID( iVal ) as tZFPZone;
    lf_Input:           fInputGroupPointer.InputGroup := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID( iVal ) as tInputGroup;
    lf_InputSupergroup: fInputSupergroupPointer.InputSupergroup := ZFPFile.InputSuperGroupList.ObjectWithID( iVal ) as tInputSupergroup;
    lf_Output:          fOutputGroupPointer.OutputGroup := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID( iVal ) as tOutputGroup;
    lf_OutputSuperGroup:fOutputSupergroupPointer.SuperGroup := ZFPFile.SuperGroupList.ObjectWithID( iVal ) as tZFPSuperGroup;
    lf_Mode:            fModePointer.Mode := ZFPFile.ModeList.ObjectWithID( iVal ) as tZFPMode;
    lf_AccessLevel:     fAccessLevelPointer.AccessLevel := ZFPFile.AccessLevelList.ObjectWithID( iVal ) as tAccessLevel;
    else
    begin
      iErrText := (Translate( 'Missing or illegal value') + ' "' + pList[5] + '" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 ));
      pErrors.Add( es_Error, iIndex, 5, iErrText, pErrorObject);
    end;
  end;
end;

