procedure tLoop.ImportFixedDeviceFields(const pFile: tStrings);
var
  iList : tInfiniteStringList;
  iIndex : integer;
begin
  iList := tInfiniteStringList.Create;
  try
    iIndex := 1; // skip begin record
    while iIndex < pFile.Count do
    begin
      CommaListToStringList( pFile[ iIndex ], iList, TRUE );
      if SameText( iList[ 1 ], 'END' ) then
      begin
        // done
        exit;
      end;
      ImportDeviceFieldsFile( iList );
      inc( iIndex );
    end;

  finally
    iList.Free;
  end;
end;

