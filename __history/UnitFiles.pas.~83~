procedure tZFPGlobalArray.SigGeneralGridGlobalMouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  i, iCol, iRow : integer;
begin
  if assigned( fEditor ) then
  begin
    fEditor.MouseToCell( X, Y, iCol, iRow );
    if (iRow > 0) and (iRow < fEditor.RowCount - 1 ) then
    begin
      // in the target area!
      if Shift = [ ssLeft ] then
      begin
        // Just select
        ActiveChild := iRow - 1;
        ClearSelections;
      end
      else if Shift = [ ssShift, ssLeft ] then
      begin
        // Clear all selections then select from Active Child to here
        self.ClearAllSelections;
        if iRow <= ActiveChild then
        begin
          for i := ActiveChild + 1 downto iRow do
          begin
            AddSelection( i );
          end;
        end
        else
        begin
          for i := ActiveChild + 1 to iRow do
          begin
            AddSelection( i );
          end;
        end;
        ActiveChild := iRow - 1;
      end
      else if Shift = [ ssCtrl, ssLeft ] then
      begin
        // This toggles current selection. If selection being removed, try
        // to find next. If not found, try to find previous. if not found
        // it must be last selection removed, so leave active child as is
        if EditorRowSelected( iRow ) then
        begin
          // removing
          RemoveSelection( iRow );
          for i := iRow + 1 to fEditor.RowCount - 1 do
          begin
            if EditorRowSelected( i ) then
            begin
              ActiveChild := i - 1;
              exit;
            end;
          end;
          for i := iRow - 1 downto 1 do
          begin
            if EditorRowSelected( i ) then
            begin
              ActiveChild := i - 1;
              exit;
            end;
          end;
        end
        else
        begin
          // adding
          AddSelection( iRow );
          ActiveChild := iRow - 1;
        end;
      end;
      CheckSelections;
    end;
  end;
end;

