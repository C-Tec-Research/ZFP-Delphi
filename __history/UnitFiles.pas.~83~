  iStart := -1;
  for i := 0 to fWhereUsed2.Max do
  begin
    try
      iNode := fWhereUsed2.Node[ i ];
      if assigned( iNode ) then
      begin
        iX := iNode.ID;
        if iStart = -1 then
        begin
          Result := Result + IntToStr( iX );
          iCurr := iX;
          iStart := iX;
        end
        else if iX = (iCurr + 1) then
        begin
          iCurr := iX;
        end
        else if iCurr = iStart then
        begin
          Result := Result + ',' + IntToStr( iX );
          iCurr := iX;
          iStart := iX;
        end
        else
        begin
          Result := Result + '-' + IntToStr( iCurr ) + ',' + IntToStr( iX );
          iCurr := iX;
          iStart := iX;
        end;
      end;
    except

    end;
  end;
  if iCurr <> iStart then
  begin
    Result := Result + '-' + IntToStr( iCurr );
  end;
end;

