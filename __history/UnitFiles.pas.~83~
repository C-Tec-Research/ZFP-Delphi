procedure tLoopDevices.BuildSubDeviceIconEditor;
var
  i : integer;
  iImage : integer;
  iDevice : tLoopDevice;
  iSubDevice : tLoopSubDevice;
  iConflict : boolean;
  iShortText : string;
  iExpandedShortText : string;
  iShortTextConflict : boolean;
begin
  // if all devices have the same image, then show it.
  // otherwise show unknown device image - Image cUnknownDevice in special devices
  if assigned( fSubDeviceIconEditor ) then
  begin
    iConflict := TRUE;
    iShortTextConflict := TRUE;
    iImage := XFP4PgmCfg.cSpecialImageUnknownDevice;
    case DeviceEditMode of
      demNotDefined: ;
      demDevices: ;
      demDeviceEntries:
      begin
        case fDeviceEditCurrent.Count of
          0: ;
          else
          begin
            iConflict := FALSE;
            i := fDeviceEditCurrent.First;
            iDevice := VisibleLoopDevice[ i - 1 ];
            iImage := iDevice.CustomImageIndex;
            iShortText := iDevice.ShortText.Value;
            iExpandedShortText := iDevice.ExpandedShortText;
            iShortTextConflict := FALSE;
            i := fDeviceEditCurrent.Next;
            while i >= 0 do
            begin
              iDevice := VisibleLoopDevice[ i - 1 ];
              if iImage <> iDevice.CustomImageIndex then
              begin
                iConflict := TRUE;
                break;
              end;
              if not SameText( iShortText, iDevice.ShortText.Value ) then
              begin
                iShortTextConflict := TRUE;
              end;
              i := fDeviceEditCurrent.Next;
            end;
          end;
        end;
      end;
      demSubDeviceEntries:
      begin
        case fDeviceEditCurrent.Count of
          0: ;
          else
          begin
            iConflict := FALSE;
            i := fDeviceEditCurrent.First;
            iSubDevice := VisibleLoopSubDevice[ i ];
            iImage := iSubDevice.CustomImageIndex;
            iShortText := iSubDevice.ShortText.Value;
            iExpandedShortText := iSubDevice.ExpandedShortText;
            iShortTextConflict := FALSE;
            i := fDeviceEditCurrent.Next;
            while i >= 0 do
            begin
              iSubDevice := VisibleLoopSubDevice[ i ];
              if iImage <> iSubDevice.CustomImageIndex then
              begin
                iConflict := TRUE;
                break;
              end;
              if not SameText( iShortText, iSubDevice.ShortText.Value ) then
              begin
                iShortTextConflict := TRUE;
              end;
              i := fDeviceEditCurrent.Next;
            end;
          end;
        end;
      end;
    end;
    if iConflict then
    begin
      XFP4PgmCfg.ImageListSpecial.Draw( fSubDeviceIconEditor.Canvas, 0, 0, XFP4PgmCfg.cSpecialImageUnknownDevice );
    end
    else
    begin
      XFP4PgmCfg.ImageListComponentPalette.Draw( fSubDeviceIconEditor.Canvas, 0, 0, iImage );
    end;
    fSubDeviceIconEditor.Invalidate;
    if assigned( fSubDeviceBriefTextEditor ) then
    begin
      with fSubDeviceBriefTextEditor do
      begin
        Text := iExpandedShortText;
        if iShortTextConflict then
        begin
          Font.Color := clRed;
          Font.Style := [ fsBold, fsItalic ];
        end
        else
        begin
          Font.Color := clWindowText;
          Font.Style := [];
        end;
      end;
    end;
  end;
end;

