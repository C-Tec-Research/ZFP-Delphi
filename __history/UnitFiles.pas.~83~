procedure tBaseInputGroup.ImportFile(const pFile: tStrings; var iIndex: integer; const pNode : tZFPNode;
  const pList: tStrings; const pErrors: tErrorList; const pErrorObject: tObject);
var
  iVal : integer;
begin
  // for the most part the same for triggers and input groups
  // pData is a list of fields
  // [0] = 14 (record type
  // [1] = ID
  // -----------------
  // [2] - [13 ]= OP Mode  - not used for triggers
  // ------------------
  // [14] = IG 1st stage - not currently used as this is done in trigger lists
  // [15] = OG 1st stage - not currently used as this is done in trigger lists
  // [16] = Sequence - not currently used as this is done in trigger lists
  // we need to register after load
  if pList.Count < 29 then
  begin
    pErrors.Add( es_Error, iIndex,29, Translate( 'Incomplete Record' ), pErrorObject );
  end;
  // [17] = Auto Clear
  if pList.Count > 17 then
  begin
    try
      iVal := StrToInt( pList[ 17 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 17, Translate( 'Syntax Error' ), pErrorObject );
    end;
    AutoClearOnPanelReset.ValueAsBool := iVal = 1;
  end;
  // [18] = Delays MCP
  if pList.Count > 18 then
  begin
    try
      iVal := StrToInt( pList[ 18 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 18, Translate( 'Syntax Error' ), pErrorObject );
    end;
    OutputDelaysApplyToMCPs.ValueAsBool := iVal = 1;
  end;
  // [19] = Delays Detectors
  if pList.Count > 19 then
  begin
    try
      iVal := StrToInt( pList[ 19 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 19, Translate( 'Syntax Error' ), pErrorObject );
    end;
    OutputDelaysApplyToDetectors.ValueAsBool := iVal = 1;
  end;
  // [20] = MPC Qualifies Dep
  if pList.Count > 20 then
  begin
    try
      iVal := StrToInt( pList[ 20 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 20, Translate( 'Syntax Error' ), pErrorObject );
    end;
    MCPQualifiesDependencies.ValueAsBool := iVal = 1;
  end;
  // [21]-[24] Input group dependencies not yet implemented (and may never be)
  // [25]-[28] are the silence functions and only apply to input groups

end;

