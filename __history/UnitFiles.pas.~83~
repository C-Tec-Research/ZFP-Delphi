procedure tZFPLoopsFitted.ListToData(const pList: tStrings; const pLine, pStartCol: integer;
                          const pErrors : tErrorList; const pErrorObject : tObject);
var
  iErrText : string;
  iLoopCount : integer;
begin
  try
    iLoopCount := StrToInt( pList[ pStartCol ] );
    if (iLoopCount >= 0) and (iLoopCount <= ZFPNode.NodalType.MaxLoops.ValueAsInt ) then
    begin
      LoopsFitted.ValueAsInt := iLoopCount;
      ZFPNode.LoopList.NormalLoopCount := iLoopCount;
      // set up the mapping depending on whether the extra two fields are present
      // or on the loop count if not
      ZFPNode.ImportLoopCountRec( iLoopCount, pList[ pStartCol + 1 ], pList[ pStartCol + 2 ] );
    end
    else
    begin
      iErrText := Translate( 'Illegal Loop Count');
      pErrors.Add( tErrorSeverity.es_Warning, pLine, pStartCol, iErrText, pErrorObject );
    end;
  except
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( tErrorSeverity.es_Warning, pLine, pStartCol, iErrText, pErrorObject );
  end;
end;

