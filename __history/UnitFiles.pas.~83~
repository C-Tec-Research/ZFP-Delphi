    try
      if Value is tInputGroup then
      begin
        InputGroupPointer.InputGroup := Value as tInputGroup;
        PointerType.PointerType := lf_Input;
      end
      else if Value is tInputSuperGroup then
      begin
        InputSuperGroupPointer.SuperGroup := Value as tInputSuperGroup;
        PointerType.PointerType := lf_InputSuperGroup;
      end
      else
      begin
        raise Exception.Create('Unexpected input object');
      end;
    finally
      ZFPFile.UndoRedo.GroupUndoActive := FALSE;
    end;
  end
  else
  begin
    PointerType.PointerType := lf_None;
  end;
