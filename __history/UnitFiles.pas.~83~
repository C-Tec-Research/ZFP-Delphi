procedure tZFPPanelGlobalObject.OnCellEditChange( const Sender : tObject; const Col, Row: integer;
  const Value: string);
begin
  if Col = 0 then
  begin
    if Row > 0 then
    begin
      // changing or adding name of a zone
      if Row - 1 > GlobalArray.Count then
      begin
        // should not happen
        exit;
      end
      else if Row - 1 = GlobalArray.Count then
      begin
        // adding a entry
        GlobalArray.Max := GlobalArray.Max + 1;
        // A new zone added here is by default only defined on this panel
        with GlobalArray[ Row - 1 ].NodesWhereUsed do
        begin
          RegisterNode( ZFPNode );
        end;
      end;
      GlobalArray[ Row - 1 ].Name := Value;
      ShowEditor;
    end;
  end
  else if Col = 1 then
  begin
    if Row > 0 then
    begin
      // changing or adding ID of a zone
      if Row - 1 > GlobalArray.Count then
      begin
        // should not happen
        exit;
      end
      else if Row - 1 = GlobalArray.Count then
      begin
        // adding a new zone
        GlobalArray.Max := GlobalArray.Max + 1;
        // A new zone added here is by default only defined on this panel
        with GlobalArray[ Row - 1 ].NodesWhereUsed do
        begin
          RegisterNode( ZFPNode );
        end;
      end;
      GlobalArray[ Row - 1 ].ID.Value := Value;
      ShowEditor;
    end;
  end;
end;

procedure tZFPPanelGlobalObject.OnSelectCell(Sender: TObject; ACol,
  ARow: Integer; var CanSelect: Boolean);
var
  iNode : tZFPNode;
begin
  if (ARow > 0) and (ARow <= GlobalArray.Count ) then
  begin
    // not the title bar
    if ACol >= 2 then
    begin
      // a panel/zene toggle
      iNode := ZFPNode;
      if fEditor.Cell[ ACol, ARow ] = '1' then
      begin
        GlobalArray[ ARow - 1 ].UnregisterNode( iNode );
        fEditor.Cell[ ACol, ARow ] := '0'
      end
      else
      begin
        GlobalArray[ ARow - 1 ].RegisterNode( iNode );
        fEditor.Cell[ ACol, ARow ] := '1'
      end;
    end
    else if ACol = 1 then
    begin

    end;
  end;
end;

procedure tZFPPanelGlobalObject.SetEditor(const Value: tSigGeneralGrid);
begin
  fEditor := Value;
  if assigned( fEditor ) then
  begin
    fEditor.OnSelectCell := OnSelectCell;
    fEditor.OnCellEditChange := OnCellEditChange;
    ShowEditor;
  end;
end;

procedure tZFPPanelGlobalObject.ShowEditor;
var
  i : integer;
  iGlobalObject : tZFPGlobalObject;
  iCount : integer;
begin
  if assigned( fEditor ) then
  begin
    with fEditor do
    begin
      iCount := 1 + GlobalArray.Count;
      RowCount := iCount + 1;

      for i := 1 to iCount - 1 do
      begin
        iGlobalObject := GlobalArray[ i - 1 ];
        if assigned( iGlobalObject ) then
        begin
          Cell[ 0, i ] := iGlobalObject.Name;
          Cell[ 1, i ] := iGlobalObject.ID.Value;
        end
        else
        begin
          Cell[ 0, i ] := '';
          Cell[ 1, i ] := '';
        end;
        if assigned( iGlobalObject.NodesWhereUsed ) then
        begin
          if iGlobalObject.NodesWhereUsed.UsedByNode( ZFPNode ) then
          begin
            Cell[ 2, i ] := '1';
          end
          else
          begin
            Cell[ 2, i ] := '0';
          end;
          Error[ 0, i ] := GlobalArray.DuplicateName( iGlobalObject );
          Error[ 1, i ] := GlobalArray.DuplicateID( iGlobalObject );
        end;
      end;
    end;
  end;
end;

