function tLoopDevices.DeviceWithABusSubdevice(
  const pIndex: integer): tLoopDevice;
var
  i: Integer;
  iFirstABusDevice, iLastABusDevice : integer;
begin
  for i := 0 to Max do
  begin
    Result := LoopDevice[ i ];
    iFirstABusDevice := Result.FirstABusDevice;
    iLastABusDevice := iFirstABusDevice + Result.ABusCount - 1;
    //if pIndex in [iFirstABusDevice..iLastABusDevice] then
    if (pIndex >= iFirstABusDevice) and  (pIndex <= iLastABusDevice) then
    begin
      exit;
    end;
  end;
  // else
  Result := nil;
end;

function tLoopDevices.DuplicateDeviceName(const pDevice: tLoopDevice): boolean;
var
  i: Integer;
  iName : string;
  iDevice : tLoopDevice;
begin
  iName := pDevice.ExpandedName;
  Result := FALSE;
  for i := 0 to Max do
  begin
    iDevice := LoopDevice[ i ];
    if iDevice <> pDevice then
    begin
      if SameText( iDevice.ExpandedName, iName ) then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
end;

function tLoopDevices.DuplicateSubDeviceName(const pSubDevice: tLoopSubDevice): boolean;
var
  i, j : integer;
  iName : string;
  iDevice : tLoopDevice;
  iSubdevice : tLoopSubdevice;
begin
  iName := pSubDevice.ExpandedName;
  Result := FALSE;
  for i := 0 to Max do
  begin
    iDevice := LoopDevice[ i ];
    for j := 1 to iDevice.SubDeviceCount do        // 0 = device; only test subdevices
    begin
      iSubDevice := iDevice.SubDevice[ j ];
      if iSubDevice <> pSubDevice then
      begin
        if SameText( iSubDevice.ExpandedName, iName ) then
        begin
          Result := TRUE;
          exit;
        end;
      end;
    end;
  end;
end;

procedure tLoopDevices.ExpandRange;
var
  iDeviceEditCurrent : tDSMList;
  iSubDeviceIndex : integer;
  iDeviceIndex : integer;
  iDevice, iVisibleDevice : tLoopDevice;
begin
  // moving from a device range to a subdevice range
  iDeviceEditCurrent := -1;
  iDeviceIndex := fDeviceEditCurrent.First;
  iSubDeviceIndex := 0;
  if iDeviceIndex <> -1 then
  begin
    iVisibleDevice := VisibleLoopDevice[ iDeviceIndex - 1 ];
    while iSubDeviceIndex < VisibleSubDeviceCount do
    begin
      inc( iSubDeviceIndex );
      iDevice := VisibleLoopSubDevice[ iSubDeviceIndex ].Device;
      if iVisibleDevice = iDevice then
      begin
        break;
      end;
    end;
    if iSubDeviceIndex < VisibleSubDeviceCount then
    begin
      iDeviceEditCurrent := iSubDeviceIndex;
    end
    else
    begin
      fDeviceEditCurrent.Value := iDeviceEditCurrent;
      exit;
    end;
    while iSubDeviceIndex < VisibleSubDeviceCount do
    begin
      inc( iSubDeviceIndex );
      iDevice := VisibleLoopSubDevice[ iSubDeviceIndex ].Device;
      if iVisibleDevice = iDevice then
      begin
        iDeviceEditCurrent := iDeviceEditCurrent + iSubDeviceIndex;
      end
      else
      begin
        iDeviceIndex := fDeviceEditCurrent.Next;
        if iDeviceIndex = -1 then
        begin
          fDeviceEditCurrent.Value := iDeviceEditCurrent;
          exit;
        end;
        // else
        iVisibleDevice := VisibleLoopDevice[ iDeviceIndex - 1 ];
        if iDevice = iVisibleDevice then
        begin
          iDeviceEditCurrent := iDeviceEditCurrent + iSubDeviceIndex;
        end;
      end;
    end;
  end;
  fDeviceEditCurrent.Value := iDeviceEditCurrent;
end;

