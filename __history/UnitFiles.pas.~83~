function tZFPGlobalArray.NextFreeID: integer;
var
  i: Integer;
  iList : tDSMList;
  iMax : integer;
begin
  iList := '';
  for i := 0 to Max do
  begin
    iList := iList + GlobalObject[ i ].ID.ValueAsInt;
  end;
  Result := MinLegalAddress;
  iMax := iList.cMax;
  if MaxLegalAddress <> 0 then
  begin
    iMax := MaxLegalAddress;
  end;
  while Result <= iMax do
  begin
    if Result <= iList then
    begin
      inc( Result );
    end
    else
    begin
      exit;
    end;
  end;
  Result := 0; // should never get here - > 9999 objects!
end;

