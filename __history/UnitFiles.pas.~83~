function tLoopSubDeviceField.FieldsOverlap(const pField1,
  pField2: tDeviceField): boolean;
var
  iField1Start, iField1End : integer;
  iField2Start, iField2End : integer;
begin
  iField1Start := pField1.Location.ValueAsInt;
  iField1End   := iField1Start + pField1.Length.ValueAsInt;
  iField2Start := pField2.Location.ValueAsInt;
  iField2End   := iField2Start + pField2.Length.ValueAsInt;
  if iField1Start = iField2Start then
  begin
    Result := TRUE;
  end
  else if iField1Start > iField2Start then
  begin
    Result := iField1Start < iField2End;
  end
  else // iField1Start < iField2Start
  begin
    Result := iField1End > iField2Start;
  end;
end;
}

procedure tLoopSubDeviceField.fOnCheckPointerValid(const pPointer: tSigPointer;
  var pIsValid: boolean);
var
  iCurrentPointer : tSigPointer;
label
  Loop;
begin
  //pIsValid := pPointer = CurrentPointer;
Loop:
  iCurrentPointer := CurrentPointer;
  if not assigned( iCurrentPointer ) then
  begin
    if (fFieldDescriptor.DeviceFieldEditorStyle = es_Zone) and ( assigned( Zone )) then
    begin
      PointerType1.PointerType := lf_Zone;
      goto Loop;
    end
    else
    begin
      pIsValid := FALSE;
    end;
  end
  else if pPointer.DestinationObject <> iCurrentPointer.DestinationObject then
  begin
    pIsValid := FALSE;
  end

end;

function tLoopSubDeviceField.GetCurrentPointer: tGlobalObjectPointer;
begin
  Result := nil;
  case PointerType1.PointerType of
    lf_None: ;
    lf_Zone:             Result := ZonePointer1;
    lf_Input:
    begin
      // check that an input group pointer is valid
      case tFieldEditorStyle(FieldDescriptor.EditorStyle.ValueAsInt) of
        es_IO_Group:
        begin
          case self.OwnerAsSubdevice.IOType of
            sdt_Input: Result := InputGroupPointer;
            sdt_Output: ;
            sdt_User_Selectable: ;
            sdt_Other: ;
            sdt_Not_Fitted: ;
          end;
        end;
        es_Target_Group,
        es_Isolation_Group,
        es_Fault_Group: Result := InputGroupPointer;
      end;
    end;
    lf_InputSupergroup:;
    lf_Output:
    begin
      // check that an output group pointer is valid
      case self.OwnerAsSubdevice.IOType of
        sdt_Input: ;
        sdt_Output: Result := OutputGroupPointer;
        sdt_User_Selectable: ;
        sdt_Other: ;
        sdt_Not_Fitted: ;
      end;
    end;
    lf_OutputSuperGroup:;
    lf_Mode: ;
    lf_AccessLevel: ;
  end;
end;

