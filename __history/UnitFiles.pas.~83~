procedure tZFPPanelFile.ImportFile(const pFile: tStrings; var iIndex : integer; pErrors : tErrorList;
                          const pErrorObject : tObject);
var
  i, j : integer;
  iChild : tZFPPanelFileLine;
  iGroupChild : tZFPPanelFileGroup;
  iMemoChild : tZFPPanelFileMemo;
  iLineAsList : tInfiniteStringList;
  iErrText : string;
  iAllowUpdate : boolean;
  iChildFound : boolean;
begin
  iLineAsList := tInfiniteStringList.Create;
  iAllowUpdate := TRUE;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "BEGIN" found');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    CommaListToStringList( pFile[ iIndex ], iLineAsList, TRUE );
    if iLineAsList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iLineAsList[ 0 ] <> ExportPrefix then
    begin
      iErrText := Translate( 'Incorrect record type');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iLineAsList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 1, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iLineAsList[ 2 ] <> ZFPNode.NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + iLineAsList[ 2 ] + '" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 );
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iAllowUpdate then
    begin
      Clear;
      while True do
      begin
        inc( iIndex );
        CommaListToStringList( pFile[ iIndex ], iLineAsList, TRUE );
        // decide which child, if any
        if iLineAsList[ 1 ] = 'END' then
        begin
          // done
          exit;
        end;
        if iLineAsList[ 1 ] = 'BEGIN' then
        begin
          // done
          continue;
        end;
        // else
        if not ImportSpecialLines( iLineAsList, iIndex, pErrors, pErrorObject ) then
        begin
          iChildFound := FALSE;
          for i := 0 to Children.Count - 1 do
          begin
            if Children.Item[ i ] is tZFPPanelFileLine then
            begin
              iChild := Children.Item[ i ] as tZFPPanelFileLine;
              if iLineAsList[ 1 ] = iChild.ExportPrefix then
              begin
                iChild.ListToData( iLineAsList, iIndex, 2, pErrors, pErrorObject );
                iChildFound := TRUE;
                break;
              end;
            end
            else if Children.Item[ i ] is tZFPPanelFileGroup then
            begin
              iGroupChild := Children.Item[ i ] as tZFPPanelFileGroup;
              for j := 0 to iGroupChild.LineCount - 1 do
              begin
                if iGroupChild.ExportPrefix = '' then
                begin
                  iGroupChild.ListToData( j, iLineAsList, iIndex, 2, pErrors, pErrorObject );
                  iChildFound := TRUE;
                  break;
                end
                else if iLineAsList[ 1 ] = iGroupChild.ExportPrefix then
                begin
                  iGroupChild.ListToData( j, iLineAsList, iIndex, 3, pErrors, pErrorObject );
                  iChildFound := TRUE;
                  break;
                end;
              end;
            end
            else if Children.Item[ i ] is tZFPPanelFileMemo then
            begin
              iMemoChild := Children.Item[ i ] as tZFPPanelFileMemo;
              if iMemoChild.ExportPrefix = '' then
              begin
                iMemoChild.ListToData( iLineAsList, 2 );
              end
              else
              begin
                iMemoChild.ListToData( iLineAsList, 3 );
              end;
              iChildFound := TRUE;
            end
            else
            begin
              iErrText := Translate( 'Internal Error - Unexpected Child Type - ignored');
              pErrors.Add( tErrorSeverity.es_Default, iIndex, 1, iErrText, self);
            end;
          end;
          if not iChildFound then
          begin
            iErrText := Translate( 'Unrecognised Record subtype' + ' (' + iLineAsList[ 1 ] + ') ' + Translate('ignored') );
            pErrors.Add( tErrorSeverity.es_Warning, iIndex, 1, iErrText, self);
          end;
        end;
      end;
    end;
  finally
    iLineAsList.Free;
  end;
end;

