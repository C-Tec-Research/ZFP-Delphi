procedure tPulsePattern.ImportFile(const pFile: tStrings; var iIndex: integer;
  const pNode: tZFPNode; const pList: tStrings; const pErrors: tErrorList;
  const pErrorObject: tObject);
var
  i, iVal : integer;
begin
  inherited;
  // pData is a list of fields
  // [0] = 60 (record type
  // [1] = ID
  // [2-9] = Pattern
  for i := 2 to cMax + 1 do
  begin
    try
      iVal := StrToInt( pList[ i ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, i, Translate( 'Syntax Error' ), pErrorObject );
    end;
    case iVal of
      0: PulseState[ i - 1 ] := FALSE;
      1: PulseState[ i - 1 ] := TRUE;
      255:
      begin
        CycleIndex.ValueAsInt := i - 1;
        exit;
      end;
      else
      begin
        PulseState[ i - 1 ] := FALSE;
        pErrors.Add( es_Error, 0,0, Translate( 'Syntax Error' ), pErrorObject );
      end;
    end;
  end;
  // if we get here there is no repeat
  CycleIndex.ValueAsInt := 0;
end;

procedure tPulsePattern.OnPatternChange(const NewVal: string);
var
  i : integer;
  iMax : integer;
begin
  iMax := self.CycleIndex.ValueAsInt;
  if iMax = 0 then
  begin
    iMax := cMax + 1;
  end;
  for i := 1 to cMax do
  begin
    if assigned( fToPatternEditor[ i ] ) then
    begin
      with fToPatternEditor[ i ] do
      begin
        with EditorAsImage do
        begin
          if i < iMax then
          begin
            if PulseState[ i ] then
            begin
              ImageIndex := 1;
            end
            else
            begin
              ImageIndex := 0;
            end;
          end
          else if i = iMax then
          begin
            ImageIndex := 5;
          end
          else
          begin
            ImageIndex := 3;
          end;
        end;
      end;
    end;
    if assigned( fFieldPatternEditor[ i ] ) then
    begin
      with fFieldPatternEditor[ i ] do
      begin
        with EditorAsImage do
        begin
          if i < iMax then
          begin
            if PulseState[ i ] then
            begin
              ImageIndex := 1;
            end
            else
            begin
              ImageIndex := 0;
            end;
          end
          else if i = iMax then
          begin
            ImageIndex := 5;
          end
          else
          begin
            ImageIndex := 3;
          end;
        end;
      end;
    end;
  end;
end;

procedure tPulsePattern.SetImageList(const Value: tImageList);
var
  i: Integer;
begin
  if fImageList <> Value then
