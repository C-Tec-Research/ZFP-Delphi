{ tInputGroupModalOperation }

procedure tInputGroupModalOperation.AddOrUpdateExtraEditors(
  pToEditor: TSigVariableEditorList; var pIndex: integer);
var
  iSilenceEditor : TSigVariableEditor;
  iOpEditor : TSigVariableEditor;
  iData1Editor : TSigVariableEditor;
  iData1aEditor : TSigVariableEditor;
  iData2Editor : TSigVariableEditor;
begin
  if pToEditor = fFieldEditor then
  begin
    ClearFieldEditors;
    if assigned( pToEditor ) then
    begin
      fFieldSilenceEditorIndex := pIndex;
      fFieldSilenceEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fFieldSilenceEditor ) then
      begin
        fFieldSilenceEditor.EditorStyle := vesCheckbox;
      end
      else
      begin
        fFieldSilenceEditor := pToEditor.Add( vesCheckbox );
      end;
      iSilenceEditor := fFieldSilenceEditor;

      fFieldOpEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fFieldOpEditor ) then
      begin
        fFieldOpEditor.EditorStyle := vesComboBox;
      end
      else
      begin
        fFieldOpEditor := pToEditor.Add( vesComboBox );
      end;
      iOpEditor := fFieldOpEditor;
      //fOpMode.ComboBox := fOpEditor.EditorAsComboBox;

      fFieldData1Editor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fFieldData1Editor ) then
      begin
        fFieldData1Editor := pToEditor.Add( vesNone );
      end;
      iData1Editor := fFieldData1Editor;

      fFieldData2Editor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fFieldData2Editor ) then
      begin
        fFieldData2Editor := pToEditor.Add( vesNone );
      end;
      iData2Editor := fFieldData2Editor;

      fFieldData1aEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fFieldData1aEditor ) then
      begin
        fFieldData1aEditor := pToEditor.Add( vesNone );
      end;
      iData1aEditor := fFieldData1aEditor;

    end
    else
    begin
      exit;
    end;
  end
  else
  begin
    fToEditor := pToEditor;
    fToIndex := pIndex;
    ClearToEditors;
    if assigned( pToEditor ) then
    begin
      fToSilenceEditorIndex := pIndex;
      fToSilenceEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fToSilenceEditor ) then
      begin
        fToSilenceEditor.EditorStyle := vesCheckbox;
      end
      else
      begin
        fToSilenceEditor := pToEditor.Add( vesCheckbox );
      end;
      iSilenceEditor := fToSilenceEditor;

      fToOpEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fToOpEditor ) then
      begin
        fToOpEditor.EditorStyle := vesComboBox;
      end
      else
      begin
        fToOpEditor := pToEditor.Add( vesComboBox );
      end;
      iOpEditor := fToOpEditor;
      //fOpMode.ComboBox := fOpEditor.EditorAsComboBox;

      fToData1Editor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fToData1Editor ) then
      begin
        fToData1Editor := pToEditor.Add( vesNone );
      end;
      iData1Editor := fToData1Editor;

      fToData2Editor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fToData2Editor ) then
      begin
        fToData2Editor := pToEditor.Add( vesNone );
      end;
      iData2Editor := fToData2Editor;

      fToData1aEditor := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if not assigned( fToData1aEditor ) then
      begin
        fToData1aEditor := pToEditor.Add( vesNone );
      end;
      iData1aEditor := fToData1aEditor;

    end
    else
    begin
      exit;
    end;
  end;
  if assigned( pToEditor ) then
  begin
    with iSilenceEditor do
    begin
      LabelText := Translate( 'Cancel Delays on Silence' ) + '?';
      //fCancelDelaysOnSilence.Editor := fSilenceEditor;
      OnChange := OnCancelDelaysOnSilenceChange;
      OnLabelClick := fOnCancelDelaysOnSilenceLabelClick;
      EditorAsCheckbox.Checked := fCancelDelaysOnSilence.ValueAsBool;
    end;

    iOpEditor.OnChange := OnOpModeChange;
    iOpEditor.OnLabelClick := fOnOpEditorLabelClick;
    fOpMode.AssignItemList( iOpEditor.EditorAsComboBox.Items );
    iOpEditor.EditorAsComboBox.ItemIndex := fOpMode.MapValueToItem( fOpMode.ValueAsInt );
    iOpEditor.LabelText := OpModeLabelText;
    //fOpMode.ComboBox := fOpEditor.EditorAsComboBox;

    case OwnerAsBaseInputGroup.IGStyle of
      igs_Classic:
      begin
        case Operation of
          opm_NA:
          begin
            iData1Editor.EditorStyle := vesNone;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesNone;
            iData1Editor.LabelText := '';
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := '';
          end;
          opm_Single:
          begin
            iData1Editor.EditorStyle := vesNone;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesNone;
            iData1Editor.LabelText := '';
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := '';
          end;
          opm_2_Devices:
          begin
            iData1Editor.EditorStyle := vesCheckbox;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Same Input Group' );
            iData1Editor.OnChange := OnSameInputGroupChange;
            iData1Editor.EditorAsCheckBox.Checked := SameInputGroup;
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := Translate( 'Timeout (0-600 secs)' );
            iData2Editor.OnChange := OnTimeoutChange;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 600;
              Value := Data2.ValueAsInt;
            end;
          end;
          opm_Dependency_A:
          begin
            iData1Editor.EditorStyle := vesSpinEdit;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Detector Confirmation Time (0-60 sec)' );
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := '';
            iData1Editor.OnChange := OnConfirmationTimeChange;
            with iData1Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 60;
              Value := Data1.ValueAsInt;
            end;
            iData2Editor.LabelText := Translate( 'Alarm Reset Time (1-30 mins)' );
            iData2Editor.OnChange := OnAlarmResetChange;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 30;
              Value := Data2.ValueAsInt;
            end;
          end;
          opm_Dependency_B:
          begin
            iData1Editor.EditorStyle := vesCheckbox;
            iData1aEditor.EditorStyle := vesSpinEdit;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Same Input Group' );
            iData1Editor.OnChange := OnSameInputGroupChange;
            iData1aEditor.LabelText := Translate( 'Detector Inhibit Time(1-5 mins)' );
            iData1aEditor.OnChange := OnDetectorInhibitTimeChange;
            iData2Editor.LabelText := Translate( 'Alarm Reset Time (1-30 mins)' );
            iData2Editor.OnChange := OnAlarmResetChange;
            with iData1Editor.EditorAsCheckBox do
            begin
              Checked := SameInputGroup;
            end;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 30;
              Value := Data2.ValueAsInt;
            end;
            with iData1aEditor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 5;
              Value := DetectorInhibitTime; // bits 1 - 7
            end;
          end;
          opm_Investigation:
          begin
            iData1Editor.EditorStyle := vesSpinEdit;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Input Delay (0-300 sec)' );
            iData1aEditor.LabelText := '';
            iData1Editor.OnChange := OnInputDelayChange;
            with iData1Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 300;
              Value := Data1.ValueAsInt;
            end;
            iData2Editor.LabelText := Translate( 'Investigation Delay (1-10 mins)' );
            iData2Editor.OnChange := OnInvestigationDelayChange;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 10;
              Value := Data2.ValueAsInt;
            end;
          end;
        end;
      end;
      igs_Switch:
      begin
        iData1Editor.EditorStyle := vesNone;
        iData1aEditor.EditorStyle := vesNone;
        iData2Editor.EditorStyle := vesNone;
        iData1Editor.LabelText := '';
        iData2Editor.LabelText := '';
        iData1aEditor.LabelText := '';
      end;
      igs_AND:
      begin
        iData1Editor.EditorStyle := vesSpinEdit;
        iData1aEditor.EditorStyle := vesNone;
        iData2Editor.EditorStyle := vesSpinEdit;
        iData1Editor.LabelText := Translate( 'Count for Partial ON' );
        iData1Editor.OnChange := OnANDPartialActivationCountChange;
        with iData1Editor.EditorAsSpinEdit do
        begin
          MinValue := fANDPartialActivationCount.MinVal;
          MaxValue := fANDPartialActivationCount.MaxVal;
          Value := fANDPartialActivationCount.ValueAsInt;
        end;
        iData1aEditor.LabelText := '';
        iData2Editor.LabelText := Translate( 'Count for Full ON' );
        iData2Editor.OnChange := self.OnANDFullActivationCountChange;
        with iData2Editor.EditorAsSpinEdit do
        begin
          MinValue := fANDFullActivationCount.MinVal;
          MaxValue := fANDFullActivationCount.MaxVal;
          Value := fANDFullActivationCount.ValueAsInt;
        end;
      end;
    end;
  end;
end;

