procedure tCEInputGroupState.UpdateIGStyle(pIGOldStyle, pIGNewStyle: tInputGroupStyle);
begin
  // our parent type has changed so we need to redefine out value in line with our
  // old parent style
  // no need to pass down further
{
  case IGStyle of
    igs_Classic: Result := State1;
    igs_Switch: Result := State2;
    igs_AND: Result := State3;
  end;
}
  case pIGOldStyle of
    igs_Classic:
    begin
      case pIGNewStyle of
        igs_Classic: ;
        igs_Switch:
        begin
          State2.ValueAsInt := State1.ValueAsInt;
        end;
        igs_AND:
        begin
          State3.ValueAsInt := State1.ValueAsInt;
        end;
      end;
    end;
    igs_Switch:
    begin
      case pIGNewStyle of
        igs_Classic:
        begin
          State1.ValueAsInt := State2.ValueAsInt;
        end;
        igs_Switch: ;
        igs_AND:
        begin
          State3.ValueAsInt := State2.ValueAsInt;
        end;
      end;
    end;
    igs_AND:
    begin
      case pIGNewStyle of
        igs_Classic:
        begin
          State1.ValueAsInt := State3.ValueAsInt;
        end;
        igs_Switch:
        begin
          State2.ValueAsInt := State3.ValueAsInt;
        end;
        igs_AND: ;
      end;
    end;
  end;
  fTreeNode1.Text := TreeText;
end;

