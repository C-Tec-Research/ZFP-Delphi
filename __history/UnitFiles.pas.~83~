procedure tCETreeProperty.UnDelete(const pIndex: integer; const pUndoAction : tSigFileUndoAction);
var
  iNextChild : tCETreeProperty;
  iSibling : tCETreeProperty;
  iSiblingIndex : integer;
begin
  inherited Undelete( pIndex, pUndoAction );
  // we must regenerate tree entry
  if Children[ pIndex ] is tCETreeProperty then
  begin
    iNextChild := Children[ pIndex ] as tCETreeProperty;
    // find the next sibling, if any
    iSiblingIndex := pIndex + 1;
    iSibling := nil;
    while iSiblingIndex < Children.Count do
    begin
      if Children[ iSiblingIndex ] is tCETreeProperty then
      begin
        iSibling := Children[ iSiblingIndex ] as tCETreeProperty;
        break;
      end;
      inc( iSiblingIndex );
    end;
    with iNextChild do
    begin
      if assigned( iSibling ) then
      begin
        TreeNode1 := TreeNodes1.InsertObject( iSibling.TreeNode1, iNextChild.TreeText, iNextChild );
      end
      else
      begin
        TreeNode1 := TreeNodes1.AddChildObject( self.TreeNode1, iNextChild.TreeText, iNextChild );
      end;
      TreeNode1.ImageIndex := ImageIndex;
      TreeNode1.SelectedIndex := ImageIndex + cSelectedOffset;
      //BuildTree;
      //TreeNode1.Selected := TRUE;
      //iIndex := 0;
      //BuildEditorList( iIndex );
    end;
  end;
end;

