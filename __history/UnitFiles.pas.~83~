procedure tZFPSuperGroup.ShowEditors;
var
  i, iCount : integer;
  iGlobalObject : tGroup;
begin
  if assigned( fGroupChildrenEditor ) then
  begin
    with fGroupChildrenEditor do
    begin
      iCount := ZFPFile.CauseAndEffects.OutputGroups.Count;
      if iCount > 0 then
      begin
        RowCount := iCount + 1;
      end
      else
      begin
        RowCount := 2;
      end;

      for i := 1 to iCount do
      begin
        iGlobalObject := ZFPFile.CauseAndEffects.OutputGroups.OutputGroup[ i - 1 ];
        if assigned( iGlobalObject ) then
        begin
          Cell[ 0, i ] := iGlobalObject.Name;
        end
        else
        begin
          Cell[ 0, i ] := '';
        end;
        if self.GroupChildren.HasGroup( iGlobalObject ) then
        begin
          Cell[ 1, i ] := '1';
        end
        else
        begin
          Cell[ 1, i ] := '0';
        end;
        Error[ 0, i ] := ZFPFile.CauseAndEffects.OutputGroups.DuplicateName( iGlobalObject );
      end;
    end;
  end;
  if assigned( fSuperGroupChildrenEditor ) then
  begin
    with fSuperGroupChildrenEditor do
    begin
      iCount := ZFPFile.SuperGroupList.Count;
      if iCount > 0 then
      begin
        RowCount := iCount + 1;
      end
      else
      begin
        RowCount := 2;
      end;

      for i := 1 to iCount do
      begin
        iGlobalObject := ZFPFile.SuperGroupList.SuperGroup[ i - 1 ];
        if assigned( iGlobalObject ) then
        begin
          Cell[ 0, i ] := iGlobalObject.Name;
        end
        else
        begin
          Cell[ 0, i ] := '';
        end;
        if not CanAddSupergroup( iGlobalObject as tZFPSupergroup ) then
        begin
          Cell[ 1, i ] := '3';
        end
        else if SuperGroupChildren.HasGroup( iGlobalObject ) then
        begin
          Cell[ 1, i ] := '1';
        end
        else
        begin
          Cell[ 1, i ] := '0';
        end;
        Error[ 0, i ] := ZFPFile.SuperGroupList.DuplicateName( iGlobalObject );
      end;
    end;
  end;
end;

