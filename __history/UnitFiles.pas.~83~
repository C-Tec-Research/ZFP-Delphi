      fFieldVolumeEditor.EditorStyle := vesSpinEdit;
    end
    else
    begin
      fFieldVolumeEditor := pToEditor.Add( vesSpinEdit );
    end;
    iVolumeEditor := fFieldVolumeEditor;

  end
  else
  begin
    fToSoundEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fToSoundEditor ) then
    begin
      fToSoundEditor.EditorStyle := vesComboBox;
    end
    else
    begin
      fToSoundEditor := pToEditor.Add( vesComboBox );
    end;
    iSoundEditor := fToSoundEditor;

    fToVolumeEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fToVolumeEditor ) then
    begin
      fToVolumeEditor.EditorStyle := vesSpinEdit;
    end
    else
    begin
      fToVolumeEditor := pToEditor.Add( vesSpinEdit );
    end;
    iVolumeEditor := fToVolumeEditor;

  end;

  with iSoundEditor do
  begin
    with EditorAsComboBox do
    begin
      Style := csDropDownList;
      XFP4PgmCfg.ActionList.GroupActionValues.BuildVisibleStrings(Items);
      ItemIndex := fSound.MapValueToItem( fSound.ValueAsInt );
    end;
    OnChange := fOnSoundChange;
    LabelText := Translate( 'Tone/Message' );
  end;

  with iVolumeEditor do
  begin
    with EditorAsSpinEdit do
    begin
      Value := fVolume.ValueAsInt;
      MinValue := 0;
      MaxValue := 255;
    end;
    OnChange := fOnVolumeChange;
    LabelText := Translate( 'Volume' );
