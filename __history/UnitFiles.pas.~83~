                  Font.Style := [];
                end;
              end;
              UpdateSubDeviceFieldEditor;
            end;
          end;
        end;
      end;
    finally
      GroupUndoActive := FALSE;
      if assigned( fOnSubDeviceIOEditorChange ) then
      begin
        fOnSubDeviceIOEditorChange( Sender );
      end;
    end;
  end;
