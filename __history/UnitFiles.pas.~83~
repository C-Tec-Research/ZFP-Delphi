procedure tZFPPanelZoneFile.AddSpecialLines(const pFile: tStrings);
var
  iZoneList : tZFPZoneList;
  iNode : tZFPNode;
  iZone : tZFPZone;
  i,j : integer;
  iLine : string;
begin
  inherited;

  iZoneList := ZFPFile.ZoneList;
  if assigned( iZoneList ) then
  begin
    iNode := ZFPNode;
    for i := 0 to iZoneList.Max do
    begin
      iZone := iZoneList.Zone[ i ];
      if iZone.NodesWhereUsed.UsedByNode( iNode ) then
      begin
        iLine := ExportPrefix + ',' + iZone.ID.Value + ',"' + iZone.ExpandedName + '"' + iZone.DisablementCellText;
        for j := 0 to ZFPFile.NodeList.Max do
        begin
          if iZone.NodesWhereUsed.UsedByNode( ZFPFile.NodeList.Node[ j ] ) then
          begin
            iLine := iLine + ',' + IntToStr( j + 1 );
          end;
        end;
        pFile.Add( iLine );
        //pFile.Add( ExportPrefix + ',' + iZone.ID.Value + ',"' + iZone.ExpandedName + '","' + iZone.ExpandedPagerText + '"' );
      end;
    end;
    // now add universal zones
    with XFP4PgmCfg.SystemZones do
    begin
      for i := 0 to Max do
      begin
        pFile.Add( ExportPrefix + ',' + Map[ i ].Enum.Value + ',' + Map[ i ].EnumName.Value )
      end;
    end;
  end;

end;

