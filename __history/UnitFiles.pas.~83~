procedure tLoopDevices.SwapDevices(const Dev1, Dev2: integer);
begin
  // swap devices, then swap indexes and locations back to leave index sequence intact
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    SwapChild( Dev1, Dev2 );
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

procedure tLoopDevices.UpdateSubDevices(const iDevice : tLoopDevice; const ValueAsInt : integer);
var
  i : integer;
  iSubDevice : tLoopSubDevice;
begin
  iDevice.DeviceMap.ValueAsInt := ValueAsInt;
  if ValueAsInt <> 0 then
  begin
    iSubDevice := iDevice.SubDevice[ 1 ];
    for i := 5 to iSubDevice.Fields.Max do //Default only Sensitivies/Tones/Volumes. NOT Zones/Groups.
    begin
      iSubDevice.Field[ i ].Value := iSubDevice.Field[ i ].FieldDescriptor.DefaultValue.Value;
    end;
  end;

end;

procedure tLoopDevices.UpdateSubDeviceFieldEditor;
var
  iDevice : tLoopDevice;
  iSubDevice : tLoopSubDevice;
  i, j, iIndex : integer;
  iSubDeviceIndex : integer;
  iField : tDeviceField;
  iEditor : TSigVariableEditor;
  iDeviceEditCurrent : tDSMList;
  iObject : tZFPGlobalObject;
begin
  // we only need to modify editors relating to IO fields whose functionality has changed
  if assigned( fSubDeviceFieldEditor ) then
  begin
    // we consider fields to be common if:
    // for special editors (e.g. group editors) they have the same editor type.
    // For more general purpose editors, mut also have same name and map.
    // This is the ultimate aim, but initially we require that all devices are same type
    // (i.e. have the same device map). This guarantees that they will have the same field set
    iDeviceEditCurrent := fDeviceEditCurrent.DSMList;
    iIndex := fDeviceEditCurrent.First;
    if iIndex < 0 then
    begin
      exit;  // nothing selected
    end;
    if not AllSelectedDevicesSame then
    begin
      exit; // not allowed to edit fields on mixed devices at the moment.
    end;

    case DeviceEditMode of
      demNotDefined: ;
      demDevices: ;
      demDeviceEntries:
      begin
        // if we are showing only a single device with more than one subdevice then we build
        // the current subdevice tab.
        iDevice := VisibleLoopdevice[ iIndex - 1 ];
        iSubDeviceIndex := SubDeviceEditor.TabIndex;
        if iSubDeviceIndex < 0 then
        begin
          iSubDeviceIndex := 0;
        end;
        // we handle only fields of current subdevice
        iSubDevice := iDevice.SubDevice[ iSubDeviceIndex ];
        for i := 0 to iSubDevice.Fields.Max do
        begin
          iField := iSubDevice.Field[ i ].FieldDescriptor;
          case iField.DeviceFieldEditorStyle of
            es_None: ;
            es_Mask_Edit: ;
            es_Drop_Down: ;
            es_Drop_Down_List: ;
            es_Image_List: ;
            es_Spin_Edit: ;
            es_Drop_Down_Image_List: ;
            es_Zone: ;
            es_IO_Group:
            begin
              // Find the editor for this field
              iEditor := nil;
              for j := 0 to fSubDeviceFieldEditor.ComponentCount - 1 do
              begin
                if fSubDeviceFieldEditor.Editor[ j ].Tag = i then
                begin
                  // found
                  iEditor := fSubDeviceFieldEditor.Editor[ j ];
                end;
              end;
              if assigned( iEditor ) then
              begin
                // we must first decide if this is in input or output
                case iSubdevice.IOType of
                  sdt_Input:
                  begin
                    iEditor.EditorStyle := vesButton;
                    iObject := iSubDevice.Field[ i ].InputGroup1;
                    {
                    if not assigned( iObject ) then
                    begin
                      if Loop.LoopType <> ltA_Bus then
                      begin
                        iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ i ].Value, 0 ));
                        iSubDevice.Field[ i ].InputGroupPointer1.InputGroup := iObject as tInputGroup;
                      end;
                    end;
                    }
                    with iEditor.EditorAsButton do
                    begin
                      if assigned( iObject ) then
                      begin
                        Caption := iObject.ListName;
                      end
                      else
                      begin
                        Caption := ChevronText( 'None' );
                      end;
                    end;
                  end;
                  sdt_Output:
                  begin
                    iEditor.EditorStyle := vesButton;
                    iObject := iSubDevice.Field[ i ].OutputGroup1;
                    {
                    if not assigned( iObject ) then
                    begin
                      if Loop.LoopType <> ltA_Bus then
                      begin
                        iObject := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ i ].Value, 0 ));
                        iSubDevice.Field[ i ].OutputGroupPointer1.OutputGroup := iObject as tOutputGroup;
                      end;
                    end;
                    }
                    with iEditor.EditorAsButton do
                    begin
                      if assigned( iObject ) then
                      begin
                        Caption := iObject.ListName;
                      end
                      else
                      begin
                        Caption := ChevronText( 'None' );
                      end;
                    end;
                  end;
                  else
                  begin
                    iEditor.EditorStyle := vesNone;
                  end;
                end;
              end;
            end;
            es_Target_Group,
            es_Isolation_Group,
            es_Fault_Group: ;
          end;
        end;
      end;
      demSubDeviceEntries:
      begin
        // only for a single sub-device
        if fDeviceEditCurrent.Count = 1 then
        begin
          iSubDevice := self.VisibleLoopSubDevice[ fDeviceEditCurrent.First ];
          for i := 0 to iSubDevice.Fields.Max do
          begin
            iField := iSubDevice.Field[ i ].FieldDescriptor;
            case iField.DeviceFieldEditorStyle of
              es_Link_Address, es_Link_Count, es_None: ;
              es_Mask_Edit: ;
              es_Drop_Down: ;
              es_Drop_Down_List: ;
              es_Image_List: ;
              es_Spin_Edit: ;
              es_Drop_Down_Image_List: ;
              es_Zone: ;
              es_IO_Group:
              begin
                // Find the editor for this field
                iEditor := nil;
                for j := 0 to fSubDeviceFieldEditor.ComponentCount - 1 do
                begin
                  if fSubDeviceFieldEditor.Editor[ i ].Tag = i then
                  begin
                    // found
                    iEditor := fSubDeviceFieldEditor.Editor[ i ];
                  end;
                end;
                if assigned( iEditor ) then
                begin
                  // we must first decide if this is in input or output
                  case iSubdevice.IOType of
                    sdt_Input:
                    begin
                      iEditor.EditorStyle := vesButton;
                      iObject := iSubDevice.Field[ i ].InputGroup1;
                      {
                      if not assigned( iObject ) then
                      begin
                        if Loop.LoopType <> ltA_Bus then
                        begin
                          iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ i ].Value, 0 ));
                          iSubDevice.Field[ i ].InputGroupPointer1.InputGroup := iObject as tInputGroup;
                        end;
                      end;
                      }
                      with iEditor.EditorAsButton do
                      begin
                        if assigned( iObject ) then
                        begin
                          Caption := iObject.ListName;
                        end
                        else
                        begin
                          Caption := ChevronText( 'None' );
                        end;
                      end;
                    end;
                    sdt_Output:
                    begin
                      iEditor.EditorStyle := vesButton;
                      iObject := iSubDevice.Field[ i ].OutputGroup1;
                      {
                      if not assigned( iObject ) then
                      begin
                        if Loop.LoopType <> ltA_Bus then
                        begin
                          iObject := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ i ].Value, 0 ));
                          iSubDevice.Field[ i ].OutputGroupPointer1.OutputGroup := iObject as tOutputGroup;
                        end;
                      end;
                      }
                      with iEditor.EditorAsButton do
                      begin
                        if assigned( iObject ) then
                        begin
                          Caption := iObject.ListName;
                        end
                        else
                        begin
                          Caption := ChevronText( 'None' );
                        end;
                      end;
                    end;
                    else
                    begin
                      iEditor.EditorStyle := vesNone;
                    end;
                  end;
                end;
              end;
              es_Target_Group,
              es_Isolation_Group,
              es_Fault_Group: ;
            end;
          end;
        end;
      end;
    end;
  end;
end;

