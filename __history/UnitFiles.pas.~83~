procedure tInputSuperGroup.ShowEditors;
var
  i, iCount : integer;
  iGlobalObject : tGroup;
begin
  if assigned( fGroupChildrenEditor ) then
  begin
    fNeedsShowEditors := FALSE;
    with fGroupChildrenEditor do
    begin
      iCount := ZFPFile.CauseAndEffects.InputGroups.Count;
      if iCount > 0 then
      begin
        RowCount := iCount + 1;
      end
      else
      begin
        RowCount := 2;
      end;

      for i := 1 to iCount do
      begin
        iGlobalObject := ZFPFile.CauseAndEffects.InputGroups.InputGroup[ i - 1 ];
        if assigned( iGlobalObject ) then
        begin
          Cell[ 0, i ] := iGlobalObject.Name;
        end
        else
        begin
          Cell[ 0, i ] := '';
        end;
        if self.GroupChildren.HasGroup( iGlobalObject ) then
        begin
          Cell[ 1, i ] := '1';
        end
        else
        begin
          Cell[ 1, i ] := '0';
        end;
        Error[ 0, i ] := ZFPFile.CauseAndEffects.InputGroups.DuplicateName( iGlobalObject );
      end;
    end;
  end;
  if assigned( fSuperGroupChildrenEditor ) then
  begin
    with fSuperGroupChildrenEditor do
    begin
      iCount := ZFPFile.InputSuperGroupList.Count;
      if iCount > 0 then
      begin
        RowCount := iCount + 1;
      end
      else
      begin
        RowCount := 2;
      end;

      for i := 1 to iCount do
      begin
        iGlobalObject := ZFPFile.InputSuperGroupList.SuperGroup[ i - 1 ];
        if assigned( iGlobalObject ) then
        begin
          Cell[ 0, i ] := iGlobalObject.Name;
        end
        else
        begin
          Cell[ 0, i ] := '';
        end;
        if (iGlobalObject as tBaseSupergroup).ContainsSupergroup( self ) then
        begin
          Cell[ 1, i ] := '3';
        end
        else if SuperGroupChildren.HasGroup( iGlobalObject ) then
        begin
          Cell[ 1, i ] := '1';
        end
        else
        begin
          Cell[ 1, i ] := '0';
        end;
        Error[ 0, i ] := ZFPFile.InputSuperGroupList.DuplicateName( iGlobalObject );
      end;
    end;
  end;
end;

