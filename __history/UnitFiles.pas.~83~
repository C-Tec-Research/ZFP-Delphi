function tSequenceLinesList.AppendEffectsColumns(const i: integer): string;
var
  iAction : tAction;
  iEditorStyle : tOGSeqEditorStyle;
begin
  if i >= Count then
  begin
    Result := ',0,0,0';
  end
  else
  begin
    with Line[ i ] do
    begin
      Result := ',' + IntToStr( PreDelay.ValueAsInt ) + ',' + IntToStr( Action.ValueAsInt );
      iAction := XFP4PgmCfg.ActionList.ActionWithValue( Action.Value );
      if assigned( iAction ) then
      begin
        iEditorStyle := iAction.EditorStyle.ValueAsOGSeqStyle;
      end
      else
      begin
        iEditorStyle := og_None;
      end;
      case iEditorStyle of
        og_None,
        og_Mode,
        og_Spin_Edit,
        og_Map,
        og_Output_Group,
        og_Supergroup,
        og_Trigger,
        og_Input_Group,
        og_Timer,
        og_Zone,
        og_Access_Level:
        begin
          Result := Result + ',0';
        end;
        og_Sounder_Pattern:
        begin
          if assigned( PulsePattern.PulsePattern ) then
          begin
            Result := Result + ',' + PulsePattern.PulsePattern.ID.Value;
          end
        end;
        og_Group_Action:
        begin
          if assigned( GroupAction.GroupAction ) then
          begin
            Result := Result + ',' + GroupAction.GroupAction.ID.Value;
          end
        end;
      end;
    end;
  end;
end;

