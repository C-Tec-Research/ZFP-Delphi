procedure tLoopDevices.RecalculateVisibleCounts;
var
  i: Integer;
begin
  fVisibleDeviceCount := 0;
  fVisibleSubDeviceCount := 0;
  for i := 0 to Max do
  begin
    with LoopDevice[ i ] do
    begin
      if IOType <> sdt_Not_Fitted then
      begin
        inc( fVisibleDeviceCount );
        inc( fVisibleSubDeviceCount, SubDevices.Max );
      end;
    end;
