procedure tLoopDevice.SetLoopSubdevices;
var
  iNewSubDeviceMax : integer;
  i : integer;
  iRef : integer;
  iSubDeviceType : tSubDeviceType;
  iSubdevices : tSubDeviceList;
  iSubdevice : tSubDevice;
  iDevice : tDevice;
begin

  iDevice := Protocol.DeviceList.DeviceWithMapping[ DeviceMap ];
  iSubdevices := iDevice.SubDevices;
  // firstly the count
  iNewSubDeviceMax := iSubdevices.ActualSubdeviceCount.ValueAsInt;
  if iNewSubDeviceMax = 0 then
  begin
    // old way
    fUseVariableSubdevices := FALSE;
    iNewSubDeviceMax := iSubdevices.Max;
  end
  else
  begin
    fUseVariableSubdevices := TRUE;
  end;
  if iNewSubDeviceMax <> SubDevices.Max then
  begin
    SubDevices.Max := iNewSubDeviceMax;
  end;
  for i := 0 to iNewSubDeviceMax do
  begin
    // now the fields
    {
      There are 3 situations here
      if UseVariableSubdevices is FALSE, then the field count is fixed for each subdevice.
      if UseVariableSubdevices is TRUE and the subdevice count is 1, then again the
         field count is fixed, but this time the fields for each subdevice are copied over
         from subdevice 1, provided that the subdevice is valid at this location.
      if UseVariableSubdevices is true and the subdevice count is greater than 1 then the fields
         are variable, and not finalised until the subdevice type is selected. In this case there
         is an extra 'field' listing possible subdevice types, so the field editor is dynamic
         in this case. However this could be restricted by the ValidOnSubdevices field.
    }

    //SetLoopSubDeviceFields( i );
    //(*
    if not UseVariableSubdevices then
    begin
      // the old way
      iSubDevice := iSubDevices.SubDevice[ i ];
      iSubDeviceType := iSubDevice.SubDeviceTypeVal;
      with SubDevice[ i ] do
      begin
        PermittedIOType := iSubDeviceType;
        case iSubDeviceType of
          sdt_User_Selectable:
          begin
            IOType := sdt_Output;
          end;
          sdt_Input,
          sdt_Output,
          sdt_Other,
          sdt_Not_Fitted:
          begin
            IOType := iSubDeviceType;
          end;
          else
          begin
            IOType := sdt_Other;
          end;
        end;
      end;
    end
    else
    begin
      with SubDevice[ i ] do
      begin
        // decide if we need our 'Extra' field here
        // There is an added complication in that if there are exactly 1 input device
        // and exactly 1 output device then we do not need the extra field, because
        // that function is handled by the IO selection, but MaxSubdevicesValidAt handles that.
        FieldListIsUserSelectable := iSubDevices.MaxSubdevicesValidAt( i, fIORequiresEditorRebuild, fInputRef, fOutputRef, iRef ) > 1;
        // Field count
        Ref.ValueAsInt := iRef;
        iSubDeviceType := iSubDevices.IOTypeAt( i );
        PermittedIOType := iSubDeviceType;
        case iSubDeviceType of
          sdt_User_Selectable:
          begin
            //IOType := sdt_Output;
            IOType := iSubDevices.SubDevice[ 1 ].SubDeviceTypeVal;
          end;
          sdt_Input,
          sdt_Output,
          sdt_Other,
          sdt_Not_Fitted:
          begin
            IOType := iSubDeviceType;
          end;
          else
          begin
            IOType := sdt_Other;
          end;
        end;
      end;
    end;
    //*)
    SetLoopSubDeviceFields( i );
  end;
end;

