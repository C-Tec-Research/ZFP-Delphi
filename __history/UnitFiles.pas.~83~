              begin
                Color := clWindow;
                Font.Color := clWindowText;
                if fDeviceEditCurrent.Count > 1 then
                begin
                  Font.Style := [fsBold ];
                end
                else
                begin
                  Font.Style := [];
                end;
              end;
              if iRebuildRequired then
              begin
                BuildSubDeviceFieldEditor;
