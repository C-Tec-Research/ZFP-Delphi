procedure tInputGroup.FixModalOverrides;
var
  iMode : tZFPMode;
  i: Integer;
  iModeToCopy : integer;
  iNewMode : tInputGroupModalOperation;
  iIGStyle : tInputGroupStyle;
begin
  iIGStyle := IGStyle;
  case iIGStyle of
    igs_Classic: ;
    igs_Switch,
    igs_AND: exit;
  end;
  for i := 0 to ZFPFile.ModeList.Max do
  begin
    iMode := ZFPFile.ModeList.Mode[ i ];
    // Is this mode applicable to us?
    if iMode.NodesWhereUsed.SharesNodes( NodesWhereUsed ) then
    begin
      // see if we already have a setup for this Mode
      if not assigned( fModalOperations.InputGroupModalOperationForPanelMode[ iMode ]) then
      begin
        // no - copy one of the 4 fixed ones
        iModeToCopy := iMode.ID.ValueAsInt;
        iNewMode := fModalOperations.AddNewChild as tInputGroupModalOperation;
        iNewMode.PanelMode.Mode := iMode;
        with fModalOperations.InputGroupModalOperation[ iModeToCopy ] do
        begin
          iNewMode.OpMode := OpMode;
          iNewMode.Data1.Value := Data1.Value;
          iNewMode.Data2.Value := Data2.Value;
          iNewMode.CancelDelaysOnSilence.Value := CancelDelaysOnSilence.Value;
        end;
      end;
    end;
  end;
end;

