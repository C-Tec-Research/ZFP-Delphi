function tCETreeProperty.PasteFromOurClipboard( const Offset : integer;
         const pAutoIncInputs, pAutoIncOutputs : boolean;
         const StopAtObject : tObject; var ListEnd : boolean; const AutoSelect : boolean ): tCETreeProperty;
var
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
  pLine : integer;
  iIndex : integer;
begin
  // see if we can.
  Result := nil;
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    if Clipboard.Count > 1 then
    begin
      // analyse the line...
      if SigNETParse ( Clipboard[ 0 ], SigProperty,
             SigIndex, SigValue, SigComment) then
      begin
        // if we can create the clipboard as a child then do it.
        if CanCreateChild( SigProperty, SigIndex, SigValue, SigComment ) then
        begin
          Result := AddNextValidChild( ChildType( SigProperty, SigIndex, SigValue ), AutoSelect );
        end;
        if not assigned( Result ) then
        begin
          // if parent is tree then if parent can create we create as sibling before
          if assigned( Parent ) then
          begin
            if Parent.CanCreateChild( SigProperty, SigIndex, SigValue ) then
            begin
              //Result := Parent.PasteFromOurClipboard( Offset, pAutoIncInputs, pAutoIncOutputs, StopAtObject, ListEnd, AutoSelect);
              //exit;
              Result := InsertSiblingAfter( ChildType( SigProperty, SigIndex, SigValue ), AutoSelect);
            end;
          end;
        end;
      end;
      if assigned( Result ) then
      begin
        pLine := 1;
        Result.Load( Clipboard, pLine, TRUE, TRUE );
        ZFPFile.ExecuteAfterLoadActions;
        if pAutoIncInputs then Result.AutoIncInputs( Offset, StopAtObject, ListEnd );
        if pAutoIncOutputs then Result.AutoIncOutputs( Offset, StopAtObject, ListEnd );
        with Result do
        begin
          BuildTree;
          RefreshTreeText;
          TreeNode1.ImageIndex := ImageIndex;
          TreeNode1.SelectedIndex := ImageIndex + cSelectedOffset;
          TreeNode1.Selected := TRUE;
          iIndex := 0;
          BuildEditorList( iIndex );
        end;
      end
      else
      begin
        raise Exception.Create('Cannot Paste here');
      end;
    end;
    // just ignore if clipboard is empty. this complies with normal paste rules,
    // although it should not be possible!
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

procedure tCETreeProperty.PasteSpecialFromOurClipboard;
var
  i : integer;
  ListEnd : boolean;
  iAutoSelect : boolean;
begin
// TODO paste from our clipboard
  with FormPasteSpecial do
  begin
    OnSelectLimit := self.OnSelectLimit;
    EnableInputInc := Clipboard.HasInputs;
    EnableOutputInc := Clipboard.HasOutputs;
    if Execute then
    begin
      ListEnd := FALSE;
      case RadioGroupRepeat.ItemIndex of
        0: // paste set number of times (can go past end of list no problem)
        begin
          iAutoSelect := TRUE;
          for i := 1 to SigSpinEditFixedTimes.Value do
          begin
            fLastPastedChild := PasteFromOurClipBoard( i, CheckBoxAutoIncInput.Checked, CheckBoxAutoIncOutput.Checked,
                                   nil, ListEnd, iAutoSelect );
            iAutoSelect := FALSE;
          end;
        end;
        1: // paste until either the input list or output list is exhausted
        begin
          i := 0;
          iAutoSelect := TRUE;
          while not ListEnd do
          begin
            inc( i );
            fLastPastedChild := PasteFromOurClipBoard( i, CheckBoxAutoIncInput.Checked, CheckBoxAutoIncOutput.Checked,
                                   nil, ListEnd, iAutoSelect );
            iAutoSelect := FALSE;
          end;
        end;
        2: // paste until a list exhausted or an entry found
        begin
          i := 0;
          iAutoSelect := TRUE;
          while not ListEnd do
          begin
            inc( i );
            fLastPastedChild := PasteFromOurClipBoard( i, CheckBoxAutoIncInput.Checked, CheckBoxAutoIncOutput.Checked,
                                   SelectObject, ListEnd, iAutoSelect );
            iAutoSelect := FALSE;
          end;
        end;
      end;
      fLastPastedChild := nil;
    end;
  end;
end;

