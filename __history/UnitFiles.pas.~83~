procedure tZFPPanelFile.ExportFile(const pFile: tStrings);
var
  i, j : integer;
  iChild : tZFPPanelFileLine;
  iGroupChild : tZFPPanelFileGroup;
  iMemoChild : tZFPPanelFileMemo;
  iLine : string;
begin
  pFile.Clear;
  pFile.Add( ExportPrefix + ',BEGIN,' + ZFPNode.NetworkFile.PanelAddress.Address.Value );
  for i := 0 to Children.Count - 1 do
  begin
    if Children.Item[ i ] is tZFPPanelFileLine then
    begin
      iChild := Children.Item[ i ] as tZFPPanelFileLine;
      iLine := iChild.DataAsList;
      if iLine <> '' then
      begin
        pfile.Add( ExportPrefix + ',' + iChild.ExportPrefix + ',' + iLine );
      end;
    end
    else if Children.Item[ i ] is tZFPPanelFileGroup then
    begin
      iGroupChild := Children.Item[ i ] as tZFPPanelFileGroup;
      for j := 0 to iGroupChild.LineCount - 1 do
      begin
        iLine := iGroupChild.DataAsList( j );
        if iGroupChild.TransmitBlankLines or (iLine <> '') then
        begin
          if iGroupChild.ExportPrefix = '' then
          begin
            pFile.Add( ExportPrefix + ',' + iLine);
          end
          else
          begin
            pFile.Add( ExportPrefix + ',' + iGroupChild.ExportPrefix + ',' + iLine);
          end;
        end;
      end;
    end
    else if Children.Item[ i ] is tZFPPanelFileMemo then
    begin
      iMemoChild := Children.Item[ i ] as tZFPPanelFileMemo;
      for j := 0 to iMemoChild.LineCount - 1 do
      begin
        iLine := iMemoChild.DataAsList( j );
        if iMemoChild.TransmitBlankLines or (iLine <> '') then
        begin
          if iMemoChild.ExportPrefix = '' then
          begin
            pFile.Add( ExportPrefix + ',' + iLine);
          end
          else
          begin
            pFile.Add( ExportPrefix + ',' + iMemoChild.ExportPrefix + ',' + iLine);
          end;
        end;
      end;
    end;
  end;
  AddSpecialLines( pFile );
  pFile.Add( ExportPrefix + ',END,' + ZFPNode.NetworkFile.PanelAddress.Address.Value );
end;

