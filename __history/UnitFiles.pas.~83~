procedure tCETreeOutputObject.AutoIncOutputs( const Offset : integer; const StopAtObject : TObject;
  var ListEnd: boolean);
var
  iPos : integer;
  iObjectAssigned : tObject;
begin
  inherited;
  iObjectAssigned := nil;
  case self.PointerType.PointerType of
    lf_None: ;
    lf_Zone:
    begin
      if assigned( ZonePointer.Zone ) then
      begin
        with ZFPFile.ZoneList do
        begin
          iPos := Children.IndexOfItem( ZonePointer.Zone, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              ZonePointer.Zone := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              ZonePointer.Zone := Zone[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := ZonePointer.Zone;
            end;
          end
          else
          begin
            ZonePointer.Zone := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_Input:
    begin
      if assigned( InputGroupPointer.InputGroup ) then
      begin
        with ZFPFile.CauseAndEffects.InputGroups do
        begin
          iPos := Children.IndexOfItem( InputGroupPointer.InputGroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              InputGroupPointer.InputGroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              InputGroupPointer.InputGroup := InputGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := InputGroupPointer.InputGroup;
            end;
          end
          else
          begin
            InputGroupPointer.InputGroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_InputSupergroup:
    begin
      if assigned( InputSupergroupPointer.InputSupergroup ) then
      begin
        with ZFPFile.InputSuperGroupList do
        begin
          iPos := Children.IndexOfItem( InputSupergroupPointer.InputSupergroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              InputSupergroupPointer.InputSupergroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              InputSupergroupPointer.InputSupergroup := InputSuperGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := InputSupergroupPointer.InputSupergroup;
            end;
          end
          else
          begin
            InputSupergroupPointer.InputSupergroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_Output:
    begin
      if assigned( OutputGroupPointer.OutputGroup ) then
      begin
        with ZFPFile.CauseAndEffects.OutputGroups do
        begin
          iPos := Children.IndexOfItem( OutputGroupPointer.OutputGroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              OutputGroupPointer.OutputGroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              OutputGroupPointer.OutputGroup := OutputGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := OutputGroupPointer.OutputGroup;
            end;
          end
          else
          begin
            OutputGroupPointer.OutputGroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_OutputSuperGroup:
    begin
      if assigned( OutputSupergroupPointer.SuperGroup ) then
      begin
        with ZFPFile.SuperGroupList do
        begin
          iPos := Children.IndexOfItem( OutputSupergroupPointer.SuperGroup, TList.TDirection.FromBeginning );
          if iPos >= 0 then
          begin
            Inc( iPos, Offset );
            if iPos > Max then
            begin
              OutputSupergroupPointer.SuperGroup := nil;
              PointerType.PointerType := lf_None;
              ListEnd := TRUE;
            end
            else
            begin
              OutputSupergroupPointer.SuperGroup := SuperGroup[ iPos ];
              if iPos = Max then
              begin
                ListEnd := TRUE;
              end;
              iObjectAssigned := OutputSupergroupPointer.SuperGroup;
            end;
          end
          else
          begin
            OutputSupergroupPointer.SuperGroup := nil;
            PointerType.PointerType := lf_None;
          end;
        end;
      end;
    end;
    lf_Mode: ;
    lf_AccessLevel: ;
  end;
  if not ListEnd then
  begin
    if assigned( StopAtObject ) then
    begin
      if StopAtObject = iObjectAssigned then
      begin
        ListEnd := TRUE;
      end;
    end;
  end;
end;

procedure tCETreeOutputObject.BuildEditorList( var pIndex : integer );
