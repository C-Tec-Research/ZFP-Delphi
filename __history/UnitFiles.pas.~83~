function tLoopSubDevice.ExpandText(const pText: string): string;
var
  iPos1, iPos2 : integer;
  iOwner : tSigCompoundProperty;
  iLoopDevice : tLoopDevice;
begin
  // now do our parent substitutions
  iOwner := Owner;
  iLoopDevice := nil;
  while assigned( iOwner ) do
  begin
    if iOwner is tLoopDevice then
    begin
      iLoopDevice := iOwner as tLoopDevice;
      break;
    end;
    iOwner := iOwner.Owner;
  end;

  Result := pText;
  // are we a device or a subdevice?
  if SameText( Index, '0' )  then
  begin
    // device - remove optional values if any
    iPos1 := Pos( '[', Result );
    if iPos1 > 0 then
    begin
      iPos2 := Pos( ']', Result );
      if iPos2 > iPos1 then
      begin
        Result := Copy( Result, 1, iPos1 - 1 ) + Copy( Result, iPos2 + 1, Length( Result ));
      end;
    end;
  end
  else
  begin
    // subdevice - remove '[' and ']'
    iPos1 := Pos( '[', Result );
    if iPos1 > 0 then
    begin
      iPos2 := Pos( ']', Result );
      if iPos2 > iPos1 then
      begin
        Result := Substitute( Result, '[', '', 1 );
        Result := Substitute( Result, ']', '', 1 );
      end;
    end;
  end;
  // now substitute any remaining <s>
  Result := Substitute( Result, '<s>', Index );
  Result := Substitute( Result, '<S>', Index );
  if assigned( iLoopDevice ) then
  begin
    Result := iLoopDevice.GetExpandedName( Result );
  end;
end;

procedure TLoopSubDevice.ExportDeviceFieldsFile2(var iFieldArray : tFieldArray; const pErrors : TErrorList );
var
  i : integer;
  iField : tLoopSubDeviceField;
  iFieldDescriptor : tDeviceField;
  iValue : string;
  iVal : Word;
  iMap : tSigEnumMap;
  iSetOutput : boolean;
  iErrorText : string;
begin
  for i := 0 to Fields.Max do
  begin
    iField := Field[ i ];
    iFieldDescriptor := iField.FieldDescriptor;
    iValue := iField.Value;
    if iValue = '' then
    begin
      iValue := iFieldDescriptor.DefaultValue.Value;
    end;
    iSetOutput := FALSE;
    case tFieldEditorStyle( iFieldDescriptor.EditorStyle.ValueAsInt ) of
      es_Link_Address:
      begin
        // if we are subdevice device 0, then this is subdevice address of subdevice 1,
        // i.e. Cell index of subdevice 1
        // if we are any other subdevice then this is device address
        // Note that these values are calculated regardless of bus architecture so the fields
        // should only be present on A-Bus devices
        if StrToInt( Index ) = 0 then
        begin
          iVal := Device.ABusAddress;
        end
        else
        begin
          iVal := StrToInt( Device.Index ) + 1;
        end;
      end;
      es_Link_Count:
      begin
        // If we are subdevice 0 then it is the fitted subdevice count
        // Otherwise it is the channel (our Index)
        if StrToInt( Index ) = 0 then
        begin
          iVal := Device.SubdevicesAllocatedToGroups;
        end
        else
        begin
          iVal := StrToInt( Index ) - 1; // channel numbers are zero offset, but zero = device for us
        end;
      end;
      es_None:
      begin
        iVal := StrToIntDef( iFieldDescriptor.DefaultValue.Value, 0);       // if no editor then default value is mandatory value.
      end;
      es_Mask_Edit, es_Spin_Edit:
      begin
        iVal := StrToIntDef( iValue, 0 );
        if (iVal < iFieldDescriptor.MinVal.ValueAsInt) or (iVal > iFieldDescriptor.MaxVal.ValueAsInt ) then
        begin
          if not HasReportedError( re_Range_Error ) then
          begin
            iErrorText := Device.Name + ', ' +
                        iFieldDescriptor.Name.Value + ' ' + Translate('should lie in range' ) + ' ' +
                        iFieldDescriptor.MinVal.Value + '-' + iFieldDescriptor.MaxVal.Value;
            pErrors.Add( es_Error, 0, iErrorText, TLoopSubDeviceError.Create( self, iField, sdef_Range));
          end;
        end;
      end;
      es_Drop_Down:
      begin
        iMap := iFieldDescriptor.MapList.MapWithText( iValue );
        if assigned( iMap ) then
        begin
          iVal := iMap.Enum.ValueAsInt;
        end
        else
        begin
          // try numeric value
          iVal := StrToIntDef( iValue, 0 );
        end;
      end;
      es_Drop_Down_List:
      begin
        iMap := iFieldDescriptor.MapList.MapWithText( iValue );
        if assigned( iMap ) then
        begin
          iVal := iMap.Enum.ValueAsInt;
        end
        else
        begin
          // try numeric value
          // iMap := nil; not required - is already nil
          try
            iVal := StrToInt( iValue );
            iMap := iFieldDescriptor.MapList.MapWithValue( iVal );
          except
            iVal := 0;
          end;
        end;
        iErrorText := Device.Name + ', ' +
                      iFieldDescriptor.Name.Value + ' ' + Translate('has illegal value of' ) + ' ' +
                      ' ' + iValue;
        if not iField.HasReportedError( re_Range_Error ) then
        begin
          if not assigned( iMap ) then
          begin
            pErrors.Add( es_Error, 0, iErrorText, TLoopSubDeviceError.Create( self, iField, sdef_Range));
          end
          else if not iMap.Visible.ValueAsBool then
          begin
            pErrors.Add( es_Error, 0, iErrorText, TLoopSubDeviceError.Create( self, iField, sdef_Range));
          end;
        end;
      end;
      es_Image_List, es_Drop_Down_Image_List:
      begin
        iVal := 0;
      end;
      es_IO_Group:
      begin
        iVal := StrToIntDef( iValue, 0 );
        case IOType of
          sdt_Output:
          begin
            iSetOutput := TRUE;
            //if assigned( iField.OutputGroupPointer1.OutputGroup ) then
            if assigned( iField.OutputGroup1 ) then
            begin
              iVal := iField.OutputGroup1.ID.ValueAsInt;
            end;
          end;
          sdt_Input:
          begin
            if assigned( iField.InputGroup1 ) then
            begin
              iVal := iField.InputGroup1.ID.ValueAsInt;
            end;
          end;
        end;
      end;
      es_Zone:
      begin
        if assigned( iField.Zone ) then
        begin
          iVal := iField.Zone.ID.ValueAsInt;
        end
        else
        begin
          iVal := StrToIntDef( iValue, 0 );
        end;
      end;
      es_Target_Group,
      es_Isolation_Group,
      es_Fault_Group:
      begin
        if assigned( iField.InputGroup1 ) then
        begin
          iVal := iField.InputGroup1.ID.ValueAsInt;
        end
        else
        begin
          iVal := StrToIntDef( iValue, 0 );
        end;
      end;
      else
      begin
        iVal := 0;
      end;
    end;
    iFieldArray.SetBits( iFieldDescriptor.Location[ SubDeviceID ], iFieldDescriptor.Length.ValueAsInt, iVal);
    if iSetOutput then
    begin
      iFieldArray.SetBit( iFieldDescriptor.Location[ SubDeviceID ] + 14, TRUE  );
    end;
  end;
end;

