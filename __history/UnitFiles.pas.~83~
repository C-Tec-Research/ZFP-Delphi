procedure tZFPGlobalArray.IDChanged(const pLine: integer; const pFrom,
  pTo: string);
var
  iChild : tZFPGlobalObject;
  i, j : integer;
  iError : boolean;
  iCellID : string;
begin
  if pFrom = pTo then
  begin
    exit;
  end;
  if assigned( fEditor ) then
  begin
    if fEditor.RowCount <> (Count + 2 ) then
    begin
      fEditor.RowCount := Count + 2; // One for titles, one for new entries
      // last line
      i := Count + 1;
      fEditor.Cell[ cColName, i ] := '';
      fEditor.Cell[ cColID, i ] := '';
      fEditor.Error[ cColName, i ] := FALSE;
      fEditor.ErrorText[ cColID, i ] := '';
      fEditor.Error[ cColID, i ] := FALSE;
      fEditor.ErrorText[ cColID, i ] := '';
      for j := cColPanel1 to fEditor.ColCount - 1 do
      begin
        fEditor.Cell[ j, i ] := '0';
      end;
    end;
    for i := 1 to Max + 1 do
    begin
      iChild := GlobalObject[ i - 1 ];
      if assigned( iChild ) then
      begin
        iCellID := fEditor.Cell[ cColID, i ];
        if (i = pLine) then
        begin
          fEditor.Cell[ cColID, i ] := IntToStr( iChild.VisibleID );
        end;
        if (i = pLine) or (iCellID = pFrom) or (iCellID = pTo) then
        begin
        iError := DuplicateID( iChild );
        fEditor.Error[ cColID, i ] := iError;
          if iError then
          begin
            fEditor.ErrorText[ cColID, i ] := Translate( 'Duplicate ID' );
          end
          else
          begin
            fEditor.ErrorText[ cColID, i ] := Translate( '' );
          end;
        end;
      end;
    end;
  end;
end;

