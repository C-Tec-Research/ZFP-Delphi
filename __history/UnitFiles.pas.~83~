procedure tZFPNode.SetNodalType(const Value: tNodalType);
var
  i: Integer;
begin
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    if XFP4PgmCfg.NodalInfo.IsEmptyNode( Value ) then
    begin
      OwnerList.Remove( self, undoDelete2 );
    end
    else if not XFP4PgmCfg.NodalInfo.NodalClassList.NodalTypeToMap( Value, fNodalMap ) then
    begin
      raise Exception.Create('Internal error 002');
    end
    else
    begin
      // assign devices
      if assigned( fLoopsFittedTabSheet ) then
      begin
        fLoopsFittedTabSheet.TabVisible := NodalType.MaxLoops.ValueAsInt > 0;
      end;
      if NodalType.MaxLoops.ValueAsInt < LoopList.NormalLoopCount then
      begin
        LoopList.NormalLoopCount := NodalType.MaxLoops.ValueAsInt;
      end
      else
      begin
        LoopList.SetupTabs;
      end;
      for i := 0 to LoopList.Max do
      begin
        LoopList.Loop[ i ].ClearDevices;
        //LoopList.Loop[ i ].LoadFixedDevices;  Done in ClearDevices
      end;
    end;
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;

end;

