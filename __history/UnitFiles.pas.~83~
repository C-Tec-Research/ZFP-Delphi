function tZFPGlobalArray.FindOrCreate(pID: integer; pName: string;
  pOverideName: boolean; pNode: tZFPNode): tZFPGlobalObject;
var
  i: integer;
begin
  for i := 0 to Max do
  begin
    Result := GlobalObject[ i ];
    with Result do
    begin
      if ID.ValueAsInt = pID then
      begin
        if Result.NodesWhereUsed.UsedByNode( pNode ) then
        begin
          // found
          if pOverideName and (pName <> '' ) then
          begin
            Result.Name := pName;
          end;
          exit;
        end;
      end;
    end;
  end;
  // not found, so Create
  Result := GlobalObject[ AddObject( pName ) ];
  Result.ID.ValueAsInt := pID;
end;

