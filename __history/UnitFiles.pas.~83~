function tZFPPanelZoneFile.ImportSpecialLines(const pFile: tStrings; const iIndex : integer; pErrors : tErrorList;
                          const pErrorObject : tObject): boolean;
var
  iZoneList : tZFPZoneList;
  iZoneID : integer;
  i: Integer;
  iZone : tZFPZone;
begin
  iZoneList := ZFPFile.ZoneList;
  iZoneID := StrToInt( pFile[ 1 ] );
  Result := TRUE;
  // is it a system zone?
  if iZoneID < 200 then
  begin
    // no - standard zone so can update or add
    for i := 0 to iZoneList.Max do
    begin
      iZone := iZoneList.Zone[ i ];
      if iZone.ID.ValueAsInt = iZoneID then
      begin
        iZone.Name := UnquotedString( pFile[ 2 ] );
        iZone.PagerText.Value := UnquotedString( pFile[ 3 ] );
        exit;
      end;
    end;
    // else add zone
    with iZoneList do
    begin
      Max := Max + 1;
      iZone := Zone[ Max ];
      iZone.ID.ValueAsInt := iZoneID;
      iZone.Name := UnquotedString( pFile[ 2 ] );
      iZone.PagerText.Value := UnquotedString( pFile[ 3 ] );
    end;
  end;
  // Ignore system zones
end;

