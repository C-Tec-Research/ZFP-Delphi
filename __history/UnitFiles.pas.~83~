function tLoopDevice.DuplicateSubDeviceName(const pName: string;
  const pSubDevice: integer): boolean;
var
  i: Integer;
begin
  Result := FALSE;
  for i := 1 to fSubDevices.Max do  // 0 is device name, not subdevice name!
  begin
    if i <> pSubDevice then
    begin
      if SameText( pName, SubDevice[ i ].ExpandedName ) then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
end;

procedure tLoopDevice.ExecuteOnChange(const pChangedObject: tSigBaseProperty; const pUndoing, pRedoing : boolean);
begin
  if pUndoing then
  begin
    AmUndoing := TRUE;
  end;
  if pRedoing then
  begin
    AmRedoing := TRUE;
  end;
  try

    inherited;

    // make sure subdevice count is correct
    if pChangedObject = fDeviceMap then
    begin
      CheckSubDeviceCount;
    end;
  finally
    if pUndoing then
    begin
      AmUndoing := FALSE;
    end;
    if pRedoing then
    begin
      AmRedoing := FALSE;
    end;
  end;
end;

procedure tLoopDevice.ExportDeviceFieldsFile(const pFile: tStrings; const pErrors : TErrorList);
var
  iString : string;
  i: Integer;
begin
  if IOType <> sdt_Not_Fitted then
  begin
    if assigned( Device ) then
    begin
      case Loop.LoopType of
        ltA_Bus:
        begin
          iString := '20,'+ IntToStr( Loop.LoopAddress.ValueAsInt ) + ','
                +  IntToStr( StrToInt( Index ) + 1);
          SubDevices.ExportDeviceFieldsFile( pFile, iString, 0, Device.TypeIDonLoop.ValueAsInt, pErrors );
          for i := 1 to SubDevices.Max do
          begin
            if SubDevices.SubDevice[ i ].AllocatedToGroup then
            begin
              iString := '20,'+ IntToStr( Loop.SubLoopAddress.ValueAsInt ) + ','
                      +  IntToStr( ABusAddressOf( SubDevices.SubDevice[ i ] ) );
              SubDevices.ExportDeviceFieldsFile( pFile, iString, i, Device.TypeIDonLoop.ValueAsInt, pErrors );
            end;
          end;
        end;
        ltA_Bus_Subdevices:
        begin
          //raise Exception.Create('ABus Subdevices loop found');
          if not HasReportedError( re_Internal_Error ) then
          begin
            pErrors.Add( es_Error, 0, Translate( 'ABus Subdevices loop found' ), TLoopSubDeviceError.Create( SubDevice[ 0 ], sdef_Description));
          end;
        end;
        ltSystem,
        ltNormal:
        begin
          iString := '20,'+ IntToStr( Loop.LoopAddress.ValueAsInt ) + ','
                +  IntToStr( StrToInt( Index ) + 1) + ',' + Device.TypeIDonLoop.Value;
          SubDevices.ExportDeviceFieldsFile( pFile, iString, pErrors );
        end;
      end;
    end
    else
    begin
      //raise Exception.Create('Device not assigned for loop ' + Loop.LoopAddress.Value
      //                     + ', Device ' + IntToStr( StrToInt( Index ) + 1));
      iString := Translate('Device not assigned for loop') + ' ' + Loop.LoopAddress.Value
                           + ', '+ Translate('Device')  + ' '+ IntToStr( StrToInt( Index ) + 1);
      if not HasReportedError( re_Internal_Error ) then
      begin
        pErrors.Add( es_Error, 0, iString, TLoopSubDeviceError.Create( SubDevice[ 0 ], sdef_Description));
      end;
    end;
  end;
end;

