function tCETreeProperty.InsertNextValidChild(pAtPos: integer;
  pOfType: tCETreePropertyClass; pSibling : tTreeNode ) : tCETreeProperty;
var
  iNewPos : integer;
begin
  if CanCreateChildOfType( pOfType ) then
  begin
    Result := CreateNextValidChild( pOfType );
    iNewPos := Children.IndexOf( Result );
    with Result do
    begin
      TreeNode1 := TreeNodes1.InsertObject( pSibling, Result.TreeText, Result );
      TreeNode1.ImageIndex := Result.ImageIndex;
      TreeNode1.SelectedIndex := Result.ImageIndex + cSelectedOffset;
      TreeNode1.Selected := TRUE;
    end;
    Children.Move( iNewPos, pAtPos );
  end
  else
  begin
    raise Exception.Create('Cannot Create this child here');
  end;
end;

function tCETreeProperty.InsertNextValidChildAfter(pCurrChild: tCETreeProperty;
  pOfType: tCETreePropertyClass; const AutoSelect : boolean) : tCETreeProperty;
var
  iPos : integer;
  iSiblingIndex : integer;
begin
  iPos := FindPosOfChild( pCurrChild );
  if iPos = -1 then
  begin
    raise Exception.Create('Internal Error locating current Cause and Effects Object');
  end
  else
  begin
    if iPos = Children.Count - 1 then
    begin
      // add at end
      Result := AddNextValidChild( pOfType, AutoSelect );
    end
    else
    begin
      iSiblingIndex := self.FindChildAfter( iPos );
      if iSiblingIndex < 0 then
      begin
        Result := AddNextValidChild( pOfType, AutoSelect );
      end
      else
      begin
        Result := InsertNextValidChild( iPos + 1, pOfType, (Children.Item[ iSiblingIndex ] as tCETreeProperty).TreeNode1 );
      end;
    end;
  end;
end;

function tCETreeProperty.InsertNextValidChildBefore(
  pCurrChild: tCETreeProperty; pOfType: tCETreePropertyClass) : tCETreeProperty;
var
  iPos : integer;
begin
  iPos := FindPosOfChild( pCurrChild );
  if iPos = -1 then
  begin
    raise Exception.Create('Internal Error locating current Cause and Effects Object');
  end
  else
  begin
    Result := InsertNextValidChild( iPos, pOfType, pCurrChild.TreeNode1 );
  end;
end;

