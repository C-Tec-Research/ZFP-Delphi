procedure tZFPFile.AddError(const pSeverity: tErrorSeverity; const pRow,
  pCol: integer; const pErrorText: string; pObject: tObject);
var
  iOwner : tSigCompoundProperty;
begin
  inherited;
  if assigned( pObject ) then
  begin
    if pObject is tSigCompoundProperty then
    begin
      iOwner := pObject as tSigCompoundProperty;
    end
    else if pObject is tSigBaseProperty then
    begin
      iOwner := (pObject as tSigBaseProperty).Owner;
    end
    else
    begin
      exit;
    end;
    while assigned( iOwner ) do
    begin
      if iOwner is tZFPGlobalArray then
      begin
        fPendingErrorFrames.Add( (iOwner as tZFPGlobalArray).EditorFrame.FrameErrorList );
        exit;
      end;
      if iOwner is tLoopSubDevice then
      begin
        fPendingErrorFrames.Add( DeviceErrorFrame );
        exit;
      end;
      if iOwner is tCETreeProperty then
      begin
        fPendingErrorFrames.Add( CETreeErrorFrame );
        exit;
      end;
      iOwner := iOwner.Owner;
    end;
    raise Exception.Create('Internal Error 001');
  end;
end;

