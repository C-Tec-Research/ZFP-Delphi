procedure tZFPGlobalArray.OnBlockAdd(Sender: tObject);
var
  i, iFrom, iTo : integer;
  iBaseText : string;
  iPos : integer;
  iLeft, iRight : string;
begin
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  BlockAddActive := TRUE;
  try
    with FormBlockAddition do
    begin
      if Execute then
      begin
        iFrom := SigSpinEditFrom.Value;
        iTo := SigSpinEditTo.Value;
        iBaseText := EditName.Text;
        iPos := Pos( '<n>', iBaseText );
        if iPos = 0 then
        begin
          raise Exception.Create('Substitution string (<n>) not found. Unable to create block.');
        end;
        // else
        iLeft := Copy( iBaseText, 1, iPos -1 );
        iRight := Copy( iBaseText, iPos +3, 255 );
        if iFrom <= iTo then
        begin
          for i := iFrom to iTo do
          begin
            AddObject( iLeft + IntToStr( i ) + iRight );
          end;
        end
        else
        begin
          // descending!
          for i := iFrom downto iTo do
          begin
            AddObject( iLeft + IntToStr( i ) + iRight );
          end;
        end;
        //ShowMainEditor;
        EditorFrame.PageControlProperties.TabIndex := 0;
        ShowEditors;
        UpdateEditors;
      end;
    end;
  finally
    BlockAddActive := FALSE;
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

