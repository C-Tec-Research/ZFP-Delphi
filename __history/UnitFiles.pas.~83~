procedure tLoopSubDevice.ImportDeviceFieldsFile(const iFieldArray: tFieldArray);
var
  i : integer;
  iField : tLoopSubDeviceField;
  iFieldDescriptor : tDeviceField;
  //iVal : integer;
  iVal : word;
  iMap : tSigEnumMap;
  iObject : tZFPGlobalObject;
  iIOOutput : boolean;
begin
  for i := 0 to Fields.Max do
  begin
    iField := Field[ i ];
    iFieldDescriptor := iField.FieldDescriptor;
    iVal := iFieldArray.GetBits(iFieldDescriptor.Location[ SubDeviceID ], iFieldDescriptor.Length.ValueAsInt);
    case tFieldEditorStyle( iFieldDescriptor.EditorStyle.ValueAsInt ) of
      es_None:
      begin
        // if no editor then default value is mandatory value, so ignore what came back.
      end;
      es_Zone:
      begin
        iField.Value := IntToStr( iVal );
        iField.Zone := (OwnerFile as tZFPFile).ZoneList.ObjectWithID( iVal ) as tZFPZone;
      end;
      es_IO_Group:
      begin
        iIOOutput := iFieldArray.GetBit(iFieldDescriptor.Location[ SubDeviceID ] + 14 );
        iField.Value := IntToStr( iVal );
        // recalculate group
        // we must first decide if this is in input or output
        case PermittedIOType of
          sdt_Input:
          begin
            iObject := (OwnerFile as tZFPFile).CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iField.Value, 0 ));
            iField.InputGroup1 := iObject as tInputGroup;
          end;
          sdt_Output:
          begin
            iObject := (OwnerFile as tZFPFile).CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iField.Value, 0 ));
            iField.OutputGroup1 := iObject as tOutputGroup;
          end;
          sdt_User_Selectable:
          begin
            if iIOOutput then
            begin
              IOType := sdt_Output;
              iObject := (OwnerFile as tZFPFile).CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iField.Value, 0 ));
              iField.OutputGroup1 := iObject as tOutputGroup;
            end
            else
            begin
              IOType := sdt_Input;
              iObject := (OwnerFile as tZFPFile).CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iField.Value, 0 ));
              iField.InputGroup1 := iObject as tInputGroup;
            end;
          end
          else
          begin
            // do nothing;
          end;
        end;
      end;
      es_Target_Group,
      es_Isolation_Group,
      es_Fault_Group:
      begin
        iField.Value := IntToStr( iVal );
        iObject := (OwnerFile as tZFPFile).InputObjectWithID(StrToIntDef( iField.Value, 0 ));
        if Assigned( iObject ) then
        begin
          iField.InputGroup1 := iObject as tInputGroup;
          //iField.PointerType1.PointerType := lf_Input;
        end
        else
        begin
          iField.PointerType1.PointerType := lf_None;
        end;
      end;
      es_Mask_Edit, es_Spin_Edit:
      begin
        iField.Value := IntToStr( iVal );
      end;
      es_Drop_Down, es_Drop_Down_List:
      begin
        iMap := iFieldDescriptor.MapList.MapWithValue( iVal );
        if assigned( iMap ) then
        begin
          iField.Value := iMap.EnumName.Value;
        end
        else
        begin
          // try numeric value
          iField.Value := IntToStr( iVal );
        end;
      end;
      es_Image_List, es_Drop_Down_Image_List:
      begin
        iField.Value := '';
      end;
      es_Link_Address:
      begin
        // this is the device entry (A-Bus subdevices go a different way)
        // and represents the lowest subdevice index on loop 11
        iField.Value := ''; // recalculated on send
        if StrToInt( Index ) = 0 then
        begin
          Device.FirstABusDevice := iVal; // only valid for duration of load
        end;
      end;
      es_Link_Count:
      begin
        // this is the device entry (A-Bus subdevices go a different way)
        // and represents the subdevice count on loop 11
        iField.Value := ''; // recalculated on send
        if StrToInt( Index ) = 0 then
        begin
          Device.ABusCount := iVal; // only valid for duration of load
        end;
      end
      else
      begin
        iField.Value := '';
      end;
    end;

  end;
end;

