procedure tZFPFile.ExportNetworkCfgFile(const pPanel: tZFPNode;
  const pStrings: tStrings; pErrors : tErrorList;
  const pClearFirst: boolean);
var
  iLine : string;
  i, j : integer;
  iPanel : integer;
  iErrorObject : tZFPSegmentError;
begin
  iPanel := pPanel.ID;
  if pClearFirst then
  begin
    pStrings.Clear;
  end;
  pStrings.Add( '120,BEGIN,' + IntToStr( iPanel ));
  // CauseAndEffects.OutputGroups.ExportConfigFile( pPanel, pStrings );
  // network address. Currently segnment is not used and is always zero.
  // the address is the same as the panel number unless there is only one
  // panel, when the address is zero
  with pPanel.NetworkFile.PanelAddress do
  begin
    if NodeList.Max = 0 then
    begin
      pStrings.Add( '120,1,0,' + Address.Value);
    end
    else
    begin
      if Segment.ValueAsInt = 0 then
      begin
        if assigned( pErrors ) then
        begin
          iErrorObject := tZFPSegmentError.Create( Segment );
          pErrors.Add( tErrorSeverity.es_Error, pStrings.Count, Translate( 'Invalid segment address' ), iErrorObject);
        end;
      end;
      pStrings.Add( '120,1,' + Segment.Value + ',' + Address.Value );
    end;
  end;
  // We do not currently support tethering
  //with pPanel.NetworkFile.TetheredAddress do
  with pPanel.NetworkFile.PanelAddress do
  begin
    pStrings.Add( '120,2,' + Segment.Value + ',' + Address.Value );
  end;

  with pPanel.DataFilters do
  begin
    for i := 0 to NodeList.Max do
    begin
      iLine := '120,20,' + NodeList.Node[ i ].NetworkFile.PanelAddress.Address.Value;
      for j := 0 to Max do
      begin
        iLine := iLine + BoolCSVCol( GetFilter( j, i ));
      end;
{
                       + BoolCSVCol( RcvZoneAlarm[ i ] )
                       + BoolCSVCol( RcvDeviceAlarm[ i ] )
                       + BoolCSVCol( RcvFaults[ i ] )
                       + BoolCSVCol( RcvDisablements[ i ] )
                       + BoolCSVCol( RcvSelections[ i ] )
                       + BoolCSVCol( RcvTestConditions[ i ] )
                       + BoolCSVCol( RcvSupervisoryAlarms[ i ] )
                       + BoolCSVCol( RcvSilenceAction[ i ] )
                       + BoolCSVCol( RcvMuteAction[ i ] )
                       + BoolCSVCol( RcvReset[ i ] )
                       + BoolCSVCol( RcvAcks[ i ] )
                       + BoolCSVCol( RcvModes[ i ] )
                       + BoolCSVCol( HidePanelNameOfEvents[ i ] )
                       ;
}
      pStrings.Add( iLine );
    end;
  end;
  // list of panels fitted
  if NodeList.Max = 0 then
  begin
    pStrings.Add( '120,25,0');
  end
  else
  begin
    iLine := '120,25';
    for i := 0 to NodeList.Max do
    begin
      iLine := iLine + ',' + NodeList.Node[ i ].NetworkFile.PanelAddress.Address.Value;
    end;
    pStrings.Add( iLine );
  end;
  pStrings.Add( '120,END,' + IntToStr( iPanel ));
end;

