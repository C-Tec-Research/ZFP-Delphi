procedure tInputGroup.ExportConfigFile(const pPanel: tZFPNode;
  const pStrings: tStrings);
var
  iLine : string;
  iSilence : string;
  i: Integer;
  iMode : tZFPMode;
  iModePointer : tModePointer;
  im: Integer;
  iFound : boolean;
begin
  iLine := '14,'// line type
        +  IntToStr( ID.ValueAsInt ); // Input Group ID
  iSilence := '';
  // the 4 modal operations
  for im := 0 to 3 do
  begin
    case IGStyle of
      igs_Classic:
      begin
        iFound := FALSE;
        for i := 0 to ModalOperations.Max do
        begin
          with ModalOperations.InputGroupModalOperation[ i ] do
          begin
            iModePointer := PanelMode;
            if assigned( iModePointer ) then
            begin
              iMode := iModePointer.Mode;
              if assigned( iMode ) then
              begin
                if iMode.ValidOnPanel( pPanel ) then
                begin
                  if iMode.ID.ValueAsInt = im then
                  begin
                    if Operation <> opm_NA then
                    begin
                      iFound := TRUE;
                      iLine := iLine + ',' + IntToStr( fOpMode.ValueAsInt ) + ','
                            + IntToStr( Data1.ValueAsInt ) + ',' + IntToStr( Data2.ValueAsInt );
                      iSilence := iSilence + ExportSilence;
                      break;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
        if not iFound then
        begin
          // use default
          with DefaultModalOperation do
          begin
            iLine := iLine + ',' + IntToStr( fOpMode.ValueAsInt ) + ','
                  + IntToStr( Data1.ValueAsInt ) + ',' + IntToStr( Data2.ValueAsInt );
            iSilence := iSilence + ExportSilence;
          end;
        end;
      end;
      igs_Switch:
      begin
        iLine := iLine + ',1,0,0';
        iSilence := iSilence + ',0';
      end;
      igs_AND:
      begin
        iFound := FALSE;
{
        for i := 0 to ModalOperations.Max do
        begin
          with ModalOperations.InputGroupModalOperation[ i ] do
          begin
            iModePointer := PanelMode;
            if assigned( iModePointer ) then
            begin
              iMode := iModePointer.Mode;
              if assigned( iMode ) then
              begin
                if iMode.ValidOnPanel( pPanel ) then
                begin
                  if iMode.ID.ValueAsInt = im then
                  begin
                    if Operation <> opm_NA then
                    begin
                      iFound := TRUE;
                      iLine := iLine + ',' + IntToStr( OpMode.ValueAsInt ) + ','
                            + IntToStr( Data1.ValueAsInt ) + ',' + IntToStr( Data2.ValueAsInt );

                      iSilence := iSilence + ',0';
                      break;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
}
        if not iFound then
        begin
          // use default
          with DefaultModalOperation do
          begin
            iLine := iLine + ',' + IntToStr( fOpMode.ValueAsInt ) + ','
                  + IntToStr(ANDPartialActivationCount.ValueAsInt ) + ',' + IntToStr( ANDFullActivationCount.ValueAsInt );
            iSilence := iSilence + ExportSilence;
          end;
        end;
      end;
    end;
  end;
  // Input group first stage - currently not implemented
  iLine := iLine + ',0';
  // Output group first stage - currently not implemented
  iLine := iLine + ',0';
  // sequence - currently not implemented
  iLine := iLine + ',0';
  // disablement
  //iLine := iLine + DisablementCellText;
   // autoclear
  if AutoClearOnPanelReset.ValueAsBool then
  begin
    iLine := iLine + ',1';
  end
  else
  begin
    iLine := iLine + ',0';
  end;
  // delays MCP
  if OutputDelaysApplyToMCPs.ValueAsBool then
  begin
    iLine := iLine + ',1';
  end
  else
  begin
    iLine := iLine + ',0';
  end;
  // Delays Det
  if OutputDelaysApplyToDetectors.ValueAsBool then
  begin
    iLine := iLine + ',1';
  end
  else
  begin
    iLine := iLine + ',0';
  end;
  // MCP Qualifies Dep
  if MCPQualifiesDependencies.ValueAsBool then
  begin
    iLine := iLine + ',1';
  end
  else
  begin
    iLine := iLine + ',0';
  end;
  // group dependencies - currently cocked up so ignore
  for im := 0 to 3 do
  begin
    iLine := iLine + ',0';
  end;
  iLine := iLine + iSilence;
  // Style
  iLine := iLine + ',' + IntToStr( fIGStyle2.ValueAsInt );
  // used in AND group
  iLine := iLine + ',0';
  pStrings.Add( iLine );
end;

