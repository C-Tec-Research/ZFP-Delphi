              end;
            end;
          end;
        end;
      end;
    end;
    // now change page to output groups
    if assigned( fShowOGTab ) then
    begin
      fShowOGTab( self );
      fUndoRedoNavigationHelper.CheckStatus;
    end;
  finally
    UndoRedo.GroupUndoActive := FALSE;
  end;
