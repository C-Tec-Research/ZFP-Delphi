procedure tZFPNodeList.Swap(const pFrom, pTo: integer);
var
  iNode1, iNode2 : tZFPNode;
  iFrom, iTo : integer;
begin
  (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := TRUE;
  try
    iFrom := IndexOfNodeWithID( pFrom );
    iTo := IndexOfNodeWithID( pTo );
    iNode1 := NodeWithID( pFrom );
    iNode2 := NodeWithID( pTo );
    if assigned( iNode1 ) then
    begin
      iNode1.ID := pTo;
      if assigned( iNode2 ) then
      begin
        iNode2.ID := pFrom;
        inherited Swap( iFrom, iTo );
      end
      else
      begin
        // node does not exist - use move instead, but easier to sort for how often it happens
        Sort;
      end;
    end
    else if assigned( iNode2 ) then
    begin
      iNode2.ID := pFrom;
      // node does not exist - use move instead, but easier to sort for how often it happens
      Sort;
    end;
  finally
    (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := FALSE;
  end;
end;

