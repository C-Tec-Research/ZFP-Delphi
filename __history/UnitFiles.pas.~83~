  // then swap indexes and locations back to leave index sequence intact
  iDev1 := LoopDevice[ pFrom ];
  iDev2 := LoopDevice[ pTo ];
  iIndexTemp := iDev1.Index;
  iDev1.Index := iDev2.Index;
  iDev2.Index := iIndexTemp;
  iIndexTemp := iDev1.Location;
  iDev1.Location := iDev2.Location;
