procedure tInputGroupModalOperation.UpdateExtraEditors( pToEditor : TSigVariableEditorList );
var
  iData1Editor, iData1aEditor, iData2Editor : tSigVariableEditor;
begin
  if pToEditor = fFieldEditor then
  begin
    iData1Editor := fFieldData1Editor;
    iData1aEditor := fFieldData1aEditor;
    iData2Editor := fFieldData2Editor;
  end
  else
  begin
    iData1Editor := fToData1Editor;
    iData1aEditor := fToData1aEditor;
    iData2Editor := fToData2Editor;
  end;
  if assigned( iData1Editor ) and assigned( iData2Editor ) and assigned( iData1aEditor) then
  begin
    iData1Editor.OnChange := nil; // avoid false triggering
    iData1aEditor.OnChange := nil; // avoid false triggering
    iData2Editor.OnChange := nil; // avoid false triggering
    case OwnerAsBaseInputGroup.IGStyle of
      igs_Classic:
      begin
        case Operation of
          opm_NA:
          begin
            iData1Editor.EditorStyle := vesNone;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesNone;
            iData1Editor.LabelText := '';
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := '';
          end;
          opm_Single:
          begin
            iData1Editor.EditorStyle := vesNone;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesNone;
            iData1Editor.LabelText := '';
            iData1aEditor.LabelText := '';
            iData2Editor.LabelText := '';
          end;
          opm_2_Devices:
          begin
            iData1Editor.EditorStyle := vesCheckbox;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Same Input Group' );
            iData1aEditor.LabelText := '';
            iData1Editor.OnChange := OnSameInputGroupChange;
            iData2Editor.LabelText := Translate( 'Timeout (0-600 secs)' );
            iData2Editor.OnChange := OnTimeoutChange;
            with iData1Editor.EditorAsCheckBox do
            begin
              Checked := SameInputGroup;
            end;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 600;
              Value := Data2.ValueAsInt;
            end;
          end;
          opm_Dependency_A:
          begin
            iData1Editor.EditorStyle := vesSpinEdit;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Detector Confirmation Time (0-60 sec)' );
            iData1aEditor.LabelText := '';
            iData1Editor.OnChange := OnConfirmationTimeChange;
            with iData1Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 60;
              Value := Data1.ValueAsInt;
            end;
            iData2Editor.LabelText := Translate( 'Alarm Reset Time (1-30 mins)' );
            iData2Editor.OnChange := OnAlarmResetChange;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 30;
              Value := Data2.ValueAsInt;
            end;
          end;
          opm_Dependency_B:
          begin
            iData1Editor.EditorStyle := vesCheckbox;
            iData1aEditor.EditorStyle := vesSpinEdit;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Same Input Group' );
            iData1Editor.OnChange := OnSameInputGroupChange;
            iData1aEditor.LabelText := Translate( 'Detector Inhibit Time(1-5 mins)' );
            iData1aEditor.OnChange := OnDetectorInhibitTimeChange;
            iData2Editor.LabelText := Translate( 'Alarm Reset Time (1-30 mins)' );
            iData2Editor.OnChange := OnAlarmResetChange;
            with iData1Editor.EditorAsCheckBox do
            begin
              Checked := SameInputGroup;
            end;
            with iData1aEditor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 5;
              Value := DetectorInhibitTime;
            end;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 30;
              Value := Data2.ValueAsInt;
            end;
          end;
          opm_Investigation:
          begin
            iData1Editor.EditorStyle := vesSpinEdit;
            iData1aEditor.EditorStyle := vesNone;
            iData2Editor.EditorStyle := vesSpinEdit;
            iData1Editor.LabelText := Translate( 'Input Delay (0-300 sec)' );
            iData1aEditor.LabelText := '';
            iData1Editor.OnChange := OnInputDelayChange;
            with iData1Editor.EditorAsSpinEdit do
            begin
              MinValue := 0;
              MaxValue := 300;
              Value := Data1.ValueAsInt;
            end;
            iData2Editor.LabelText := Translate( 'Investigation Delay (1-10 mins)' );
            iData2Editor.OnChange := OnInvestigationDelayChange;
            with iData2Editor.EditorAsSpinEdit do
            begin
              MinValue := 1;
              MaxValue := 10;
              Value := Data2.ValueAsInt;
            end;
          end;
        end;
      end;
      igs_Switch:
      begin
        iData1Editor.EditorStyle := vesNone;
        iData1aEditor.EditorStyle := vesNone;
        iData2Editor.EditorStyle := vesNone;
        iData1Editor.LabelText := '';
        iData1aEditor.LabelText := '';
        iData2Editor.LabelText := '';
      end;
      igs_AND:
      begin
        iData1Editor.EditorStyle := vesSpinEdit;
        iData1aEditor.EditorStyle := vesNone;
        iData2Editor.EditorStyle := vesSpinEdit;
        iData1Editor.LabelText := Translate( 'Count for Partial ON' );
        iData1aEditor.LabelText := '';
        iData1Editor.OnChange := OnANDPartialActivationCountChange;
        with iData1Editor.EditorAsSpinEdit do
        begin
          MinValue := fANDPartialActivationCount.MinVal;
          MaxValue := fANDPartialActivationCount.MaxVal;
          Value := fANDPartialActivationCount.ValueAsInt;
        end;
        iData2Editor.LabelText := Translate( 'Count for Full ON' );
        iData2Editor.OnChange := self.OnANDFullActivationCountChange;
        with iData2Editor.EditorAsSpinEdit do
        begin
          MinValue := fANDFullActivationCount.MinVal;
          MaxValue := fANDFullActivationCount.MaxVal;
          Value := fANDFullActivationCount.ValueAsInt;
        end;
      end;
    end;
  end;
end;

