procedure tLoopDevices.OnNameEditorChange(Sender: tObject);
var
  iSubDevice : integer;
  iDevice : integer;
  iDeviceObject : tLoopDevice;
  iSubDeviceObject : tLoopSubDevice;
  iDuplicateName : boolean;
begin
  if assigned( fSubDeviceNameEditor ) and assigned( fSubDeviceEditor) then
  begin
    GroupUndoActive := TRUE;
    try
      // first we must decide if data has changed or we are just setting up
      case DeviceEditMode of
        demNotDefined,
        demDevices:
        begin
          exit;
        end;
        demDeviceEntries:
        begin
          iSubDevice := fSubDeviceEditor.TabIndex;
          if iSubDevice < 0 then
          begin
            iSubdevice := 0;
          end;
          iDevice := fDeviceEditCurrent.First;
          iDeviceObject := VisibleLoopDevice[ iDevice - 1 ];
          if assigned( iDeviceObject ) then
          begin
            // we assume no non-fitted devices available to edit, so se if
            // description has really changed
            //if iDeviceObject.SubDevice[ iSubDevice ].Name.Value <> SubDeviceNameEditor.Text then
            if fNameEditorText <> SubDeviceNameEditor.Text then
            begin
              // here we want to update even if only case sensitivity changed
              iDeviceObject.SubDevice[ iSubDevice ].Name.Value := SubDeviceNameEditor.Text;
              if iSubDevice = 0 then
              begin
                iDuplicateName := DuplicateDeviceName( iDeviceObject );
              end
              else
              begin
                iDuplicateName := DuplicateSubDeviceName( iDeviceObject.SubDevice[ iSubDevice ] );
              end;
              iDevice := fDeviceEditCurrent.Next;
              while iDevice >= 0 do
              begin
                iDeviceObject := VisibleLoopDevice[ iDevice - 1 ];
