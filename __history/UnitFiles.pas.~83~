procedure tZFPGlobalObject.ImportShareData(const pNode: tZFPNode;
  const pData: tStringList; const pLine: integer; const pErrors: tErrorList;
  const pErrorObject: tObject);
var
  iVal, i : integer;
begin
  // all records that are shared share the same data. For some, sharing is not important
  //
  // pData is a list of fields
  // [0] = record type and must match pRecType
  // [1] = ID
  // [2] = Name
  // [3] = Disablement Group (which can be zero)
  // [4] onwards is a list of panels that share this ID
  //
  // This analyses a single record.
  // pData[ 0 ] to pData[ 3 ] will have been analysed at a higher level
  // in order to get this far. We simply add the disablement group
  // and add any share data. If we are adding to a registration we ignore
  // conflicts (because we can't tell if they are genuine). We can check
  // if any entries are missing, but for the moment, we don't.
  // Therefore the only errors we detect are missing disablement group column
  // column and syntax errors.

  try
    iVal := StrToInt( pData[ 3 ] );
    DisablementTrigger.InputGroup := ZFPFile.InputObjectWithID( iVal );
  except
    pErrors.Add( es_Error, pLine, 3, Translate( 'Syntax Error' ), self );
  end;
  UnregisterAllNodes;
  RegisterNode( pNode );
  for i := 4 to pData.Count - 1 do
  begin
    try
      iVal := StrToInt( pData[ i ] );
      RegisterNode( iVal );
    except
      pErrors.Add( es_Error, pLine, i, Translate( 'Syntax Error' ), self );
    end;
  end;
end;

