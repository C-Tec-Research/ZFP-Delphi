procedure tOutputGroup.ImportFile(const pFile: tStrings; var iIndex: integer; const pNode : tZFPNode;  //JG LM&RC
  const pList : tStrings; const pErrors: tErrorList; const pErrorObject: tObject);
var
  iErrText : string;
begin
  if pList[ 0 ] <> ExportPrefix then
  begin
    iErrText := Translate( 'incorrect record type') + ' "' + pList[0] + '"';
    pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
  end;
  if pList[ 2 ] = '1' then
  begin
    Silenceable.ValueAsBool := TRUE;
  end
  else
  begin
    Silenceable.ValueAsBool := FALSE;
  end;
  if pList[ 3 ] = '1' then
  begin
    NormOnReset.ValueAsBool := TRUE;
  end
  else
  begin
    NormOnReset.ValueAsBool := FALSE;
  end;
  if pList[ 4 ] = '1' then
  begin
    SendToDRAX.ValueAsBool := TRUE;
  end
  else
  begin
    SendToDRAX.ValueAsBool := FALSE;
  end;
  if pList.Count > 5 then
  begin
    if pList[ 5 ] = '1' then
    begin
      LimpMode.ValueAsBool := TRUE;
    end
    else
    begin
      LimpMode.ValueAsBool := FALSE;
    end;
    if pList[ 6 ] = '1' then
    begin
      RemoteControl.ValueAsBool := TRUE;
    end
    else
    begin
      RemoteControl.ValueAsBool := FALSE;
    end;
  end;
end;

