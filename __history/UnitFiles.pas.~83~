begin
  inherited;
  if pToEditor = fFieldEditor then
  begin
    fFieldSoundEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fFieldSoundEditor ) then
    begin
      fFieldSoundEditor.EditorStyle := vesComboBox;
