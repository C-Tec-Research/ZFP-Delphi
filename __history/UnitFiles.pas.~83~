procedure tZFPNodeList.Sort;
begin
  Sort( 0, Max );
end;

procedure tZFPNodeList.Sort(const pFrom, pTo: integer);
var
  iMid : integer;
  iLo, iHi, iTest : integer;
begin
  // heap sort
  (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := TRUE;
  try
  if pFrom >= pTo then
  begin
    //done
    exit;
  end;
  iLo := pFrom;
  iHi := pTo;
  iMid := (pFrom + pTo) div 2;
  iTest := Node[ iMid ].ID;
  while True do
  begin
    while iLo < iMid do
    begin
      if Node[iLo].ID > iTest then
      begin
        break;
      end;
      inc( iLo );
    end;
    while iHi > iMid do
    begin
      if Node[iHi].ID < iTest then
      begin
        break;
      end;
      dec( iHi );
    end;
    if iHi = iLo then
    begin
      // we have met in the middle - this is definitely the centre value
      Sort( pFrom, iMid - 1 );
      Sort( iMid + 1, pTo );
      exit;
    end;
    // else, swap them
    inherited Swap( iLo, iHi );
    if iLo = iMid then
    begin
      // new 'centre'. Must be less than it was before, so need to reset iLo and iTest, but not iHi
      iLo := pFrom;
      iTest := Node[ iMid ].ID;
    end
    else if iHi = iMid then
    begin
      // new 'centre'. Must be more than it was before, so need to reset iHi and iTest, but not iLo
      iHi := pTo;
      iTest := Node[ iMid ].ID;
    end;
  end;
  finally
    (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := FALSE;
  end;
end;

