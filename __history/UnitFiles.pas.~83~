  // create copies of all selected input groups as output groups
  UndoRedo.GroupUndoActive := TRUE;
  try
    with CauseAndEffects do
    begin
      with InputGroups do
      begin
        with EditorFrame as TFrameInputGroupEditor do
        begin
          with SigGeneralGridGlobal do
          begin
            for i := 1 to RowCount do
