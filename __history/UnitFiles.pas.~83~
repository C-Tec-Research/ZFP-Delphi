function tZFPGlobalArray.DuplicateID(pGlobalObject: tZFPGlobalObject): boolean;
var
  i: Integer;
  iGlobalObject : tZFPGlobalObject;
begin
  // a bit more complicated than you might think.
  // A sibling may have the same ID provided it is not on the same panel as
  // any panel that the child exists on.
  for i := 0 to Max do
  begin
    iGlobalObject := GlobalObject[ i ];
    if iGlobalObject <> pGlobalObject  then
    begin
      if iGlobalObject.ID.ValueAsInt = pGlobalObject.ID.ValueAsInt then
      begin
        if iGlobalObject.NodesWhereUsed.SharesNodes( pGlobalObject.NodesWhereUsed ) then
        begin
          Result := TRUE;
          exit;
        end;
      end;
    end;
  end;
  // else
  Result := FALSE;
end;

function tZFPGlobalArray.DuplicateName(pGlobalObject: tZFPGlobalObject): boolean;
var
  i : integer;
  iName : string;
  iGlobalObject : tZFPGlobalObject;
begin
  iName := pGlobalObject.Name;
  for i := 0 to Max do
  begin
    iGlobalObject := GlobalObject[ i ];
    if iGlobalObject <> pGlobalObject then
    begin
      if SameText( iName, iGlobalObject.Name ) then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
  Result := FALSE;
end;

