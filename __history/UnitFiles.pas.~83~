procedure tLoopSubDevices.ImportDeviceFieldsFile( const pList: tStrings; const pLoopID : integer);
var
  iFieldArray : tFieldArray;
  i: Integer;
begin
  // pList already populated
  // pList [0-2] already verified
  // pList[ 3 ] is the device type
  // pList[ 4 - 33 ] are bytes [2-31] of iFieldArray
  iFieldArray.Zero;

  i := StrToInt( pList[ 3 ] );
  iFieldArray[ 0 ] := i mod 256;
  iFieldArray[ 1 ] := i div 256;

  for i := 2 to 31 do
  begin
    iFieldArray.Data[ i ] := StrToInt( pList[ i + 2 ] );
  end;
  // we have the data back - decode it.
  if pLoopID = Loop.LoopAddress.ValueAsInt then
  begin
    SubDevice[ 0 ].ImportDeviceFieldsFile( iFieldArray );
  end;
  if pLoopID = Loop.SubLoopAddress.ValueAsInt then
  begin
    for i := 1 to Max do
    begin
      SubDevice[ i ].ImportDeviceFieldsFile( iFieldArray );
    end;
  end;
end;

procedure tLoopSubDevices.ImportNamesFile(const pFile: tStrings;
  var pLine: integer; const pList: tStrings; const pErrors : tErrorList;
  const pErrorObject : tObject );
var
  iSubdevice: Integer;
  jSubdevice : tLoopSubDevice;
  iErrText : string;
begin
  // pList already populated
  // pList [0-2] already verified
  // pList[ 3 ] is the subdevcie
  // pList[ 4 ] is the name
  iSubdevice := StrToInt( pList[ 3 ] );
  jSubdevice := SubDevice[ iSubdevice ];
  if assigned( jSubdevice ) then
  begin
    jSubdevice.Name.Value := pList[ 4 ];
  end
  else if pList[ 4 ] <> '' then
  begin
    iErrText := Translate( 'Attempting to name non-existant sub-device');
    pErrors.Add( tErrorSeverity.es_Error, pLine - 1, 3, iErrText, pErrorObject);
  end;
end;

procedure tLoopSubDevices.ImportSubDeviceFieldsFile(const pList: tStrings);
var
  iFieldArray : tFieldArray;
  i: Integer;
  iSubdevices : tSubDeviceList;
  iSubdevice : tSubDevice;
  iDevice : tDevice;
  iRef : integer;
  iSubDeviceIndex : integer;
  iField : tDeviceField;
  iLoopSubdevice : tLoopSubdevice;
begin
  // pList already populated
  // pList [0-2] already verified
  // pList[ 3 ] is the device type
  // pList[ 4 - 33 ] are bytes [2-31] of iFieldArray
  iFieldArray.Zero;

  i := StrToInt( pList[ 3 ] );
  iFieldArray[ 0 ] := i mod 256;
  iFieldArray[ 1 ] := i div 256;

  for i := 2 to 31 do
  begin
    iFieldArray.Data[ i ] := StrToInt( pList[ i + 2 ] );
  end;
  // we have the data back - decode it.
  // Now embedded in the field information is the subdevice number
  // Unlike conventional devices there is a separate record for each
  // subdevice.
  iDevice := Device.Protocol.DeviceList.DeviceWithMapping[ Device.DeviceMap ];
  iSubdevices := iDevice.SubDevices;
  if iSubdevices.Max > 1 then
  begin
    iRef := iSubdevices.SubunitOfType( StrToInt( pList[ 3 ]) );
  end
  else
  begin
    iRef := 1;
  end;

  iSubDevice := iSubdevices.SubDevice[ iRef ];
  // The subdevice is in field with editor es_Link_Count
  for i := 0 to iSubDevice.FieldList.Max do
  begin
    iField := iSubDevice.FieldList.DeviceField[ i ];
    case iField.DeviceFieldEditorStyle of
      es_None, es_Mask_Edit, es_Drop_Down, es_Drop_Down_List,
      es_Image_List, es_Spin_Edit, es_Drop_Down_Image_List,
      es_Zone,
      es_IO_Group,
      es_Target_Group,
      es_Isolation_Group,
      es_Fault_Group: ;
      es_Link_Address:
      begin
        // this is the device associated with this record; We already know that
      end;
      es_Link_Count:
      begin
        // This is the port, which in our terms is the subdevice offset by 1.
        iSubDeviceIndex :=  iFieldArray.GetBits( iField.Location[ 0 ], iField.Length.ValueAsInt) + 1;
        iLoopSubdevice := Subdevice[ iSubDeviceIndex ];
        iLoopSubdevice.Ref.ValueAsInt := iRef;
        case iLoopSubdevice.PermittedIOType of
          sdt_Input: ;
          sdt_Output: ;
          sdt_User_Selectable:
          begin
            iLoopSubdevice.IOType := iSubdevice.SubDeviceTypeVal;
          end;
          sdt_Other: ;
          sdt_Not_Fitted: ;
        end;
        // we can now import like a device
        iLoopSubdevice.ImportDeviceFieldsFile( iFieldArray );
        exit; // must exit as field list may have changed.
      end;
    end;

  end;
end;

