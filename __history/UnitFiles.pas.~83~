procedure tLoopDevices.AdjustRangeToExcludeEmptyDevices( const pUndoing : boolean );
var
  iDeviceEditCurrent : tDSMList;
  iVisibleDeviceIndex : integer;
  iDeviceIndex : integer;
  iDevice : tLoopDevice;
  iSaveUndoing : boolean;
Label
  iLoop;
begin
  iSaveUndoing := AmUndoing;
  AmUndoing := pUndoing;
  try
    iDeviceEditCurrent := -1;
    iDeviceIndex := fDeviceEditCurrent.First;
    //while iDeviceIndex > 0 do
    while (iDeviceIndex > 0) And (iDeviceIndex <= Loop.MaxDevicesOnCurrentLoop) do //BUG0000046
    begin
      if LoopDevice[ iDeviceIndex - 1 ].IOType <> sdt_Not_Fitted then
      begin
        break;
      end;
      iDeviceIndex := fDeviceEditCurrent.Next;
    end;
    if iDeviceIndex >= 0 then
    begin
      iDevice := LoopDevice[ iDeviceIndex - 1 ];
      for iVisibleDeviceIndex := 0 to VisibleDeviceCount - 1 do
      begin
        if VisibleLoopDevice[ iVisibleDeviceIndex ] = iDevice then
        begin
          iDeviceEditCurrent := iDeviceEditCurrent + (iVisibleDeviceIndex + 1);
  iLoop:
          iDeviceIndex := fDeviceEditCurrent.Next;
          if iDeviceIndex < 0 then
          begin
            //done
            fDeviceEditCurrent.Value := iDeviceEditCurrent;
            exit;
          end
          else
          begin
            iDevice := LoopDevice[ iDeviceIndex - 1 ];
            if iDevice.IOType = sdt_Not_Fitted then
            begin
              goto iLoop;
            end;
          end;
        end;
      end;
    end;
    fDeviceEditCurrent.Value := iDeviceEditCurrent;
  finally
    AmUndoing := iSaveUndoing;
  end;
end;

procedure tLoopDevices.AdjustRangeToIncludeEmptyDevices( const pUndoing : boolean );
var
  iDeviceEditCurrent : tDSMList;
  iVisibleDeviceIndex : integer;
  iDeviceIndex : integer;
  iVisibleDevice : tLoopDevice;
  iSaveUndoing : boolean;
begin
  iSaveUndoing := AmUndoing;
  AmUndoing := pUndoing;
  try
    iDeviceEditCurrent := -1;
    iVisibleDeviceIndex := fDeviceEditCurrent.First;
    if iVisibleDeviceIndex >= 0 then
    begin
      iVisibleDevice := VisibleLoopDevice[ iVisibleDeviceIndex - 1 ];
      for iDeviceIndex := 0 to Max do
      begin
        if LoopDevice[ iDeviceIndex ] = iVisibleDevice then
        begin
          iDeviceEditCurrent := iDeviceEditCurrent + (iDeviceIndex + 1);
          iVisibleDeviceIndex := fDeviceEditCurrent.Next;
          if iVisibleDeviceIndex < 0 then
          begin
            //done
            fDeviceEditCurrent.Value := iDeviceEditCurrent;
            exit;
          end
          else
          begin
            iVisibleDevice := VisibleLoopDevice[ iVisibleDeviceIndex - 1 ];
          end;
        end;
      end;
    end;
    fDeviceEditCurrent.Value := iDeviceEditCurrent;
  finally
    AmUndoing := iSaveUndoing;
  end;
end;

function tLoopDevices.AllSelectedDevicesSame: boolean;
var
  iDevice : tLoopDevice;
  iMap : integer;
  iIndex : integer;
begin
  iIndex := fDeviceEditCurrent.First;
  Result := TRUE;
  if iIndex < 0 then
  begin
    exit;
  end
  else
  begin
    //iDevice := nil;
    case DeviceEditMode of
      demNotDefined:
      begin
        exit;
      end;
      demDevices:
      begin
        exit;
      end;
      demDeviceEntries:
      begin
        iDevice := VisibleLoopDevice[ iIndex - 1 ];
      end;
      demSubDeviceEntries:
      begin
        iDevice := VisibleLoopSubdevice[ iIndex ].Device;
        if not assigned( iDevice ) then
        begin
          exit;
        end;
      end;
      else
      begin
        exit;
      end;
    end;
    if assigned( iDevice ) then
    begin
      iMap := iDevice.DeviceMap.ValueAsInt;
    end
    else
    begin
      exit;
    end;
  end;
  iIndex := fDeviceEditCurrent.Next;
  while iIndex >= 0 do
  begin
    //iDevice := nil;
    case DeviceEditMode of
      demNotDefined:
      begin
        exit;
      end;
      demDevices:
      begin
        exit;
      end;
      demDeviceEntries:
      begin
        iDevice := VisibleLoopDevice[ iIndex - 1 ];
      end;
      demSubDeviceEntries:
      begin
        iDevice := VisibleLoopSubdevice[ iIndex ].Device;
      end;
      else
      begin
        exit;
      end;
    end;
    if assigned(iDevice) then
    begin
      if iDevice.DeviceMap.ValueAsInt <> iMap then
      begin
        result := FALSE;
        exit;
      end;
    end;
    iIndex := fDeviceEditCurrent.Next;
  end;
end;

procedure tLoopDevices.BuildNameEditor;
var
  i : integer;
  iVisible : boolean;
  iSubDevice : integer;
  iDevice : tLoopDevice;
  iSubDeviceObject : tLoopSubDevice;
  iDuplicateName : boolean;
  iConflict : boolean;
  iActualIOTypeConflict : boolean;
  iPermittedIOValue : tSubDeviceType;
  iPermittedIOTypeConflict : boolean;
  iDeviceType : string;
  iDeviceTypeConflict : boolean;
begin
  // fDeviceEditCurrent stores all current devices
  iVisible := FALSE;
  iConflict := FALSE;
  iDuplicateName := FALSE;
  iPermittedIOValue := sdt_Not_Fitted;
  iPermittedIOTypeConflict := TRUE;
  fActualIOValue := sdt_Not_Fitted;
  iActualIOTypeConflict := TRUE;   // to short circuit loops when not used
  iDeviceTypeConflict := TRUE;
  iDeviceType := ChevronText( 'Unknown' );
  if assigned( fSubDeviceNameEditor ) and assigned( fSubDeviceEditor) then
  begin
    case DeviceEditMode of
      demNotDefined: ;
      demDevices: ;
      demDeviceEntries:
      begin
        //iVisible := TRUE; // assume OK
        //iPagerTextVisible := TRUE;
        iSubDevice := fSubDeviceEditor.TabIndex;
        if iSubDevice < 0 then
        begin
          iSubdevice := 0;
        end;
        iDuplicateName := FALSE;
        iConflict := FALSE;
        iDeviceTypeConflict := FALSE;
        case fDeviceEditCurrent.Count of
          0: // nothing to edit
          begin
            fNameEditorText := '';
            iVisible := FALSE;
          end;
          else
          begin
            i := fDeviceEditCurrent.First;
            iDeviceTypeConflict := FALSE;
            if i < 0 then
            begin
              iVisible := FALSE;
            end
            else
            begin
              iDevice := VisibleLoopDevice[ i - 1 ];
              if assigned( iDevice ) then
              begin
                iSubDeviceObject := iDevice.SubDevice[ iSubDevice ];
                if assigned( SubDeviceIOTypeEditor ) then
                begin
                  //SetSubDeviceIOEditorText( iSubDeviceObject.IOType.ValueAsText );
                  fSubDeviceIOTypeEditor.ItemIndex := Ord( iSubDeviceObject.IOType );
                //iDeviceObject.SubDevice[ iSubDevice ].IOType.ValueAsInt := Ord( iActualIOValue );
                  iPermittedIOValue := iSubDeviceObject.PermittedIOType; //  iDevice.PermittedIOType;
                  // iActualIOValue := iDevice.IOType;
                  iPermittedIOTypeConflict := FALSE;
                  iActualIOTypeConflict := FALSE;
                end;
                iVisible := TRUE;
                fNameEditorText := iSubDeviceObject.Name.Value;
                if iSubdevice = 0 then
                begin
                  if DuplicateDeviceName( iDevice ) then
                  begin
                    iDuplicateName := TRUE;
                  end;
                end
                else if DuplicateSubDeviceName( iDevice.SubDevice[ iSubDevice ] ) then
                begin
                  iDuplicateName := TRUE;
                end;
                iDeviceType := iDevice.DeviceMap.ValueAsText;
                i := fDeviceEditCurrent.Next;
                while i >= 0 do
                begin
                  iDevice := VisibleLoopDevice[ i - 1 ];
                  if assigned( iDevice ) then
                  begin
                    if iDevice.IOType <> sdt_Not_Fitted then
                    begin
                      iSubDeviceObject := iDevice.SubDevice[ iSubDevice ];
                      if not iConflict then
                      begin
                        if not (SameText( fNameEditorText, iSubDeviceObject.Name.Value )) then
                        begin
                          iConflict := TRUE;
                        end;
                      end;
                      if (not iActualIOTypeConflict) and (fActualIOValue <> iSubDeviceObject.IOType) then
                      begin
                        iActualIOTypeConflict := TRUE;
                      end;
                      if (not iPermittedIOTypeConflict) and (iPermittedIOValue <> iSubDeviceObject.PermittedIOType) then
                      begin
                        iPermittedIOTypeConflict := TRUE;
                      end;
                      if (not iDeviceTypeConflict) and not SameText( iDeviceType, iDevice.DeviceMap.ValueAsText) then
                      begin
                        iDeviceTypeConflict := TRUE;
                      end;
                      if iConflict and iPermittedIOTypeConflict and iActualIOTypeConflict and iDeviceTypeConflict then
                      begin
                        break;
                      end;
                    end;
                  end;
                  i := fDeviceEditCurrent.Next;
                end;
              end
              else
              begin
                Visible := FALSE;
              end;
            end;
          end;
        end;
      end;
      demSubDeviceEntries:
      begin
        iVisible := TRUE; // assume OK
        iDuplicateName := FALSE;
        iConflict := FALSE;
        iDeviceTypeConflict := FALSE;
        case fDeviceEditCurrent.Count of
          0: // nothing to edit
          begin
            fNameEditorText := '';
            iVisible := FALSE;
          end;
          else
          begin
            i := fDeviceEditCurrent.First;
            if i < 0 then
            begin
              iVisible := FALSE;
            end
            else
            begin
              iSubDeviceObject := VisibleLoopSubDevice[ i ];
              if assigned( SubDeviceIOTypeEditor ) then
              begin
                //SetSubDeviceIOEditorText( iSubDeviceObject.IOType.ValueAsText );
                fSubDeviceIOTypeEditor.ItemIndex := Ord( iSubDeviceObject.IOType );
              end;
              fNameEditorText := iSubDeviceObject.Name.Value;
              iDeviceType := iSubDeviceObject.Device.DeviceMap.ValueAsText;
              if DuplicateSubDeviceName( iSubDeviceObject ) then
              begin
                iDuplicateName := TRUE;
              end;
              if assigned( SubDeviceIOTypeEditor ) then
              begin
                //SubDeviceIOTypeEditor.Text := iSubDeviceObject.IOType.ValueAsText;
                SubDeviceIOTypeEditor.ItemIndex := Ord( iSubDeviceObject.IOType );
                fActualIOValue := iSubDeviceObject.IOType;
                iPermittedIOTypeConflict := FALSE;
                iActualIOTypeConflict := FALSE;
                iPermittedIOValue := iSubDeviceObject.PermittedIOType;
              end;
              i := fDeviceEditCurrent.Next;
              while i >= 0 do
              begin
                iSubDeviceObject := VisibleLoopSubDevice[ i ];
                if iSubDeviceObject.Device.IOType <> sdt_Not_Fitted then
                begin
                  if not SameText( fNameEditorText, iSubDeviceObject.Name.Value ) then
                  begin
                    iConflict := TRUE;
                  end;
                  if (not iActualIOTypeConflict) and (fActualIOValue <> iSubDeviceObject.IOType) then
                  begin
                    iActualIOTypeConflict := TRUE;
                  end;
                  if (not iPermittedIOTypeConflict) and (iPermittedIOValue <> iSubDeviceObject.PermittedIOType) then
                  begin
                    iPermittedIOTypeConflict := TRUE;
                  end;
                  if (not iDeviceTypeConflict) and (not SameText( iDeviceType, iSubDeviceObject.Device.DeviceMap.ValueAsText )) then
                  begin
                    iDeviceTypeConflict := TRUE;
                  end;
                  if iConflict and iPermittedIOTypeConflict and iActualIOTypeConflict and iDeviceTypeConflict then
                  begin
                    break;
                  end;
                end;
                i := fDeviceEditCurrent.Next;
              end;
            end;
          end;
        end;
      end;
    end;
    {
      Now decide on font. The situations we want to describe are:
      Selection contains elements with duplicate names
      Name is not extensible if more than one entry selected.
      Selection contains incompatible entries
      Normal is black on white background.
      Incompatible entries is a light grey background.
      Non extensible names effectively will be bold red until an extensible
      name is entered. Extensible names are shown bold black itallic unless they
      give a duplicate result.
      Duplicate names are shown red itallic bold.
      As soon as a new name is entered, the background should become
      white, since incompatibilities will be removed
    }
    with SubDeviceNameEditor do
    begin
      Visible := iVisible;
      if iVisible then
      begin
        if iConflict then
        begin
          Color := clSilver;
        end
        else
        begin
          Color := clWindow;
        end;
        if iDuplicateName then
        begin
          Font.Color := clRed;
          Font.Style := [ fsBold, fsItalic ];
        end
        else
        begin
          Font.Color := clWindowText;
          if fDeviceEditCurrent.Count > 1 then
          begin
            Font.Style := [fsBold ];
          end
          else
          begin
            Font.Style := [ ];
          end;
        end;
        Text := fNameEditorText;
      end;
    end;
    if assigned( SubDeviceNameLabel ) then
    begin
      with SubDeviceNameLabel do
      begin
        Visible := iVisible;
      end;
    end;
    // with the type editor there are two fields to consider -
    // the subdevice permitted IO value and the subdevice actual IO value
    // If there is a Permitted IO conflict, don't show the editor
    // If no Permitted IO conflict, show the editor. If it is type
    // sdt_User_Select then enable it, otherwise disable it.
    // If there is an IO conflict and it is visible then show red
    // whether enabled or not
    if assigned( SubDeviceIOTypeEditor ) and assigned( SubDeviceIOTypeLabel ) then
    begin
      with SubDeviceIOTypeEditor do
      begin
        if iPermittedIOTypeConflict then
        begin
          Visible := FALSE;
          SubDeviceIOTypeLabel.Visible := FALSE;
        end
        else
        begin
          Visible := TRUE;
          SubDeviceIOTypeLabel.Visible := TRUE;
          case iPermittedIOValue of
            sdt_User_Selectable:
            begin
              Visible := TRUE;
              Enabled := TRUE;
              SubDeviceIOTypeLabel.Visible := TRUE;
              SubDeviceIOTypeLabel.Enabled := TRUE;
            end;
            sdt_Other:
            begin
              Visible := FALSE;
              SubDeviceIOTypeLabel.Visible := FALSE;
            end;
            else
            begin
              Visible := TRUE;
              Enabled := FALSE;
              SubDeviceIOTypeLabel.Enabled := FALSE;
            end;
          end;
          if iActualIOTypeConflict then
          begin
            Font.Color := clRed;
            Font.Style := [ fsBold, fsItalic ];
          end
          else
          begin
            Font.Color := clWindowText;
            Font.Style := [];
          end;
        end;
      end;
    end;
  end;
  if assigned( SubDeviceTypeEditor ) then
  begin
    with SubDeviceTypeEditor do
    begin
      if iDeviceTypeConflict then
      begin
        Text := ChevronText( 'Various' );
        Font.Color := clRed;
        Font.Style := [ fsBold, fsItalic ];
      end
      else
      begin
        Text := iDeviceType;
        Font.Color := clWindowText;
        Font.Style := [];
      end;
    end;
  end;
end;

procedure tLoopDevices.BuildSubDeviceEditor;
var
  i, j, iMinSDCount, iMaxSDCount, iCurrent : integer;
  iDevice : tLoopDevice;
  iDevice2 : tDevice;
  iSubDevice : tSubdevice;
  iText, iText2 : string;
begin
  if assigned( fSubDeviceEditor ) then
  begin
    case DeviceEditMode of
      demNotDefined: ;
      demDevices: ;
      demDeviceEntries:
      begin
        //fSubDeviceEditor.Tabs.Clear;
        // Are we are editing multiple devices?
        iMinSDCount := -1;
        iMaxSDCount := -1;
        case fDeviceEditCurrent.Count of
          0: // nothing to edit
          begin
            SetSubDeviceEditorState( FALSE );
          end;
          else
          begin
            i := fDeviceEditCurrent.First;
            while i > 0 do
            begin
              iDevice := VisibleLoopDevice[ i - 1 ];
              if assigned( iDevice ) then
              begin
                if iDevice.IOType <> sdt_Not_Fitted then
                begin
                  iCurrent := iDevice.SubDevices.Max;
                  if iCurrent > iMaxSDCount then
                  begin
                    iMaxSDCount := iDevice.SubDevices.Max;
                  end;
                  if iMinSDCount < 0 then
                  begin
                    iMinSDCount := iMaxSDCount;
                  end
                  else if iCurrent < iMinSDCount then
                  begin
                    iMinSDCount := iCurrent;
                  end;
                end;
              end;
              // build common fields
              i := fDeviceEditCurrent.Next;
            end;
            if iMinSDCount < 0 then
            begin
              SetSubDeviceEditorState( FALSE );
            end
            else
            begin
              SetSubDeviceEditorState( TRUE, TRUE );
            end;
            if iMaxSDCount < (fSubDeviceEditor.Tabs.Count - 1) then
            begin
              fSubDeviceEditor.Tabs.Clear;
            end;
            if iMaxSDCount > 0 then
            begin
              if AllSelectedDevicesSame then
              begin
                {
                  There are 2 situations here
                  if UseVariableSubdevices is FALSE, then the subdevice count
                    matches the cfg file and the names are used from there
                    ('The old way')
                  if UseVariableSubdevices is TRUE, then we just use the index
                }
                iDevice := VisibleLoopDevice[ fDeviceEditCurrent.First - 1 ];
                iDevice2 := iDevice.Device;
                if fSubDeviceEditor.Tabs.Count < 1 then
                begin
                  fSubDeviceEditor.Tabs.Add( Translate( 'Device' ));
                end
                else
                begin
                  fSubDeviceEditor.Tabs[ 0 ] := Translate( 'Device' );
                end;
                for i := 1 to iMaxSDCount do
                begin
                  if iDevice.UseVariableSubdevices then
                  begin
                    iText := '';
                    for j := 1 to iDevice2.SubDevices.Max do
                    begin
                      iSubDevice := iDevice2.SubDevices.SubDevice[ j ];
                      iText2 := iSubDevice.VariableSubDeviceName[ i ];
                      if iText2 <> '' then
                      begin
                        if iText = '' then
                        begin
                          iText := iText2;
                        end
                        else if iText <> iText2 then
                        begin
                          iText := ''; // conflict - revert to standard text
                          break;
                        end;
                      end;
                    end;
                  end
                  else
                  begin
                    iSubDevice := iDevice2.SubDevices.SubDevice[ i ];
                    iText := iSubDevice.SubDeviceName.Value;
                  end;
                  if iText = '' then
                  begin
                    iText := Translate( 'Sub-device' ) + ' ' + IntToStr( i );
                  end;
                  if i < fSubDeviceEditor.Tabs.Count then
                  begin
                    fSubDeviceEditor.Tabs[ i ] := iText;
                  end
                  else
                  begin
                    fSubDeviceEditor.Tabs.Add( iText );
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
      demSubDeviceEntries:
      begin
        fSubDeviceEditor.Tabs.Clear;
        // Are we are editing multiple sub-devices?
        case fDeviceEditCurrent.Count of
          0: // nothing to edit
          begin
            SetSubDeviceEditorState( FALSE );
          end;
          else
          begin
            SetSubDeviceEditorState( TRUE, TRUE );
          end;
        end;
      end;
    end;
  end;
end;

