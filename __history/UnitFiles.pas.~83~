  iIndexText : string;
begin
  if pIndexText = '' then
  begin
    iIndexText := IntToStr( Max + 1 );
  end
  else
  begin
    iIndexText := pIndexText;
  end;
  if SameText( pPropertyText, tInputGroup.ClassType + ' Item') then
  begin
    Result := tInputGroup.Create( 'Item', iIndexText, self );
    Result.Value := pValue;
  end
  else if SameText( pPropertyText, 'Item') then
  begin
    Result := TInputGroup.Create( 'Item', iIndexText, self );
    Result.Value := pValue;
  end
  else
  begin
    Result := inherited CreateChild( pPropertyText, iIndexText, pValue, pComment, pErrors, pErrorLine, pErrorPos );
  end;
end;

