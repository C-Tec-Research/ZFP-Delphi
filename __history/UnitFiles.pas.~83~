procedure tCETreeEmptyView.OnTreeView1Changing(Sender: TObject; Node: TTreeNode;
  var AllowChange: Boolean);
var
  iFromTreeProperty : tCETreeProperty;
  iToTreeProperty : tCETreeProperty;
  iNodeFrom : TTreeNode;
  i: Integer;
begin
  if assigned( fTreeView1 ) then
  begin
    iNodeFrom := fTreeView1.Selected;
    if assigned( iNodeFrom ) then
    begin
      iFromTreeProperty := tCETreeProperty( iNodeFrom.Data );
    end
    else
    begin
      iFromTreeProperty := self;
    end;
    if assigned( Node ) then
    begin
      iToTreeProperty := tCETreeProperty( Node.Data );
    end
    else
    begin
      iToTreeProperty := self;
    end;
    // disconnect buttons from 'from' property. Take care if it is ourselves
    // - we do not want to set fSpeedButton to nil so cannot use the Button property
    // we must use fButtons directly
    if assigned( iFromTreeProperty ) then
    begin
      with( iFromTreeProperty ) do
      begin
        if assigned( fAddChildButton1 ) then fAddChildButton1.Button := nil;
        if assigned( fAddChildButton2 ) then fAddChildButton2.Button := nil;
        if assigned( fAddChildButton3 ) then fAddChildButton3.Button := nil;
        if assigned( fAddSibling1BeforeButton ) then fAddSibling1BeforeButton.Button := nil;
        if assigned( fAddSibling1AfterButton ) then fAddSibling1AfterButton.Button := nil;
        if assigned( fAddSibling2BeforeButton ) then fAddSibling2BeforeButton.Button := nil;
        if assigned( fAddSibling2AfterButton ) then fAddSibling2AfterButton.Button := nil;
        if assigned( fCutButton ) then fCutButton.Button := nil;
        if assigned( fCopyButton ) then fCopyButton.Button := nil;
        if assigned( fPasteButton ) then fPasteButton.Button := nil;
        if assigned( fPasteSpecialButton ) then fPasteSpecialButton.Button := nil;
        if assigned( fDeleteButton ) then fDeleteButton.Button := nil;
      end;
    end;
    if assigned( iToTreeProperty ) then
    begin
      with iToTreeProperty do
      begin
        if assigned( fAddChildButton1 ) then fAddChildButton1.Button := self.fSpeedButtonAddChild[ 1 ];
        if assigned( fAddChildButton2 ) then fAddChildButton2.Button := self.fSpeedButtonAddChild[ 2 ];
        if assigned( fAddChildButton3 ) then fAddChildButton3.Button := self.fSpeedButtonAddChild[ 3 ];
        if assigned( fAddSibling1BeforeButton ) then fAddSibling1BeforeButton.Button := self.fSpeedButtonAddSibling1Before;
        if assigned( fAddSibling1AfterButton ) then fAddSibling1AfterButton.Button := self.fSpeedButtonAddSibling1After;
        if assigned( fAddSibling2BeforeButton ) then fAddSibling2BeforeButton.Button := self.fSpeedButtonAddSibling2Before;
        if assigned( fAddSibling2AfterButton ) then fAddSibling2AfterButton.Button := self.fSpeedButtonAddSibling2After;
        if assigned( fCutButton ) then fCutButton.Button := self.fSpeedButtonCut;
        if assigned( fCopyButton ) then fCopyButton.Button := self.fSpeedButtonCopy;
        if assigned( fPasteButton ) then fPasteButton.Button := self.fSpeedButtonPaste;
        if assigned( fPasteSpecialButton ) then fPasteSpecialButton.Button := self.fSpeedButtonPasteSpecial;
        if assigned( fDeleteButton ) then fDeleteButton.Button := self.fSpeedButtonDelete;
        CheckButtonsStatus;
        EditorList := self.fEditorList;

        //BuildEditorList;
      end;
    end;

  end;
end;

