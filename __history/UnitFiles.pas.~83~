function tCETreeProperty.CheckValid(const pErrors: tErrorList;
  pValidFlags: tCETreeValidFlags): boolean;
var
  iHasChildren : boolean;
  i : integer;
  iError : string;
begin
  // stage 1 - add to Valid Flags flags
  pValidFlags := pValidFlags + ValidFlags;
  iHasChildren := FALSE;
  Result := TRUE;
  for i := 0 to Children.Count - 1 do
  begin
    if Entry[ i ] is tCETreeProperty then
    begin
      iHasChildren := TRUE;
      if not (Entry[ i ] as TCETreeProperty).CheckValid( pErrors, pValidFlags ) then
      begin
        Result := FALSE;
      end;
    end;
  end;
  // add Errors
  if not iHasChildren then
  begin
    if not (vfInputPresent in pValidFlags) then
    begin
      Result := FALSE;
      iError := Translate( 'No Input found' );
      pErrors.Add( es_Error, 0, iError, tZFPCandEError.Create(self));
    end;
    if not (vfInputStatePresent in pValidFlags) then
    begin
      Result := FALSE;
      iError := Translate( 'No Input State found' );
      pErrors.Add( es_Error, 0, iError, tZFPCandEError.Create(self));
    end;
    if not (vfActionPresent in pValidFlags) then
    begin
      Result := FALSE;
      iError := Translate( 'No Action Sequence found' );
      pErrors.Add( es_Error, 0, iError, tZFPCandEError.Create(self));
    end;
    if not (vfOutputPresent in pValidFlags) then
    begin
      Result := FALSE;
      iError := Translate( 'No Output found' );
      pErrors.Add( es_Error, 0, iError, tZFPCandEError.Create(self));
    end;
  end;
end;

