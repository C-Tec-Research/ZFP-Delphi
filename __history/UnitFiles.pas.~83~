procedure tInputGroups.SetActiveChild(const Value: integer);
begin
  if fActiveChild <> Value then
  begin
    if (fActiveChild >= 0) and (fActiveChild <= Max) then
    begin
      with InputGroup[ fActiveChild ] do
      begin
        DefaultModalOperation.VariableListModalOverrides2 := nil;
        TabControlModalOverrides2 := nil;
        VariableListModalOverrides2 := nil;
        TabSheetModalOverride2 := nil;
        SigNETStringGridDevices := nil;
        OnOpEditorLabelClick := nil;
        OnData1LabelClick := nil;
        OnData1aLabelClick := nil;
        OnData2LabelClick := nil;
        OnCancelDelaysOnSilenceClick := nil;
        OnAutoClearOnPanelResetLabelClick := nil;
        OnOutputDelaysApplyToMPCsLabelClick := nil;
        OnMPCQualifiesDependenciesLabelClick := nil;
      end;
    end;
    inherited;
    if fActiveChild >= 0 then
    begin
      if assigned( VariableListModalOverrides2 ) then
      begin
        VariableListModalOverrides2.Visible := TRUE;
      end;
      with InputGroup[ fActiveChild ] do
      begin
        VariableListModalOverrides2 := self.VariableListModalOverrides2;
        //DefaultModalOperation.AddExtraEditors( VariableListModalOverrides );
        DefaultModalOperation.OpModeLabelText := Translate( 'Default Operation' );
        OnOpEditorLabelClick := self.fOnOpEditorLabelClick;
        OnData1LabelClick := self.fOnDefaultData1Click;
        OnData1aLabelClick := self.fOnDefaultData1aClick;
        OnData2LabelClick := self.fOnDefaultData2Click;
        OnCancelDelaysOnSilenceClick := self.fOnCancelDelaysOnSilenceClick;
        OnAutoClearOnPanelResetLabelClick := self.fOnAutoClearOnPanelResetLabelClick;
        OnMPCQualifiesDependenciesLabelClick := self.fOnMPCQualifiesDependenciesLabelClick;
        OnIGStyleCBClick := self.fOnIGStyleCBClick;
        TabControlModalOverrides2 := self.TabControlModalOverrides2;
        TabSheetModalOverride2 := self.TabSheetModalOverides2;
        SigNETStringGridDevices := self.SigNETStringGridDevices;
      end;
    end
    else
    begin
      if assigned( VariableListModalOverrides2 ) then
      begin
        VariableListModalOverrides2.Visible := FALSE;
      end;
      if assigned( TabSheetModalOverides2 ) then
      begin
        TabSheetModalOverides2.Visible := FALSE;
      end;
    end;
  end;
end;

