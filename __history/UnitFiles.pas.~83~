function tGroupPointerList.HasGroup(pGroup: tGroup): boolean;
var
  i: Integer;
begin
  for i := 0 to Max do
  begin
    if Group[ i ] = pGroup then
    begin
      Result := TRUE;
      exit;
    end;
  end;
  // else
  Result := FALSE;
end;

procedure tGroupPointerList.RemoveGroup(pGroup: tGroup);
var
  i: Integer;
begin
  (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := TRUE;
  try
    for i := 0 to Max do
    begin
      if Group[ i ] = pGroup then
      begin
        GroupPointer[ i ].Group := nil;
        Delete( i, undoDelete2 );
        exit;
      end;
    end;
  finally
    (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := FALSE;
  end;
end;

