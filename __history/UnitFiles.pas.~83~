procedure TZFPFile.ShowZoneDevices( const pZone: tZFPZone );
var
  i, j, k : integer;
  iPanel, iLoop, iDevice, iSubDev, iImage: integer;
  iSubDevice : tLoopSubDevice;
begin
  with ZoneList.EditorFrame as tFrameZoneEditor do
  begin
    if PageControlProperties.ActivePage <> TabSheetDevices then
    begin
      exit;
    end;
    OnIncludeSelectionIn := pZone.IncludeDevicesIn;
    ClearDevices;
    if not assigned(pZone ) then
    begin
      exit;
    end;
    for i := 0 to NodeList.Max do
    begin
      with NodeList.Node[ i ] do
      begin
        iPanel := ID;
        for j := 0 to LoopList.Max do
        begin
          iLoop := LoopList.Loop[ j ].LoopAddress.ValueAsInt;
          with LoopList.Loop[ j ].LoopDevices do
          begin
            for k := 1 to VisibleSubDeviceCount do
            begin
              iSubDevice := VisibleLoopSubDevice[ k ];
              if iSubDevice.Zone = pZone then
              begin
                iSubDev := StrToInt( iSubDevice.Index );
                iImage := iSubDevice.DeviceImage;
                iDevice := StrToInt( iSubDevice.Device.Index ) + 1;
                AddDevice( iPanel, iLoop, iDevice, iSubDev, iImage, iSubDevice.ExpandedName, iSubDevice );
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

