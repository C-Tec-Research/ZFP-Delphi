var
  iSubDevice : integer;
  iDevice : integer;
  iDeviceObject : tLoopDevice;
  iSubDeviceObject : tLoopSubDevice;
  iActualIOValue : tSubDeviceType;
  iRebuildRequired : boolean;
begin
  if assigned( fSubDeviceIOTypeEditor ) and assigned( fSubDeviceEditor) then
  begin
    GroupUndoActive := TRUE;
    try
      case fSubDeviceIOTypeEditor.ItemIndex of
        0: // input
        begin
          iActualIOValue := sdt_Input;
        end;
        1:
        begin
          iActualIOValue := sdt_Output;
        end;
        else
        begin
          iActualIOValue := sdt_Other;
        end;
      end;

      // first we must decide if data has changed or we are just setting up
      case DeviceEditMode of
        demNotDefined,
        demDevices:
        begin
          exit;
        end;
        demDeviceEntries:
        begin
          iSubDevice := fSubDeviceEditor.TabIndex;
          if iSubDevice < 0 then
          begin
            iSubdevice := 0;
          end;
          iDevice := fDeviceEditCurrent.First;
          iDeviceObject := VisibleLoopDevice[ iDevice - 1 ];
          if assigned( iDeviceObject ) then
          begin
            // we assume no non-fitted devices available to edit, so see if
            // IO has really changed
            iSubDeviceObject := iDeviceObject.SubDevice[ iSubDevice ];
            if fActualIOValue <> iActualIOValue then
            begin
              // changing type could change ref, so check that
              iSubDeviceObject.IOType := iActualIOValue;
              iRebuildRequired := iSubDeviceObject.IORequiresEditorRebuild;
              iDevice := fDeviceEditCurrent.Next;
              while iDevice >= 0 do
              begin
                iDeviceObject := VisibleLoopDevice[ iDevice - 1 ];
                iSubDeviceObject := iDeviceObject.SubDevice[ iSubDevice ];
