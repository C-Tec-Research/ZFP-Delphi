  iFieldArray.Zero;
  for i := 0 to Max do
  begin
    SubDevice[ i ].ExportDeviceFieldsFile2( iFieldArray, pErrors );
  end;
  iString := pString;
  for i := 2 to 31 do
  begin
    iString := iString + ',' + IntToStr( iFieldArray.Data[ i ] );
