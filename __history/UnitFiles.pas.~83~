procedure tCETreeProperty.Assign(const pFrom: tSigBaseProperty;
  const AllowUndo: boolean; const AutoSelect : boolean);
var
  i: Integer;
  iFrom : tCETreeProperty;
  iChild : tCETreeProperty;
  iFromEntry : tCETreeProperty;
begin
  if pFrom is tCETreeProperty then
  begin
    iFrom := pFrom as tCETreeProperty;
    inherited Assign( pFrom, AllowUndo );
    // copy children if they are of type tCETreeProperty
    for i := 0 to iFrom .Children.Count - 1 do
    begin
      if iFrom.Entry[ i ] is tCETreeProperty then
      begin
        iFromEntry := iFrom.Entry[ i ] as tCETreeProperty;
        iChild := nil;
        if iFromEntry is tCETreeRoot then
        begin
          if CanCreateChildOfType( tCETreeRoot ) then
          begin
            iChild := self.AddNextValidChild( tCETreeRoot, AutoSelect );
          end;
        end
        else if iFromEntry is tCETreeInputGroup then
        begin
          if CanCreateChildOfType( tCETreeInputGroup ) then
          begin
            iChild := self.AddNextValidChild( tCETreeInputGroup, AutoSelect );
          end;
        end
        else if iFromEntry is tCEInputGroupState then
        begin
          if CanCreateChildOfType( tCEInputGroupState ) then
          begin
            iChild := self.AddNextValidChild( tCEInputGroupState, AutoSelect );
          end;
        end
        else if iFromEntry is tCETreeModeSet then
        begin
          if CanCreateChildOfType( tCETreeModeSet ) then
          begin
            iChild := self.AddNextValidChild( tCETreeModeSet, AutoSelect );
          end;
        end
        else if iFromEntry is tCETreeAction then
        begin
          if CanCreateChildOfType( tCETreeAction ) then
          begin
            iChild := self.AddNextValidChild( tCETreeAction, AutoSelect );
          end;
        end;
        if assigned( iChild ) then
        begin
          iChild.Assign( iFrom.Entry[ i ], AllowUndo, FALSE );
        end
        else
        begin
          raise Exception.Create('Unable to create child');
        end;
      end;
    end;
  end
  else
  begin
    raise Exception.Create('Cannot Copy here');
  end;
end;

