  //OwnerAsZFPFile.BlockEditorUpdate := TRUE;
  try
  // cancel current editors
  if (ActiveChild <> -1) and (ActiveChild <= Max ) then
  begin
    iChild := Children.Item[ ActiveChild ] as tZFPNode;
    iChild.PanelRecalTimeEditor := nil;
    iChild.MaintenanceDateEditor := nil;
    iChild.MaintenanceStringEditor := nil;
    iChild.MainBoardVersionEditor := nil;
    iChild.LoopDriver1VersionEditor := nil;
    iChild.LoopDriver2VersionEditor := nil;
    //iChild.NonCompliantImage := nil;
    iChild.VerificationDetEditor := nil;
    iChild.VerificationMCPEditor := nil;
