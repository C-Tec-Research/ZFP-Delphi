procedure tLoopDevices.OnFieldEditorChange(Sender: tObject);
var
  iFieldEditor : tSigVariableEditor;
  iFieldNo : integer;
  iIndex : integer;
  iSubDeviceIndex : integer;
  iDevice : tLoopDevice;
  iSubDevice : tLoopSubDevice;
  iField : tDeviceField;
  iObject : tZFPGlobalObject;
  iSelected : boolean;
  iReturnObject : tLoopFieldPointerTypeEnum;
begin
  iSelected := FALSE; // used for zone selection, etc.
  iFieldEditor := Sender as tSigVariableEditor;
  iFieldNo := iFieldEditor.Tag;
  iIndex := fDeviceEditCurrent.First;
  iObject := nil;
  if iIndex < 0 then
  begin
    exit;  // nothing selected
  end;
  GroupUndoActive := TRUE;
  try
    case DeviceEditMode of
      demNotDefined: ;
      demDevices: ;
      demDeviceEntries:
      begin
        while iIndex >= 0 do
        begin
          iDevice := VisibleLoopdevice[ iIndex - 1 ];
          if assigned( iDevice ) then
          begin
            iSubDeviceIndex := SubDeviceEditor.TabIndex;
            if iSubDeviceIndex < 0 then
            begin
              iSubDeviceIndex := 0;
            end;
            // we handle only fields of current subdevice
            iSubDevice := iDevice.SubDevice[ iSubDeviceIndex ];
            iField := iSubDevice.Field[ iFieldNo ].FieldDescriptor;
            case iField.DeviceFieldEditorStyle of
              es_Link_Address, es_Link_Count, es_None: ;
              es_Zone:
              begin
                // let user select
                if not iSelected then
                begin
                  iObject := iSubDevice.Field[ iFieldNo ].Zone;
                  iObject := ZFPFile.ZoneList.SelectFromList( TRUE, iObject, OwnerNode );
                  iSelected := TRUE;
                end;
                iSubDevice.Field[ iFieldNo ].Zone := iObject as tZFPZone;
                if assigned( iObject ) then
                begin
                  iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                  iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                end
                else
                begin
                  iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                  iSubDevice.Field[ iFieldNo ].Value := '0';
                end;
              end;
              es_IO_Group:
              begin
                // we must first decide if this is in input or output
                case iSubdevice.IOType of
                  sdt_Input:
                  begin
                    if not iSelected then
                    begin
                      {
                      case iSubDevice.Field[ iFieldNo ].PointerType1.PointerType of
                      lf_Input:
                      begin
                        iObject := iSubDevice.Field[ iFieldNo ].InputGroupPointer1.InputGroup;
                      end;
                      else
                        iObject := nil;
                      end;
                      if not assigned( iObject ) then
                      begin
                        iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ iFieldNo ].Value, 0 ));
                        iSubDevice.Field[ iFieldNo ].InputGroupPointer1.InputGroup := iObject as tInputGroup;
                        iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_Input;
                      end;
                      }
                      iObject := iSubdevice.InputGroup;
                      //iObject := ZFPFile.CauseAndEffects.InputGroups.SelectFromList( TRUE, iObject, OwnerNode );
                      iReturnObject := lf_Input;
                      iObject := ZFPFile.SelectFromList( 'Select Input', TRUE, iObject, [lf_Input], iReturnObject,OwnerNode );
                      iSelected := TRUE;
                    end;
                    if assigned( iObject ) then
                    begin
                      iSubDevice.Field[ iFieldNo ].InputGroup1 := iObject as tInputGroup;
                      //iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_Input;
                      iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                      iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                    end
                    else
                    begin
                      iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                      iSubDevice.Field[ iFieldNo ].Value := '0';
                      iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_None;
                    end;
                  end;
                  sdt_Output:
                  begin
                    if not iSelected then
                    begin
                      iObject := iSubDevice.Field[ iFieldNo ].OutputGroup1;
                      {
                      if not assigned( iObject ) then
                      begin
                        if not (iSubDevice.Loop.LoopType in [ltA_Bus, ltSystem]) then
                        begin
                          iObject := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ iFieldNo ].Value, 0 ));
                          iSubDevice.Field[ iFieldNo ].OutputGroupPointer1.OutputGroup := iObject as tOutputGroup;
                        end;
                      end;
                      }
                      iObject := ZFPFile.CauseAndEffects.OutputGroups.SelectFromList( TRUE, iObject, OwnerNode );
                      //iReturnObject := lf_Output;
                      //iObject := ZFPFile.SelectFromList( 'Select Output', TRUE, iObject, [lf_Output, lf_OutputSuperGroup], iReturnObject,OwnerNode );
                      iSelected := TRUE;
                    end;
                    iSubDevice.Field[ iFieldNo ].OutputGroup1 := iObject as tOutputGroup;
                    if assigned( iObject ) then
                    begin
                      iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                      iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                    end
                    else
                    begin
                      iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                      iSubDevice.Field[ iFieldNo ].Value := '0';
                    end;
                  end;
                  else
                  begin
                    // do nothing;
                  end;
                end;
              end;
              es_Target_Group,
              es_Isolation_Group,
              es_Fault_Group:
              begin
                if not iSelected then
                begin
                  case iSubDevice.Field[ iFieldNo ].PointerType1.PointerType of
                  lf_Input:
                  begin
                    iObject := iSubDevice.Field[ iFieldNo ].InputGroup1;
                  end;
                  else
                    iObject := nil;
                  end;
                  iReturnObject := lf_Input;
                  iObject := ZFPFile.SelectFromList( 'Select Input', TRUE, iObject, [ lf_Input ], iReturnObject, OwnerNode );
                  iSelected := TRUE;
                end;
                if Assigned( iObject ) then
                begin
                  iSubDevice.Field[ iFieldNo ].InputGroup1 := iObject as tInputGroup;
                  //iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_Input;
                end
                else
                begin
                  iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_None;
                end;
                if assigned( iObject ) then
                begin
                  iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                  iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                end
                else
                begin
                  iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                  iSubDevice.Field[ iFieldNo ].Value := '0';
                end;
              end;
              es_Mask_Edit, es_Drop_Down, es_Drop_Down_List,
                          es_Image_List, es_Spin_Edit, es_Drop_Down_Image_List:
              begin
                iSubDevice.Field[ iFieldNo ].Value := iFieldEditor.Text;
              end;
            end;
          end;
          iIndex := fDeviceEditCurrent.Next;
        end;
        // now reset the text on the editor
        iFieldEditor.Font.Color := clWindowText;
        iFieldEditor.Font.Style := [ ];
      end;
      demSubDeviceEntries:
      begin
        // only one subdevice possible
        iSubdevice := VisibleLoopSubdevice[ iIndex ]; // no offset
        iField := iSubDevice.Field[ iFieldNo ].FieldDescriptor;
        case iField.DeviceFieldEditorStyle of
          es_Link_Address, es_Link_Count, es_None: ;
          es_Zone:
          begin
            // let user select
            iObject := iSubDevice.Field[ iFieldNo ].Zone;
            iObject := ZFPFile.ZoneList.SelectFromList( TRUE, iObject, OwnerNode );
            iSubDevice.Field[ iFieldNo ].Zone := iObject as tZFPZone;
            if assigned( iObject ) then
            begin
              iFieldEditor.EditorAsButton.Caption := iObject.ListName;
              iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
            end
            else
            begin
              iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
              iSubDevice.Field[ iFieldNo ].Value := '';
            end;
          end;
          es_Mask_Edit, es_Drop_Down, es_Drop_Down_List,
          es_Image_List, es_Spin_Edit, es_Drop_Down_Image_List:
          begin
            iSubDevice.Field[ iFieldNo ].Value := iFieldEditor.Text;
          end;
          es_IO_Group:
          begin
            // we must first decide if this is in input or output
            case iSubdevice.IOType of
              sdt_Input:
              begin
                iObject := iSubDevice.Field[ iFieldNo ].InputGroup1;
                if not assigned( iObject ) then
                begin
                  iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ iFieldNo ].Value, 0 ));
                  iSubDevice.Field[ iFieldNo ].InputGroup1 := iObject as tInputGroup;
                end;
                iObject := ZFPFile.CauseAndEffects.InputGroups.SelectFromList( TRUE, iObject, OwnerNode );
                iSubDevice.Field[ iFieldNo ].InputGroup1 := iObject as tInputGroup;
                if assigned( iObject ) then
                begin
                  iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                  iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                end
                else
                begin
                  iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                  iSubDevice.Field[ iFieldNo ].Value := '0';
                end;
              end;
              sdt_Output:
              begin
                iObject := iSubDevice.Field[ iFieldNo ].OutputGroup1;
                if not assigned( iObject ) then
                begin
                  iObject := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( iSubDevice.Field[ iFieldNo ].Value, 0 ));
                  iSubDevice.Field[ iFieldNo ].OutputGroup1 := iObject as tOutputGroup;
                end;
                iObject := ZFPFile.CauseAndEffects.OutputGroups.SelectFromList( TRUE, iObject, OwnerNode );
                iSubDevice.Field[ iFieldNo ].OutputGroup1 := iObject as tOutputGroup;
                if assigned( iObject ) then
                begin
                  iFieldEditor.EditorAsButton.Caption := iObject.ListName;
                  iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
                end
                else
                begin
                  iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
                  iSubDevice.Field[ iFieldNo ].Value := '0';
                end;
              end;
              else
              begin
                // do nothing;
              end;
            end;
          end;
          es_Target_Group,
          es_Isolation_Group,
          es_Fault_Group:
          begin
            case iSubDevice.Field[ iFieldNo ].PointerType1.PointerType of
            lf_Input:
            begin
              iObject := iSubDevice.Field[ iFieldNo ].InputGroup1;
            end;
            else
              iObject := nil;
            end;
            //iObject := ZFPFile.SelectInputFromList( TRUE, iObject, OwnerNode );
            iReturnObject := lf_Input;
            iObject := ZFPFile.SelectFromList( 'Select Input', TRUE, iObject, [ lf_Input ], iReturnObject, OwnerNode );
            if Assigned( iObject ) then
            begin
              iSubDevice.Field[ iFieldNo ].InputGroup1 := iObject as tInputGroup;
              //iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_Input;
            end
            else
            begin
              iSubDevice.Field[ iFieldNo ].PointerType1.PointerType := lf_None;
            end;
            if assigned( iObject ) then
            begin
              iFieldEditor.EditorAsButton.Caption := iObject.ListName;
              iSubDevice.Field[ iFieldNo ].Value := iObject.ID.Value;
            end
            else
            begin
              iFieldEditor.EditorAsButton.Caption := ChevronText( 'None' );
              iSubDevice.Field[ iFieldNo ].Value := '0';
            end;
          end;
        end;
      end;
    end;
  finally
    GroupUndoActive := FALSE;
  end;
end;

