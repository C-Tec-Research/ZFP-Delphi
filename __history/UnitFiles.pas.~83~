procedure tZFPGlobalArray.ShowMainEditor;
var
  iChild : tZFPGlobalObject;
  i, j : integer;
  iError : boolean;
begin
  if assigned( fEditor ) then
  begin
    if fEditor.ColCount <> ZFPFile.NodeList.Count + cColPanel1 then
    begin
      fEditor.ColCount := ZFPFile.NodeList.Count + cColPanel1;  // ID + Desc
    end;
    for i := cColPanel1 to fEditor.ColCount - 1 do
    begin
      fEditor.Cell[ i, 0 ] := 'N' + IntToStr(ZFPFile.NodeList.Node[ i - cColPanel1 ].ID );
    end;
    fEditor.RowCount := Count + 2; // One for titles, one for new entries
    for i := 1 to Max + 1 do
    begin
      iChild := GlobalObject[ i - 1 ];
      if assigned( iChild ) then
      begin
        fEditor.Cell[ cColName, i ] := iChild.Name;
        iError := DuplicateName( iChild );
        fEditor.Error[ cColName, i ] := iError;
        if iError then
        begin
          fEditor.ErrorText[ cColName, i ] := Translate( 'Duplicate Name' );
        end
        else
        begin
          fEditor.ErrorText[ cColName, i ] := Translate( '' );
        end;
        fEditor.Cell[ cColID, i ] := IntToStr( iChild.VisibleID );
        iError := DuplicateID( iChild );
        fEditor.Error[ cColID, i ] := iError;
        if iError then
        begin
          fEditor.ErrorText[ cColID, i ] := Translate( 'Duplicate ID' );
        end
        else
        begin
          fEditor.ErrorText[ cColID, i ] := Translate( '' );
        end;
        for j := cColPanel1 to fEditor.ColCount - 1 do
        begin
          if iChild.NodesWhereUsed.UsedByNode( ZFPFile.NodeList.Node[ j - cColPanel1 ]) then
          begin
            fEditor.Cell[ j, i ] := '1';
          end
          else
          begin
            fEditor.Cell[ j, i ] := '0';
          end;
        end;
      end;
    end;
    // last line
    i := Count + 1;
    fEditor.Cell[ cColName, i ] := '';
    fEditor.Cell[ cColID, i ] := '';
    fEditor.Error[ cColName, i ] := FALSE;
    fEditor.ErrorText[ cColID, i ] := '';
    fEditor.Error[ cColID, i ] := FALSE;
    fEditor.ErrorText[ cColID, i ] := '';
    for j := cColPanel1 to fEditor.ColCount - 1 do
    begin
      fEditor.Cell[ j, i ] := '0';
    end;
    // finally
    CheckSelections;
  end;
end;

procedure tZFPGlobalArray.ShowPanelNames;
var
  i : integer;
  iError : boolean;
begin
  //if not ZFPFile.BlockEditorUpdate then
  begin
    if assigned( fPanelEditor ) then
    begin
      fPanelEditor.RowCount := ZFPFile.NodeList.Count + 1;
      if fPanelEditor.RowCount > 1 then
      begin
        fPanelEditor.FixedRows := 1;
      end;
      if assigned( ZFPFile.NodeList ) then
      begin
        for i := 1 to ZFPFile.NodeList.Count do
        begin
          fPanelEditor.Cell[ 0, i ] := 'N' + IntToStr( ZFPFile.NodeList.Node[ i - 1 ].ID );
          fPanelEditor.Cell[ 1, i ] := ZFPFile.NodeList.Node[ i - 1 ].Name1.Value;
          iError := ZFPFile.NodeList.DuplicateName( i - 1 );
          fPanelEditor.Error[ 1, i ] := iError;
          if iError then
