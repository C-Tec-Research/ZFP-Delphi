function tLoopDevices.GetCellIcon(  const CellIndex : integer  ): integer;
begin
  if CellIndex < 0 then
  begin
    Result := -1;
    exit;
  end;
  case DeviceEditMode of
    demNotDefined:
    begin
      Result := -1;
    end;
    demDevices:
    begin
      if CellIndex > Loop.MaxDevicesOnCurrentLoop then
      begin
        Result := -1;
      end
      else if CellIndex - 1 > Max then
      begin
        Result := 0;
      end
      else
      begin
        Result := LoopDevice[ CellIndex - 1 ].DeviceImage; //StrToIntDef( Cells[ ACol, ARow ], 0 );
      end;
    end;
    demDeviceEntries:
    begin
      if CellIndex > VisibleDeviceCount then
      begin
        Result := -1;
      end
      else
      begin
        Result := VisibleLoopDevice[ CellIndex - 1 ].DeviceImage; //StrToIntDef( Cells[ ACol, ARow ], 0 );
      end;
    end;
    demSubDeviceEntries:
    begin
      if CellIndex > VisibleSubDeviceCount then
      begin
        Result := -1;
      end
      else
      begin
        Result := VisibleLoopSubDevice[ CellIndex ].DeviceImage; // subdevices not offset like others, i.e. 1 = subdevice 1
      end;
    end;
    else
    begin
      Result := -1;
    end;
  end;
end;

