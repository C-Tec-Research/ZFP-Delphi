function tZFPFile.CanDisassociate(pNode: tZFPNode; pZone: tZFPZone): boolean;
var
  i, j, k : integer;
  iDev: integer;
  iSubDevice : tLoopSubDevice;
  iDevice : tLoopDevice;
  iNewZone : tZFPZone;
  iLoop : integer;
  iSubDeviceAddress : tSubDeviceAddress;
begin
  Result := TRUE;
  ClearErrorList;
  with pNode do
  begin
    for j := 0 to LoopList.Max do
    begin
      iLoop := LoopList.Loop[ j ].LoopAddress.ValueAsInt;
      with LoopList.Loop[ j ].LoopDevices do
      begin
        for k := 1 to VisibleSubDeviceCount do
        begin
          iSubDevice := VisibleLoopSubDevice[ k ];
          if iSubDevice.Zone = pZone then
          begin
            iDevice := iSubDevice.Device;
            iDev := StrToInt( iSubDevice.Device.Index );
            iSubDeviceAddress := tSubDeviceAddress.Create;
            iSubDeviceAddress.Panel := pNode.ID;
            iSubDeviceAddress.Loop := iLoop;
            iSubDeviceAddress.LoopDevices := LoopList.Loop[ j ].LoopDevices;
            iSubDeviceAddress.Device := iDevice;
            iSubDeviceAddress.SubDevice := iSubDevice;
            AddError( es_Error, iLoop, iDev + 1, Translate( 'Device' + ' "' + iDevice.Name + '" ' + Translate('defined in zone')), iSubDeviceAddress );
          end;
        end;
      end;
    end;
    if ErrorList.Count > 0 then
    begin
      case FormDissociation.Execute( Translate( 'zone' )) of
        drMoveToNewZone:
        begin
          iNewZone := ZoneList.SelectFromList( TRUE, pZone, pNode ) as tZFPZone;
          if iNewZone = pZone then
          begin
            // cancelled!
            Result := FALSE;
            exit;
          end
          else
          begin
            for i := 0 to ErrorList.Count - 1 do
            begin
              iSubDevice := (ErrorList.Error[ i ].ErrorObject as tSubDeviceAddress).SubDevice;
              iSubDevice.Zone := iNewZone;
            end;
            Result := TRUE;
            exit;
          end;
        end;
        drShowErrors:
        begin
          fPendingErrorFrames.Add( ZoneList.ErrorFrame );
          fPendingErrorFrames.Add( fDeviceErrorFrame );
          OnErrorDblClick := OnShowSubDeviceZoneOnDoubleClick;
          ShowErrorFrames;
          Result := FALSE;
          exit;
        end;
        drAbort:
        begin
          Result := FALSE;
          exit;
        end;
      end;

    end;
  end;
end;

