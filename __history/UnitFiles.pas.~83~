function tCETreeOutputObject.CanCreateChildOfType(
  pOfType: tCETreePropertyClass): boolean;
begin
  // for all output types, we can only create a sequence, and then
  // only if we are not the child of a sequence
  if pOfType = tCETreeAction then
  begin
    // must always have a parent!
    Result := not (Parent is tCETreeAction);
  end
  else
  begin
    Result := FALSE;
  end;
end;

function tCETreeOutputObject.CheckValid(const pErrors: tErrorList;
  pValidFlags: tCETreeValidFlags): boolean;
begin
  Result := inherited;
  case PointerType.PointerType of
    lf_Zone,
    lf_Output,
    lf_OutputSuperGroup:
    begin
      if assigned( CurrentObject ) then
      begin
        if CurrentObject.IsEmpty then
        begin
          if not CurrentObject.HasReportedError( re_Empty ) then
          begin
            pErrors.Add( es_Warning, 0, Translate('Output object empty') + ' (' +
                       CurrentObject.ExpandedName + ')', CurrentObject );
          end;
        end;
      end
      else
      begin
        pErrors.Add( es_Error, 0, Translate('Internal Error') + ' CEO002', self );
      end;
    end;
  end;
end;

