function tZFPFile.SelectFromListCommon( const pCaption : string; const pAllowCreate: boolean;
  const CurrObject: tZFPGlobalObject; const Pages: tLoopFieldPointerTypeEnums;
  var DefaultPage: tLoopFieldPointerTypeEnum): tZFPGlobalObject;
var
  iDefaultPage : integer;
begin
  fAllowCreate := pAllowCreate;
  // could be anything!
  iDefaultPage := 0;
  fSelectOutputTab := -1;
  fSelectInputSuperGroupTab := -1;
  fSelectOutputSuperGroupTab := -1;
  fSelectInputTab := -1;
  fSelectZoneTab := -1;
  fSelectModeTab := -1;
  fSelectAccessLevelTab := -1;
  with FormSelectGlobalObject do
  begin
    //OnChangeTab := self.OnChangeTabPanels;
    ClearTabs;
    if lf_Input in Pages then
    begin
      fSelectInputTab := AddTab( 'Input Groups', CauseAndEffects.InputGroups, tInputGroups.MaxNameLength );
      if DefaultPage = lf_Input then
      begin
        iDefaultPage := fSelectInputTab;
      end;
    end;
    if lf_InputSuperGroup in Pages then
    begin
      fSelectInputSuperGroupTab := AddTab( 'Input Supergroups', InputSuperGroupList, tInputSuperGroupList.MaxNameLength );
      if DefaultPage = lf_InputSuperGroup then
      begin
        iDefaultPage := fSelectInputSuperGroupTab;
      end;
    end;
    if lf_Output in Pages then
    begin
      fSelectOutputTab := AddTab( 'Output Groups', CauseAndEffects.OutputGroups, tOutputGroups.MaxNameLength );
      if DefaultPage = lf_Output then
      begin
        iDefaultPage := fSelectOutputTab;
      end;
    end;
    if lf_OutputSuperGroup in Pages then
    begin
      fSelectOutputSuperGroupTab := AddTab( 'Output Supergroups', SuperGroupList, tZFPSuperGroupList.MaxNameLength );
      if DefaultPage = lf_OutputSuperGroup then
      begin
        iDefaultPage := fSelectOutputSuperGroupTab;
      end;
    end;
    if lf_Zone in Pages then
    begin
      fSelectZoneTab := AddTab( 'Zones', ZoneList, tZFPZoneList.MaxNameLength );
      if DefaultPage = lf_Zone then
      begin
        iDefaultPage := fSelectZoneTab;
      end;
    end;
    if lf_Mode in Pages then
    begin
      fSelectModeTab := AddTab( 'Modes', ModeList, tZFPModeList.MaxNameLength );
      if DefaultPage = lf_Mode then
      begin
        iDefaultPage := fSelectModeTab;
      end;
    end;
    if lf_AccessLevel in Pages then
    begin
      fSelectAccessLevelTab := AddTab( 'Access Level', AccessLevelList, tAccessLevelList.MaxNameLength );
      if DefaultPage = lf_AccessLevel then
      begin
        iDefaultPage := fSelectAccessLevelTab;
      end;
    end;
    if not assigned( CurrObject ) then
    begin
      SetTab( iDefaultPage );
    end
    else if CurrObject is tZFPSuperGroup then // must do before tOutputGroup because tOutputGroup is ancestor of tZFPSuperGroup
    begin
      SetTab( fSelectOutputSuperGroupTab );
    end
    else if CurrObject is tInputSuperGroup then
    begin
      SetTab( fSelectInputSuperGroupTab );
    end
    else if CurrObject is tOutputGroup then
    begin
      SetTab( fSelectOutputTab );
    end
    else if CurrObject is tInputGroup then
    begin
      SetTab( fSelectInputTab );
    end
    else if CurrObject is tZFPZone then
    begin
      SetTab( fSelectZoneTab );
    end
    else if CurrObject is tZFPMode then
    begin
      SetTab( fSelectModeTab );
    end
    else if CurrObject is tAccessLevel then
    begin
      SetTab( fSelectAccessLevelTab );
    end
    else
    begin
      SetTab( iDefaultPage );
    end;
    Result := Execute( CurrObject, pCaption ) as tZFPGlobalObject;
    if TabControlObjects.TabIndex = fSelectOutputTab then
    begin
      DefaultPage := lf_Output;
    end
    else if TabControlObjects.TabIndex = fSelectInputSuperGroupTab then
    begin
      DefaultPage := lf_InputSupergroup;
    end
    else if TabControlObjects.TabIndex = fSelectOutputSuperGroupTab then
    begin
      DefaultPage := lf_OutputSuperGroup;
    end
    else if TabControlObjects.TabIndex = fSelectInputTab then
    begin
      DefaultPage := lf_Input;
    end
    else if TabControlObjects.TabIndex = fSelectZoneTab then
    begin
      DefaultPage := lf_Zone;
    end
    else if TabControlObjects.TabIndex = fSelectModeTab then
    begin
      DefaultPage := lf_Mode;
    end
    else if TabControlObjects.TabIndex = fSelectAccessLevelTab then
    begin
      DefaultPage := lf_AccessLevel;
    end

  end;
end;

