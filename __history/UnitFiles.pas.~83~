procedure tZFPGlobalArray.OnSelectCell(Sender: TObject; ACol, ARow: Integer;
  var CanSelect: Boolean);
var
  iNode : tZFPNode;
begin
  if (ARow > 0) and (ARow <= Count ) then
  begin
    ActiveChild := ARow - 1;
    // not the title bar
    if ACol >= cColPanel1 then
    begin
      // a panel toggle
      iNode := ZFPFile.NodeList.Node[ ACol - cColPanel1 ];
      if fEditor.Cell[ ACol, ARow ] = '1' then
      begin
        with GlobalObject[ ARow - 1 ] do
        begin
          if CanUnregisterNode( iNode ) then
          begin
            UnregisterNode( iNode );
            fEditor.Cell[ ACol, ARow ] := '0'
          end;
        end;
      end
      else
      begin
        GlobalObject[ ARow - 1 ].RegisterNode( iNode );
        fEditor.Cell[ ACol, ARow ] := '1'
      end;
      CheckErrors;
    end;
  end
  else
  begin
    ActiveChild := -1;
    CheckErrors;
  end;
end;

