procedure tZFPLoopsFitted.ExecuteOnChange(
  const pChangedObject: tSigBaseProperty; const pUndoing, pRedoing : boolean);
begin
  if pUndoing then
  begin
    AmUndoing := TRUE;
  end;
  if pRedoing then
  begin
    AmRedoing := TRUE;
  end;
  try
    if pChangedObject = fLoopsFitted then
    begin
      if assigned( ZFPNode.LoopList ) then
      begin
        ZFPNode.LoopList.SetNormalLoopCount( fLoopsFitted.ValueAsInt );
      end;
    end;
    inherited;
  finally
    if pUndoing then
    begin
      AmUndoing := FALSE;
    end;
    if pRedoing then
    begin
      AmRedoing := FALSE;
    end;
  end;
end;


