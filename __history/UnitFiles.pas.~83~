      inc( iGlobalObject.fDeviceCount );
    end;
    iGlobalObject := iLoopSubdevice.OutputGroup;
    if assigned( iGlobalObject ) then
    begin
      inc( iGlobalObject.fDeviceCount );
    end;
    iGlobalObject := iLoopSubdevice.Zone;
    if assigned( iGlobalObject ) then
    begin
      inc( iGlobalObject.fDeviceCount );
    end;
  end;

end;

