function tZFPNodeList.DuplicateName(pNode: integer): boolean;
var
  iName : string;
  i : integer;
begin
  iName := Node[ pNode ].Name1.Value;
  for i := 0 to Max do
  begin
    if i <> pNode then
    begin
      if SameText( iName, Node[ i ].Name1.Value ) then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
  Result := FALSE;
end;

