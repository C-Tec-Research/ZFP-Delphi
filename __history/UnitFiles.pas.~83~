procedure tLoopDevices.ResizeDeviceGrid;
var
  //iBevelEdgeCount,
  iWidth : integer;
  iCellWidth, iColCount : integer;
begin
  if assigned( fDeviceGrid ) then
  begin
    with fDeviceGrid do
    begin
      iWidth := ClientWidth;
      //dec( iWidth, GetSystemMetrics( SM_CXVSCROLL ) );
      dec( iWidth, GridLineWidth );
      iCellWidth := DefaultColWidth + GridLineWidth;
      iColCount := iWidth div iCellWidth;
      if iColCount < 8 then
      begin
        iColCount := 8;
      end;
      if iColCount <> ColCount then
      begin
        ColCount := iColCount;
      end;
      case DeviceEditMode of
        demNotDefined:
        begin
          RowCount := 17;
        end;
        demDevices:
        begin
          if (Loop.MaxDevicesOnCurrentLoop mod ColCount) = 0 then
          begin
            RowCount := (Loop.MaxDevicesOnCurrentLoop div ColCount);
          end
          else
          begin
            RowCount := 1 + (Loop.MaxDevicesOnCurrentLoop div ColCount);
          end;
        end;
        demDeviceEntries:
        begin
          if (VisibleDeviceCount mod ColCount) = 0 then
          begin
            RowCount := (VisibleDeviceCount div ColCount);
          end
          else
          begin
            RowCount := 1 + (VisibleDeviceCount div ColCount);
          end;
        end;
        demSubDeviceEntries:
        begin
          if (VisibleSubDeviceCount mod ColCount) = 0 then
          begin
            RowCount := (VisibleSubDeviceCount div ColCount);
          end
          else
          begin
            RowCount := 1 + (VisibleSubDeviceCount div ColCount);
          end;
        end;
      end;
      Invalidate;
    end;
  end;
end;

