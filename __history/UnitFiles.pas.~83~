function tBaseSupergroup.ContainsObject(
  const pGroup: tZFPGlobalObject): boolean;
var
  i: Integer;
begin
  Result := FALSE;
  for i := 0 to GroupChildren.Max do
  begin
    if assigned( GroupChildren.Group[ i ] ) then
    begin
      if GroupChildren.Group[ i ] = pGroup then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
  for i := 0 to SuperGroupChildren.Max do
  begin
    if assigned( SuperGroupChildren.SuperGroup[ i ]) then
    begin
      if SuperGroupChildren.SuperGroup[ i ].ContainsObject( pGroup ) then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
end;

function tBaseSupergroup.ContainsSupergroup(
  const pSuperGroup: tBaseSupergroup): boolean;
var
  i: Integer;
begin
  if pSuperGroup = self then
  begin
    Result := TRUE;
  end
  else
  begin
    Result := FALSE;
    for i := 0 to SuperGroupChildren.Max do
    begin
      if assigned( SuperGroupChildren.SuperGroup[ i ]) then
      begin
        Result := SuperGroupChildren.SuperGroup[ i ].ContainsSupergroup( pSuperGroup );
        if Result then
        begin
          exit;
        end;
      end;
    end;
  end;
end;

