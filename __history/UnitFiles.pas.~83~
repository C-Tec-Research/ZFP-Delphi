function tCEInputGroupState.CanCreateChildOfType(
  pOfType: tCETreePropertyClass): boolean;
var
  iOwner : tSigCompoundProperty;
begin
{
  if pOfType = tCETreeOutputGroup then
  begin
    Result := TRUE;
  end
}
  if pOfType = tCETreeAction then
  begin
    Result := TRUE;
  end
  else if pOfType = tCETreeModeSet then
  begin
    iOwner := Owner;
    while assigned( iOwner ) do
    begin
      if iOwner is tCETreeModeSet then
      begin
        Result := FALSE;
        exit;
      end;
      iOwner := iOwner.Owner;
    end;
    // else
    Result := TRUE;
  end
  else if pOfType = tCETreeOutputObject then
  begin
    Result := TRUE;
  end
  else
  begin
    Result := FALSE;
