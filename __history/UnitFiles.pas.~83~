          const pList : tStringList; const AutoSelect : boolean);
var
  iErrText : string;
  iAllowAdd : boolean;
  iIndent : integer;
  iAutoSelect : boolean;
Label
  Loop;
begin
  iAllowAdd := TRUE;
  if iIndex >= pFile.Count then
  begin
    iErrText := Translate( 'Unexpected EOF');
    pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, self);
    iAllowAdd := FALSE;
  end;
  iAutoSelect := AutoSelect;
Loop:
  CommaListToStringList( pFile[ iIndex ], pList, TRUE );
  if PList.Count < 2 then
  begin
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( es_Error, 0, 0, iErrText, pErrorObject);
    iAllowAdd := FALSE;
  end;
  if pList[ 0 ] <> '150' then
  begin
    iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
    pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, self);
    iAllowAdd := FALSE;
  end;
  // we don't actually care about panel!
  if pList[ 1 ] = 'END' then
  begin
    exit;
  end;
  if pList[ 1 ] = 'BEGIN' then
  begin
    iAllowAdd := FALSE;
  end;
  // pList[ 1 ] is the seq. Don't bother checking for now.
  iIndent := -1;
  try
    iIndent := StrToInt( pList[ 2 ] );
  except
    iErrText := Translate( 'Missing or illegal value') + ' "' + pList[2] + '"';
    pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
    iAllowAdd := FALSE;
  end;
  if not iAllowAdd then
  begin
    // skip to next line
    inc( iIndex );
    goto Loop;
  end;
  if iIndent <= Indent then
  begin
    // not our child - pass back to parent
    exit;
  end
  else if (iIndent = Indent + 1) or (Indent = -1) then
  begin
    // our child
    ImportTreeLine( iIndent, pFile, iIndex, pList, pErrors, pErrorObject, iAutoSelect);
    iAutoSelect := FALSE;
    goto Loop;
  end
  else
  begin
    iErrText := Translate( 'Missing or illegal value') + ' "' + pList[2] + '"';
    pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
  end;
end;

function tCETreeProperty.ExportTreeLine(const pSeq, pIndent: integer): string;
begin
  // descendants use this as a prequel, that
  // Result := inherited + ....
  Result := '150,' + IntToStr( pSeq ) + ',' + IntToStr( pIndent ) + ',"'
         + TreeText + '","' + ClassName + '"';
end;

procedure tCETreeProperty.ImportTreeLine(const Indent: integer;
  const pFile: tStrings; var iIndex: integer; const pList: tStringList;
  pErrors: tErrorList; const pErrorObject: tObject; const AutoSelect : boolean);
var
  iErrText, iTreeText, iClassName : string;
  iChildType : tCETreePropertyClass;
  iChild : tCETreeProperty;
begin
  // we already know that the first part of the line is OK
  // see which child we are creating
  iTreeText := pList[ 3 ];
  iClassName := ClassType + ' ' + pList[ 4 ];
  iChildType := ChildType( iClassName, '', iTreeText );
  if CanCreateChildofType( iChildType ) then
  begin
    iChild := AddNextValidChild( iChildType, AutoSelect );
    iChild.TreeText := iTreeText;
    iChild.ImportTreeData( pList, iIndex, pErrors, pErrorObject );
    iChild.TreeNode1.ImageIndex := iChild.ImageIndex;
    iChild.TreeNode1.SelectedIndex := iChild.ImageIndex + cSelectedOffset;

    inc( iIndex );
    iChild.ImportTreeFile( Indent, pFile, iIndex, pErrors, pErrorObject, pList, FALSE );
  end
  else
  begin
    iErrText := Translate( 'Unable to create') + ' "' + pList[4] + '" ' + Translate('here');
    pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
    inc( iIndex );
  end;
end;

