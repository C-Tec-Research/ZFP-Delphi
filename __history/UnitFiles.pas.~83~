function tCETreeProperty.CanCreateChild(const pLine: string): boolean;
var
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
begin
  // analyse the line...
  if SigNETParse ( pLine, SigProperty,
         SigIndex, SigValue, SigComment) then
  begin
    Result := CanCreateChild( SigProperty, SigIndex, SigValue, SigComment );
  end
  else
  begin
    Result := FALSE;
  end;
end;

function tCETreeProperty.CanPasteFromClipboard: boolean;
var
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
begin
  // see if we can.
  Result := FALSE;
  if assigned( Clipboard ) then
  begin
    if Clipboard.Count > 1 then
    begin
      // analyse the line...
      if SigNETParse ( Clipboard[ 0 ], SigProperty,
             SigIndex, SigValue, SigComment) then
      begin
        // if parent is tree then if parent can create we create as sibling before
        if assigned( Parent ) then
        begin
          if Parent.CanCreateChild( SigProperty, SigIndex, SigValue ) then
          begin
            Result := TRUE;
            exit;
          end;
        end;
        // if we can create the clipboard as a child then do it.
        if CanCreateChild( SigProperty, SigIndex, SigValue, SigComment ) then
        begin
          Result := TRUE;
          exit;
        end;
      end;
    end;
  end;
end;

function tCETreeProperty.CanPasteSpecialFromClipboard: boolean;
begin
  Result := CanPasteFromClipboard;
  if Result then
  begin
    Result := HasPasteSpecialObjects;
  end;
end;

