function tSequence.ValidWithObject(const pObject: tZFPGlobalObject): boolean;
begin
  if assigned( pObject ) then
  begin
    case fSeqStyle.ValueAsOGSeqStyle of
      og_None:        Result := TRUE;
      og_Mode:        Result := pObject is tZFPMode;
      og_Spin_Edit:   Result := TRUE;
      og_Map:         Result := TRUE;
      og_Output_Group: Result := (pObject is tOutputGroup) or (pObject is tZFPSuperGroup ) ;
      og_Supergroup:   Result := pObject is tZFPSupergroup;
      og_Trigger:      Result := (pObject is tOutputGroup);
      og_Sounder_Pattern: Result := TRUE;
      og_Input_Group:     Result := (pObject is tInputGroup) or (pObject is tInputSupergroup);
      og_Timer:           Result := TRUE;
      og_Zone:            Result := pObject is tZFPZone;
      og_Access_Level:    Result := pObject is tAccessLevel;
      og_Group_Action:    Result := pObject is tGroupAction;
      else                Result := TRUE;
    end;
  end
  else
  begin
    Result := TRUE;
  end;
end;

