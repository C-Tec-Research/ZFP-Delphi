procedure tZFPSuperGroup.ImportFile(const pFile: tStrings; var iIndex: integer; const pNode : tZFPNode;
  const pList: tStrings; const pErrors: tErrorList; const pErrorObject: tObject);
var
  i: Integer;
  iID : integer;
  iErrText : string;
  iOutputGroup : tOutputGroup;
begin
  for i := 2 to pList.Count - 1 do
  if pList[ i ] <> '' then
  begin
    try
      iID := StrToInt( pList[ i ] );
    except
      iID := -1;
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, i, iErrText, pErrorObject);
    end;
    if iID > 0  then
    begin
      iOutputGroup := ZFPFile.OutputObjectWithID( iID );
      if assigned( iOutputGroup ) then
      begin
        if iOutputGroup is tZFPSupergroup then
        begin
          if CanAddSupergroup( iOutputGroup as tZFPSupergroup ) then
          begin
            SuperGroupChildren.AddGroup( iOutputGroup );
          end;
        end
        else
        begin
          GroupChildren.AddGroup( iOutputGroup );
        end;
      end
      else
      begin
        iErrText := Translate( 'Item not found');
        pErrors.Add( tErrorSeverity.es_Error, iIndex, i, iErrText, pErrorObject);
      end;
    end;
  end;
end;

