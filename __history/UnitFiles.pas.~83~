function tZFPPanelGeneralProperties.ImportSpecialLines( const pFile: tStrings;
   const iIndex : integer; pErrors : tErrorList;
                          const pErrorObject : tObject ): boolean;
var
  iLoopList : tLoopList;
  i: Integer;
  iLoopAddress : integer;
  iText : string;
begin
  if pFile[ 1 ] = '16' then
  begin
    Result := TRUE;
    iLoopList := (Owner as tZFPNode).LoopList;
    iLoopAddress := 0;
    try
      iLoopAddress := StrToInt( pFile[ 2 ] );
    except
      iText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Warning, iIndex, 2, iText, pErrorObject );
    end;
    iText := UnquotedString( pFile[ 3 ] );
    for i := 0 to iLoopList.Max do
    begin
      with iLoopList.Loop[ i ] do
      begin
        if LoopAddress.ValueAsInt = iLoopAddress then
        begin
          if iText <> '' then
          begin
            LoopName.Value := iText;
          end
          else
          begin
            iText := Translate( 'Blank Loop Name not allowed');
            pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iText, pErrorObject );
          end;
          exit;
        end
        else if SubLoopAddress.ValueAsInt = iLoopAddress then
        begin
          exit; // ignore subloop names
        end;
      end;
    end;
    // else
    if iText <> '' then
    begin
      iText := Translate( 'Loop Name given to loop not fitted');
      pErrors.Add( tErrorSeverity.es_Warning, iIndex, 2, iText, pErrorObject );
    end;
  end
  else if pFile[ 1 ] = '7'  then
  begin
    Result := TRUE;
    if pFile[ 2 ] = '0-00' then
    begin
      MainBoardVersion.Value := Translate( 'Not Known' );
    end
    else
    begin
      MainBoardVersion.Value := pFile[ 2 ];
    end;
    if pFile[ 3 ] = '0-00' then
    begin
      LoopDriver1Version.Value := Translate( 'Not Fitted' );
    end
    else
    begin
      LoopDriver1Version.Value := pFile[ 3 ];
    end;
    if pFile[ 4 ] = '0-00' then
    begin
      LoopDriver2Version.Value := Translate( 'Not Fitted' );
    end
    else
    begin
      LoopDriver2Version.Value := pFile[ 4 ];
    end;
  end
  else
  begin
    Result := FALSE;
  end;
end;

