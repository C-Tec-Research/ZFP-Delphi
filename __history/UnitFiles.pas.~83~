procedure tLoopDevices.ContractRange;
var
  iDeviceEditCurrent : tDSMList;
  iSubDeviceIndex : integer;
  iDeviceIndex : integer;
  iDevice, iVisibleDevice : tLoopDevice;
begin
  // moving from a subdevice range to a device range
  iDeviceEditCurrent := -1;
  iSubDeviceIndex := fDeviceEditCurrent.First;
  iDeviceIndex := -1;
  if iSubDeviceIndex <> -1 then
  begin
    iDevice := VisibleLoopSubDevice[ iSubDeviceIndex ].Device;
    iVisibleDevice := nil;
    while iDeviceIndex < VisibleDeviceCount do
    begin
      inc( iDeviceIndex );
      iVisibleDevice := VisibleLoopDevice[ iDeviceIndex ];
      if iVisibleDevice = iDevice then
      begin
        break;
      end;
    end;
    if iDeviceIndex < VisibleDeviceCount then
    begin
      iDeviceEditCurrent := (iDeviceIndex + 1); // iDevice index is offset by 1 relative to iDeviceEditCurrent
    end
    else
    begin
      fDeviceEditCurrent.Value := iDeviceEditCurrent;
      exit;
    end;
    iSubDeviceIndex := fDeviceEditCurrent.Next;
    while iSubDeviceIndex > 0 do
    begin
      iDevice := VisibleLoopSubDevice[ iSubDeviceIndex ].Device;
      if iVisibleDevice <> iDevice then
      begin
        while iDeviceIndex < VisibleDeviceCount do
        begin
          inc( iDeviceIndex );
          iVisibleDevice := VisibleLoopDevice[ iDeviceIndex ];
          if iVisibleDevice = iDevice then
          begin
            break;
          end;
        end;
        if iDeviceIndex < VisibleDeviceCount then
        begin
          iDeviceEditCurrent := iDeviceEditCurrent + (iDeviceIndex + 1);
        end;
      end;
      iSubDeviceIndex := fDeviceEditCurrent.Next;
    end;
  end;
  fDeviceEditCurrent.Value := iDeviceEditCurrent;
end;

