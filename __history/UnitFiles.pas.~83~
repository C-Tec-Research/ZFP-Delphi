procedure tDeviceEditModeProperty.SetValue(const pValue: string);
var
  iNode : tZFPNode;
  iLoopList : tLoopList;
  iLoopDevices : tLoopDevices;
  jNewVal : integer;
  iNewVal : tDeviceEditMode;
begin
  if Value <> pValue then
  begin
    with OwnerFile as tZFPFile do
    begin
      jNewVal := StrToInt( pValue );
      if jNewVal < 0 then
      begin
        iNewVal := demNotDefined;
      end
      else
      begin
        iNewVal := tDeviceEditMode( jNewVal );
      end;
      if assigned( NodeList ) then
      begin
        with NodeList do
        begin
          case DeviceEditMode of
            demNotDefined: ;
            demDevices:
            begin
              case iNewVal of
                demNotDefined: ;
                demDevices: ;
                demDeviceEntries:
                begin
                  AdjustRangeToExcludeEmptyDevices( self.AmUndoing );
                end;
                demSubDeviceEntries: ;
              end;
            end;
            demDeviceEntries:
            begin
              case iNewVal of
                demNotDefined: ;
                demDevices:
                begin
                  AdjustRangeToIncludeEmptyDevices( self.Undoing );
                end;
                demDeviceEntries: ;
                demSubDeviceEntries:
                begin
                  ExpandRange;
                end;
              end;
            end;
            demSubDeviceEntries:
            begin
              ContractRange;
            end;
          end;
        end;
      end;

      inherited;

      if assigned( NodeList ) then
      begin
        with NodeList do
        begin
          case DeviceEditMode of
            demDevices:
            begin
              if assigned( SpeedButtonShowComponentPalette ) then
              begin
                SpeedButtonShowComponentPalette.Enabled := FALSE;
                SpeedButtonShowComponentPalette.Caption := Translate( 'Device Palette' );
              end;
              if assigned( SpeedButtonEditDevices ) then
              begin
                SpeedButtonEditDevices.Enabled := TRUE;
                SpeedButtonEditDevices.Caption := Translate( 'Edit Devices' );
              end;
              if assigned( PanelComponentPalette ) then
              begin
                PanelComponentPalette.Visible := TRUE;
              end;
              if assigned( PanelDeviceProperties ) then
              begin
                PanelDeviceProperties.Visible := FALSE;
              end;
            end;
            demDeviceEntries:
            begin
              if assigned( SpeedButtonShowComponentPalette ) then
              begin
                SpeedButtonShowComponentPalette.Enabled := TRUE;
                SpeedButtonShowComponentPalette.Caption := Translate( 'Device Palette' );
              end;
              if assigned( SpeedButtonEditDevices ) then
              begin
  //              SpeedButtonEditDevices.Enabled := TRUE;
  //              SpeedButtonEditDevices.Caption := Translate( 'Edit Sub-Devices' );
                  SpeedButtonEditDevices.Enabled := FALSE;
                  SpeedButtonEditDevices.Caption := Translate( 'Edit Devices' );
              end;
              if assigned( PanelComponentPalette ) then
              begin
                PanelComponentPalette.Visible := FALSE;
              end;
              if assigned( PanelDeviceProperties ) then
              begin
                PanelDeviceProperties.Visible := TRUE;
              end;
            end;
            demSubDeviceEntries:
            begin
              if assigned( SpeedButtonShowComponentPalette ) then
              begin
                SpeedButtonShowComponentPalette.Enabled := TRUE;
                SpeedButtonShowComponentPalette.Caption := Translate( 'Edit Devices' );
              end;
              if assigned( SpeedButtonEditDevices ) then
              begin
  //              SpeedButtonEditDevices.Enabled := FALSE;
  //              SpeedButtonEditDevices.Caption := Translate( 'Edit Sub-Devices' );
                  SpeedButtonEditDevices.Enabled := FALSE;
                  SpeedButtonEditDevices.Caption := Translate( 'Edit Devices' );
              end;
              if assigned( PanelComponentPalette ) then
              begin
                PanelComponentPalette.Visible := FALSE;
              end;
              if assigned( PanelDeviceProperties ) then
              begin
                PanelDeviceProperties.Visible := TRUE;
              end;
            end;
          end;
          //RefreshEditors;
        end;

        if NodeList.ActiveChild >= 0 then
        begin
          iNode := NodeList.Node[ Nodelist.ActiveChild ];
          if assigned( iNode ) then
          begin
            iLoopList := iNode.LoopList;
            if assigned( iLoopList ) then
            begin
              iLoopDevices := iLoopList.Loop[ iLoopList.ActiveChild ].LoopDevices;
              if assigned( iLoopDevices ) then
              begin
                iLoopDevices.RefreshEditors;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

