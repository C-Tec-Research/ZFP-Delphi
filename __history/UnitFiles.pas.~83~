procedure TLoopSubDeviceField.SetFieldDescriptor(const iField: TDeviceField);
var
  iObject : tZFPGlobalObject;
  iMustResetValue : boolean;
begin
  iMustResetValue := self.Value = '';
  if assigned( fFieldDescriptor ) then
  begin
    if fFieldDescriptor.FieldType.ValueAsInt <> iField.FieldType.ValueAsInt then
    begin
      iMustResetValue := TRUE; //FieldsOverlap( fFieldDescriptor, iField );
    end
    else if fFieldDescriptor.Location[ OwnerAsSubdevice.SubDeviceID ] <> iField.Location[ OwnerAsSubdevice.SubDeviceID ] then
    begin
      iMustResetValue := TRUE; //FieldsOverlap( fFieldDescriptor, iField );
    end
    else if fFieldDescriptor.Length.ValueAsInt <> iField.Length.ValueAsInt then
    begin
      iMustResetValue := TRUE; //FieldsOverlap( fFieldDescriptor, iField );
    end
  end;
  fFieldDescriptor := iField;
  if iMustResetValue then
  begin
    if assigned( fFieldDescriptor ) then
    begin
      self.Value := fFieldDescriptor.DefaultValue.Value;
    end;
  end;
  case iField.DeviceFieldEditorStyle of
    //es_Link_Address, es_Link_Count, es_None: ;
    //es_Mask_Edit,
    //es_Drop_Down,
    //es_Drop_Down_List,
    //es_Image_List,
    //es_Spin_Edit,
    //es_Drop_Down_Image_List: ;
    es_Zone:
    begin
      iObject := Zone;
      if not assigned( iObject ) then
      begin
        iObject:= ZFPFile.ZoneList.ObjectWithID(StrToIntDef( Value, 0 ));
        Zone := iObject as tZFPZone;
      end;
    end;
    es_IO_Group:
    begin
      // if this is in an A-Bus device or Sytem device then don't set default input or output group
      {
      if OwnerAsSubdevice.Loop.LoopType in [ltA_Bus, ltSystem] then
      begin
        PointerType1.PointerType := lf_None;
      end
      else
      }
      begin
        // we must first decide if this is in input or output
        case OwnerAsSubdevice.IOType of
          sdt_Input:
          begin
            case PointerType1.PointerType of
            lf_Input:
            begin
              iObject := InputGroup1;
            end;
            lf_Output:
            begin
              self.Value := fFieldDescriptor.DefaultValue.Value;
              iObject := nil;
            end
            else
              iObject := nil;
            end;
            if not assigned( iObject ) then
            begin
              iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID(StrToIntDef( Value, 0 ));
              InputGroup1 := iObject as tInputGroup;
              //PointerType1.PointerType := lf_Input;
            end;
          end;
          sdt_Output:
          begin
            case PointerType1.PointerType of
            lf_Output:
            begin
              iObject := OutputGroup1;
            end;
            lf_Input:
            begin
              self.Value := fFieldDescriptor.DefaultValue.Value;
              iObject := nil;
            end
            else
              iObject := nil;
            end;
            if not assigned( iObject ) then
            begin
              iObject := ZFPFile.CauseAndEffects.OutputGroups.ObjectWithID(StrToIntDef( Value, 0 ));
              OutputGroup1 := iObject as tOutputGroup;
              //PointerType1.PointerType := lf_Output;
            end;
          end;
        end;
      end;
    end;
    es_Target_Group,
    es_Isolation_Group,
    es_Fault_Group:
    begin
      case PointerType1.PointerType of
      lf_Input:
      begin
        iObject := InputGroup1;
      end;
      else
        iObject := nil;
      end;
      if not assigned( iObject ) then
      begin
        iObject := ZFPFile.InputObjectWithID(StrToIntDef( Value, 0 ));
        if Assigned( iObject ) then
        begin
          if iObject is tInputGroup then
          begin
            InputGroup1 := iObject as tInputGroup;
            //PointerType1.PointerType := lf_Input;
          end
          else
          begin
            PointerType1.PointerType := lf_None;
          end;
        end
        else
        begin
          PointerType1.PointerType := lf_None;
        end;
      end;
    end;
    {
    else
    begin
      if assigned( fFieldDescriptor ) then
      begin
        if self.Value <> fFieldDescriptor.DefaultValue.Value then
        begin
          self.Value := fFieldDescriptor.DefaultValue.Value;
        end;
      end;
    end;
    }
