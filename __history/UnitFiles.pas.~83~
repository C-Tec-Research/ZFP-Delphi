  Result := CurrentObject = pGlobalObject;
  if not Result then
  begin
    case PointerType.PointerType of
      lf_None: ;
      lf_Zone: ;
      lf_Input:
      begin
        if pGlobalObject is tInputSupergroup then
        begin
          with pGlobalObject as tInputSupergroup do
          begin
            Result := ContainsObject( InputGroupPointer.InputGroup );
          end;
        end;
      end;
      lf_InputSupergroup:
      begin
        if fInputSuperGroupPointer.SuperGroup.ContainsObject( pGlobalObject ) then
        begin
          Result := TRUE;
        end;
      end;
      lf_Output:
      begin
        if pGlobalObject is tZFPSupergroup then
        begin
          with pGlobalObject as tZFPSupergroup do
