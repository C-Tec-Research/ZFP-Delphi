function tZFPFile.IncludeDevicesIn( pObjects: tObjectList; const pCurrObject : tZFPGlobalObject;
         const pPages : tLoopFieldPointerTypeEnums; const pDefaultPage : tLoopFieldPointerTypeEnum;
         const pErrorFrame : tFrameErrorList ) : boolean;
var
  iSubDevice : tLoopSubDevice;
  iNewObject : tZFPGlobalObject;
  i : integer;
  iReturnPage : tLoopFieldPointerTypeEnum;
begin
  UndoRedo.GroupUndoActive := TRUE;
  try
    Result := FALSE; // Returns TRUE ONLY IF NewObject is same class as type as original but different from it
    ClearErrorList;
    // pObjects are all subdevices
    iReturnPage := pDefaultPage;
    iNewObject := SelectFromList( 'Move Devices to...', TRUE, pCurrObject, pPages, iReturnPage );
    if iNewObject <> pCurrObject then
    begin
      if iReturnPage = pDefaultPage then
      begin
        Result := TRUE;
      end;
      // assigned the items to the new object
      for i := 0 to pObjects.Count - 1 do
      begin
        iSubDevice := pObjects[ i ] as tLoopSubDevice;
        case iReturnPage of
          lf_None: ;
          lf_Zone:
          begin
            iSubDevice.Zone := iNewObject as tZFPZone;
          end;
          lf_Input:
          begin
            if iSubDevice.IOType = sdt_Input then
            begin
              iSubDevice.InputGroup := iNewObject as tInputGroup;
            end
            else
            begin
              ErrorList.Add( es_Warning, i, 0, Translate('Attempting to assign subdevice' )
                             + ' "' + iSubDevice.ExpandedName + '" ' + Translate( 'to input group.' + ' ' +
                             Translate( 'This is not an input subdevice.'  )), iSubdevice);
            end;
          end;
          lf_InputSupergroup: ;
          lf_Output:
          begin
            if iSubDevice.IOType = sdt_Output then
            begin
              iSubDevice.OutputGroup := iNewObject as tOutputGroup;
            end
            else
            begin
              ErrorList.Add( es_Warning, i, 0, Translate('Attempting to assign subdevice' )
                             + ' "' + iSubDevice.ExpandedName + '" ' + Translate( 'to output group.' + ' ' +
                             Translate( 'This is not an output subdevice.'  )), iSubDevice);
            end;
          end;
          lf_OutputSuperGroup: ;
          lf_Mode: ;
          lf_AccessLevel: ;
          lf_Seq: ;
        end;
      end;
      if assigned( pErrorFrame ) then
      begin
        pErrorFrame.ErrorList := ErrorList;
        pErrorFrame.OnErrorDblClick := pCurrObject.OnDeviceIncludeInDoubleClick;
      end;

    end;
  finally
    UndoRedo.GroupUndoActive := FALSE;
  end;
end;

