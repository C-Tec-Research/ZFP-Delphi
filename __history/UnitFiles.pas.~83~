procedure tSequenceList.OnAddNode( const pNode : integer );
var
  i : integer;
begin
  // make sure non-editable sequences are registered to all nodes
  if Max >= 2 then
  begin
    for i := 0 to 2 do
    begin
      Sequence[ i ].RegisterAllNodes;
    end;
  end;
end;

function tSequenceList.OnAddObject(const NewObjectName: string;
  var NewObject: TObject): boolean;
var
  iSequence : tSequence;
begin
  Result := inherited OnAddObject( NewObjectName, NewObject );
  if assigned( NewObject ) and assigned( fRestrictionObject ) then
  begin
    if NewObject is tSequence then
    begin
      iSequence := NewObject as tSequence;
      if fRestrictionObject is tZFPMode then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Mode;
      end
      else if fRestrictionObject is tOutputGroup then  // includes supergroups
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Output_Group;
      end
      else if fRestrictionObject is tPulsePattern then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Sounder_Pattern;
      end
      else if fRestrictionObject is tInputGroup then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Input_Group;
      end
      else if fRestrictionObject is tInputSuperGroup then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Input_Group;
      end
      else if fRestrictionObject is tZFPZone then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Zone;
      end
      else if fRestrictionObject is tGroupAction then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Group_Action;
      end
      else if fRestrictionObject is tAccessLevel then
      begin
        iSequence.SeqStyle.ValueAsOGSeqStyle := og_Access_Level;
      end;
    end;
  end;
end;

procedure tSequenceList.OnSelectCell(Sender: TObject; ACol, ARow: Integer;
  var CanSelect: Boolean);
var
  iNode : tZFPNode;
begin
  if (ARow > 0) and (ARow <= Count ) then
  begin
    ActiveChild := ARow - 1;
    // not the title bar
    if (ACol >= cColPanel1) and (ARow > 3) { non editable lines } then
    begin
      // a panel toggle
      iNode := ZFPFile.NodeList.Node[ ACol - cColPanel1 ];
      if fEditor.Cell[ ACol, ARow ] = '1' then
      begin
        GlobalObject[ ARow - 1 ].UnregisterNode( iNode );
        fEditor.Cell[ ACol, ARow ] := '0'
      end
      else
      begin
        GlobalObject[ ARow - 1 ].RegisterNode( iNode );
        fEditor.Cell[ ACol, ARow ] := '1'
      end;
      CheckErrors;
    end
    else if ACol = 1 then
    begin

    end;
  end
  else
  begin
    ActiveChild := -1;
  end;
end;

