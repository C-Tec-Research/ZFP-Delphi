  iSaveColour, iSavePenColour, iSaveFontColour : tColor;
  //iTextHt, iTextWidth : integer;
  iText : string;
  iX, iY : integer;
begin
  // we draw an Icon from ImageListComponentPalette and and ID. If selected
  // the ID is in reverse image (white on Black) otherwise black on white.
  // Locked devices are black on silver
  if assigned( fDeviceGrid ) then
  begin
    with fDeviceGrid do
    begin
      iCellIndex := ARow * ColCount + ACol + 1;
      iImageIndex := CellIcon[ iCellIndex ];
      //if iCellIndex > Loop.MaxDevicesOnCurrentLoop then
      if iImageIndex = -1 then
      begin
        iSaveColour := Canvas.Brush.Color;
        iSavePenColour := Canvas.Pen.Color;
        Canvas.Brush.Color := clWhite;
        Canvas.Pen.Color := clWhite;
        Canvas.Rectangle( Rect.Left, Rect.Top, Rect.Right+1, Rect.Bottom+1 );
        Canvas.Brush.Color := iSaveColour;
        Canvas.Pen.Color := iSavePenColour;
      end
      else
      begin
        if iImageIndex < ImageListComponentPalette.Count then
        begin
          ImageListComponentPalette.Draw( Canvas, Rect.Left, Rect.Top, iImageIndex );
        end
        else
        begin
          iSaveColour := Canvas.Brush.Color;
          Canvas.Brush.Color := clSilver;
          Canvas.Rectangle( Rect.Left, Rect.Top, Rect.Right, Rect.Bottom );
          Canvas.Brush.Color := iSaveColour;
        end;
        iSaveColour := Canvas.Brush.Color;
        iSaveFontColour := Canvas.Font.Color;
        //if gdSelected in State then
        if CellLocked[ iCellIndex ] then
        begin
          Canvas.Brush.Color := clSilver;
          Canvas.Font.Color := clBlack;
        end
        else if iCellIndex = fDragStart then
        begin
          Canvas.Brush.Color := clGreen;
          Canvas.Font.Color := clWhite;
        end
        else if iCellIndex = fDragEnd then
        begin
          Canvas.Brush.Color := clBlue;
          Canvas.Font.Color := clWhite;
        end
        else if iCellIndex <= fDeviceEditPending then
        begin
          if fDeviceEditRemoving then
          begin
            Canvas.Brush.Color := clWhite;
            Canvas.Font.Color := clBlack;
          end
          else
          begin
            Canvas.Brush.Color := clBlack;
            Canvas.Font.Color := clWhite;
          end;
        end
        else if iCellIndex <= fDeviceEditCurrent.DSMList  then
        begin
          Canvas.Brush.Color := clBlack;
          Canvas.Font.Color := clWhite;
        end
        else
        begin
          Canvas.Brush.Color := clWhite;
          Canvas.Font.Color := clBlack;
        end;
        iText := CellText[ iCellIndex ];
        Canvas.Rectangle( Rect.Left, Rect.Top + ImageListComponentPalette.Height, Rect.Right, Rect.Bottom);
        iY := (Rect.Top + ImageListComponentPalette.Height + Rect.Bottom - Canvas.TextHeight( iText )) div 2;
        iX := (Rect.Left + Rect.Right - Canvas.TextWidth( iText )) div 2;
        Canvas.TextOut( iX, iY, iText );
        Canvas.Brush.Color := iSaveColour;
        Canvas.Font.Color := iSaveFontColour;
      end;
    end;
  end;
  {
  if assigned( fSigNETStringGridDevicesDrawCell ) then
  begin
    fSigNETStringGridDevicesDrawCell( Sender, ACol, ARow, Rect, State );
  end;
  }
end;

procedure tLoopDevices.SigNETStringGridDevicesEndDrag(Sender, Target: TObject;
  X, Y: Integer);
var
  ARow, ACol : integer;
begin
  // swap values if drag successful
  if assigned( Target ) then
  begin
    with fDeviceGrid do
    begin
      MouseToCell( X, Y, ACol, ARow );
      fDragEnd := ARow * ColCount + ACol + 1;
    end;
    if (fDragStart >= 0) and (fDragEnd >= 0) then
    begin
      if (fDragStart <> fDragEnd) then
      begin
        // swap devices, sub devices etc.
        case DeviceEditMode of
          demNotDefined: ;
          demDevices:
          begin
            // need to swap devices fDragStart and fDragEnd
            SwapDevices( fDragStart -1, fDragEnd - 1);
          end;
          demDeviceEntries:
          begin
            SwapDevices( VisibleLoopDeviceIndex[ fDragStart - 1 ], VisibleLoopDeviceIndex[ fDragEnd - 1] );
          end;
          demSubDeviceEntries: ;
        end;
      end;
    end;
  end;
  if fDragEnd <> -1 then
  begin
    fDeviceEditCurrent.Value := IntToStr( fDragEnd );
  end
  else if fDragStart <> -1 then
  begin
    fDeviceEditCurrent.Value := IntToStr( fDragStart );
  end;
  fDragStart := -1;
  fDragEnd := -1;
  SigNETStringGridDevicesDragging := FALSE;
  RefreshEditors;
  //fDeviceGrid.Invalidate;
end;

procedure tLoopDevices.SigNETStringGridDevicesMouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  ACol, ARow : integer;
  iCellIndex : integer;
begin
  //if assigned( fSigNETStringGridDevicesMouseDown ) then
  //begin
  //  fSigNETStringGridDevicesMouseDown( Sender, Button, Shift, X, Y );
  //end;
  with fDeviceGrid do
  begin
    MouseToCell( X, Y, ACol, ARow );
    iCellIndex := ARow * ColCount + ACol + 1;
    // If the Alt key (but not shift or Ctrl) and Left Mouse button
    // held down then we start the drag process to swap devices
    if Shift = [ ssAlt, ssLeft ] then
    begin
      case DeviceEditMode of
        demNotDefined: ;
        demDevices,
        demDeviceEntries:
        begin
          fDragStart := iCellIndex;
          fDeviceGrid.BeginDrag( TRUE );
        end;
        demSubDeviceEntries: ;
      end;
    end
    else
    begin
      fDeviceEditPending := iCellIndex;
      if not (ssCtrl in Shift) then
      begin
        // not adding
        if fDeviceEditCurrent.DSMList <> -1 then
        begin
          fDeviceEditCurrent.Value := '';
          fDeviceEditRemoving := FALSE;
          Invalidate;
        end;
      end
      else
      begin
        fDeviceEditRemoving := iCellIndex <= fDeviceEditCurrent.DSMList;
      end;
      SigNETStringGridDevicesMouseIsDown := TRUE;
    end;
  end;
end;

procedure tLoopDevices.SigNETStringGridDevicesMouseMove(Sender: TObject;
  Shift: TShiftState; X, Y: Integer);
var
  ACol, ARow : integer;
  iCellIndex : integer;
  i: integer;
begin
  with fDeviceGrid do
  begin
    MouseToCell( X, Y, ACol, ARow );
    iCellIndex := ARow * ColCount + ACol + 1;
    if iCellIndex <= 0 then
    begin
      exit;
    end;
    if SigNETStringGridDevicesDragging then
    begin
    end
    else if SigNETStringGridDevicesMouseIsDown then
    begin
      if fDeviceEditPending.Finish > iCellIndex then
      begin
        for i := fDeviceEditPending.Finish - 1 downto iCellIndex - 1 do
        begin
          ARow := i div ColCount;
          ACol := i mod ColCount;
          invalidate;
          //InvalidateCell( ACol, ARow );
        end;
        fDeviceEditPending.Finish := iCellIndex;
      end
      else if fDeviceEditPending.Finish < iCellIndex then
      begin
        for i := fDeviceEditPending.Finish - 1 to iCellIndex - 1 do
        begin
          ARow := i div ColCount;
          ACol := i mod ColCount;
          Invalidate; //Cell( ACol, ARow );
        end;
        fDeviceEditPending.Finish := iCellIndex;
      end;
    end;

  end;
  //if assigned( fSigNETStringGridDevicesMouseMove ) then
  //begin
  //  fSigNETStringGridDevicesMouseMove( Sender, Shift, X, Y );
  //end;
end;

procedure tLoopDevices.SigNETStringGridDevicesMouseUp(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  i: Integer;
  iStart, iEnd : integer;
  iDevice : tDevice;
  iDeviceEditPending : tDSMList;
  iCellIndex : integer;
  ARow, ACol : integer;
  iText : string;
begin
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    if SigNETStringGridDevicesDragging then
    begin
      with fDeviceGrid do
      begin
        MouseToCell( X, Y, ACol, ARow );
        iCellIndex := ARow * ColCount + ACol + 1;
        if CellIcon[ iCellIndex ] < 0 then
        begin
          EndDrag( FALSE );
        end
        else
        begin
          fDragEnd := iCellIndex;
          if fDragStart = fDragEnd then
          begin
            EndDrag( FALSE );
          end
          else
          begin
            EndDrag( TRUE );
          end;
        end;
      end;
    end
    else
    begin
      SigNETStringGridDevicesMouseIsDown := FALSE;
      if (ssCtrl in Shift) then
      begin
        if self.fDeviceEditRemoving then
        begin
          fDeviceEditCurrent.Value := fDeviceEditCurrent.DSMList - fDeviceEditPending;
        end
        else
        begin
          fDeviceEditCurrent.Value := fDeviceEditCurrent.DSMList + fDeviceEditPending;
        end;
      end
      else
      begin
        if fDeviceEditCurrent.DSMList <> fDeviceEditPending then
        begin
          iDeviceEditPending := fDeviceEditPending;
          fDeviceEditCurrent.Value := iDeviceEditPending;
          case DeviceEditMode of
            demNotDefined: ;
            demDevices:
            begin
              fDeviceGrid.Invalidate;
            end;
            demDeviceEntries: ;
            demSubDeviceEntries: ;
          end;
        end;
      end;
      case DeviceEditMode of
        demNotDefined: ;
        demDevices:
        begin
          if Loop.DeviceTypeEditor.ItemIndex >= 0 then
          begin
            iDevice := tDevice( Loop.DeviceTypeEditor.Items[ Loop.DeviceTypeEditor.ItemIndex ].Data );
            if fDeviceEditPending.Start >= 0 then
            begin
              if fDeviceEditPending.Start <= fDeviceEditPending.Finish then
              begin
                iStart := fDeviceEditPending.Start;
                iEnd := fDeviceEditPending.Finish;
              end
              else
              begin
                iStart := fDeviceEditPending.Finish;
                iEnd := fDeviceEditPending.Start;
              end;
              iText := Translate( 'Loop' ) + ' ' + IntToStr( Loop.LoopAddress.ValueAsInt ) +' ' + Translate( 'Device' ) + ' ';
              FormReplace.RememberAnswer := FALSE;
              for i := iStart - 1 to iEnd - 1 do
              begin
                if i < Loop.MaxDevicesOnCurrentLoop then //BUG0000047
                begin
                  if not LoopDevice[ i ].Locked then
                  begin
                    if LoopDevice[ i ].DeviceMap.ValueAsInt <> iDevice.DeviceMap.ValueAsInt then
                    begin
                      if FormReplace.Execute( LoopDevice[ i ].DeviceImage,
                          Loop.Protocol.DeviceList.DeviceWithMapping[ iDevice.DeviceMap ].ImageIndex, iText + IntToStr( i + 1 ), iStart = iEnd )then
                      begin
                        if Loop.LoopType = ltNormal then
                        begin
                          if LoopDevice[ i ].DeviceMap.ValueAsInt = 0 then //New Device
                          begin
                            LoopDevice[ i ].DeviceMap.ValueAsInt := iDevice.DeviceMap.ValueAsInt;
                          end
                          else //Device Replaced
                          begin
                            UpdateSubDevices(LoopDevice[ i ], iDevice.DeviceMap.ValueAsInt); //BUG0000063
                          end;
                        end
                        else
                        begin
                          LoopDevice[ i ].DeviceMap.ValueAsInt := iDevice.DeviceMap.ValueAsInt;
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
        demDeviceEntries: ;
        demSubDeviceEntries: ;

      end;
      fDeviceEditPending := -1;
      RefreshEditors;

      //if assigned( fSigNETStringGridDevicesMouseUp ) then
      //begin
      //  fSigNETStringGridDevicesMouseUp( Sender, Button, Shift, X, Y );
      //end;
    end;
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

