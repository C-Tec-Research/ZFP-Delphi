procedure tLoopSubDevice.SetIOType(const Value: tSubDeviceType);
begin
  case Value of
    sdt_Not_Fitted:
    begin
      fIOType2.ValueAsInt := Ord( Value );
    end;
    else
    begin
      case PermittedIOType of
        sdt_User_Selectable:
        begin
          if fIOType2.ValueAsInt <> Ord( Value ) then
          begin
            fIOType2.ValueAsInt := Ord( Value );
            if IORequiresEditorRebuild then
            begin
              case Value of
                sdt_Input:
                begin
                  fRef.ValueAsInt := fInputRef;
                end;
                sdt_Output:
                begin
                  fRef.ValueAsInt := fOutputRef;
                end;
              end;
              // rebuild the fields
              Device.SetLoopSubDeviceFields( self );
              //if IamActiveChild then
              //begin
              //  Loop.LoopDevices.BuildSubDeviceFieldEditor;
              //end;
            end;
          end;
        end;
        else
        begin
          if PermittedIOType = Value then
          begin
            fIOType2.ValueAsInt := Ord( Value );
            if IORequiresEditorRebuild then
            begin
              if fIOType2.ValueAsInt <> Ord( Value ) then
              begin
                // rebuild the fields
                Device.SetLoopSubDeviceFields( self );
                //if IamActiveChild then
                //begin
                //  Loop.LoopDevices.BuildSubDeviceFieldEditor;
                //end;
              end;
            end;
          end
          else
          begin
            raise Exception.Create('Cannot set subdevice here');
          end;
        end;
      end;
    end;
  end;
end;

