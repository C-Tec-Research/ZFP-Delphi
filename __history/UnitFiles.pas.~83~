procedure tLoopDevice.SetLoopSubDeviceFields( const pSubDev : integer );
var
//  iNewSubDeviceMax : integer;
//  i,
  j: integer;
  iNewFieldMax : integer;
  iFieldDescriptor : tDeviceField;
  //iSubDeviceType : tSubDeviceType;
  iSubdevices : tSubDeviceList;
  iSubdevice : tSubDevice;
  iDevice : tDevice;
  iRef : integer;
  iLoopSubdevice : TLoopSubDevice;
  iGlobalObject : TZFPGlobalObject;
begin
  {
    There are 3 situations here
    if UseVariableSubdevices is FALSE, then the field count is fixed for each subdevice.
    if UseVariableSubdevices is TRUE and the subdevice count is 1, then again the
       field count is fixed, but this time the fields for each subdevice are copied over
       from subdevice 1, provided that the subdevice is valid at this location.
    if UseVariableSubdevices is true and the subdevice count is greater than 1 then the fields
       are variable, and not finalised until the subdevice type is selected. In this case there
       is an extra 'field' listing possible subdevice types, so the field editor is dynamic
       in this case. However this could be restricted by the ValidOnSubdevices field.

    Note that for subdevice 0 the old way is ALWAYS used
  }
  iDevice := Protocol.DeviceList.DeviceWithMapping[ DeviceMap ];

  if assigned( iDevice ) then  //JG
  begin
    iSubdevices := iDevice.SubDevices;
    if (pSubDev = 0) or (not UseVariableSubdevices) then
    begin
      // the old way
      iSubDevice := iSubDevices.SubDevice[ pSubDev ];
      iNewFieldMax := iSubDevice.FieldList.Max;
      with SubDevice[ pSubDev ] do
      begin
        if iNewFieldMax <> Fields.Max  then
        begin
          Fields.Max := iNewFieldMax;
        end;
        for j := 0 to iNewFieldMax do
        begin
          iFieldDescriptor := Protocol.DeviceList.DeviceWithMapping[ DeviceMap ].SubDevices.SubDevice[ pSubDev ].FieldList.DeviceField[ j ];
          if iFieldDescriptor <> Field[ j ].FieldDescriptor then
          begin
            Field[ j ].FieldDescriptor := iFieldDescriptor;
          end
          else
          begin
            Field[ j ].FieldDescriptor := iFieldDescriptor;
          end;
        end;
      end;
    end
    else
    begin
      with SubDevice[ pSubDev ] do
      begin
        // decide if we need our 'Extra' field here
        // There is an added complication in that if there are exactly 1 input device
        // and exactly 1 output device then we do not need the extra field, because
        // that function is handled by the IO selection, but MaxSubdevicesValidAt handles that.
        FieldListIsUserSelectable := iSubDevices.MaxSubdevicesValidAt( pSubDev, fIORequiresEditorRebuild,
                                     fInputRef, fOutputRef, iRef ) > 1;
        // Use the dereferenced subdevice to get field values.
        Ref.ValueAsInt := iRef;
        if iRef = 0 then
        begin
          iRef := 1;
          if fIORequiresEditorRebuild then
          begin
            case IOType of
              sdt_Input: iRef := fInputRef;
              sdt_Output: iRef := fOutputRef;
              sdt_User_Selectable: ;
              sdt_Other: ;
              sdt_Not_Fitted: ;
            end;
          end;
        end
        else if iRef > iSubDevices.Max then
        begin
          // no longer valid - revert to 1
          iRef := 1;
        end;
        iSubDevice := iSubDevices.SubDevice[ iRef ];
        iNewFieldMax := iSubDevice.FieldList.Max;
        with SubDevice[ pSubDev ] do
        begin
          if iNewFieldMax <> Fields.Max  then
          begin
            Fields.Max := iNewFieldMax;
          end;
          for j := 0 to iNewFieldMax do
          begin
            //iFieldDescriptor := Protocol.DeviceList.DeviceWithMapping[ DeviceMap ].SubDevices.SubDevice[ pSubDev ].FieldList.DeviceField[ j ];
            iFieldDescriptor := iSubDevice.FieldList.DeviceField[ j ];
            if iFieldDescriptor <> Field[ j ].FieldDescriptor then
            begin
              Field[ j ].FieldDescriptor := iFieldDescriptor;
            end;
          end;
        end;
      end;
    end;
    // now check innpt group, output group and zone usage
    iLoopSubdevice := SubDevice[ pSubDev ];
    iGlobalObject := iLoopSubdevice.InputGroup;
    if assigned( iGlobalObject ) then
