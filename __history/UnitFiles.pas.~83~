{ tLogoFile }

procedure tLogoFile.ExportFile(const pPanel: integer; pList: tStrings;
  const FileOverride: string; const ClearOnEntry: boolean);
var
  i: Integer;
  iLine : string;
begin
  //inherited;
  // we divert this by using the LogoData property. We ignore the File override and ClearOnEntry in this case
  {
  LogoData.AssignTo( pList );
  with pList do
  begin
    if Count > 1 then
    begin
      Strings[ 0 ] := '300,BEGIN,' + IntToStr( pPanel );
      Strings[ 1 ] := '300,1,"' + FileOverride + '"';
      Strings[ Count - 1 ] := '300,END,' + IntToStr( pPanel );
    end;
  end;
  }
  with pList do
  begin
    pList.Clear;
    Add( '300,BEGIN,' + IntToStr( pPanel ) ); // 0
    Add( '300,1,"' + FileOverride + '"' );    // 1
    for i := 2 to LogoData.Lines.Count - 1 do
    begin
      iLine := Trim( LogoData.Lines[ i ] );
      if iLine <> '' then
      begin
        Add( iLine );
      end;
    end;
    Strings[ Count - 1 ] := '300,END,' + IntToStr( pPanel );
  end;
end;

procedure tLogoFile.ImportLogoFile(const iLineAsList : tInfiniteStringList; const pFile: tStrings; var iIndex: integer;
  const pErrors: tErrorList; const pErrorObject: tObject);
var
  iErrText : string;
begin
  // iIndex will already be pointing at name record, back off 1
  LogoData.Clear;
  dec( iIndex, 2 );
  while iIndex < pFile.Count do
  begin
    inc( iIndex );
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "END" found');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      exit;
    end;
    CommaListToStringList( pFile[ iIndex ], iLineAsList, TRUE );
    if iLineAsList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
      continue;
    end;
    if iLineAsList[ 0 ] <> '300' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + iLineAsList[0] + '" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 );
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      continue;
    end;
    LogoData.Add( pFile[ iIndex ] );
    // decide which child, if any
    if iLineAsList[ 1 ] = 'END' then
    begin
      // done
      exit;
    end;
  end;
end;

function tLogoFile.Load(pFile: tStrings; var pLine: integer; const pAllowUndo,
  pIsDirty: boolean; pErrors: tErrorList): boolean;
begin
  Result := inherited;
  // not saved, so if we load this we must create the new version, LogoData
  if FileExists then
  begin
    inherited ExportFile( 0, LogoData.Lines, Value );
  end
  else
  begin
    pErrors.Add( es_Error, pLine, 0, Translate( 'Logo Image File not found' ));
  end;
end;

procedure tLogoFile.LoadImage(pFileName: string);
begin
  Value := pFileName;
