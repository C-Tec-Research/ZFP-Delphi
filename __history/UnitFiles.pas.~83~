function tCETreeOutputObject.ImageIndex: integer;
var
  iInputGroup : tInputGroup;
begin

  case fPointerType.PointerType of
    lf_Zone:              Result := 8;
    lf_Input:
    begin
      iInputGroup := InputGroupPointer.InputGroup;
      if assigned( iInputGroup ) then
      begin
        case iInputGroup.IGStyle of
          igs_Classic: Result := 1;
          igs_Switch:  Result := 12;
          igs_AND:     Result := 11;
          else         Result := 1;
        end;
      end
      else
      begin
        Result := 1;
      end;
    end;
    lf_OutputSuperGroup:  Result := 7;
    lf_InputSuperGroup:   Result := 10;
    lf_Mode:              Result := 3;
    lf_AccessLevel:       Result := 9;
    else                  Result := 6; // by default output group

  end;
end;

procedure tCETreeOutputObject.OnOutputChange(Sender: tObject);
var
  iNewObject : tZFPGlobalObject;
  iOldObject : tZFPGlobalObject;
  iParentObject : tSequence;
  iIndex : integer;
  iParent : tCETreeProperty;
  iDefaultPage : tLoopFieldPointerTypeEnum;
begin
  iParent := Parent;
  iParentObject := nil;
  if assigned( iParent ) then
  begin
    if iParent is tCETreeAction then
    begin
      iParentObject := (iParent as tCETreeAction).Seq.Sequence;
    end;
  end;

  iDefaultPage := fPointerType.PointerType;

  case fPointerType.PointerType of
    lf_Zone:              iOldObject := ZonePointer.Zone;
    lf_Input:             iOldObject := InputGroupPointer.InputGroup;
    lf_Output:            iOldObject := OutputGroupPointer.OutputGroup;
    lf_OutputSuperGroup:  iOldObject := OutputSuperGroupPointer.SuperGroup;
    lf_InputSuperGroup:   iOldObject := InputSuperGroupPointer.SuperGroup;
    lf_Mode:              iOldObject := ModePointer.Mode;
    lf_AccessLevel:       iOldObject := AccessLevelPointer.AccessLevel;
    else                  iOldObject := nil;

  end;

  if not assigned( iOldObject ) then
  begin
    iDefaultPage := lf_Output;
  end;

  if assigned( iParentObject ) then
  begin
    case iParentObject.SeqStyle.ValueAsOGSeqStyle of
      og_Mode:
      begin
        if iDefaultPage = lf_Mode then
        begin
          iNewObject := ZFPFile.SelectFromList( 'Select Mode', TRUE, iOldObject, [lf_Mode],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end
        else
        begin
          iDefaultPage := lf_Mode;
          iNewObject := ZFPFile.SelectFromList( 'Select Mode', TRUE, nil, [lf_Mode],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end;
      end;
      og_Output_Group:
      begin
        if iDefaultPage = lf_Output then
        begin
          iNewObject := ZFPFile.SelectFromList( 'Select Output', TRUE, iOldObject, [lf_Output, lf_OutputSuperGroup],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end
        else
        begin
          iDefaultPage := lf_Output;
          iNewObject := ZFPFile.SelectFromList( 'Select Output', TRUE, nil, [lf_Output, lf_OutputSuperGroup],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end;
      end;
      og_Supergroup:
      begin
        iNewObject := ZFPFile.SelectFromList( 'Select Output', TRUE, iOldObject, [lf_OutputSuperGroup],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
      end;
      og_Trigger,
      og_Input_Group:
      begin
        if iDefaultPage in [lf_Input, lf_InputSupergroup ] then
        begin
          iNewObject := ZFPFile.SelectFromList(  'Select Input', TRUE, iOldObject, [lf_Input, lf_InputSupergroup],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end
        else
        begin
          iDefaultPage := lf_Input;
          iNewObject := ZFPFile.SelectFromList(  'Select Input', TRUE, nil, [lf_Input, lf_InputSupergroup],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end;
      end;
      og_Zone:
      begin
        if iDefaultPage = lf_Zone then
        begin
          iNewObject := ZFPFile.SelectFromList(  'Select Zone', TRUE, iOldObject, [lf_Zone],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end
        else
        begin
          iDefaultPage := lf_Zone;
          iNewObject := ZFPFile.SelectFromList(  'Select Zone', TRUE, nil, [lf_Zone],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end;
      end;
      og_Access_Level:
      begin
        if iDefaultPage = lf_AccessLevel then
        begin
          iNewObject := ZFPFile.SelectFromList( 'Select Access Level', TRUE, iOldObject, [lf_AccessLevel],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end
        else
        begin
          iDefaultPage := lf_AccessLevel;
          iNewObject := ZFPFile.SelectFromList(  'Select Access Level', TRUE, nil, [lf_AccessLevel],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
        end;
      end;
      else
      begin
        iNewObject := ZFPFile.SelectFromList(  'Select', TRUE, iOldObject, [lf_Zone, lf_Input,
                lf_Output, lf_InputSupergroup, lf_OutputSuperGroup, lf_Mode, lf_AccessLevel],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
      end;
    end;
  end
  else
  begin
    iNewObject := ZFPFile.SelectFromList(  'Select', TRUE, iOldObject, [lf_Zone, lf_Input,
                lf_Output, lf_InputSupergroup, lf_OutputSuperGroup, lf_Mode, lf_AccessLevel],
                iDefaultPage, AppliesToPanels ) as tZFPGlobalObject;
  end;
  if iNewObject <> iOldObject then
  begin
    if assigned( iOldObject ) then
    begin
      iOldObject.ClearFieldEditors;
    end;
    EditorList.ClearFromIndex( 1 );
    if not assigned( iNewObject ) then
    begin
      fPointerType.PointerType := lf_None;
    end
    else if iNewObject is tZFPZone then
    begin
      fPointerType.PointerType := lf_Zone;
      ZonePointer.Zone := iNewObject as tZFPZone;
    end
    else if iNewObject is tInputGroup then
    begin
      fPointerType.PointerType := lf_Input;
      InputGroupPointer.InputGroup := iNewObject as tInputGroup;
    end
    else if iNewObject is tZFPSuperGroup then  // must be done before tOutputGroup because tOutputGroup is ancestor of tZFPSupergroup
    begin
      fPointerType.PointerType := lf_OutputSuperGroup;
      OutputSuperGroupPointer.SuperGroup := iNewObject as tZFPSuperGroup;
    end
    else if iNewObject is tInputSuperGroup then  // must be done before tOutputGroup because tOutputGroup is ancestor of tZFPSupergroup
    begin
      fPointerType.PointerType := lf_InputSuperGroup;
      InputSuperGroupPointer.SuperGroup := iNewObject as tInputSuperGroup;
    end
    else if iNewObject is tOutputGroup then
    begin
      fPointerType.PointerType := lf_Output;
      OutputGroupPointer.OutputGroup := iNewObject as tOutputGroup;
    end
    else if iNewObject is tZFPMode then
    begin
      fPointerType.PointerType := lf_Mode;
      ModePointer.Mode := iNewObject as tZFPMode;
    end
    else if iNewObject is tAccessLevel then
    begin
      fPointerType.PointerType := lf_AccessLevel;
      AccessLevelPointer.AccessLevel := iNewObject as tAccessLevel;
    end
    else
    begin
      fPointerType.PointerType := lf_None;
    end;
    if assigned( iNewObject ) then
    begin
      iIndex := 1;
      iNewObject.AddOrUpdateExtraFields2( EditorList, iIndex );
      fOutputEditor.EditorAsButton.Caption := iNewObject.ListName;
      TreeText := iNewObject.ListName;
      //TreeText := '[' + iNewObject.Index + '] ' + iNewObject.ListName;  //JG
    end
    else
    begin
      fOutputEditor.EditorAsButton.Caption := ChevronText( 'Select' );
      TreeText := ChevronText( 'Unknown' );
    end;
    fOutputEditor.LabelText := fPointerType.LabelText;
    TreeNode1.ImageIndex := ImageIndex;
    TreeNode1.SelectedIndex := ImageIndex + cSelectedOffset;
  end;


