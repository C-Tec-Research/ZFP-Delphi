procedure tZFPFile.ImportBinaryFile(const pFile: tStrings; var iIndex: integer;
  const pErrors: tErrorList; const pErrorObject: tObject);
var
  iLineAsList : tInfiniteStringList;
  iErrText : string;
  iAllowUpdate : boolean;
begin
  iLineAsList := tInfiniteStringList.Create;
  iAllowUpdate := TRUE;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "BEGIN" found');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    CommaListToStringList( pFile[ iIndex ], iLineAsList, TRUE );
    if iLineAsList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iLineAsList[ 0 ] <> '300' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + iLineAsList[0] + '" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 );
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iLineAsList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 );
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      iAllowUpdate := FALSE;
    end;
    if iAllowUpdate then
    begin
      inc( iIndex );
      CommaListToStringList( pFile[ iIndex ], iLineAsList, TRUE );
      // decide which child, if any
      if iLineAsList[ 1 ] = 'END' then
      begin
        // done
        exit;
      end
      else if iLineAsList[ 1 ] = '1' then
      begin
        // legal file
        if SameText( iLineAsList[ 2 ], '\Images\Logo.gif' )  then
        begin
          ImportLogoFile( iLineAsList, pFile, iIndex, pErrors, pErrorObject );
        end
        else
        begin
          ImportBinaryFile( iLineAsList, iLineAsList[ 2 ], pFile, iIndex, pErrors, pErrorObject );
        end;
      end
      else
      begin
        iErrText := Translate( 'Missing File Name') + ' ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 );
        pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, pErrorObject);
      end;
      // else
    end;
  finally
    iLineAsList.Free;
  end;
end;

