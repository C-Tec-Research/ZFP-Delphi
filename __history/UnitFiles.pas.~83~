  try
    iMonth := StrToInt( pList[ pStartCol + 1 ] );
  except
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( tErrorSeverity.es_Error, pLine, pStartCol + 1, iErrText, pErrorObject );
    exit;
  end;
  try
    iYear := StrToInt( pList[ pStartCol + 2 ] );
    if iYear < 2000 then
    begin
      iYear := iYear + 2000;
    end;
  except
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( tErrorSeverity.es_Error, pLine, pStartCol + 2, iErrText, pErrorObject );
    exit;
  end;
  try
    MaintenanceDate.ValueAsDateTime := EncodeDate( iYear, iMonth, iDay);
  except
    iErrText := Translate( 'Illegal Date');
    pErrors.Add( tErrorSeverity.es_Error, pLine, pStartCol, iErrText, pErrorObject );
  end;
