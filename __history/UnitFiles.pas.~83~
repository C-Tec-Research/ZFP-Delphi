procedure tCETreeEmptyView.ExportCausesFile(const pPanel: tZFPNode;
  const pStrings: tStrings; const pErrors : tErrorList);
var
  iLine : tCELines;
  i: Integer;
  iValidFlags : tCETreeValidFlags;
begin
  // firstly we need to convert our tree structure into a flat one.
  // to do this we populate a type CELine Object then move down our tree
  iLine := tCELines.Create;
  iValidFlags := [];
  CheckValid( pErrors, iValidFlags );
  try
    for i := 0 to Children.Count - 1 do
    begin
      if Entry[ i ] is tCETreeProperty then
      begin
        with Entry[ i ] as tCETreeProperty do
        begin
          ExportLines( pPanel, iLine, pErrors );
        end;
      end;
    end;
    iLine.AddCELines( pStrings );
  finally
    iLine.Free;
  end;

end;

