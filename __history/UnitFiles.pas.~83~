function tLoopDevices.GetVisibleLoopDevice(const i: integer): tLoopDevice;
var
  j, k : integer;
begin
  k := i;
  for j := 0 to Max do
  begin
    Result := LoopDevice[ j ];
    if Result.IOType <> sdt_Not_Fitted then
    begin
      if k = 0 then
      begin
        exit;
      end
      else
      begin
        dec( k );
      end;
    end;
  end;
  // else
  Result := nil;
end;

function tLoopDevices.GetVisibleLoopDeviceIndex(const i: integer): integer;
var
  j, k : integer;
  iDevice : tLoopDevice;
begin
  k := i;
  for j := 0 to Max do
  begin
    iDevice := LoopDevice[ j ];
    if iDevice.IOType <> sdt_Not_Fitted then
    begin
      if k = 0 then
      begin
        Result := j;
        exit;
      end
      else
      begin
        dec( k );
      end;
    end;
  end;
  // else
  Result := -1;
end;

function tLoopDevices.GetVisibleLoopSubDevice(const iPos: integer): tLoopSubDevice;
var
  j, k, l : integer;
  iDevice : tLoopDevice;
begin
  k := iPos;
  for j := 0 to Max do
  begin
    iDevice := LoopDevice[ j ];
    if iDevice.IOType <> sdt_Not_Fitted then
    begin
      l := iDevice.SubDeviceCount; // subdevice 0 = device!
      if k <= l then
      begin
        Result := iDevice.SubDevice[ k ];
        exit;
      end
      else
      begin
        dec( k, l );
      end;
    end;
  end;
  // else
  Result := nil;
end;

