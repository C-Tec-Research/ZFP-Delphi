procedure tZFPNode.ImportDeviceFieldsFile( const pFile: tStrings; var iIndex : integer;
                          pErrors : tErrorList; const pErrorObject : tObject );
var
  pList : tInfiniteStringList;
  iErrText : string;
  iAllowLoad : boolean;
  iErrorObject : tObject;
begin
  if assigned( pErrorObject ) then
  begin
    iErrorObject := pErrorObject;
  end
  else
  begin
    iErrorObject := self;
  end;
  iAllowLoad := TRUE;
  pList := tInfiniteStringList.Create;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "BEGIN" ');
      pErrors.Add( tErrorSeverity.es_Error, 0, iErrText, iErrorObject);
      iAllowLoad := FALSE;
    end;
    CommaListToStringList( pFile[ iIndex ], pList, TRUE );
    if PList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, iErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 0 ] <> '20' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, iErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 1, iErrText, iErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 2 ] <> NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + pList[ 2 ] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, iErrorObject);
      iAllowLoad := FALSE;
    end;
    inc( iIndex );
    if iAllowLoad then
    begin
      ClearDevices;
      LoopList.ImportDeviceFieldsFile( pFile, iIndex, pList, pErrors, iErrorObject );
    end;
  finally
    pList.Free;
  end;
end;

