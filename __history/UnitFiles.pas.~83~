procedure tPulsePattern.AddOrUpdateExtraEditors2(
  pToEditor: TSigVariableEditorList; var pIndex: integer);
var
  i: Integer;
  iMax : integer;
  iPatternEditor : TSigVariableEditor;
begin
  //inherited;
  iMax := CycleIndex.ValueAsInt;
  if iMax <= 0 then
  begin
    iMax := cMax + 1;
  end;

  for i := 1 to cMax do
  begin
    if pToEditor = fFieldEditor then
    begin
      fFieldPatternEditor[ i ] := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fFieldPatternEditor[ i ] ) then
      begin
        fFieldPatternEditor[ i ].EditorStyle := vesImage;
      end
      else
      begin
        fFieldPatternEditor[ i ] := pToEditor.Add( vesImage );
      end;
      iPatternEditor := fFieldPatternEditor[ i ];
    end
    else
    begin
      fToPatternEditor[ i ] := pToEditor.Editor[ pIndex ];
      inc( pIndex );
      if assigned( fToPatternEditor[ i ] ) then
      begin
        fToPatternEditor[ i ].EditorStyle := vesImage;
      end
      else
      begin
        fToPatternEditor[ i ] := pToEditor.Add( vesImage );
      end;
      iPatternEditor := fToPatternEditor[ i ];
    end;


    with iPatternEditor do
    begin
      ImageList := self.ImageList;
      Tag := i;
      LabelText := Translate( 'Interval' ) + ' ' + IntToStr( i )  + '   (' + Translate( cPeriod ) + ')';
      with EditorAsImage do
      begin
        Tag := i;
        // image indexes
        // blank = 0 = False
        // ticked = 1 = true
        // disabled = 3
        // cycle = 5
        if i < iMax then
        begin
          if PulseState[ i ] then
          begin
            ImageIndex := 1;
          end
          else
          begin
            ImageIndex := 0;
          end;
        end
        else if i = iMax then
        begin
          ImageIndex := 5;
        end
        else
        begin
          ImageIndex := 3;
        end;
      end;
      OnChange := fOnPulseStateChange;
    end;
  end;
end;

function tPulsePattern.CheckSelection(pWithObject: tZFPGlobalObject): boolean;
var
  i : integer;
