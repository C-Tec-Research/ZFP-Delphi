  i : integer;
  iFieldArray : tFieldArray;
  iString : string;
  iDeviceIDOnLoop : integer;
begin
  iFieldArray.Zero;
  iFieldArray[ 0 ] := pDeviceIDOnLoop mod 256;
  iFieldArray[ 1 ] := pDeviceIDOnLoop div 256;
  SubDevice[ pSubdevice ].ExportDeviceFieldsFile2( iFieldArray, pErrors );
  iDeviceIDOnLoop := iFieldArray[ 0 ] + 256 * iFieldArray[ 1 ];
  iString := pString + ',' + IntToStr( iDeviceIDOnLoop );
  for i := 2 to 31 do
  begin
    iString := iString + ',' + IntToStr( iFieldArray.Data[ i ] );
  end;
  pFile.Add( iString );
end;

procedure tLoopSubDevices.ExportNamesFile(const pFile: tStrings; const pLoop : tLoop; const pDevice : tLoopDevice;
          const pErrors : TErrorList);
var
  i: Integer;
  iSubDevice : tLoopSubDevice;
  iString : string;
  iName : string;
begin
  if pLoop.LoopType <> ltA_Bus then
  begin
    iString := '2,' + pLoop.LoopAddress.Value + ',' + IntToStr( StrToInt(pDevice.Index) + 1 ) + ',';
    //for i := 1 to Max do
    for i := 0 to 4 do
    begin
      iSubDevice := SubDevice[ i ];
      if assigned( iSubDevice ) then
      begin
        iName := iSubDevice.ExpandedName;
        pFile.Add( iString + IntToStr( i ) + ',' + iName );
        if (i = 0) and (iName = '') then
        begin
          if pLoop.LoopType = ltSystem then
          begin
            if not iSubDevice.HasReportedError( re_No_Name ) then
            begin
              pErrors.Add( es_Error, 0, 'Missing DeviceName', TLoopSubDeviceError.Create( iSubDevice, sdef_Description ) );
            end;
          end
          else
          begin
            if not iSubDevice.HasReportedError( re_No_Name ) then
            begin
              pErrors.Add( es_Warning, 0, 'Missing DeviceName', TLoopSubDeviceError.Create( iSubDevice, sdef_Description ) );
            end;
          end;
        end;
      end
      else
      begin
        pFile.Add( iString + IntToStr( i ) + ',' );
      end;
    end;
  end
  else
  begin
    iString := '2,' + pLoop.LoopAddress.Value + ',' + IntToStr( StrToInt(pDevice.Index) + 1 ) + ',';
    iSubDevice := SubDevice[ 0 ];
    if assigned( iSubDevice ) then
    begin
      iName := iSubDevice.ExpandedName;
      pFile.Add( iString + '0,' + iName );
      if iName = '' then
      begin
        if not iSubDevice.HasReportedError( re_No_Name ) then
        begin
          pErrors.Add( es_Warning, 0, 'Missing DeviceName', TLoopSubDeviceError.Create( iSubDevice, sdef_Description ) );
        end;
      end;
    end
    else
    begin
      pFile.Add( iString + '0,' );
    end;
    iString := '2,' + IntToStr( pLoop.SubLoopAddress.ValueAsInt) + ',';
    for i := 1 to Max do
    begin
      iSubDevice := SubDevice[ i ];
      if assigned( iSubDevice ) then
      begin
        if iSubdevice.AllocatedToGroup then
        begin
          pFile.Add( iString + IntToStr(pDevice.ABusAddressOf( iSubdevice )) + ',0,' + iSubDevice.ExpandedName );
        end;
      end;
    end;
  end;
end;

