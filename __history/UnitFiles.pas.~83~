procedure tSequence.ImportFile(const pFile: tStrings; var iIndex: integer;
  const pNode: tZFPNode; const pList: tStrings; const pErrors: tErrorList;
  const pErrorObject: tObject);
var
  i, j, iCol, iMax : integer;
  iErrText : string;
  iVal : integer;
  iAction : tAction;
  iSeqStyleSet : boolean;
begin
  // [0] = record type
  // [1] = ID
  // [2] = Priority
  // [ 3n ] = Predelay
  // [ 3n + 1 ] = Action
  // [ 3n + 2 ] = Data, mostly not used
  iMax := pList.Count div 3;
  if iMax < 1 then
  begin
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
    exit;
  end;
  iCol := 2;
  try
    iVal := StrToInt( pList[ iCol ]);
    Priority.ValueAsInt := iVal;
  except
    iErrText := Translate( 'Syntax Error');
    pErrors.Add( tErrorSeverity.es_Error, iIndex, iCol, iErrText, pErrorObject);
    exit;
  end;
  iSeqStyleSet := FALSE;
  dec( iMax, 2 ); // iCount would be old iMax - 1 so real iMax is Old iMax - 2
  SequenceLines.Max := iMax;
  for i := 0 to iMax do
  begin
    inc( iCol );
    try
      iVal := StrToInt( pList[ iCol ]);
      SequenceLine[ i ].Predelay.ValueAsInt := iVal;
    except
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iCol, iErrText, pErrorObject);
      exit;
    end;
    inc( iCol );
    try
      iVal := StrToInt( pList[ iCol ]);
      SequenceLine[ i ].Action.ValueAsInt := iVal;
      if not iSeqStyleSet then
      begin
        for j := 0 to XFP4PgmCfg.ActionList.Max do
        begin
          iAction := XFP4PgmCfg.ActionList.Action[ j ];
          if iAction.Enum.ValueAsInt = iVal then
          begin
            case iAction.EditorStyle.ValueAsOGSeqStyle of
              og_None: ;
              og_Mode: ;
              og_Spin_Edit: ;
              og_Map: ;
              og_Timer: ;
              og_Sounder_Pattern,
              og_Group_Action,
              og_Access_Level,
              og_Output_Group,
              og_Supergroup,
              og_Trigger,
              og_Input_Group,
              og_Zone:
              begin
                SeqStyle.ValueAsOGSeqStyle := iAction.EditorStyle.ValueAsOGSeqStyle;
                iSeqStyleSet := TRUE;
              end;
            end;
          end;
        end;
      end;
    except
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iCol, iErrText, pErrorObject);
      exit;
    end;
    inc( iCol );
    try
      iVal := StrToInt( pList[ iCol ]);
      SequenceLine[ i ].PendingID := iVal;
      SequenceLine[ i ].PendingNode := pNode;
      ZFPFile.RegisterAfterLoadEntry( SequenceLine[ i ] );
    except
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, iCol, iErrText, self);
      exit;
    end;
  end;
  if not iSeqStyleSet then
  begin
    SeqStyle.ValueAsOGSeqStyle := og_Output_Group;
  end;
end;

procedure tSequence.LimitSeqLineEditor;
var
  i: integer;
  iAction : tAction;
begin
  if Editable then
  begin
    // waste of tome otherwise!
    if assigned( SequenceLinesEditor ) then
    begin
      with fActionEditor do
      begin
        Items.Clear;
        for i := 0 to XFP4PgmCfg.ActionList.Max do
        begin
          iAction := XFP4PgmCfg.ActionList.Action[ i ];
          case iAction.EditorStyle.ValueAsOGSeqStyle of
            og_None:
            begin
              Items.AddObject( iAction.EnumName.Value, iAction);
            end;
            og_Mode,
            og_Output_Group,
            og_Trigger,
            og_Input_Group,
            og_Supergroup,
            og_Zone,
            og_Group_Action,
            og_Access_Level:
            begin
              if SeqStyle.ValueAsOGSeqStyle = iAction.EditorStyle.ValueAsOGSeqStyle then
              begin
                Items.AddObject( iAction.EnumName.Value, iAction);
              end;
            end;
            og_Spin_Edit:
            begin
              // never allow these
            end;
            og_Map:
            begin
              // never allow these
            end;
            og_Sounder_Pattern:
            begin
              // only allowed with output groups
              if SeqStyle.ValueAsOGSeqStyle = og_Output_Group then
              begin
                Items.AddObject( iAction.EnumName.Value, iAction);
              end;
            end;
            og_Timer:
            begin
              // no longer used
            end;
          end;
        end;
      end;
    end;
  end;

end;

