procedure tZFPGlobalArray.ImportFile(const pFile: tStrings; var iIndex: integer;
  const pNode: tZFPNode; pErrors: tErrorList; const pErrorObject: tObject);
var
  iID : integer;
  pList : tStringList;
  iObject : tZFPGlobalObject;
  iErrText : string;
begin
  pList := tInfiniteStringList.Create;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before') + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, 0, 0, iErrText, pErrorObject);
    end;
    CommaListToStringList( pFile[ iIndex ], pList, TRUE );
    if pList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
    end;
    if pList[ 0 ] <> ExportPrefix then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
    end;
    if pList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex + 1, iErrText, pErrorObject);
    end;
    if pList[ 2 ] <> pNode.NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + pList[ 2 ] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
    end;
    while iIndex < pFile.Count - 1 do
    begin
      inc( iIndex );
      CommaListToStringList( pFile[ iIndex ], pList, TRUE );
      if PList.Count > 1 then
      begin
        if pList[ 0 ] <> ExportPrefix then
        begin
          iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
          pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
        end;
        if pList[ 1 ] = 'END' then
        begin
          exit;
        end;
        if pList[ 1 ] = 'BEGIN' then
        begin
          continue;
        end;
      end;
      iID := StrToIntDef( pList[ 1 ], -1);
      iID := iID - ClassIDOffset;
      if iID < 0 then
      begin
        iErrText := Translate( 'Item not found');
        pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
      end
      else
      begin
        iObject := ObjectWithID( iID );
        if assigned( iObject ) then
        begin
          iObject.ImportFile( pFile, iIndex, pNode, pList, pErrors, pErrorObject );
        end
        else
        begin
          iErrText := Translate( 'Item not found');
          pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
        end;
      end;
    end;
    iErrText := (Translate( 'EOF before "END" found'));
    pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, self);

  finally
    pList.Free;
  end;
end;

procedure tZFPGlobalArray.ImportShareData( const pNode : tZFPNode;
  const pData: tStringList; const pLine : integer; const pErrors: tErrorList; const pErrorObject : tObject);
var
  i, j, k, iVal, iID : integer;
  iEmptyObject : tZFPGlobalObject;
  iStart, iEnd : integer;
  iData : string;
  iNode : tZFPNode;
  iValid : boolean;
begin
  // all records that are shared share the same data. For some, sharing is not important
  //
  // pData is a list of fields
  // [0] = record type and must match pRecType
  // [1] = ID
  // [2] = Name
  // [3] = Disablement Group (which can be zero)
  // [4] onwards is a list of panels that share this ID
  //
  // Algorithm
  // ------------------
  // Go through existing list and look at enties with the same ID
  // The current node will already have been cleared, so we look for two
  // situations (assuming the address is correct)
  // 1 - the object is associated with at least one panel in the list.
  //     We register the current panel and terminate the search.
  // 2 - the object is not associated with any panel. We continue the search
  //     but if condition 1 is not reached we use this value. This situation
  //     should really only arise with systems having only one panel.
  // If neither 1 nor 2 is satisfied we add a new object, and give it the
  // name '<unnamed>'. This should be overwritten later.

  // first rebuild the panel list
  iData := pData[ 4 ]; // infinite list so OK
  for i := 5 to pData.Count - 1 do
  begin
    iData := iData + ',' + pData[ i ];
  end;
  if pData.Count < 3 then
  begin
    pErrors.Add( es_Error, pLine, 0, Translate( 'Incomplete Record' ), pErrorObject );
    exit;
  end;
  if pData[ 0 ] <> ExportSharePrefix then
  begin
    pErrors.Add( es_Error, pLine, 0, Translate( 'Incorrect Record Type' ), pErrorObject );
    exit;
  end;
  try
    iID := StrToInt( pData[ 1 ] ) - ClassIDOffset;
  except
    pErrors.Add( es_Error, pLine, 1, Translate( 'Syntax Error' ), self );
    exit;
  end;
  iEmptyObject := nil;
  {
  if pData.Count < 5 then
  begin
    pErrors.Add( es_Warning, pLine, 4, Translate( 'No panels specified' ), self );
  end;
  // allowed now
  }
  for i := 0 to Max do
  begin
    with GlobalObject[ i ] do
    begin
      if ID.ValueAsInt = iID then
      begin
        if NodesWhereUsed.Empty then
        begin
          iEmptyObject := GlobalObject[ i ];
        end
        else
        begin
          iValid := FALSE;
          // see if any other panel is in list
          for j := 0 to NodesWhereUsed.Max do
          begin
            iNode := NodesWhereUsed.Node[ j ];
            if assigned( iNode ) then
            begin
              if ValueInDSMList( iData, iNode.ID ) then
              begin
                iValid := TRUE;
                break;
              end;
            end;
          end;
          if iValid then
          begin
            NodesWhereUsed.RegisterNode( pNode );
            if pData[ 2 ] = '' then
            begin
              pErrors.Add( es_Error, pLine, 2, Translate( 'Blank name not allowed' ) + ' - ' + Translate( 'Record Ignored' ), pErrorObject );

            end
            else
            begin
              Name := pData[ 2 ];
            end;
            try
              fDisablementID := StrToInt( pData[ 3 ] );
              fDisablementNode := pNode;
              if fDisablementID > 0 then
              begin
                ZFPFile.RegisterAfterLoadEntry( GlobalObject[ i ] );
              end
              else
              begin
                DisablementTrigger.InputGroup := nil;
              end;
              //DisablementTrigger.InputGroup := ZFPFile.InputObjectWithID( iVal );
            except
              pErrors.Add( es_Error, pLine, 3, Translate( 'Syntax Error' ), pErrorObject );
            end;
            try
              while SplitDSMList( iData, iStart, iEnd ) do
              begin
                for k := iStart to iEnd do
                begin
                  NodesWhereUsed.RegisterNode( ZFPFile.NodeList.NodeWithID( k ));
                end;
              end;
            except
              pErrors.Add( es_Error, pLine, j, Translate( 'Syntax Error' ), self );
            end;
            exit;
          end;
        end;
      end;
    end;
  end;
  // if we get here we have not explicitely found an entry
  if assigned( iEmptyObject ) then
  begin
    with iEmptyObject do
    begin
      NodesWhereUsed.RegisterNode( pNode );
      if pData[ 2 ] = '' then
      begin
        pErrors.Add( es_Error, pLine, 2, Translate( 'Blank name not allowed' ) + ' - ' + Translate( 'Record Ignored' ), pErrorObject );

      end
      else
      begin
        Name := pData[ 2 ];
      end;
      try
        fDisablementID := StrToInt( pData[ 3 ] );
        fDisablementNode := pNode;
        if fDisablementID > 0 then
        begin
          ZFPFile.RegisterAfterLoadEntry( iEmptyObject );
        end
        else
        begin
          DisablementTrigger.InputGroup := nil;
        end;
      except
        pErrors.Add( es_Error, pLine, 3, Translate( 'Syntax Error' ), pErrorObject );
      end;
      try
        while SplitDSMList( iData, iStart, iEnd ) do
        begin
          for k := iStart to iEnd do
          begin
            NodesWhereUsed.RegisterNode( ZFPFile.NodeList.NodeWithID( k ));
          end;
        end;
      except
        pErrors.Add( es_Error, pLine, 4, Translate( 'Syntax Error' ), self );
      end;
    end;
    exit;
  end;
  // If we get here we have to create a new share.
  with iEmptyObject do
  begin
    if pData[ 2 ] = '' then
    begin
      iEmptyObject := GlobalObject[ AddObject( ChevronText( 'Unnamed' )) ];
      pErrors.Add( es_Error, pLine, 2, Translate( 'Blank name not allowed' ) + ' - ' + Translate( 'Record Ignored' ), pErrorObject );
    end
    else
    begin
      iEmptyObject := GlobalObject[ AddObject( pData[ 2 ] ) ];
    end;
  end;
  with iEmptyObject do
  begin
    UnregisterAllNodes;
    ID.ValueAsInt := iID;
    NodesWhereUsed.RegisterNode( pNode );
    try
      iVal := StrToInt( pData[ 3 ] );
      fDisablementID := iVal;
      fDisablementNode := pNode;
      if iVal > 0 then
      begin
        ZFPFile.RegisterAfterLoadEntry( iEmptyObject );
      end
      else
      begin
        DisablementTrigger.InputGroup := nil;
      end;
    except
      pErrors.Add( es_Error, pLine, 3, Translate( 'Syntax Error' ), pErrorObject );
    end;
    try
      while SplitDSMList( iData, iStart, iEnd ) do
      begin
        for k := iStart to iEnd do
        begin
          NodesWhereUsed.RegisterNode( ZFPFile.NodeList.NodeWithID( k ));
        end;
      end;
    except
      pErrors.Add( es_Error, pLine, 4, Translate( 'Syntax Error' ), self );
    end;
  end;
end;

