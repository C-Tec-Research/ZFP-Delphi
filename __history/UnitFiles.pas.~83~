procedure tCETreeInputGroup.ImportTreeData(const pList: tStringList;
  const iIndex : integer; pErrors: tErrorList; const pErrorObject: tObject);
var
  iVal : integer;
  iErrText : string;
begin
  try
    iVal := StrToInt( pList[ 5 ] );
  except
    iErrText := Translate( 'Missing or illegal value');
    pErrors.Add( es_Error, iIndex, 5, iErrText, pErrorObject);
    exit;
  end;
  fPointerType.ValueAsInt := iVal;
  if pList[ 6 ] = '' then
  begin
    CurrentObject := nil;
    exit;
  end;
  try
    iVal := StrToInt( pList[ 6 ] );
  except
    iErrText := Translate( 'Missing or illegal value');
    pErrors.Add( es_Error, iIndex, 6, iErrText, pErrorObject);
    exit;
  end;
  case fPointerType.PointerType of
    lf_None: ;  // legal but no pointers change
    lf_Input:           fInputGroupPointer.InputGroup := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID( iVal ) as tInputGroup;
    lf_InputSupergroup: fInputSuperGroupPointer.SuperGroup := ZFPFile.InputSuperGroupList.ObjectWithID( iVal ) as tInputSuperGroup;
    else
    begin
      iErrText := (Translate( 'Missing or illegal value') + ' "' + pList[5] + '" ' + Translate('in line') + ' ' + IntToStr( iIndex + 1 ));
      pErrors.Add( es_Error, iIndex, 5, iErrText, pErrorObject);
    end;
  end;
end;

