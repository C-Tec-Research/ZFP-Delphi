procedure tLoopList.ImportDeviceFieldsFile(const pFile: tStrings; var pLine: integer; pList: tStrings;
          pErrors : tErrorList; const pErrorObject : tObject);
var
  iLoopAddress : integer;
  iLoopIndex : integer;
  iErrText : string;
begin
  while True do
  begin
    if pLine >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "END"');
      pErrors.Add( tErrorSeverity.es_Error, pLine, 0, iErrText, pErrorObject);
    end;
    CommaListToStringList( pFile[ pLine ], pList, TRUE );
    if pList.Count > 2 then
    begin
      if pList[ 0 ] <> '20' then
      begin
        iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
        pErrors.Add( tErrorSeverity.es_Error, pLine, 0, iErrText, pErrorObject);
      end;
      if pList[ 1 ] = 'END' then
      begin
        // done
        exit;
      end;
      if pList[ 1 ] = 'BEGIN' then
      begin
        // done
        inc( pLine );
        continue;
      end;
      // else
      iLoopAddress := StrToInt( pList[ 1 ] );
      // special for A-Bus
      {
      if iLoopAddress = 11 then
      begin
        iLoopAddress := 10;
      end;
      }
      iLoopIndex := LoopIndexWithAddress[ iLoopAddress ];
      if iLoopIndex >= 0 then
      begin
        //ActiveChild := iLoopIndex;
        Loop[ iLoopIndex ].ImportDeviceFieldsFile( pList);
      end
      else
      begin
        Max := Max + 1;
        OwnerAsNode.GeneralProperties.LoopsFitted.LoopsFitted.ValueAsInt := Max - 2;
        Loop[ Max ].LoopAddress.ValueAsInt := iLoopAddress;
        Loop[ Max ].ImportDeviceFieldsFile( pList);
      end;
    end;
    inc( pLine );
  end;
end;

procedure tLoopList.ImportNameFile(const pFile: tStrings; var pLine: integer;
  const pList: tStrings; const pErrors : tErrorList; const pErrorObject : tObject );
var
  iLoopAddress : integer;
  iLoop : tLoop;
  iAllowUpdate : boolean;
  iErrText : string;
begin
  iAllowUpdate := TRUE;
  while True do
  begin
    if pLine >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "END" found');
      iAllowUpdate := FALSE;
      pErrors.Add( tErrorSeverity.es_Error, pLine, 0, iErrText, pErrorObject );
    end;
    CommaListToStringList( pFile[ pLine ], pList, TRUE );
    if pList.Count > 2 then
    begin
      if pList[ 0 ] <> '2' then
      begin
        iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
        iAllowUpdate := FALSE;
        pErrors.Add( tErrorSeverity.es_Error, pLine, 0, iErrText, pErrorObject );
      end;
      if pList[ 1 ] = 'END' then
      begin
        // done
        exit;
      end;
      // else
      inc( pLine );
      if pList[ 1 ] = 'BEGIN' then
      begin
        continue;
      end;
      iLoopAddress := StrToInt( pList[ 1 ] );
      iLoop := LoopWithAddress[ iLoopAddress ];
      if assigned( iLoop ) then
      begin
        if iAllowUpdate then
        begin
          if iLoopAddress = iLoop.LoopAddress.ValueAsInt then
          begin
            iLoop.ImportNamesFile( pFile, pLine, pList, pErrors, pErrorObject );
          end
          else if iLoopAddress = iLoop.SubLoopAddress.ValueAsInt then
          begin
            iLoop.ImportSubloopNamesFile( pFile, pLine, pList, pErrors, pErrorObject );
          end;
        end;
      end
      else
      begin
        iErrText := Translate( 'Unexpected Loop') + ' "' + pList[1] + '"';
        pErrors.Add( tErrorSeverity.es_Error, pLine, 1, iErrText, pErrorObject );
      end;
    end;
  end;
end;

function tLoopList.IndexOfLoopWithID(const pID: integer): integer;
