function tCETreeInputGroup.CanCreateChildOfType(
  pOfType: tCETreePropertyClass): boolean;
var
  iOwner : tSigCompoundProperty;
begin
  if pOfType = tCEInputGroupState then
  begin
    Result := TRUE;
  end
  else if pOfType = tCETreeModeSet then
  begin
    iOwner := Owner;
    while assigned( iOwner ) do
    begin
      if iOwner is tCETreeModeSet then
      begin
        Result := FALSE;
        exit;
      end;
      iOwner := iOwner.Owner;
    end;
    // else
    Result := TRUE;
  end
  else
  begin
    Result := FALSE;
  end;
end;

function tCETreeInputGroup.CheckValid(const pErrors: tErrorList;
  pValidFlags: tCETreeValidFlags): boolean;
begin
  Result := inherited;
  case PointerType.PointerType of
    lf_Input,
    lf_InputSupergroup:
    begin
      if assigned( CurrentObject ) then
      begin
        if CurrentObject.IsEmpty then
        begin
          if not CurrentObject.HasReportedError( re_Empty ) then
          begin
            pErrors.Add( es_Warning, 0, Translate('Input object empty') + ' (' +
                       CurrentObject.ExpandedName + ')', CurrentObject );
          end;
        end;
      end
      else
      begin
        pErrors.Add( es_Error, 0, Translate('Internal Error') + ' CEO001', self );
      end;
    end;
  end;
end;

