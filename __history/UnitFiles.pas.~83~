procedure tZFPNode.ImportNetworkFile(const pFile: tStrings; var iIndex : integer;
  const pErrors: tErrorList; const pErrorObject : tObject);
var
  pList : tInfiniteStringList;
  iErrText : string;
  iAllowLoad : boolean;
  iSeg, iAdd, iCol, iColCount : integer;
begin
  iAllowLoad := TRUE;
  pList := tInfiniteStringList.Create;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "BEGIN" found in Network File');
      pErrors.Add( es_Error, 0, 0, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    CommaListToStringList( pFile[ iIndex ], pList, TRUE );
    if PList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( es_Error, iIndex, 3, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 0 ] <> '120' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
      pErrors.Add( es_Error, iIndex, 0, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 1, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 2 ] <> NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + pList[ 2 ] + '"';
      pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    while iIndex < pFile.Count -1 do
    begin
      inc( iIndex );
      CommaListToStringList( pFile[ iIndex ], pList, TRUE );
      iColCount := pList.Count;
      if iColCount > 1 then
      begin
        if pList[ 0 ] <> '120' then
        begin
          iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
          pErrors.Add( es_Error, iIndex, 0, iErrText, pErrorObject);
        end;
        if pList[ 1 ] = 'BEGIN' then
        begin
          continue;
        end;
        if pList[ 1 ] = 'END' then
        begin
          exit;
        end;
      end;
      case StrToIntDef( pList[ 1 ], -1 ) of
        -1:
        begin
          iErrText := Translate( 'Syntax Error');
          pErrors.Add( es_Error, iIndex, 1, iErrText, pErrorObject);
        end;
        1: // network address
        begin
          if iAllowLoad then
          begin
            // catch 22 if address changed! So only allow segment change
            try
              if iColCount > 2 then
              begin
                iSeg := StrToInt( pList[ 2 ] );
                if iSeg in [0..255] then
                begin
                  NetworkFile.PanelAddress.Segment.ValueAsInt := iSeg;
                end
                else
                begin
                  iErrText := Translate( 'Segment out of range' );
                  pErrors.Add( es_Warning, iIndex, 2, iErrText, pErrorObject);
                end;
              end
              else
              begin
                iErrText := Translate( 'Segment') + ' ' +
                            Translate( 'missing') + ' ';
                pErrors.Add( es_Warning, iIndex, iColCount - 1, iErrText, pErrorObject);
              end;
            except
              iErrText := Translate( 'Syntax Error');
              pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
            end;
            try
              if iColCount > 3 then
              begin
                iAdd := StrToInt( pList[ 3 ] );
                if iAdd <> NetworkFile.PanelAddress.Address.ValueAsInt then
                begin
                  iErrText := Translate( 'Panel Address cannot be changed' ) + '!';
                  pErrors.Add( es_Warning, iIndex, 3, iErrText, pErrorObject);
                end;
              end
              else
              begin
                iErrText := Translate( 'Address') + ' ' +
                            Translate( 'missing') + ' ';
                pErrors.Add( tErrorSeverity.es_Warning, iIndex, 3, iErrText, pErrorObject);
              end;
            except
              iErrText := Translate( 'Syntax Error');
              pErrors.Add( es_Error, iIndex, 3, iErrText, pErrorObject);
            end;
          end;
        end;
        2: // Tethered to
        begin
          if iAllowLoad then
          begin
            try
              iSeg := StrToInt( pList[ 2 ] );
              if iSeg in [0..255] then
              begin
                //NetworkFile.TetheredAddress.Segment.ValueAsInt := iSeg;
              end
              else
              begin
                iErrText := Translate( 'Segment out of range' );
                pErrors.Add( tErrorSeverity.es_Warning, iIndex, 2, iErrText, pErrorObject);
              end;
            except
              iErrText := Translate( 'Syntax Error');
              pErrors.Add( es_Error, iIndex, 2, iErrText, pErrorObject);
            end;
            try
              iAdd := StrToInt( pList[ 3 ] );
              if (iAdd > 0) and (iAdd <= XFP4PgmCfg.MaxPanelsInSystem.ValueAsInt ) then
              begin
                //NetworkFile.TetheredAddress.Address.ValueAsInt := iAdd;
              end
              else
              begin
                iErrText := Translate( 'Tethered to address out of range' ) + '! ';
                pErrors.Add( es_Warning, iIndex, 3, iErrText, pErrorObject);
              end;
            except
              iErrText := Translate( 'Syntax Error');
              pErrors.Add( es_Error, iIndex, 3, iErrText, self);
            end;
          end;
        end;
        25: // list of fitted panels
        begin
          for iCol := 2 to pList.Count - 1 do
          begin
            if pList[ iCol ] <> '' then
            begin
              iAdd := ZFPFile.NodeList.IndexOfNodeWithID( StrToInt( pList[ iCol ] ) );
              if iAdd < 0  then
              begin
                iAdd := ZFPFile.NodeList.Max + 1;
                ZFPFile.NodeList.Max := iAdd;
                ZFPFile.NodeList.Node[ iAdd ].NetworkFile.PanelAddress.Address.ValueAsInt :=
                                       StrToInt( pList[ iCol ] );
              end;
            end;
          end;
        end;
        20: // exception and control filters
        begin
          if iAllowLoad then
          begin
            iAdd := -1;
            try
              iAdd := StrToInt( pList[ 2 ] );
              if (iAdd > 0) and (iAdd <= XFP4PgmCfg.MaxPanelsInSystem.ValueAsInt ) then
              else
              begin
                iErrText := Translate( 'Panel Address not valid' ) + '!';
                pErrors.Add( es_Warning, iIndex, 2, iErrText, pErrorObject);
              end;
            except
              iErrText := Translate( 'Syntax Error');
              pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
            end;
            //iCol := 3;
            with DataFilters do
            begin
              for iCol := 3 to 3 + Max do
              begin
                if iCol < pList.Count then
                begin
                  iSeg := StrToIntDef( pList[ iCol ], -1);
                  case iSeg of
                    1:
                    begin
                      SetFilter( iCol - 3, iAdd, TRUE );
                    end;
                    0:
                    begin
                      SetFilter( iCol - 3, iAdd, FALSE );
                    end
                    else
                    begin
                      iErrText := Translate( 'Syntax Error');
                      pErrors.Add( es_Error, iIndex, iCol, iErrText, pErrorObject);
                    end;
                  end;
                end
                else
                begin
                  iErrText := Translate( DataFilter[ iCol - 3 ].Name ) + ' ' +
                              Translate( 'data missing' );
                  pErrors.Add( es_Error, iIndex, iCol, iErrText, pErrorObject);
                end;
              end;
            end;
          end;
        end
        else
        begin
          iErrText := Translate( 'Unexpected record subtype "' ) +
                      pList[ 1 ] + '"';
          pErrors.Add( es_Error, iIndex, 1, iErrText, pErrorObject);
        end;
      end;
    end;
    iErrText := (Translate( 'EOF before "END" found in Network File'));
    pErrors.Add( es_Error, iIndex, 0, iErrText, pErrorObject);

  finally
    pList.Free;
  end;
end;

procedure tZFPNode.ImportOutputGroups(const pFile: tStrings; var iIndex : integer;
          const pErrors: tErrorList; const pErrorObject : tObject);
var
  pList : tStringList;
  iOutputGroup : tOutputGroup;
  iErrText : string;
  iAllowLoad : boolean;
  iOG : integer;
begin
  iAllowLoad := TRUE;
  pList := tStringList.Create;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before "BEGIN" found');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
      exit;
    end;
    CommaListToStringList( pFile[ iIndex ], pList, TRUE );
    if PList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 0 ] <> '15' then
    begin
      iErrText := Translate( 'Incorrect record type');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 1, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    if pList[ 2 ] <> NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + pList[ 2 ] + '" ';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
      iAllowLoad := FALSE;
    end;
    while iIndex < pFile.Count - 1 do
    begin
      inc( iIndex );
      CommaListToStringList( pFile[ iIndex ], pList, TRUE );
      if PList.Count > 1 then
      begin
        if pList[ 0 ] <> '15' then
        begin
          iErrText := Translate( 'incorrect record type');
          pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
        end;
        if pList[ 1 ] = 'END' then
        begin
          exit;
        end;
        if pList[ 1 ] = 'BEGIN' then
        begin
          continue;
        end;
      end;
      try
        iOG := StrToInt( pList[ 1 ] );
        iOutputGroup := ZFPFile.CauseAndEffects.OutputGroups.FindOrCreate( iOG, ChevronText( 'Unknown' ), FALSE, self ) as tOutputGroup;
      except
        iErrText := Translate( 'illegal input group') + ' "' + pList[1] + '" ';
        pErrors.Add( tErrorSeverity.es_Error, iIndex, 1, iErrText, pErrorObject);
        iOutputGroup := nil;
      end;
      if iAllowLoad and assigned( iOutputGroup ) then
      begin
        if pList[ 2 ] = '1' then
        begin
          iOutputGroup.Silenceable.ValueAsBool := TRUE;   //JG LM&RC
        end
        else
        begin
          iOutputGroup.Silenceable.ValueAsBool := FALSE;
        end;
        if pList[ 3 ] = '1' then
        begin
          iOutputGroup.NormOnReset.ValueAsBool := TRUE;
        end
        else
        begin
          iOutputGroup.NormOnReset.ValueAsBool := FALSE;
        end;
        if pList[ 4 ] = '1' then
        begin
          iOutputGroup.SendToDRAX.ValueAsBool := TRUE;
        end
        else
        begin
          iOutputGroup.SendToDRAX.ValueAsBool := FALSE;
        end;
        if pList.Count > 5 then
        begin
            if pList[ 5 ] = '1' then
            begin
              iOutputGroup.LimpMode.ValueAsBool := TRUE;
            end
            else
            begin
              iOutputGroup.LimpMode.ValueAsBool := FALSE;
            end;
            if pList[ 6 ] = '1' then
            begin
              iOutputGroup.RemoteControl.ValueAsBool := TRUE;
            end
            else
            begin
              iOutputGroup.RemoteControl.ValueAsBool := FALSE;
            end;
        end;
      end;
    end;
    iErrText := Translate( 'EOF before "END" found in Network File');
    pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, self);

  finally
    pList.Free;
  end;
end;

