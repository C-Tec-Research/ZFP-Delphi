procedure tZFPNode.ImportInputGroups(const pFile: tStrings; var iIndex : integer;
                          const pErrors : tErrorList; const pErrorObject : tObject);
//begin
//  ZFPFile.CauseAndEffects.InputGroups.ImportFile( pFile, iIndex, self, pErrors, pErrorObject );
var
  iID : integer;
  pList : tStringList;
  iObject : tZFPGlobalObject;
  iErrText : string;
begin
  pList := tInfiniteStringList.Create;
  try
    if iIndex >= pFile.Count then
    begin
      iErrText := Translate( 'EOF before') + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, 0, 0, iErrText, pErrorObject);
    end;
    CommaListToStringList( pFile[ iIndex ], pList, TRUE );
    if pList.Count < 3 then
    begin
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 3, iErrText, pErrorObject);
    end;
    if pList[ 0 ] <> '14' then
    begin
      iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
    end;
    if pList[ 1 ] <> 'BEGIN' then
    begin
      iErrText := Translate( 'Missing' ) + ' "BEGIN"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex + 1, iErrText, pErrorObject);
    end;
    if pList[ 2 ] <> NetworkFile.PanelAddress.Address.Value then
    begin
      iErrText := Translate( 'Wrong Panel' ) + ' "' + pList[ 2 ] + '"';
      pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
    end;
    while iIndex < pFile.Count - 1 do
    begin
      inc( iIndex );
      CommaListToStringList( pFile[ iIndex ], pList, TRUE );
      if PList.Count > 1 then
      begin
        if pList[ 0 ] <> '14' then
        begin
          iErrText := Translate( 'Incorrect record type') + ' "' + pList[0] + '"';
          pErrors.Add( tErrorSeverity.es_Error, iIndex, 0, iErrText, pErrorObject);
        end;
        if pList[ 1 ] = 'END' then
        begin
          exit;
        end;
        if pList[ 1 ] = 'BEGIN' then
        begin
          continue;
        end;
      end;
      iID := StrToIntDef( pList[ 1 ], -1);
      iObject := ZFPFile.CauseAndEffects.InputGroups.ObjectWithID( iID );
      if assigned( iObject ) then
      begin
        iObject.ImportFile( pFile, iIndex, self, pList, pErrors, pErrorObject );
      end
      else
      begin
        iErrText := Translate( 'Item not found');
        pErrors.Add( tErrorSeverity.es_Error, iIndex, 2, iErrText, pErrorObject);
      end;
    end;
    iErrText := (Translate( 'EOF before "END" found'));
    pErrors.Add( tErrorSeverity.es_Error, iIndex, iErrText, self);

  finally
    pList.Free;
  end;
end;

