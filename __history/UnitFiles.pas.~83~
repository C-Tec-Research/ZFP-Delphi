procedure tZFPFile.ShowInputGroupDevices(pInputGroup: tInputGroup);
var
  i, j, k : integer;
  iPanel, iLoop, iDevice, iSubDev, iImage: integer;
  iSubDevice : tLoopSubDevice;
  iView : TIGView;
  iGrid : TSigNETStringGrid;
  iCanAdd : boolean;
  iObject : tZFPGlobalObject;
  iObjectList : tZFPGlobalArray;
begin

  if assigned( CauseAndEffects.InputGroups.EditorFrame ) then
  begin
    with CauseAndEffects.InputGroups.EditorFrame as TFrameInputGroupEditor do
    begin
      ObjectsImageList := self.ObjectsImageList;
      if PageControlProperties.ActivePage = TabSheetDevices then
      begin
        iView := igvDevices;
        iGrid := StringGridDevices;
      end
      else if PageControlProperties.ActivePage = TabSheetDisablements then
      begin
        if PageControlIGDisablements.ActivePage = TabSheetDisablementDevices then
        begin
          iView := igvDisablementDevices;
          iGrid := StringGridIGDisablementDevices;
        end
        else if PageControlIGDisablements.ActivePage = TabSheetIGDisablementObjects then
        begin
          iView := igvDisablementObjects;
          iGrid := StringGridIGDisablementOthers;
        end
        else
        begin
          exit;
        end;
      end
      else if PageControlProperties.ActivePage = TabSheetIGFaults then
      begin
        iView := igvFaultDevices;
        iGrid := StringGridIGFaultsDevices;
      end
      else
      begin
        exit;
      end;
      OnIncludeSelectionIn := pInputGroup.IncludeDevicesIn;
      if not assigned(pInputGroup ) then
      begin
        exit;
      end;
      ObjectsImageList := self.ObjectsImageList;  // self required here
      case iView of
        igvDevices,
        igvDisablementDevices,
        igvFaultDevices:
        begin
          ClearDevices( iGrid );
          for i := 0 to NodeList.Max do
          begin
            with NodeList.Node[ i ] do
            begin
              iPanel := ID;
              for j := 0 to LoopList.Max do
              begin
                iLoop := LoopList.Loop[ j ].LoopAddress.ValueAsInt;
                with LoopList.Loop[ j ].LoopDevices do
                begin
                  for k := 1 to VisibleSubDeviceCount do
                  begin
                    iSubDevice := VisibleLoopSubDevice[ k ];
                    case iView of
                      igvDevices:
                      begin
                        iCanAdd := iSubDevice.InputGroup = pInputGroup;
                      end;
                      igvDisablementDevices:
                      begin
                        iCanAdd := iSubDevice.DisablementGroup = pInputGroup;
                      end;
                      igvFaultDevices:
                      begin
                        iCanAdd := iSubDevice.FaultGroup = pInputGroup;
                      end;
                      else
                      begin
                        iCanAdd := FALSE;
                      end;
                    end;
                    if iCanAdd then
                    begin
                      iSubDev := StrToInt( iSubDevice.Index );
                      iImage := iSubDevice.DeviceImage;
                      iDevice := StrToInt( iSubDevice.Device.Index ) + 1;
                      AddDevice( iPanel, iLoop, iDevice, iSubDev, iImage, iSubDevice.ExpandedName, iSubDevice );
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
        igvDisablementObjects:
        begin
          ClearObjects( iGrid );
          // Modes - Image Index := 3
          iObjectList := ModeList;
          iImage := 3;
          for i := 0 to iObjectList.Max do
          begin
            iObject := iObjectList.GlobalObject[ i ];
            if iObject.DisablementTrigger.InputGroup = pInputGroup then
            begin
              AddObject( iImage, iObject.Name, iObject.VisibleID, iObject );
            end;
          end;
          // Zones - Image Index := 8
          iObjectList := ZoneList;
          iImage := 8;
          for i := 0 to iObjectList.Max do
          begin
            iObject := iObjectList.GlobalObject[ i ];
            if iObject.DisablementTrigger.InputGroup = pInputGroup then
            begin
              AddObject( iImage, iObject.Name, iObject.VisibleID, iObject );
            end;
          end;
          // Input Groups Image Index := 1
          iObjectList := CauseAndEffects.InputGroups;
          iImage := 1;
          for i := 0 to iObjectList.Max do
          begin
            iObject := iObjectList.GlobalObject[ i ];
            if iObject.DisablementTrigger.InputGroup = pInputGroup then
            begin
              AddObject( iImage, iObject.Name, iObject.VisibleID, iObject );
            end;
          end;
          // Output Groups ImageIndex := 6
          iObjectList := CauseAndEffects.OutputGroups;
          iImage := 6;
          for i := 0 to iObjectList.Max do
          begin
            iObject := iObjectList.GlobalObject[ i ];
            if iObject.DisablementTrigger.InputGroup = pInputGroup then
            begin
              AddObject( iImage, iObject.Name, iObject.VisibleID, iObject );
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure tZFPFile.ShowOutputGroupDevices(pOutputGroup: tOutputGroup);
var
  i, j, k : integer;
  iPanel, iLoop, iDevice, iSubDev, iImage: integer;
  iSubDevice : tLoopSubDevice;
begin
  if assigned( CauseAndEffects.OutputGroups.EditorFrame ) then
  begin
    with CauseAndEffects.OutputGroups.EditorFrame as TFrameOutputGroupEditor do
    begin
      if PageControlProperties.ActivePage <> TabSheetDevices then
      begin
        exit;
      end;
      OnIncludeSelectionIn := pOutputGroup.IncludeDevicesIn;
      ClearDevices;
      for i := 0 to NodeList.Max do
      begin
        with NodeList.Node[ i ] do
        begin
          iPanel := ID;
          for j := 0 to LoopList.Max do
          begin
            iLoop := LoopList.Loop[ j ].LoopAddress.ValueAsInt;
            with LoopList.Loop[ j ].LoopDevices do
            begin
              for k := 1 to VisibleSubDeviceCount do
              begin
                iSubDevice := VisibleLoopSubDevice[ k ];
                if iSubDevice.OutputGroup = pOutputGroup then
                begin
                  iImage := iSubDevice.DeviceImage;
                  iDevice := StrToInt( iSubDevice.Device.Index ) + 1;
                  iSubDev := StrToInt( iSubDevice.Index );
                  AddDevice( iPanel, iLoop, iDevice, iSubDev, iImage, iSubDevice.ExpandedName, iSubDevice );
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

