procedure tInputSuperGroup.ImportFile(const pFile: tStrings;
  var iIndex: integer; const pNode: tZFPNode; const pList: tStrings;
  const pErrors: tErrorList; const pErrorObject: tObject);
var
  i: Integer;
  iID : integer;
  iErrText : string;
  iGroup : tGroup;
begin
  for i := 2 to pList.Count - 1 do
  if pList[ i ] <> '' then
  begin
    try
      iID := StrToInt( pList[ i ] );
    except
      iID := -1;
      iErrText := Translate( 'Syntax Error');
      pErrors.Add( tErrorSeverity.es_Error, iIndex, i, iErrText, pErrorObject);
    end;
    if iID > 0  then
    begin
      if iID <= ClassIDOffset then
      begin
        iGroup := ZFPFile.InputObjectWithID( iID );
      end
      else
      begin
        dec( iID, ClassIDOffset );
        iGroup := ZFPFile.InputSuperGroupList.ObjectWithID( iID ) as tGroup;
      end;
      if assigned( iGroup ) then
      begin
        if iGroup is tInputSuperGroup then
        begin
          if CanAddSupergroup( iGroup as tInputSuperGroup ) then
          begin
            SuperGroupChildren.AddGroup( iGroup );
          end;
        end
        else
        begin
          GroupChildren.AddGroup( iGroup );
        end;
      end
      else
      begin
        iErrText := Translate( 'Item not found');
        pErrors.Add( tErrorSeverity.es_Error, iIndex, i, iErrText, pErrorObject);
      end;
    end;
  end;
end;

