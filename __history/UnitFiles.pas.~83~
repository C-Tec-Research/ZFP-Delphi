procedure tPulsePattern.fOnPulseStateChange(Sender: tObject);
var
  i, j, iMax : integer;
begin
  if Sender is TSigVariableEditor then
  begin
    with (Sender as TSigVariableEditor) do
    begin
      i := Tag;

      case EditorAsImage.ImageIndex of
        0: // currently Off
        begin
          EditorAsImage.ImageIndex := 1;
          PulseState[ i ] := TRUE;
        end;
        1: // on
        begin
          // switch to cyclic and disable other editors, but not if i is 0
          if i = 0 then
          begin
            EditorAsImage.ImageIndex := 0;
            PulseState[ i ] := FALSE;
          end
          else
          begin
            EditorAsImage.ImageIndex := 5;
            fLastCycleindex := CycleIndex.ValueAsInt;
            CycleIndex.ValueAsInt := i;
            for j := i + 1 to cMax do
            begin
              if assigned( fToPatternEditor[ j ] ) then
              begin
                fToPatternEditor[ j ].EditorAsImage.ImageIndex := 3;
              end;
              if assigned( fFieldPatternEditor[ j ] ) then
              begin
                fFieldPatternEditor[ j ].EditorAsImage.ImageIndex := 3;
              end;
            end;
          end;
        end;
        3:
        begin
          // disabled - do nothing
        end;
        5:
        begin
          // switch to off and re-instate last cycle index if last changed = this
          if fLastChangeIndex = i then
          begin
            iMax := fLastCycleIndex;
            fLastCycleIndex := 0;
          end
          else
          begin
            iMax := 0;
          end;
          CycleIndex.ValueAsInt := iMax;
          if iMax = 0 then
          begin
            iMax := 9;
          end
          else
          begin
            if assigned( fToPatternEditor[ iMax ] ) then
            begin
              fToPatternEditor[ iMax ].EditorAsImage.ImageIndex := 5;
            end;
            if assigned( fFieldPatternEditor[ iMax ] ) then
            begin
              fFieldPatternEditor[ iMax ].EditorAsImage.ImageIndex := 5;
            end;
          end;
          PulseState[ i ] := FALSE;
          for j := i to iMax - 1 do
          begin
            if PulseState[ j ] then
            begin
              if assigned( fToPatternEditor[ j ] ) then
              begin
                fToPatternEditor[ j ].EditorAsImage.ImageIndex := 1;
              end;
              if assigned( fFieldPatternEditor[ j ] ) then
              begin
                fFieldPatternEditor[ j ].EditorAsImage.ImageIndex := 1;
              end;
            end
            else
            begin
              if assigned( fToPatternEditor[ j ] ) then
              begin
                fToPatternEditor[ j ].EditorAsImage.ImageIndex := 0;
              end;
              if assigned( fFieldPatternEditor[ j ] ) then
              begin
                fFieldPatternEditor[ j ].EditorAsImage.ImageIndex := 0;
              end;
            end;
          end;
        end;
      end;
      fLastChangeIndex := i;
    end;
  end;
end;

