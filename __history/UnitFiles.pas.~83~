procedure tSequence.AddOrUpdateExtraEditors2(pToEditor: TSigVariableEditorList;
  var pIndex: integer);
var
  iPriorityEditor : tSigVariableEditor;
  iSeqStyleEditor : tSigVariableEditor;
begin
  inherited;
  // need to add priority
  if pToEditor = fFieldEditor then
  begin
    fFieldPriorityEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fFieldPriorityEditor ) then
    begin
      fFieldPriorityEditor.EditorStyle := vesSpinEdit;
    end
    else
    begin
      fFieldPriorityEditor := pToEditor.Add( vesSpinEdit );
    end;
    iPriorityEditor := fFieldPriorityEditor;

    fFieldSeqStyleEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fFieldSeqStyleEditor ) then
    begin
      fFieldSeqStyleEditor.EditorStyle := vesComboBox;
    end
    else
    begin
      fFieldSeqStyleEditor := pToEditor.Add( vesComboBox );
    end;
    iSeqStyleEditor := fFieldSeqStyleEditor;

  end
  else
  begin
    fToPriorityEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fToPriorityEditor ) then
    begin
      fToPriorityEditor.EditorStyle := vesSpinEdit;
    end
    else
    begin
      fToPriorityEditor := pToEditor.Add( vesSpinEdit );
    end;
    iPriorityEditor := fToPriorityEditor;

    fToSeqStyleEditor := pToEditor.Editor[ pIndex ];
    inc( pIndex );
    if assigned( fToSeqStyleEditor ) then
    begin
      fToSeqStyleEditor.EditorStyle := vesComboBox;
    end
    else
    begin
      fToSeqStyleEditor := pToEditor.Add( vesComboBox );
    end;
    iSeqStyleEditor := fToSeqStyleEditor;

  end;

  with iPriorityEditor do
  begin
    LabelText := Translate( 'Priority' +' (255 = ' + Translate( 'Highest' ) + ')');
    OnChange := OnPriorityChange;
    with EditorAsSpinEdit do
    begin
      Value := Priority.ValueAsInt;
      MaxValue := 255;
      MinValue := 0;
    end;
    EditorAsSpinEdit.Value := Priority.ValueAsInt;
    OnLabelClick := SelfOnPriorityLabelClick;
    EditorAsSpinEdit.Enabled := self.Editable;
  end;

  with iSeqStyleEditor do
  begin
    LabelText := Translate( 'Acts On' );
    EditorAsComboBox.Style := csDropDownList;
    fSeqStyle.AssignItemList(EditorAsComboBox.Items );
    EditorAsComboBox.ItemIndex := fSeqStyle.MapValueToItem( fSeqStyle.ValueAsInt );
    OnChange := OnSeqStyleChange;
    OnLabelClick := SelfOnSeqStyleLabelClick;
    EditorAsComboBox.Enabled := self.Editable;
  end;
end;

