  iGlobalObject : tZFPGlobalObject;
begin
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    Max := Max + 1;
    Result := Max;
    iGlobalObject := GlobalObject[ Max ];
    if NewObjectName <> '' then
    begin
      iGlobalObject.Name := NewObjectName;
    end;
    iGlobalObject.fName.Loadable := pLoadable;
    iGlobalObject.RegisterAllNodes;
    ShowEditors;
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

procedure tZFPGlobalArray.OnCellEditChange( const Sender : tObject; const Col, Row: integer;
  const Value: string);
var
  i : integer;
begin
  ZFPFile.UndoRedo.GroupUndoActive := TRUE;
  try
    if Col in [cColName, cColID] then
    begin
      if Row > 0 then
      begin
        // changing or adding name of a zone
        if Row - 1 > Count then
        begin
          // should not happen
          exit;
        end
        else if Row - 1 = Count then
        begin
          // adding a new object
          Max := Max + 1;
          // by default all existing panels have a new zone defined on them
          for i := 0 to ZFPFile.NodeList.Max do
          begin
            self[ Row - 1 ].NodesWhereUsed.RegisterNode( ZFPFile.NodeList.Node[ i ] );
            fEditor.Cell[ i + cColPanel1, Row ] := '1';
          end;
          fEditor.Cell[ cColID, Row ] := IntToStr( self[ Row - 1 ].VisibleID );

          fEditor.RowCount := Count + 2;

          ClearSelections;

        end
        else if ActiveChild <> (Row - 1) then
        begin
          ActiveChild := Row - 1;
        end;
        case Col of
          cColName: self[ Row - 1 ].Name := Value;
          cColID: self[ Row - 1 ].VisibleID := StrToInt( Value );
        end;
        CheckErrors;
      end;
    end;
  finally
    ZFPFile.UndoRedo.GroupUndoActive := FALSE;
  end;
end;

procedure tZFPGlobalArray.OnDeleteClick(Sender: tObject);
var
  i : integer;
  iRefreshRequired : boolean;
begin
  // deletes selected entries
  (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := TRUE;
  iRefreshRequired := FALSE;
  try
    ZFPFile.ClearErrorList;
    for i := Editor2.RowCount - 1 downto 1 do
    begin
      if EditorRowSelected( i ) then
      begin
        if CanDelete( i - 1 ) then
        begin
          if GlobalObject[ i - 1 ].Editable then
          begin
            Delete( i - 1, undoDelete2 );
            iRefreshRequired := TRUE;
            {
            ClearAllSelections;
            UpdateEditors;
            ZFPFile.CauseAndEffects.CETree.RefreshEditor;
            }
          end
          else
          begin
            ZFPFile.ErrorList.Assign( FormLoadErrors.MemoLoadErrors.Lines );
            if not FormLoadErrors.Execute( Translate('Deletion Errors'), Translate('Cannot Delete') + ' "' + GlobalObject[ i - 1 ].Name + '", - ' + Translate( 'Object is not editable')) then
            begin
              exit;
            end;
          end;
        end
        else
        begin
          ZFPFile.ErrorList.Assign( FormLoadErrors.MemoLoadErrors.Lines );
          if FormLoadErrors.Execute( Translate('Deletion Errors'), Translate('Cannot Delete') + ' "' + GlobalObject[ i - 1 ].Name + '", - ' + Translate( 'Object in use')) then
          begin
            ZFPFile.fPendingErrorFrames.Add( EditorFrame.FrameErrorList );
            ZFPFile.ShowErrorFrames;
          end
          else
          begin
            exit;
          end;
        end;
      end;
    end;
  finally
    (OwnerFile as tZFPFile).UndoRedo.GroupUndoActive := FALSE;
    if iRefreshRequired then
    begin
      ClearAllSelections;
      UpdateEditors;
      ZFPFile.CauseAndEffects.CETree.RefreshEditor;
    end;
  end;
end;

procedure tZFPGlobalArray.OnFixedCellClick(Sender: TObject; ACol,
  ARow: Integer);
var
  iNewVal : boolean;
  i : integer;
  iActiveChild : tZFPGlobalObject;
begin
  if ACol = 0 then
  begin
    if ARow = 0 then
    begin
      iNewVal := fEditor.Cell[ cColPanel1,1 ] <> '1';
      // toggle all
      for i := 0 to Max do
      begin
        if iNewVal then
        begin
          GlobalObject[ i ].RegisterAllNodes;
        end
        else
        begin
          GlobalObject[ i ].UnregisterAllNodes;
        end;
      end;
      UpdateEditors;
    end;
  end
  else if ARow = 0 then
  begin
    if ACol >= cColPanel1 then
    begin
      // toggle just this node
      iNewVal := fEditor.Cell[ ACol, 1 ] <> '1';
      for i := 0 to Max do
      begin
        if iNewVal then
        begin
          GlobalObject[ i ].RegisterNode( ACol - cColPanel0 );
        end
        else
        begin
          GlobalObject[ i ].UnregisterNode( ACol - cColPanel0 );
        end;
      end;
      UpdateEditors;
    end
    else if ACol = cColName then
    begin
      iActiveChild := GlobalObject[ ActiveChild ];
      SortByName;
      ShowEditors;
      SetActiveChildObject( iActiveChild );
    end
    else if ACol = cColID then
    begin
      iActiveChild := GlobalObject[ ActiveChild ];
      SortByID;
      ShowEditors;
      SetActiveChildObject( iActiveChild );
    end;
  end;
end;

