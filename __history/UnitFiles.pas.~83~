function tLoopDevice.RelativeABusAddressOf(
  const pSubDevice: tLoopSubdevice): integer;
var
  i: Integer;
  iAddress : integer;
begin
  Result := -1; // don't send if -1!
  iAddress := 0;
  for i := 1 to Subdevices.Max do // exclude subdevice 0 = device
  begin
    if SubDevice[ i ] = pSubDevice then
    begin
      if SubDevice[ i ].AllocatedToGroup then
      begin
        Result := iAddress;
      end;
      exit;
    end
    else if SubDevice[ i ].AllocatedToGroup then
    begin
      inc( iAddress );
    end;
  end;
end;

