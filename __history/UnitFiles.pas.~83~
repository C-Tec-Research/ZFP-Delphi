procedure tInputGroup.ImportFile(const pFile: tStrings; var iIndex: integer;
  const pNode: tZFPNode; const pList: tStrings; const pErrors: tErrorList;
  const pErrorObject: tObject);
var
  i, j, iVal : integer;
  iDefaultAll : boolean;
begin
  inherited;
  // for the most part the same for triggers and input groups
  // pData is a list of fields
  // [0] = 14 (record type
  // [1] = ID
  // -----------------
  // [2] - [13 ]= OP Mode  - not used for triggers
  // default operation is not uploaded, so we set default to be mode 0 operation
  // and adjust overrides accordingly
  if pList.Count > 13 then
  begin
    ModalOperations.Max := 3;
    try
      iVal := StrToInt( pList[ 2 ] );
    except
      iVal := 2;
      pErrors.Add( es_Error, iIndex, 2, Translate( 'Syntax Error' ), pErrorObject );
    end;
    DefaultModalOperation.fOpMode.ValueAsInt := iVal;
    //ModalOperations.InputGroupModalOperation[ 0 ].PanelMode.Mode := ZFPFile.ModeList.FindMode( 0, pNode );
    ModalOperations.InputGroupModalOperation[ 0 ].OpMode := opm_NA; // NA
    try
      iVal := StrToInt( pList[ 3 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 3, Translate( 'Syntax Error' ), pErrorObject );
    end;
    DefaultModalOperation.Data1.ValueAsInt := iVal;
    ModalOperations.InputGroupModalOperation[ 0 ].Data1.ValueAsInt := 0;
    try
      iVal := StrToInt( pList[ 4 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex, 4, Translate( 'Syntax Error' ), pErrorObject );
    end;
    DefaultModalOperation.Data2.ValueAsInt := iVal;
    ModalOperations.InputGroupModalOperation[ 0 ].Data2.ValueAsInt := 0;
    for i := 0 to 3 do
    begin
      j := (3 * i) - 1;
      try
        iVal := StrToInt( pList[ 3 + j ] );
      except
        iVal := 2;
        pErrors.Add( es_Error, iIndex,j, Translate( 'Syntax Error' ), pErrorObject );
      end;
      //ModalOperations.InputGroupModalOperation[ i ].PanelMode.Mode := ZFPFile.ModeList.FindMode( i, pNode );
      ModalOperations.InputGroupModalOperation[ i ].fOpMode.ValueAsInt := iVal;
      try
        iVal := StrToInt( pList[ 4 + j ] );
      except
        iVal := 0;
        pErrors.Add( es_Error, iIndex,4 + j, Translate( 'Syntax Error' ), pErrorObject );
      end;
      ModalOperations.InputGroupModalOperation[ i ].Data1.ValueAsInt := iVal;
      try
        iVal := StrToInt( pList[ 5 + j ] );
      except
        iVal := 0;
        pErrors.Add( es_Error, iIndex,5 + j, Translate( 'Syntax Error' ), pErrorObject );
      end;
      ModalOperations.InputGroupModalOperation[ i ].Data2.ValueAsInt := iVal;
    end;
    iDefaultAll := TRUE;
    for i := 0 to ZFPFile.ModeList.Max do
    begin
      with ModalOperations.InputGroupModalOperation[ i ] do
      begin
        if OpMode <> DefaultModalOperation.OpMode then
        begin
          iDefaultAll := FALSE;
          break;
        end;
        if Data1.ValueAsInt <> DefaultModalOperation.Data1.ValueAsInt then
        begin
          iDefaultAll := FALSE;
          break;
        end;
        if Data2.ValueAsInt <> DefaultModalOperation.Data2.ValueAsInt then
        begin
          iDefaultAll := FALSE;
          break;
        end;
      end;
    end;
    // set defaults if appropriate
    if iDefaultAll then
    begin
      for i := 0 to 3 do
      begin
        with ModalOperations.InputGroupModalOperation[ i ] do
        begin
          OpMode := opm_NA;
          Data1.ValueAsInt := 0;
          Data2.ValueAsInt := 0;
        end;
      end;
    end;
  end;
  // ------------------
  // [14] = IG 1st stage - not currently used as this is done in trigger lists
  // [15] = OG 1st stage - not currently used as this is done in trigger lists
  // [16] = Sequence - not currently used as this is done in trigger lists
  // [17] = Auto Clear
  // [18] = Delays MCP
  // [19] = Delays Detectors
  // [20] = MPC Qualifies Dep
  // [21]-[24] Input group dependencies not yet implemented (and may never be)
  // [25]-[28] are the silence functions and only apply to input groups
  // Again, the default is not transmitted, so use mode 0 as default
  // [29] if present is the Style
  if pList.Count > 28 then
  begin
    try
      iVal := StrToInt( pList[ 25 ] );
    except
      iVal := 0;
      pErrors.Add( es_Error, iIndex,25, Translate( 'Syntax Error' ), pErrorObject );
    end;
    DefaultModalOperation.CancelDelaysOnSilence.ValueAsBool := iVal = 1;
    ModalOperations.InputGroupModalOperation[ 0 ].CancelDelaysOnSilence.ValueAsDefaultableBool := db_Default;
    for i := 1 to 3 do
    begin
      j := 25 + i;
      try
        iVal := StrToInt( pList[ j ] );
      except
        iVal := 0;
        pErrors.Add( es_Error, iIndex,j, Translate( 'Syntax Error' ), pErrorObject );
      end;
      if DefaultModalOperation.CancelDelaysOnSilence.ValueAsBool = (iVal = 1)  then
      begin
        ModalOperations.InputGroupModalOperation[ i ].CancelDelaysOnSilence.ValueAsDefaultableBool := db_Default;
      end
      else
      begin
        ModalOperations.InputGroupModalOperation[ i ].CancelDelaysOnSilence.ValueAsBool := (iVal = 1);
      end;
    end;
  end;
  fIGStyle2.ValueAsInt := StrToIntDef( pList[ 29 ], 0 );  // no errors - may be missing
  // required
  FixModalOverrides;
end;

