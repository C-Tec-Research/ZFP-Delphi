  RefreshEditors;
  if assigned( fSubDeviceEditor ) then
  begin
    if fSubDeviceEditor.Tabs.Count > 1 then
    begin
      for i := 0 to iDevice.SubDeviceCount - 1 do
      begin
        if iDevice.SubDevice[ i ] = pSubDevice then
