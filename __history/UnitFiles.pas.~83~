function tGlobalObjectPointer.OnInterestedPartyCanDestroy(
  const pParty: tSigBaseProperty): boolean;
var
  iOwner : tSigCompoundProperty;
  iPreamble : string;
begin
  Result := inherited;
  // which error list we add to depends on which object owns us
  if not Result then
  begin
    iPreamble := Translate( 'Cannot Delete' ) + ' ' + GlobalObject.Name + ' - ';
    iOwner := Owner;
    while assigned( iOwner ) do
    begin
      if iOwner is tCETreeProperty then
      begin
        ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object in use by Cause and Effects Tree' ), self );
        exit;
      end;
      if iOwner is tLoopSubDevice then
      begin
        ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object needed by device' ), self );
        exit;
      end;
      if iOwner is tLoopDevice then
      begin
        ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object needed by device' ), self );
        exit;
      end;
      if iOwner is tInputSuperGroup then
      begin
        ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object in Supergroup' ), self );
        exit;
      end;
      if iOwner is tZFPSuperGroup then
      begin
        ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object in Supergroup' ), self );
        exit;
      end;
      if iOwner is tInputGroupModalOperations then
      begin
        Result := TRUE;  // the modal operation aspect can be removed.
        exit;
      end;
      iOwner := iOwner.Owner;
    end;
    // if we get here we did not find a standard entry so give generic message
    ZFPFile.AddError( es_Error, 0, 0, iPreamble + Translate( 'Object in use' ), self );

  end;
end;

