function tZFPNodeList.CreateNode(const pID: integer;
  const pType: tNodalType): tZFPNode;
begin
  // no duplicates
  Result := NodeWithID( pID );
  if not assigned( Result ) then
  begin
    //{ debug 123
    if XFP4PgmCfg.NodalInfo.IsEmptyNode( pType ) then
    begin
      Result := nil;
    end
    else
    begin
    //}
      if NodeCountOfType( pType ) >= MaxNodeCountOfType( pType ) then
      begin
        raise Exception.Create(Translate( 'Max nodes of this type already added'));
      end;
      Result := AddNewChild as tZFPNode;
      Result.ID := pID;
      Sort;
    //{ debug 123
    end;
    //}
  end;
  if assigned( Result ) then
  begin
    Result.NodalType := pType;
    if XFP4PgmCfg.NodalInfo.IsEmptyNode( pType ) then
    begin
      // setting the node type to an empty node detroys it, so we must not return a value!
      Result := nil;
    end;
  end;
end;

