procedure tLoopDevices.ImportDeviceFieldsFile( const pList: tStrings);
var
  iIndex : integer;
  iLoopDevice : tLoopDevice;
  iLoopAddress : integer;
begin
  // pList is already populated!
  // pList[0] and pList[ 1 ] are already known to be valid
  if pList.Count > 2 then
  begin
    iIndex := StrToInt( pList[ 2 ] ) - 1;
    //ActiveChild := iIndex;
    iLoopAddress := StrToInt( pList[ 1 ] );
    if Loop.LoopType = ltA_Bus then
    begin
      // recheck column 1 to see if we are dealing with device or subdevice
      case iLoopAddress of
        10:
        begin
          iLoopDevice := LoopDevice[ iIndex ];
          if assigned( iLoopDevice ) then
          begin
            // just as normal
            iLoopDevice.ImportDeviceFieldsFile( pList, iLoopAddress );
          end
          else
          begin
            // to do - work out if not a fitted device.
          end;
        end;
        11:
        begin
          // we need to work out which device this subdevice is associated with
          iLoopDevice := DeviceWithABusSubdevice( iIndex + 1 );
          if assigned( iLoopDevice ) then
          begin
            iLoopDevice.ImportSubDeviceFieldsFile( pList );
          end
          else
          begin
            // to do - work out if not a fitted device.
          end;
        end;
        else
        begin
          raise Exception.Create(Translate( 'Device Fields Unexpected Loop Address') );
        end;
      end;
    end
    else
    begin
      iLoopDevice := LoopDevice[ iIndex ];
      if assigned( iLoopDevice ) then
      begin
        iLoopDevice.ImportDeviceFieldsFile( pList, iLoopAddress );
      end
      else
      begin
        // to do - work out if not a fitted device.
      end;
    end;
  end
  else
  begin
    raise Exception.Create(Translate( 'Device Fields Address Missing Field') );
  end;
end;

procedure tLoopDevices.ImportNamesFile(const pFile: tStrings;
  var pLine: integer; const pList: tStrings; const pErrors : tErrorList; const pErrorObject : tObject );
var
  iIndex : integer;
  iErrText : string;
begin
  // pList is already populated!
  // pList[0] and pList[ 1 ] are already known to be valid
  if pList.Count > 2 then
  begin
    iIndex := StrToInt( pList[ 2 ] ) - 1;
    LoopDevice[ iIndex ].ImportNamesFile( pFile, pLine, pList, pErrors, pErrorObject );
  end
  else
  begin
    iErrText := Translate( 'Missing Field');
    pErrors.Add( es_Error, pLine, 2, iErrText, pErrorObject );
  end;
end;

procedure tLoopDevices.ImportSubloopNamesFile(const pFile: tStrings;
  var pLine: integer; const pList: tStrings; const pErrors: tErrorList;
  const pErrorObject: tObject);
var
  iIndex : integer;
  iErrText : string;
  iDevice : tLoopDevice;
begin
  // pList is already populated!
  // pList[0] and pList[ 1 ] are already known to be valid
  if pList.Count > 2 then
  begin
    iIndex := StrToInt( pList[ 2 ] ) - 1;
    // iIndex here maps to the subdevice of a device
    iDevice := DeviceWithABusSubdevice( iIndex );
    if assigned( iDevice ) then
    begin
      iDevice.ImportSubloopNamesFile( iIndex, pFile, pLine, pList, pErrors, pErrorObject );
    end
    else
    begin
      iErrText := Translate( 'Cannot find Device associated with this subdevice');
      pErrors.Add( es_Error, pLine, 2, iErrText, pErrorObject );
    end;
  end
  else
  begin
    iErrText := Translate( 'Missing Field');
    pErrors.Add( es_Error, pLine, 2, iErrText, pErrorObject );
  end;
end;

