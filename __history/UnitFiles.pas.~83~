function tZFPWhereUsedList.SharesNodes(
  const iObject: tZFPWhereUsedList): boolean;
var
  i: Integer;
  j: Integer;
begin
  if iObject <> self then
  begin
    for i := 0 to fWhereUsed2.Max do
    begin
      if assigned( fWhereUsed2.Node[ i ] ) then
      begin
        for j := 0 to iObject.fWhereUsed2.Max do
        begin
          if fWhereUsed2.Node[ i ] = iObject.fWhereUsed2.Node[ j ] then
          begin
            Result := TRUE;
            exit;
          end;
        end;
