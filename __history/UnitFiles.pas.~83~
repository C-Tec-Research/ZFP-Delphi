procedure tCETreeInputGroup.OnInputGroupChange(Sender: TObject);
var
  iNewInputGroup : tZFPGlobalObject;
  iIndex : integer;
  iReturnObject : tLoopFieldPointerTypeEnum;
begin
  iReturnObject := PointerType.PointerType;
  iNewInputGroup := ZFPFile.SelectFromList( 'Select Input', TRUE, CurrentObject, [ lf_Input, lf_InputSupergroup ], iReturnObject, AppliesToPanels );
  if iNewInputGroup <> CurrentObject then
  begin
    ZFPFile.UndoRedo.GroupUndoActive := TRUE;
    try
      if assigned( CurrentObject ) then
      begin
        CurrentObject.ClearFieldEditors;
      end;
      CurrentObject := iNewInputGroup;
      iIndex := 0;
      BuildEditorList( iIndex );
      TreeNode1.ImageIndex := ImageIndex;
      TreeNode1.SelectedIndex := ImageIndex + cSelectedOffset;
    finally
      ZFPFile.UndoRedo.GroupUndoActive := FALSE;
    end;
  end;
end;

