    CETree Cause and Effects Tree
      Tree Text = 
      CETree C & E Block( 1 )
        Tree Text = One out All out
        Panel List = 1-128
        CETree Input Group( 1 )
          Tree Text = All Input Device
          Input Group Pointer = Item( 0 )
          Pointer Type = lf_Input
          CETree Input Group State( 1 )
            Tree Text = Activated
            State = 2
            Switch State = 2
            AND State = 2
            CETree Action( 1 )
              Tree Text = ON
              Sequence = Item( 1 )
              CETree Output Object( 1 )
                Tree Text = All Output Devic
                Output Type = lf_Output
                Output Group = Item( 0 )
              End CETree
            End CETree
          End CETree
        End CETree
      End CETree
      CETree C & E Block( 2 )
        Tree Text = Monitored I/Ps
        Panel List = 1-128
        CETree Input Group( 1 )
          Tree Text = Class Change
          Input Group Pointer = Item( 1 )
          Pointer Type = lf_Input
          CETree Input Group State( 1 )
            Tree Text = Activated
            State = 2
            Switch State = 2
            AND State = 2
            CETree Action( 1 )
              Tree Text = ON
              Sequence = Item( 1 )
              CETree Output Object( 1 )
                Tree Text = All Output Devic
                Output Type = lf_Output
                Output Group = Item( 0 )
              End CETree
            End CETree
          End CETree
        End CETree
