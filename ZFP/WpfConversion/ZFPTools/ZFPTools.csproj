<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by Delphi to WPF Converter from ZFPTools.dpr -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>ZFPTools</RootNamespace>
    <AssemblyName>ZFPTools</AssemblyName>
    <!-- Warnings that are expected in machine-translated Delphi code -->
    <NoWarn>$(NoWarn);CS0162;CS0164;CS0168;CS0169;CS0219;CS0414;CS0649;CS0642;CS8981;CS0252;CS0253;CS1717</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Images extracted from the DFM files -->
    <Resource Include="Resources\**\*" />
    <!-- Original Delphi sources kept for reference only -->
    <None Include="Original\**\*" />
  </ItemGroup>

</Project>
