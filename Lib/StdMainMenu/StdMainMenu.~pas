procedure TStdFileMenu.fSetStdFile( NewVal : TStdFile );
begin
  iFile.Free;
  iFile := NewVal;
end;

constructor TStdFileMenu.Create(AOwner: TComponent);
begin
  inherited Create( AOwner );
end;

destructor TStdFileMenu.Destroy;
begin
  iFile.Free;
  inherited;
end;

function TStdFileMenu.fGetPropertyByName( index : string ) : TStdFileProperty;
begin
  Result := iFile.iProperties.PropertyByName[ index ];
end;

function TStdFileMenu.fGetIndexedProperty( name : string; index : string ) : TStdFileProperty;
begin
  Result := iFile.iProperties.IndexedProperty[ name, index ];
end;

function TStdFileMenu.fGetDirty : boolean;
begin
  Result := inherited fGetDirty;
  if not Result then
  begin
    if assigned( iFile ) then
    begin
      Result := iFile.IsDirty;
    end;
  end;
end;

procedure TStdFileMenu.fSetDirty( NewVal : boolean );
begin
  inherited;
  if assigned( iFile ) then
  begin
    iFile.IsDirty := NewVal;
  end;
end;

procedure TStdFileMenu.FileLoad( Sender : TObject; pWithName : string );
var
  iSuccess : boolean;
  F : TextFile;
begin
  if assigned( iOnFileLoad ) then
  begin
    iSuccess := TRUE;
    iOnFileLoad( Sender, pWithName, iSuccess );
    if iSuccess and assigned( iAfterFileLoad ) then
    begin
      iAfterFileLoad( Sender );
    end;
  end
  else
  begin

    FileName := pWithName;

    AssignFile( F, iFileName );
    try
      Reset( F );

      if not iFile.Load( F ) then
      begin
        MessageDlg( 'File did not load correctly.', mtWarning, [ mbOK ], 0 );
      end
      else if assigned( iAfterFileLoad ) then
      begin
        iAfterFileLoad( Sender );
      end;
    finally
      CloseFile( F );
    end;

  end;
end;

function TStdFileMenu.fSave( Sender : TObject ) : TModalResult;
var
  F : TextFile;
begin
  Result := mrOK;
  AssignFile( F, iFileName );
  try
    Rewrite( F );

    if not iFile.Save( F ) then
    begin
      Result := MessageDlg( 'File did not save correctly. Click OK to proceed anyway or Cancel to abort action.', mtWarning, mbOKCancel, 0 );
    end;
  finally
    CloseFile( F );
  end;
end;

function TStdFileMenu.FileCreate( Sender : TObject; pWithName : string ) : TModalResult;
var
  iSuccess : boolean;
begin
  Result := mrOK;
  if assigned( iOnFileCreate ) then
  begin
    iSuccess := TRUE; // assume failure
    iOnFileCreate( Sender, pWithName, iSuccess );
    if not iSuccess then
    begin
      Result := mrCancel;
      exit;
    end;
    if assigned( iClearDirty ) then iClearDirty( Sender );
  end
  else
  begin
    // user not taking responsibility, so auto create
    StdFile := TStdFile.Create;
    FileName := pWithName;
  end;
end;

