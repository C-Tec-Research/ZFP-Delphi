constructor TStdFileProperty.Create( pName : string; pIndex : string );
begin
  inherited Create;
  iIsDirty := FALSE;
  iValue := '';
  iName := pName;
  iIndex := pIndex;
end;

class function TStdFileProperty.GetPreferredForm( OfText : string ) : string;
begin
  Result := OfText;
end;

class function TStdFileProperty.IsFixedList : boolean;
begin
  Result := FALSE;
end;

function TStdFileProperty.fGetAsString : string;
begin
  Result := iValue;
end;

procedure TStdFileProperty.fSetAsString( NewVal : string );
begin
  if iValue <> NewVal then
  begin
    iValue := NewVal;
    iIsDirty := TRUE;
  end;
end;

function TStdFileProperty.fGetIsDirty : boolean;
begin
  Result := iIsDirty;
end;

procedure TStdFileProperty.fSetIsDirty( NewVal : boolean );
begin
  iIsDirty := NewVal;
  if NewVal <> iIsDirty then
  begin
    raise Exception.Create( 'Thr world has gone mad!' );
  end;
end;

function TStdFileProperty.Save( var F : TextFile; indent : integer ) : boolean;
begin
  Write( F, StringOfChar( ' ', Indent ), iName );
  if Index <> '' then
  begin
    Write( F, '( ', Index, ' )');
  end;
  if AsString = '' then
  begin
    WriteLn( F );
  end
  else
  begin
    WriteLn( F, ' = ', AsString );
  end;
  iIsDirty := FALSE;
  Result := TRUE;
end;

