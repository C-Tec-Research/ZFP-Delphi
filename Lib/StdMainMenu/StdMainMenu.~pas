function TStdFileObject.Load( var F : TextFile ) : boolean;
var
  iLine : string;
  iUnrecognisedPropertyFound : boolean;
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
  iToAdd : tStdFileProperty;
  i : integer;
begin
  Result := FALSE; // assume no end of object
  iUnrecognisedPropertyFound := FALSE;
  while not EOF( F ) do
  begin
    ReadLn( F, iLine );
    if SigNETParse( iLine, SigProperty, SigIndex, SigValue, SigComment ) then
    begin
      if SigProperty <> '' then
      begin
        // not a comment line
        if SameText( SigProperty, 'End ' + iName ) then
        begin
          // done
          if not iUnrecognisedPropertyFound then Result := TRUE;
          exit;
        end;
        // see if in existing list
        iToAdd := nil;
        for i := 0 to iProperties.Count - 1 do
        begin
          if SameText( iProperties.PropertyByIndex[ i ].Name, SigProperty )
          and SameText( iProperties.PropertyByIndex[ i ].iIndex, SigIndex ) then
          begin
            iToAdd := iProperties.PropertyByIndex[ i ];
            break;
          end;
        end;
        if not assigned( iToAdd ) then
        begin
          // else
          iToAdd := CreateObjectFromText( SigProperty, SigIndex );
        end;
        if assigned( iToAdd ) then
        begin
          iProperties.Add( iToAdd );
          iToAdd.AsString := SigValue;
          if iToAdd is TStdFileMultiLineProperty then
          begin
            with iToAdd as TStdFileMultiLineProperty do
            begin
              Load( F );
            end;
          end;
          iToAdd.IsDirty := FALSE;
        end
        else
        begin
          iUnrecognisedPropertyFound := TRUE;
        end;
      end;
    end
    else
    begin
      iUnrecognisedPropertyFound := TRUE;
    end;
  end;
end;

function TStdFileObject.CreateObjectFromText( pText : string; pIndex : string ) : tStdFileProperty;
begin
  // a generic file object allows any property to be created as a string property
  Result := tStdFileStringProperty.Create( pText, pIndex );
end;

