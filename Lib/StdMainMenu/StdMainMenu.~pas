procedure Register;

implementation

procedure Register;
begin
  RegisterComponents('SigNET', [TStdMainMenu, TStdFileMenu]);
end;


constructor TCustomStdMainMenu.Create( AOwner : TComponent );
begin
  inherited Create( AOwner );

  iOwningForm := AOwner as TForm;

end;

procedure TCustomStdMainMenu.AfterConstruction;
var
  NewItem : TMenuItem;
  i : integer;
begin
  if not (csDesigning in ComponentState) then
  begin

    iSigRegistry := TSigRegistry.Create( self );

    iSigRegistry.Key := Application.ExeName;

    iMainMenu := TMainMenu.Create( iOwningForm );

    with iMainMenu do
    begin
      iFileMenu := TMenuItem.Create( iOwningForm );
      Items.Add( iFileMenu );
      iFileMenu.Caption := '&File';

      iHelpMenu := TMenuItem.Create( iOwningForm );
      Items.Add( iHelpMenu );
      iHelpMenu.Caption := '&Help';

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := '&New';
      NewItem.ShortCut := TextToShortCut( 'Ctrl+N' );
      NewItem.Name := 'StdMenuNew';
      NewItem.OnClick := FileNew;

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := '&Open';
      NewItem.ShortCut := TextToShortCut( 'Ctrl+O' );
      NewItem.Name := 'StdMenuOpen';

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := '&Save';
      NewItem.ShortCut := TextToShortCut( 'Ctrl+S' );
      NewItem.Name := 'StdMenuSave';
      NewItem.OnClick := fFileSave;

      iSaveAsMenu := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( iSaveAsMenu );
      iSaveAsMenu.Caption := 'Save &As';
      iSaveAsMenu.ShortCut := TextToShortCut( 'Ctrl+A' );
      iSaveAsMenu.Name := 'StdMenuSaveAs';
      iSaveAsMenu.OnClick := fFileSaveAs;

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := '-';

      for i := 0 to 9 do
      begin
        iHistory[ i ] := TMenuItem.Create( iOwningForm );
        iFileMenu.Add( iHistory[ i ] );
        iHistory[ i ].Tag := i;
        iHistory[ i ].Name := 'StdMenuHistory' + IntToStr( i );
        iHistory[ i ].OnClick := fOnHistoryClick;
      end;

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := '-';

      NewItem := TMenuItem.Create( iOwningForm );
      iFileMenu.Add( NewItem );
      NewItem.Caption := 'E&xit';
      NewItem.ShortCut := TextToShortCut( 'Alt+F4' );
      NewItem.OnClick := fExit;

      iAboutMenu := TMenuItem.Create( iOwningForm );
      iHelpMenu.Add( iAboutMenu );
      iAboutMenu.Caption := '&About';
      iAboutMenu.Name := 'StdMenuAbout';

    end;

    ShowHistory;

//    iChainClose := iOwningForm.OnClose;
    iOwningForm.OnClose := fClose;

    iSaveDialog := TSaveDialog.Create( iOwningForm );
    iSaveDialog.Options := iSaveDialog.Options + [ ofOverwritePrompt ];

    iOwningForm.Menu := iMainMenu;

//    fFileNewEx( self );
//    FileCreate( self, '' );
  end;

end;

function TCustomStdMainMenu.fGetOnAbout : TNotifyEvent;
begin
  result := iOnAboutClick;
end;

procedure TCustomStdMainMenu.fSetOnAbout( NewVal : TNotifyEvent );
begin
  iOnAboutClick := NewVal;
  if not (csDesigning in ComponentState) then
  begin
    iAboutMenu.OnClick := NewVal;
  end;
end;

function TCustomStdMainMenu.fGetDirty : boolean;
begin
  Result := FALSE;
  if assigned( iCheckDirty ) then iCheckDirty( result );
end;

procedure TCustomStdMainMenu.fSetDirty( NewVal : boolean );
begin
  // by default does nothing
end;

procedure TCustomStdMainMenu.fClose( Sender : TObject; var Action : TCloseAction );
begin
  if fSaveIfDirty( Sender ) = mrCancel then
  begin
    Action := caNone;
  end
  else if assigned( iChainClose ) then
  begin
    iChainClose( Sender, Action );
  end;
end;

procedure TCustomStdMainMenu.fExit( Sender : TObject );
begin
  iOwningForm.Close;
end;

procedure TCustomStdMainMenu.ShowHistory;
var
  i : integer;
  iCaption : string;
begin
  for i := 0 to 9 do
  begin
    iCaption := iSigRegistry.History[ i ];
    if iCaption = '' then
    begin
      iHistory[ i ].Visible := FALSE;
    end
    else
    begin
      iHistory[ i ].Caption := iCaption;
      iHistory[ i ].Visible := TRUE;
    end;
  end;
end;

procedure TCustomStdMainMenu.FileLoad( Sender : TObject; pWithName : string );
var
  iSuccess : boolean;
begin
  if assigned( iOnFileLoad ) then
  begin
    iSuccess := TRUE;
    iOnFileLoad( Sender, pWithName, iSuccess );
  end;
  if iSuccess then
  begin
    if assigned( iAfterFileLoad ) then
    begin
      iAfterFileLoad( Sender );
    end;
  end;
end;

procedure TCustomStdMainMenu.fOnHistoryClick( Sender : TObject );
begin
  if fSaveIfDirty( Sender ) <> mrCancel then
  begin
    FileCreate( Sender, iSigRegistry.History[ TMenuItem( Sender ).Tag ] );
    FileLoad( Sender, iSigRegistry.History[ TMenuItem( Sender ).Tag ] );
  end;
end;

procedure TCustomStdMainMenu.FileNew( Sender : TObject );
begin
  fFileNewEx( Sender );
end;

function TCustomStdMainMenu.fSaveIfDirty( Sender : TObject ) : TModalResult;
begin
  if IsDirty then
  begin
    Result := MessageDlg( 'File has changed. Do you wish to save changes?', mtWarning, mbYesNoCancel, 0 );
    case Result of
      mrYes:
      begin
        Result := fFileSaveEx( Sender );
      end;
    end;
  end
  else
  begin
    Result := mrOK;
  end;
end;

function TCustomStdMainMenu.FileCreate( Sender : TObject; pWithName : string ) : TModalResult;
var
  iSuccess : boolean;
begin
  Result := mrOK;
  iSuccess := TRUE;
  if assigned( iOnFileCreate ) then
  begin
    iOnFileCreate( Sender, pWithName, iSuccess );
    if iSuccess then
    begin
      if assigned( iClearDirty ) then iClearDirty( Sender );
    end
    else
    begin
      Result := mrCancel;
    end;
  end;
end;

function TCustomStdMainMenu.fFileNewEx( Sender : TObject ) : tModalResult;
begin
  Result := fSaveIfDirty( Sender );
  if Result <> mrCancel then
  begin
    Result := FileCreate( Sender, '' );
  end;
end;

procedure TCustomStdMainMenu.fFileSave( Sender : TObject );
begin
  fFileSaveEx( Sender );
end;

function TCustomStdMainMenu.fSave( Sender : TObject ) : TModalResult;
var
  iSuccess : boolean;
begin
  Result := mrOK;
  if assigned( iOnFileSave ) then
  begin
    iSuccess := TRUE;
    iOnFileSave( self, iFileName, iSuccess );
    if not iSuccess then
    begin
      Result := mrCancel;
    end;
  end;
end;

function TCustomStdMainMenu.fFileSaveEx( Sender : TObject ) : TModalResult;
begin
  if iFileName = '' then
  begin
    Result := fFileSaveAsEx( Sender );
  end
  else
  begin
    Result := fSave( Sender );
    if assigned( iClearDirty ) then iClearDirty( Sender );
    iSigRegistry.SetHistory( iFileName );
  end;
end;

procedure TCustomStdMainMenu.fFileSaveAs( Sender : TObject );
begin
  fFileSaveAsEx( Sender );
end;

function TCustomStdMainMenu.fFileSaveAsEx( Sender : TObject ) : TModalResult;
begin
  if iFileName <> '' then
  begin
    iSaveDialog.InitialDir := ExtractFilePath( iFileName );
  end;
  iSaveDialog.FileName := ExtractFileName( iFileName );
  if iSaveDialog.Execute then
  begin
    iFileName := iSaveDialog.FileName;
    Result := fFileSaveEx( Sender );
  end
  else
  begin
    // cancelled
    Result := mrCancel;
  end;
end;

function TCustomStdMainMenu.fGetFilter : string;
begin
  Result := iFilter;
end;

procedure TCustomStdMainMenu.fSetFilter( NewVal : string );
begin
  iFilter := NewVal;
  if not (csDesigning in ComponentState) then
  begin
    iSaveDialog.Filter := NewVal;
  end;
end;

function TCustomStdMainMenu.fGetDefaultExt : string;
begin
  Result := iDefaultExt;
end;

procedure TCustomStdMainMenu.fSetDefaultExt( NewVal : string );
begin
  iDefaultExt := NewVal;
  if not (csDesigning in ComponentState) then
  begin
    iSaveDialog.DefaultExt  := NewVal;
  end;
end;

procedure TCustomStdMainMenu.AddMenuEntry( pWhere : TMenuLocation; pNewVal : tMenuItem );
begin
  case pWhere of
    mlMain:
    begin
      iMainMenu.Items.Insert( 1, pNewVal );
    end;
    mlFile:
    begin
      iFileMenu.Insert( iFileMenu.IndexOf( iSaveAsMenu ) + 1, pNewVal );
    end;
    mlHelp:
    begin
      iHelpMenu.Insert( iHelpMenu.IndexOf( iSaveAsMenu ) + 1, pNewVal );
    end;
  end;
end;

