//--------------- TStdFilePropertyList -------------

constructor TStdFilePropertyList.Create;
begin
  inherited Create( TRUE );
  iIsDirty := FALSE;
end;

function TStdFilePropertyList.Add( NewVal : TStdFileProperty ) : integer;
var
  i : integer;
begin
  // do not allow duplicates
  for i := 0 to Count - 1 do
  begin
    if SameText( PropertyByIndex[ i ].Name, NewVal.Name )
    and SameText( PropertyByIndex[ i ].Index, NewVal.Index ) then
    begin
      Result := i;
      exit;
    end;
  end;
  Result := inherited Add( NewVal );
  iIsDirty := TRUE;
end;

function TStdFilePropertyList.fGetPropertyByIndex( index : integer ) : TStdFileProperty;
begin
  result := Items[ index ] as TStdFileProperty;
end;

function TStdFilePropertyList.fGetPropertyByName( index : string ) : TStdFileProperty;
var
  i : integer;
begin
  Result := nil;
  for i := 0 to Count - 1 do
  begin
    if SameText( PropertyByIndex[ i ].Name, index ) then
    begin
      Result := PropertyByIndex[ i ];
      exit;
    end;
  end;
end;

function TStdFilePropertyList.fGetIndexedProperty( name : string; index : string ) : TStdFileProperty;
var
  i : integer;
begin
  Result := nil;
  for i := 0 to Count - 1 do
  begin
    if SameText( PropertyByIndex[ i ].Name, name ) then
    begin
      if SameText( PropertyByIndex[ i ].Index, index ) then
      begin
        Result := PropertyByIndex[ i ];
        exit;
      end;
    end;
  end;
end;

function TStdFilePropertyList.fGetIsDirty : boolean;
var
  i : integer;
begin
  Result := iIsDirty;
  if not Result then
  begin
    for i := 0 to Count - 1 do
    begin
      if PropertyByIndex[ i ].IsDirty then
      begin
        Result := TRUE;
        exit;
      end;
    end;
  end;
end;

procedure TStdFilePropertyList.fSetIsDirty( NewVal : boolean );
var
  i : integer;
begin
  // only allow to be reset, never set
  if not NewVal then
  begin
    for i := 0 to Count - 1 do
    begin
      PropertyByIndex[ i ].IsDirty := NewVal;
    end;
    iIsDirty := NewVal;
  end;
end;

function TStdFilePropertyList.Save( var F : TextFile; indent : integer ) : boolean;
var
  i : integer;
begin
  Result := TRUE;
  for i := 0 to Count - 1 do
  begin
    if not PropertyByIndex[ i ].Save( F, indent ) then
    begin
      Result := FALSE;
      // still try and save rest
    end;
  end;
end;

