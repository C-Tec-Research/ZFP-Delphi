  else if SameText( TestVal, 'y' ) then Result := TRUE
  else if SameText( TestVal, 'n' ) then Result := TRUE
  else if SameText( TestVal, 'true' ) then Result := TRUE
  else if SameText( TestVal, 'false' ) then Result := TRUE
  else if SameText( TestVal, 't' ) then Result := TRUE
  else if SameText( TestVal, 'f' ) then Result := TRUE
  else if SameText( TestVal, '1' ) then Result := TRUE
  else if SameText( TestVal, '0' ) then Result := TRUE
  else result := FALSE;
