  else if SameText( OfText, 'y' ) then Result := 'True'
  else if SameText( OfText, 'n' ) then Result := 'False'
  else if SameText( OfText, 'true' ) then Result := 'True'
  else if SameText( OfText, 'false' ) then Result := 'False'
  else if SameText( OfText, 't' ) then Result := 'True'
  else if SameText( OfText, 'f' ) then Result := 'False'
  else if SameText( OfText, '1' ) then Result := 'True'
  else if SameText( OfText, '0' ) then Result := 'False'
