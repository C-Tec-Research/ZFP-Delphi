  end;
end;

function TStdFileMemoProperty.Save( var F : TextFile; indent : integer ) : boolean;
var
  i : integer;
begin
  WriteLn( F, StringOfChar( ' ', indent ), iName );
  inc( indent, 2);
  for i := 0 to iData.Count - 1 do
  begin
    WriteLn( F, StringOfChar( ' ', indent ), '//', iData[ i ] );
  end;
  dec( indent, 2);
  WriteLn( F, StringOfChar( ' ', Indent ), 'End ' + iName );
  Result := TRUE;
end;

function TStdFileMemoProperty.Load( var F : TextFile ) : boolean;
var
  iLine : string;
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
begin
  Result := FALSE; // assume no end of object
  iData.Clear;
  while not EOF( F ) do
  begin
    ReadLn( F, iLine );
    if SigNETParse( iLine, SigProperty, SigIndex, SigValue, SigComment ) then
    begin
      if SigProperty = '' then
      begin
        iData.Add( SigComment );
      end
      else
      begin
        // not a comment line
        if SameText( SigProperty, 'End ' + iName ) then
        begin
          Result := TRUE;
        end;
        // else unexpected line - abort now in either case
        exit;
      end;
    end
    else
    begin
      // illegal format - abort
      exit;
    end;
  end;
end;

