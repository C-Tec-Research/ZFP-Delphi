function TStdFile.Load( var F : TextFile ) : boolean;
var
  iLine : string;
  SigProperty : string;
  SigIndex : string;
  SigValue : string;
  SigComment : string;
  iToAdd : tStdFileProperty;
begin
  Result := TRUE; // assume OK
  while not EOF( F ) do
  begin
    ReadLn( F, iLine );
    if SigNETParse( iLine, SigProperty, SigIndex, SigValue, SigComment ) then
    begin
      if SigProperty <> '' then
      begin
        // not a comment line; see if property exists
        iToAdd := iProperties.IndexedProperty[ SigProperty, SigIndex ];
        if not assigned( iToAdd ) then // try to create
        begin
          iToAdd := CreateObjectFromText( SigProperty, SigIndex );
          if assigned( iToAdd ) then
          begin
            // successful - add it
            iProperties.Add( iToAdd );
            // we already know that this is not a duplicate
            // entry, so value will point to correct entry
          end;
        end;
        if assigned( iToAdd ) then
        begin
          iToAdd.AsString := SigValue;
          if iToAdd is TStdFileStringProperty then
          begin
            with iToAdd as TStdFileStringProperty do
            begin
              if not Load( F ) then Result := FALSE;
            end;
          end;
          iToAdd.IsDirty := FALSE;
        end
        else
        begin
          Result := FALSE;
        end;
      end;
    end;
  end;
end;

