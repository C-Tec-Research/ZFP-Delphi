function tSVMPlay.Text( UsingLibrary : tSVMLibrary ) : string;
var
  i : integer;
begin
  Result := '';
  if iMessageNo >= 0 then
  begin
    try
      with UsingLibrary.Item[ iMessageNo ].LongText do
      begin
        for i := 0 to Count-1 do
        begin
          Result := Result + Strings[ i ];
          // strip off carriage return // line feed
          if Length( Result ) > 0 then
          begin
            case Result[ Length( Result ) ] of
              #10, #13: Result := System.Copy( Result, 1, Length( Result ) - 1 );
            end;
          end;
          if Length( Result ) > 0 then
          begin
            case Result[ Length( Result ) ] of
              #10, #13: Result := System.Copy( Result, 1, Length( Result ) - 1 );
            end;
          end;
        end;
      end;
    except
      Result := '<error - message deleted>';
    end;
  end;
  iLength := Length( Result );
end;

