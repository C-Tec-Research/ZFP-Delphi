procedure TMessageMatrixEntry.ExportAsCtec( var F : TextFile );
var
  i : integer;
begin
  for i := 0 to 3 do
  begin
    // remember to offset messages by 1 for export
    Write( F, IntToStr(TriggerActivation[ i ] + 1 ), ' ' );
  end;
  for i := 0 to 3 do
  begin
    // remember to offset messages by 1 for export
    Write( F, IntToStr(TriggerUnactivation[ i ] + 1 ), ' ' );
  end;
  WriteLn( F );
end;

procedure TMessageMatrixEntry.AdjustMessageIndexDown( FromReference : integer );
var
  i : integer;
begin
  for i := 0 to 3 do
  begin
    if TriggerActivation [ i ] > FromReference then
    begin
      TriggerActivation [ i ] := TriggerActivation[ i ] - 1;
    end;
    if TriggerUnactivation [ i ] > FromReference then
    begin
      TriggerUnactivation [ i ] := TriggerUnactivation[ i ] - 1;
    end;
  end;
  if iActiveMessage > FromReference then
  begin
    dec( iActiveMessage );
  end;
end;

procedure TMessageMatrixEntry.AdjustMessageIndexUp( FromReference : integer );
var
  i : integer;
begin
  for i := 0 to 3 do
  begin
    if TriggerActivation [ i ] >= FromReference then
    begin
      TriggerActivation [ i ] := TriggerActivation[ i ] + 1;
    end;
    if TriggerUnactivation [ i ] >= FromReference then
    begin
      TriggerUnactivation [ i ] := TriggerUnactivation[ i ] + 1;
    end;
  end;
  if iActiveMessage >= FromReference then
  begin
    Inc( iActiveMessage );
  end;
end;

