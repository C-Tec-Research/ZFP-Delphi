  iFileLength := 0;
  iIgnoreFileError := FALSE;
  iLongText := tStringList.Create;
  iShortText := '';
end;

procedure tSVMLibraryElement.Load( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
begin
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End MP3 File' ) then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
      else if SameText( iSigProperty, 'Name' ) then
      begin
        ShortText := iSigValue;
      end
      else if SameText( iSigProperty, 'Text' ) then
      begin
        LoadText( F );
      end
      else
      begin
        // ignore errors for now
      end;
    end;
  end;
end;

procedure tSVMLibraryElement.LoadText( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
begin
  iLongText.Clear;
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End Text' ) then
      begin
        // done
        Exit;
      end
      else if SameText( iSigProperty, '' ) then
      begin
        // comment
        iLongText.Add( iSigComment );
      end
      else
      begin
        // ignore errors for now
      end;
    end;
  end;
end;

procedure tSVMLibraryElement.Save( var F : TextFile; indent : integer );
