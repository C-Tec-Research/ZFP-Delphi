//------------- tSVMMessageElement ----------------

constructor tSVMMessageElement.Create;
begin
    iLength := 0;
    iOnNotify := nil;
    iPlaying := FALSE;
    iUsed := FALSE;
end;

procedure tSVMMessageElement.Save( var F : TextFile; var indent : integer );
begin
  SaveStart( F, Indent );
  SaveMiddle( F, Indent );
  SaveEnd( F, Indent );
  iIsDirty := FALSE;
end;

procedure tSVMMessageElement.SaveStart( var F : TextFile; var indent : integer );
begin
  WriteLn( F, StringOfChar( ' ', Indent ) + SaveID );
  Inc( Indent, 2 );
end;

procedure tSVMMessageElement.SaveMiddle( var F : TextFile; var indent : integer );
begin
  // currently no general properties to save
end;

procedure tSVMMessageElement.SaveEnd( var F : TextFile; var indent : integer );
begin
  Dec( Indent, 2 );
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End ' + SaveID );
end;

procedure tSVMMessageElement.Stop;
begin
  if iPlaying then
  begin
    iPlaying := FALSE;
    if assigned( iOnNotify ) then iOnNotify( nsStop );
  end;
end;

procedure tSVMMessageElement.Play( UsingLibrary : tSVMLibrary );
begin
  iPlaying := TRUE;
end;

procedure tSVMMessageElement.SetUsed( UsingLibrary : tSVMLibrary );
begin
  iUsed := TRUE; // for all except Play
end;

