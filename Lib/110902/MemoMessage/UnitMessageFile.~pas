function tFlash.IsCurrMessageUsed : boolean;
var
  i, j : integer;
  iCurrEntry : integer;
begin
  Result := TRUE; // assume find
  // used to determine if a message can be deleted
  // so non-existant messages are assumed to be used
  iCurrEntry := SVMLibrary.ActiveOption;
  if iCurrEntry >= 0 then  // if message not current then cannot delete
  begin
    for i := 0 to iMessages.Count - 1 do
    begin
      with iMessages.Item[ i ] do
      begin
        for j := 0 to Count - 1 do
        begin
          if Item[ j ] is tSVMPlay then
          begin
            with Item[ j ] as tSVMPlay do
            begin
              if MessageNo = iCurrEntry then
              begin
                exit; // done
              end;
            end;
          end;
        end;
      end;
    end;
    // if we get here, message not found, so can be deleted
    Result := FALSE;
  end;
end;

function tFlash.IsCurrMessageEntryUsed( var iLink : integer;
                                     var iEntry : integer;
                                     var iIsActivation : boolean ) : boolean;
var
  i, j : integer;
  iCurrEntry : integer;
begin
  Result := TRUE; // assume find
  iLink := -1;
  iEntry := -1;
  iIsActivation := FALSE;
  // used to determine if a message can be deleted
  // so non-existant messages are assumed to be used
  iCurrEntry := Messages.ActiveOption;
  if iCurrEntry >= 0 then  // if message not current then cannot delete
  begin
    for i := 0 to MessageMatrix.Count - 1 do
    begin
      with MessageMatrix.Item[ i ] do
      begin
        for j := 0 to 3 do
        begin
          if TriggerActivation[ j ] = iCurrEntry then
          begin
            iLink := i;
            iEntry := j;
            iIsActivation := TRUE;
            exit; // done
          end;
          if TriggerUnactivation[ j ] = iCurrEntry then
          begin
            iLink := i;
            iEntry := j;
            iIsActivation := FALSE;
            exit; // done
          end;
        end;
      end;
    end;
    // if we get here, message not found, so can be deleted
    Result := FALSE;
  end;
end;

procedure tFlash.SetMessageToCurrentLibraryEntry;
var
  i, j : integer;
  iCurrEntry : integer;
begin
  // used to set the current message options to
  // first message that uses the library entry
  iCurrEntry := SVMLibrary.ActiveOption;
  if iCurrEntry >= 0 then  // if message not current then cannot delete
  begin
    for i := 0 to iMessages.Count - 1 do
    begin
      with iMessages.Item[ i ] do
      begin
        for j := 0 to Count - 1 do
        begin
          if Item[ j ] is tSVMPlay then
          begin
            with Item[ j ] as tSVMPlay do
            begin
              if MessageNo = iCurrEntry then
              begin
                iMessages.Item[ i ].ActiveOption := j;
                iMessages.ActiveOption := i;
                exit; // done
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

