constructor tSVMTimedMessageElement.Create;
begin
  inherited Create;
  iMessageTime := 0;
end;

procedure tSVMTimedMessageElement.fSetMessageTime( NewVal : integer );
begin
  if iMessageTime <> NewVal then
  begin
    iMessageTime := NewVal;
    iIsDirty := TRUE;
  end
end;

procedure tSVMTimedMessageElement.LoadData(NewVal: word);
begin
  inherited;
  MessageTime := NewVal;
end;

procedure tSVMTimedMessageElement.SaveMiddle( var F : TextFile; var indent : integer );
begin
  inherited;
  if iMessageTime <> 0 then
  begin
    WriteLn( F, StringOfChar( ' ', Indent ) + 'Time = ' + IntToStr( iMessageTime ));
  end;
end;

