//------------------------ global ----------------------

function ReadDOS( var F : TextFile ) : string;
var
  iEnd : integer;
begin
  ReadLn( F, Result );
  // strip comments
  iEnd := Pos( '//', Result );
  if iEnd > 0 then
  begin
    Result := Copy( Result, 1, iEnd - 1 );
  end;
  Result := Trim( Result );
end;

