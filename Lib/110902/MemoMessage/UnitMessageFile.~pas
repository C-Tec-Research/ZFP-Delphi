  WriteLn( F, StringOfChar( ' ', Indent ) + 'MP3 File = ' + iFileName );
  WriteLn( F, StringOfChar( ' ', Indent + 2) + 'Name = ' + iShortText );
  WriteLn( F, StringOfChar( ' ', Indent + 2 ) + 'Text' );
  for i := 0 to iLongText.Count - 1 do
  begin
    WriteLn( F, StringOfChar( ' ', Indent + 4 ) + '//' + iLongText.Strings[ i ] );
  end;
  WriteLn( F, StringOfChar( ' ', Indent + 2 ) + 'End Text' );
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End MP3 File' );
  iIsDirty := FALSE;
end;

function tSVMLibraryElement.ExpandFileName : boolean; // attempts to expand the dos file name to the full windows path
var
  F : TSearchRec;
  TestName1, TestName2 : string;
begin
  Result := FALSE;
  if FindFirst( Path + '*.*', 0, F ) = 0 then
  begin
    TestName1 := ExtractFileName( iFileName );
    repeat
      TestName2 := ExtractShortPathName( ExtractFileName( F.Name ));
      if SameText( TestName2, TestName1 ) then
      begin
        Result := TRUE;
        FileName := Path + F.Name;
        break;
      end;
    until FindNext( F ) <> 0;
    FindClose( F );
  end;
end;

procedure tSVMLibraryElement.fSetFileName( pFileName : tFileName );
var
  F : file of byte;
begin
  if iFileName <> pFileName then
  begin
    iIgnoreFileError := FALSE;
    iFileName := pFileName;
    iIsDirty := TRUE;
    // see if we can get the file size
    iFileLength := 0; // assume no file exists
    if FileExists( pFileName ) then
    begin
      AssignFile( F, pFileName );
      Reset( F );
      try
        iFileLength := FileSize( F );
      finally
        CloseFile( F );
      end;
    end;
  end;
end;

procedure tSVMLibraryElement.fSetLongText( NewVal : tStringList );
begin
  if iLongText.Text <> NewVal.Text then
  begin
    iLongText.Text := NewVal.Text;
    iIsDirty := TRUE;
  end;
end;

function tSVMLibraryElement.AbbreviatedLongText : string;
begin
  case iLongText.Count of
