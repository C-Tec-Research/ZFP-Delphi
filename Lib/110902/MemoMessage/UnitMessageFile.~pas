  iStop := TManagedControlList.Create;
  iPrev := TManagedControlList.Create;
  iNext := TManagedControlList.Create;
end;

procedure tPlayableList.Play;
begin
  // all descendants should call inherited to action buttons
  Stop;
  if assigned( iPlay ) then iPlay.Enabled := FALSE;
  if assigned( iStop ) then iStop.Enabled := TRUE;
end;

procedure tPlayableList.Stop;
begin
  // all descendants should call inherited to action buttons
  if assigned( iPlay ) then iPlay.Enabled := TRUE;
  if assigned( iStop ) then iStop.Enabled := FALSE;
end;

procedure tPlayableList.Next;
begin
  Stop;
  if ActiveOption < Count - 1 then
  begin
    ActiveOption := ActiveOption + 1;
    if assigned( iOnChange ) then
    begin
      iOnChange( self, ActiveOption );
    end;
  end;
end;

procedure tPlayableList.Prev;
begin
  Stop;
  if ActiveOption > 0 then
  begin
    ActiveOption := ActiveOption - 1;
    if assigned( iOnChange ) then
    begin
      iOnChange( self, ActiveOption );
    end;
  end;
end;

function tPlayableList.Add( NewVal : tObject ) : integer;
begin
  Result := inherited Add( NewVal );
  ActiveOption := ActiveOption; // recalculate button status
end;

procedure tPlayableList.RegisterButtons( pPlay, pStop, pNext, pPrev : TControl );
begin
  iPlay.Add( pPlay );
  iStop.Add( pStop );
  iNext.Add( pNext );
  iPrev.Add( pPrev );
  ActiveOption := -1;
end;

procedure tPlayableList.fSetActiveOption( NewVal : integer );
begin
  Stop;
  iActiveOption := NewVal;
  if (iActiveOption < 0) or (iActiveOption >= Count ) then
  begin
    if assigned( iPlay ) then iPlay.Enabled := FALSE;
    if assigned( iStop ) then iStop.Enabled := FALSE;
    if assigned( iPrev ) then iPrev.Enabled := FALSE;
    if assigned( iNext ) then iNext.Enabled := (Count > 0);
  end
  else
  begin
    if assigned( iPlay ) then iPlay.Enabled := TRUE;
    if assigned( iStop ) then iStop.Enabled := FALSE;
    if assigned( iPrev ) then iPrev.Enabled := (NewVal > 0 );
    if assigned( iNext ) then iNext.Enabled := (NewVal < Count - 1);
  end;
end;

procedure tPlayableList.MoveUp;
begin
  if ActiveOption > 0 then
  begin
    Exchange( ActiveOption, ActiveOption - 1);
    ActiveOption := ActiveOption - 1;
    iIsDirty := TRUE;
  end;
end;

procedure tPlayableList.MoveDown;
begin
  if (ActiveOption < Count - 1) and (ActiveOption >= 0) then
  begin
    Exchange( ActiveOption, ActiveOption + 1 );
    ActiveOption := ActiveOption + 1;
    iIsDirty := TRUE;
  end;
end;

procedure tPlayableList.DeleteCurr;
