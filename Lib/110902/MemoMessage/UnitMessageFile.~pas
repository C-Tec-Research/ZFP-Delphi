procedure TMessageMatrix.ImportAsCtec( var F : TextFile );
var
  iLine : string;
  iItems : TStringList;
  i : integer;
  NewVal : tMessageMatrixEntry;
begin
  iItems := TStringList.Create;
  try
    while not EOF( F ) do
    begin
      iLine := ReadDOS( F );
      // ignore blanks and comments
      if iLine <> '' then begin
        // done?
        if SameText( iLine, 'end' ) then exit;
        iItems.Clear;
        ExtractStrings( [' '], [], PChar( iLine ), iItems );
        NewVal := tMessageMatrixEntry.Create;
        // values are offset by 1 from imported values!
        for i := 0 to 3 do
        begin
          try
            NewVal.iTriggerActivation[ i ] := StrToInt( iItems [ i ] ) - 1;
          except
            NewVal.iTriggerActivation[ i ] := -1;
          end;
          try
            NewVal.iTriggerUnactivation[ i ] := StrToInt( iItems[ 4 + i ] ) - 1;
          except
            NewVal.iTriggerUnactivation[ i ] := -1;
          end;
        end;
        Add( NewVal );
      end;
    end;
  finally
    iItems.Free;
  end;
end;

