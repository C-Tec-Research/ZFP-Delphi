procedure tSVMLibrary.Load( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
  iSVMLibraryElement : tSVMLibraryElement;
begin
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End Library' ) then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
      else if SameText( iSigProperty, 'MP3 File' ) then
      begin
        iSVMLibraryElement := tSVMLibraryElement.Create;
        iSVMLibraryElement.FileName := iSigValue;
        iSVMLibraryElement.Load( F );
        Add( iSVMLibraryElement );
      end
      else
      begin
        // ignore Errors for now
      end;
    end;
  end;
end;

procedure tSVMLibrary.Save( var F : TextFile; Indent : integer );
var
  i : integer;
begin
  WriteLn( F, StringOfChar( ' ', Indent ) + 'Library' );
  for i := 0 to Count - 1 do
  begin
    Item[ i ].Save( F, Indent + 2 );
  end;
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End Library' );
end;

procedure tSVMLibrary.ExportAsCtec( var F : TextFile );
var
  i : integer;
begin
  // this is a list of file names in DOS 8.3 format, followed by 'end'
  for i := 0 to Count - 1 do
  begin
    WriteLn( F, ExtractShortPathName( Item[ i ].FileName ) );
  end;
  WriteLn( F, 'end' );
end;

procedure tSVMLibrary.ImportAsCtec( var F : TextFile );
var
  iLine : string;
  NewElement : tSVMLibraryElement;
begin
  while not EOF( F ) do
  begin
    iLine := ReadDOS( F );
    // ignore comments and blank lines
    if iLine <> '' then
    begin
      // Done?
      if SameText( iLine, 'end' ) then exit;
      // otherwise is file name in 8.3 format
      NewElement := tSVMLibraryElement.Create;
      NewElement.FileName := iLine;
      NewElement.ShortText := ChangeFileExt( ExtractFileName( iLine ), '' );
      NewElement.LongText.Text := NewElement.ShortText;
      Add( NewElement );
    end;
  end;
end;

procedure tSVMLibrary.SubstitutePath( const OldPath : string; const NewPath : string );
var
  i : integer;
begin
  for i := 0 to Count - 1 do
  begin
    if SameText( Item[ i ].Path, OldPath ) then
    begin
      Item[ i ].Path := NewPath;
      Item[ i ].ExpandFileName;
    end;
  end
end;

procedure tSVMLibrary.IgnoreFileErrorsForPath( OldPath : string );
var
  i : integer;
begin
  for i := 0 to Count - 1 do
  begin
    if SameText( Item[ i ].Path, OldPath ) then
    begin
      Item[ i ].IgnoreFileError := TRUE;
    end;
  end
end;

