    if SigNETParse( SigText, SigProperty, SigIndex, SigValue, iSigComment ) then
    begin
      if SigProperty = 'End Notes' then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
      else
      begin
        Add( iSigComment );
      end;
    end;
  end;
end;

procedure tNotes.Save( var F : TextFile; Indent : integer );
var
  i : integer;
begin
  WriteLn( F, StringOfChar( ' ', Indent ) + 'Notes');
  inc( Indent, 2 );
  for i := 0 to Count - 1 do
  begin
    WriteLn( F, StringOfChar( ' ', Indent ) + '//' + Strings[ i ] );
  end;
  Dec( Indent, 2 );
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End Notes');
  iIsDirty := FALSE;
end;

