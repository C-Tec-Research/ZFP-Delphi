function TSVMMessage.fCheckBlocks : tSVMNotifyStatus;
var
  Done : boolean;
  ActionCount : integer; // avoid infinite empty blocks
begin
  Result := nsChange; // usually
  Done := FALSE;
  ActionCount := 16 * 254; // biggest legitimate value
  while not Done do
  begin
    Done := TRUE; // assume finished
    dec( ActionCount );
    if ActionCount < 0 then
    begin
      raise Exception.Create( 'Error - infinite closed blocks will cause SVM to lock' );
    end;
    if Item[ ActiveOption ] is tSVMBlockBegin then
    begin
      Done := FALSE;
      inc( BlockPtr );
      if BlockPtr > 16 then
      begin
        raise exception.Create( 'Repeats nested too deep!' );
      end
      else
      begin
        BlockCounter[ BlockPtr ] := (Item[ ActiveOption ] as tSVMBlockBegin).BlockCount;
        inc( iActiveOption ); // none of associated garbage required
        if ActiveOption >= Count then
        begin
          raise Exception.Create( 'Repeat with no matching End Repeat' );
        end
        else
        begin
          BlockStack[ BlockPtr ] := ActiveOption;
        end;
      end;
    end;
    if Item[ ActiveOption ] is tSVMBlockEnd then
    begin
      Done := FALSE;
      case BlockCounter[ BlockPtr ] of
        255:
        begin
          // a count of 255 means forever
          if iDelayStop then // trigger removed
          begin
            inherited Stop;
            iPlaying := FALSE;
            iActiveOption := 0;
            Done := TRUE; // truly finished
            Result := nsStop;
            if assigned( iOnNotify ) then
            begin
              iOnNotify( nsStop );
            end;
            iDelayStop := FALSE;
          end
          else
          begin
            iActiveOption := BlockStack[ BlockPtr ];
          end;
        end;
        else
        begin
          if BlockCounter[ BlockPtr ] > 1 then
          begin
            Dec( BlockCounter[ BlockPtr ] );
            iActiveOption := BlockStack[ BlockPtr ];
          end
          else if BlockPtr > 0 then
          begin
            Dec( BlockPtr );
            iActiveOption := ActiveOption + 1;
            if ActiveOption >= Count then
            begin
              if BlockPtr = 0 then
              begin
                inherited Stop;
                iPlaying := FALSE;
                iActiveOption := 0;
                Done := TRUE; // truly finished
                Result := nsStop;
                if assigned( iOnNotify ) then
                begin
                  iOnNotify( nsStop );
                end;
              end
              else
              begin
                raise Exception.Create( 'Repeat with no matching End Repeat' );
              end;
            end;
          end
          else
          begin
            // end block with no begin block
            raise Exception.Create( 'End Repeat with no matching repeat' );
          end;
        end;
      end;
    end;
  end;
end;

procedure TSVMMessage.Play;
begin
  // this is rather different to the rest.
  // there are no separate controls
  iDelayStop := FALSE;
  BlockPtr := 0;
  ActiveOption := 0;
  iPlaying := TRUE;
  if fCheckBlocks = nsChange then
  begin
    if assigned( iOnNotify ) then
    begin
      iOnNotify( nsChange );
    end;
    Item[ ActiveOption ].Play( iUsingLibrary );
    // should never be anything else
  end;
end;

procedure TSVMMessage.fSetDelayStop( NewVal : boolean );
begin
  iDelayStop := NewVal;
end;

function TSVMMessage.fGetDelayStop : boolean;
begin
  if not iPlaying then
  begin
    iDelayStop := FALSE;
  end;
  Result := iDelayStop;
end;

procedure TSVMMessage.Stop;
begin
  if iPlaying then
  begin
    iPlaying := FALSE;
    iNotifying := TRUE;
    // we are forcibly stopping, so prevent transient actions
    Item[ ActiveOption ].Stop;
    iNotifying := FALSE;
    if assigned( iOnNotify ) then
    begin
      iOnNotify( nsStop );
    end;
  end;
end;

procedure TSVMMessage.fOnNotify( NewVal : tSVMNotifyStatus );
begin
  if not iNotifying then
  begin
    try
      iNotifying := TRUE;
      if Item[ ActiveOption ] is tSVMStop then
      begin
        inherited Stop;
        iActiveOption := 0;
        if assigned( iOnNotify ) then
        begin
          iOnNotify( nsStop );
        end;
      end
      else
      begin
        iActiveOption := ActiveOption + 1;
        if ActiveOption >= Count then
        begin
          iActiveOption := 0;
          if assigned( iOnNotify ) then
          begin
            iOnNotify( nsStop );
          end;
        end
        else
        begin
          if fCheckBlocks = nsChange then
          begin
            if assigned( iOnNotify ) then
            begin
              iOnNotify( nsChange );
            end;
            Item[ ActiveOption ].Play( iUsingLibrary );
          end; // already notified if nsStop
        end;
      end;
    finally
      iNotifying := FALSE;
    end;
  end;
end;

