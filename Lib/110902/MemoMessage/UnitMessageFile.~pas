var
  i : integer;
begin
  WriteLn( F, StringOfChar( ' ', Indent ) + 'Message = ' + Name );
  Inc( Indent, 2 );
  for i := 0 to Count - 1 do
  begin
    Item[ i ].Save( F, Indent );
  end;
  Dec( Indent, 2 );
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End Message' );
  iIsDirty := FALSE;
end;

procedure TSVMMessage.ExportAsCtec( var F : TextFile );
var
  i : integer;
begin
  // A is created from its elements and ends with an 'ME'
  for i := 0 to Count - 1 do
  begin
    Item[ i ].ExportAsCtec( F );
  end;
  WriteLn( F, 'ME' );
end;

procedure TSVMMessage.ImportAsCtec( iFirstLine : string; var F : TextFile );
var
  iLine : string;
begin
  Add( CreateFromImportText( iFirstLine ));
  while not EOF( F ) do
  begin
    iLine := ReadDOS( F );
    // ignore blank lines and comments
    if iLine<> '' then
    begin
      // done?
      if SameText( iLine, 'ME' ) then exit;
      // else add new entry
      // note that a failure will cause an abort of this
      // message and create a new one with what is left of
      // the sequence
      Add( CreateFromImportText( iLine ));
    end;
  end;
end;

