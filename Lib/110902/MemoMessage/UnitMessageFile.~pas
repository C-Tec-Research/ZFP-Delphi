procedure TFlash.EndLoadFromModule;
var
  i, j : integer;
  iMessageFile : tFileStream;
  iFileSize : integer;
  iSaveFileSize : integer;
  iBlockLen : integer;
  iPage : integer;
  iMessageFileName : string;
  iLibraryElement : tSVMLibraryElement;
  iMessageMatrixEntry : tMessageMatrixEntry;
  iSVMMessageElement : tSVMMessageElement;
  iSVMMessage : tSVMMessage;
  iXtraField : boolean;
begin

  iSVMLibrary.Free;
  iSVMLibrary := tSVMLibrary.Create;

  iMessageMatrix.Free;
  iMessageMatrix := tMessageMatrix.Create;

  iMessages.Free;
  iMessages := TSVMMessages.Create( iSVMLibrary );

  for i := 0 to iMemoryMap.Directory.Count - 1 do
  begin
    if iMemoryMap.Directory.Entry[ i ].Exists then
    begin
      iLibraryElement := tSVMLibraryElement.Create;
      iSVMLibrary.Add( iLibraryElement );
      iMessageFileName := iSaveDirectory + '\messsage segment ' + IntToStr( i ) + '.mp3';
      iMessageFile := tFileStream.Create( iMessageFileName, fmCreate );
      iFileSize := iMemoryMap.Directory.Entry[ i ].FileLength;
      iSaveFileSize := iFileSize;
      iPage := iMemoryMap.Directory.Entry[ i ].PageNo;
      while iFileSize > 0 do
      begin
        iBlockLen := iMemoryMap.DataSize( iPage );
        iMessageFile.WriteBuffer( iMemoryMap.DataPage[ iPage ].Data[ 1 ], iBlockLen );
        Dec( iFileSize, iBlockLen );
        inc( iPage );
      end;
      iMessageFile.Free;
      iLibraryElement.SetFile( iMessageFileName, iSaveFileSize );
    end;
  end;

  for i := 0 to 15 do
  begin
    iMessageMatrixEntry := tMessageMatrixEntry.Create;
    with iMemoryMap.MemoryMatrix.Entry[ i ] do
    begin
      iMessageMatrixEntry.iTriggerActivation[ 0 ] := GenericMessageSilence - 1;
      iMessageMatrixEntry.iTriggerActivation[ 1 ] := GenericMessageTest - 1;
      iMessageMatrixEntry.iTriggerActivation[ 2 ] := GenericMessageAlert - 1;
      iMessageMatrixEntry.iTriggerActivation[ 3 ] := GenericMessageEvac - 1;
      iMessageMatrixEntry.iTriggerUnactivation[ 0 ] := NormaliseMessageSilence - 1;
      iMessageMatrixEntry.iTriggerUnactivation[ 1 ] := NormaliseMessageTest - 1;
      iMessageMatrixEntry.iTriggerUnactivation[ 2 ] := NormaliseMessageAlert - 1;
      iMessageMatrixEntry.iTriggerUnactivation[ 3 ] := NormaliseMessageEvac - 1;
    end;
    iMessageMatrix.Add( iMessageMatrixEntry );
  end;

  // and finally the play list
  // This starts on page 1 and may continue on pages 2 and 3
  // iSVMMessageElement : tSVMMessageElement;
  iSVMMessage := tSVMMessage.Create( iSVMLibrary );
  iSVMMessageElement := nil;
  iXtraField := FALSE;
  for i := 1 to 3 do
  begin
    for j := 0 to iMemoryMap.PlayListPage[ i ].PlayList.Count - 1 do
    begin
      with iMemoryMap.PlayListPage[ i ].PlayList.Item[ j ] do
      begin
        if iXtraField then
        begin
          iSVMMessageElement.LoadExtraData( Value );
          iSVMMessage.Add( iSVMMessageElement );
          iXtraField := FALSE;
        end
        else
        begin
          case Token of
            $00:
            begin
              iSVMMessageElement := tSVMPlay.Create;
              iSVMMessageElement.LoadData( Parm );
              iXtraField := TRUE;
            end;
            $02:
            begin
              iSVMMessageElement := tSVMSilence.Create;
              iSVMMessageElement.LoadData( Parm );
              iSVMMessage.Add( iSVMMessageElement );
            end;
            $03:
            begin
              iSVMMessageElement := tSVMStop.Create;
              iSVMMessage.Add( iSVMMessageElement );
            end;
            $06:
            begin
              iSVMMessageElement := tSVMIdle.Create;
              iSVMMessageElement.LoadData( Parm );
              iSVMMessage.Add( iSVMMessageElement );
            end;
            $0E:
            begin
              if Parm = $0FFF then
              begin
                // message end
                iMessages.Add( iSVMMessage );
                iSVMMessage := tSVMMessage.Create( iSVMLibrary );
              end
              else
              begin
                iSVMMessageElement := tSVMBlockBegin.Create;
                iSVMMessageElement.LoadData( Parm );
                iSVMMessage.Add( iSVMMessageElement );
              end;
            end;
            $0F:
            begin
              if Parm = 0 then
              begin
                iSVMMessageElement := tSVMBlockEnd.Create;
                iSVMMessage.Add( iSVMMessageElement );
              end
              else
              begin
                // list end
                if iSVMMessage.Count = 0 then
                begin
                  iSVMMessage.Free; // not needed
                end
                else
                begin
                  // should NOT get here, but...
                  iMessages.Add( iSVMMessage );
                end;
                // done
                exit;
              end;
            end;
            // ignore rest, including message checksum
          end;
        end;
      end;
    end;
  end;
end;

