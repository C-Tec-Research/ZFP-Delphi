begin
  inherited Create;
  iMessageNo := -1;
  iFade := FALSE;
end;

class function tSVMPlay.SaveID : string;
begin
  Result := 'Play';
end;

procedure tSVMPlay.Load( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
begin
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End Play' ) then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
