  if (ActiveOption < 0) or (ActiveOption >= Count - 1) then
  begin
    ActiveOption := Add( NewVal );
  end
  else
  begin
    ActiveOption := ActiveOption + 1;
    Insert( ActiveOption, NewVal );
  end;
