procedure TSVMMessage.Load( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
begin
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End Message' ) then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
      else if SameText( iSigProperty, tSVMBlockBegin.SaveID ) then
      begin
        Load( F, tSVMBlockBegin.Create );
      end
      else if SameText( iSigProperty, tSVMBlockEnd.SaveID ) then
      begin
        Load( F, tSVMBlockEnd.Create );
      end
      else if SameText( iSigProperty, tSVMIdle.SaveID ) then
      begin
        Load( F, tSVMIdle.Create );
      end
      else if SameText( iSigProperty, tSVMPlay.SaveID ) then
      begin
        Load( F, tSVMPlay.Create );
      end
      else if SameText( iSigProperty, tSVMSilence.SaveID ) then
      begin
        Load( F, tSVMSilence.Create );
      end
      else if SameText( iSigProperty, tSVMStop.SaveID ) then
      begin
        Load( F, tSVMStop.Create );
      end
      else
      begin
        // ignore errors for now
      end
    end;
  end;
end;

