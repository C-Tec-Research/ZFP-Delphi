procedure TFlash.GenerateMemoryMap( iPageSize : integer );
begin
  iMemoryMap.Free;
  iMemoryMap := tMemoryMap.Create( iPageSize );
  // Pages 0-3 created implicitly

  // Page 0 - Directory ; Also creates file data
  iSVMLibrary.CreateMemoryMap( iMemoryMap, iPageSize );
  iMessageMatrix.CreateMemoryMap( iMemoryMap );

  // pages 1..3 PlayList
  iMessages.CreateMemoryMap( iMemoryMap );
end;

procedure tSVMLibrary.CreateMemoryMap(pMemoryMap: tMemoryMap; pPageSize : integer);
var
  i, iCS : integer;
  iNextAvailPage : integer;
  iBytesLeft : integer;
  iMessageFile : tFileStream;
  iBuffer : array of byte;
  iMPData : tMPData;
begin
  iNextAvailPage := pMemoryMap.Count;
  SetLength( iBuffer, pPageSize );
  for i := 0 to Count - 1 do
  begin
    if Item[ i ].FileLength = 0 then
    begin
      // a blank entry - leave as all $FF. This is the default, so do nothing
    end
    else
    begin
      iMessageFile := tFileStream.Create( Item[ i ].FileName, fmOpenRead );
      iBytesLeft := Item[ i ].FileLength;
      pMemoryMap.Directory.Entry[ i ].FileLength := iBytesLeft;
      pMemoryMap.Directory.Entry[ i ].PageNo := iNextAvailPage;
      iCS := 0;
      while iBytesLeft > 0 do
      begin
        iMessageFile.Read( iBuffer[ 0 ], pPageSize );
        iMPData := tMPData.Create( iNextAvailPage, pPageSize );
        iMPData.LoadBinary( iBuffer, iBytesLeft );
        inc( iCS, iMPData.Checksum );
        pMemoryMap.Add( iMPData );
        inc( iNextAvailPage );
      end;
      iMessageFile.Free;
      pMemoryMap.Directory.Entry[ i ].CheckSum := iCS;
    end;
  end;
end;

procedure TMessageMatrix.CreateMemoryMap(pMemoryMap: tMemoryMap);
var
  i : integer;
begin
  // message matrix is all on Page 1
  for i := 0 to Count - 1 do
  begin
    with pMemoryMap.MemoryMatrix.Entry[ i ], Item[ i ] do
    begin
      GenericMessageSilence := TriggerActivation[ 0 ] + 1;
      GenericMessageTest := iTriggerActivation[ 1 ] + 1;
      GenericMessageAlert := iTriggerActivation[ 2 ] + 1;
      GenericMessageEvac := iTriggerActivation[ 3 ] + 1;
      NormaliseMessageSilence := iTriggerUnactivation[ 0 ] + 1;
      NormaliseMessageTest := iTriggerUnactivation[ 1 ] + 1;
      NormaliseMessageAlert := iTriggerUnactivation[ 2 ] + 1;
      NormaliseMessageEvac := iTriggerUnactivation[ 3 ] + 1;
    end;
  end;
end;

procedure TSVMMessages.CreateMemoryMap(pMemoryMap: tMemoryMap);
var
  i: integer;
begin
  // pages 1..3 PlayList
  for i := 0 to Count - 1 do
  begin
    Item[ i ].CreateMemoryMap( pMemoryMap );
  end;
  // need to add list end
  pMemoryMap.AddPlayListData( $FFFF );
end;

procedure tSVMStop.CreateMemoryMap(pMemoryMap: tMemoryMap; var pCS : word);
begin
  pMemoryMap.AddPlayListData( 3 );
  inc( pCS, 3 );
end;

procedure tSVMIdle.CreateMemoryMap(pMemoryMap: tMemoryMap; var pCS : word);
var
  iValue : word;
begin
  iValue := (MessageTime shl 4) + 6;
  pMemoryMap.AddPlayListData( iValue );
  inc( pCS, iValue div 256 );
  inc( pCS, iValue mod 256 );
end;

procedure tSVMBlockBegin.CreateMemoryMap(pMemoryMap: tMemoryMap; var pCS : word);
var
  iValue : word;
begin
  iValue := (BlockCount shl 4) + $0E;
  pMemoryMap.AddPlayListData( iValue );
  inc( pCS, iValue div 256 );
  inc( pCS, iValue mod 256 );
end;

procedure tSVMBlockEnd.CreateMemoryMap(pMemoryMap: tMemoryMap; var pCS : word);
begin
  pMemoryMap.AddPlayListData( $0F );
  inc( pCS, $0F );
end;

function PageSize( iFlashSize : TFlashSize ) : integer;
begin
  case iFlashSize of
    fsUnknown, fs1Mbit, fs2Mbit, fs4Mbit, fs8Mbit: Result := 264;
    fs16Mbit, fs32Mbit:                            Result := 528;
    fs64Mbit, fs128Mbit, fs256MBit, fs512Mbit:     Result := 1056;
    else                                           Result := 264;
  end;
end;

function PageCount( iFlashSize : TFlashSize ) : integer;
begin
  case iFlashSize of
    fsUnknown:                       Result := 0;
    fs1Mbit:                         Result := 512;
    fs2Mbit:                         Result := 1024;
    fs4Mbit:                         Result := 2048;
    fs8Mbit, fs16Mbit:               Result := 4096;
    fs32Mbit, fs64Mbit:              Result := 8192;
    fs128Mbit, fs256MBit, fs512Mbit: Result := 16384;
    else                             Result := 0;
  end;
end;

