function TSVMMessage.CreateFromImportText( NewVal : string ) : tSVMMessageElement;
var
  iItems : tStringList;
  TestVal : string;
begin
  Result := nil;
  iItems := tStringList.Create;
  try
    ExtractStrings( ['+'], [], PChar( NewVal ), iItems );
    if SameText( iItems[ 0 ], 'PLY' ) then
    begin
      Result := tSVMPlay.Create;
      with Result as tSVMPlay do
      begin
        TestVal := Trim(iItems[ 1 ]);
        Fade := SameText( TestVal, 'WF' );
        MessageNo := StrToInt( iItems[ 2 ] );
        MessageTime := StrToInt( iItems[ 3 ] ) * 10;
      end;
    end
    else if SameText( iItems[ 0 ], 'SIL' ) then
    begin
      Result := tSVMSilence.Create;
      with Result as tSVMSilence do
      begin
        MessageTime := StrToInt( iItems[ 1 ] ) * 10;
      end;
    end
    else if SameText( iItems[ 0 ], 'STP' ) then
    begin
      Result := tSVMStop.Create;
    end
    else if SameText( iItems[ 0 ], 'IDL' ) then
    begin
      Result := tSVMIdle.Create;
      with Result as tSVMIdle do
      begin
        MessageTime := StrToInt( iItems[ 1 ] ) * 10;
      end;
    end
    else if SameText( iItems[ 0 ], 'BKB' ) then
    begin
      Result := tSVMBlockBegin.Create;
      with Result as tSVMBlockBegin do
      begin
        BlockCount := StrToInt( iItems[ 1 ] );
      end;
    end
    else if SameText( iItems[ 0 ], 'BKE' ) then
    begin
      Result := tSVMBlockEnd.Create;
    end
    else
    begin
      raise exception.Create( 'Illegal construct in import file : ' + NewVal);
    end;
  finally
    iItems.Free;
  end;
end;

