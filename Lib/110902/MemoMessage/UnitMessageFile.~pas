constructor TMessageMatrixEntry.Create;
var
  i : integer;
begin
  inherited Create;
  iIsDirty := FALSE;
  for i := 0 to 3 do
  begin
    iTriggerActivation[ i ] := -1;
    iTriggerUnactivation[ i ] := -1;
    // note when importing these values, they need to be offset by one
  end;
  iActiveMessage := -1; // no message to stop!
end;

procedure TMessageMatrixEntry.Load( var F : TextFile );
var
  iSigLine : string;
  iSigProperty, iSigIndex, iSigValue, iSigComment : string;
begin
  while not EOF( F ) do
  begin
    ReadLn( F, iSigLine );
    if SigNETParse( iSigLine, iSigProperty, iSigIndex, iSigValue, iSigComment ) then
    begin
      if SameText( iSigProperty, 'End Message Matrix Entry' ) then
      begin
        // done
        iIsDirty := FALSE;
        exit;
      end
      else if SameText( iSigProperty, 'Activation' ) then
      begin
        iTriggerActivation[ StrToInt( iSigIndex ) ] := StrToInt( iSigValue );
      end
      else if SameText( iSigProperty, 'Removal' ) then
      begin
        iTriggerUnactivation[ StrToInt( iSigIndex ) ] := StrToInt( iSigValue );
      end
      else
      begin
        // ignore Errors for now
      end;
    end;
  end;
end;

procedure TMessageMatrixEntry.Save( var F : TextFile; indent : integer );
var
  i : integer;
begin
  WriteLn( F, StringOfChar( ' ', Indent ) + 'Message Matrix Entry' );
  inc( Indent, 2 );
  for i := 0 to 3 do
  begin
    WriteLn( F, StringOfChar( ' ', Indent ) + 'Activation(' + IntToStr( i ) + ') = ' + IntToStr( iTriggerActivation[ i ] ));
    WriteLn( F, StringOfChar( ' ', Indent ) + 'Removal(' + IntToStr( i ) + ') = ' + IntToStr( iTriggerUnactivation[ i ] ));
  end;
  dec( Indent, 2 );
  WriteLn( F, StringOfChar( ' ', Indent ) + 'End Message Matrix Entry' );
  iIsDirty := FALSE;
end;

