procedure tFlash.InsertLibraryEntryBeforeCurrent;
var
  iCurrEntry : integer;
begin
  iCurrEntry := SVMLibrary.ActiveOption;
  iMessages.AdjustMessageIndexUp( iCurrEntry );
  iSVMLibrary.Insert( iCurrEntry, tSVMLibraryElement.Create );
end;

procedure tFlash.InsertLibraryEntryAfterCurrent;
var
  iCurrEntry : integer;
begin
  iCurrEntry := SVMLibrary.ActiveOption;
  if iCurrEntry < (SVMLibrary.Count - 1 ) then
  begin
    // same as inserting before next
    SVMLibrary.ActiveOption := iCurrEntry + 1;
    InsertLibraryEntryBeforeCurrent;
  end
  else
  begin
    // inserting at end
    SVMLibrary.ActiveOption := SVMLibrary.Add( tSVMLibraryElement.Create );
    // no message adjustment requird
  end;
end;



