procedure TFlash.fSetTriggerUsed( Index : integer );
var
  i : integer;
begin
  if Index >= 0 then
  begin
    with iMessages.Item[ index ] do
    begin
      Used := TRUE;
      for i := 0 to Count - 1 do
      begin
        Item[ i ].SetUsed( iSVMLibrary );
      end;
    end;
  end;
end;

procedure TFlash.fSetOptimised( NewVal : boolean );
var
  i, j : integer;
begin
  iOptimised := NewVal;
  iSVMLibrary.ResetUsed;
  iMessages.ResetUsed;
  // for AVAC, message 0 is always used
  fSetTriggerUsed( 0 );
  for i := 0 to iMessageMatrix.Count - 1 do
  begin
    for j := 0 to 3 do
    begin
      fSetTriggerUsed( iMessageMatrix.Item[ i ].TriggerActivation[ j ] );
      fSetTriggerUsed( iMessageMatrix.Item[ i ].TriggerUnactivation[ j ] );
    end;
  end;
  i := 0;
  while i < iMessages.Count - 1 do
  begin
    if iMessages.Item[ i ].Used then
    begin
      inc( i );
    end
    else
    begin
      iMessageMatrix.AdjustMessageIndexDown( i );
      iMessages.Delete( i );
    end;
  end;
  i := 0;
  while i < iSVMLibrary.Count - 1 do
  begin
    if iSVMLibrary.Item[ i ].Used then
    begin
      inc( i );
    end
    else
    begin
      iMessages.AdjustMessageIndexDown( i );
      iSVMLibrary.Delete( i );
    end;
  end;
end;

procedure tFlash.MoveLibraryEntryUp; // moves currently active entry up one place
var
  i, j : integer;
  iCurrEntry : integer;
begin
  iCurrEntry := SVMLibrary.ActiveOption;
  if iCurrEntry > 0 then
  begin
    SVMLibrary.Exchange( iCurrEntry, iCurrEntry - 1 );
    for i := 0 to iMessages.Count - 1 do
    begin
      with iMessages.Item[ i ] do
      begin
        for j := 0 to Count - 1 do
        begin
          if Item[ j ] is tSVMPlay then
          begin
            with Item[ j ] as tSVMPlay do
            begin
              if MessageNo = iCurrEntry then
              begin
                MessageNo := iCurrEntry - 1;
              end
              else if MessageNo = (iCurrEntry - 1) then
              begin
                MessageNo := iCurrEntry;
              end;
            end;
          end;
        end;
      end;
    end;
    SVMLibrary.ActiveOption := iCurrEntry - 1;
  end;
end;

