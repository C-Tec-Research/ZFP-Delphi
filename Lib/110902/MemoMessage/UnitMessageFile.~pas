procedure TSVMFile.Load( pFileName : string );
var
  F : TextFile;
  SigText : string;
  SigProperty, SigIndex, SigValue, iSigComment : string;
begin

  iFileName := pFileName;
  AssignFile(F, pFileName);
  Reset( F ); // Go to start
  try
    while not EOF( F) do
    begin
      ReadLn( F, SigText );
      if SigNETParse( SigText, SigProperty, SigIndex, SigValue, iSigComment ) then
      begin
        if SameText( SigProperty, 'File' ) then
        begin
          Load( F );
        end;
      end;
    end;
    // And finally close it
  finally
    CloseFile( F );
    iIsDirty := FALSE;
  end;
end;

procedure TSVMFile.Load( var F : TextFile );
var
  SigText : string;
  SigProperty, SigIndex, SigValue, iSigComment : string;
  i : tModuleType;
//  j : tFlashSize;
begin

  iOptimised := FALSE;
  while not EOF( F) do
  begin
    ReadLn( F, SigText );
    if SigNETParse( SigText, SigProperty, SigIndex, SigValue, iSigComment ) then
    begin
      if SigProperty = '' then
      begin
        // ignore comments except in the Notes section
      end
      else if SameText( SigProperty, 'End File' ) then
      begin
        // done
        iIsDirty := FALSE;
        Exit;
      end
      else if SameText( SigProperty, 'Module Type' ) then
      begin
        for i := mtAVAC to mtSS2N do
        begin
          if SameText( SigValue, cModuleType[ i ] )then
          begin
            ModuleType := i;
            break;
          end;
        end;
      end
      else if SameText (SigProperty, 'Flash' ) then
      begin
        // don't update the flash size - this should be controlled by unit
{
        for j := fsUnknown to fs512Mbit do
        begin
          if SameText( SigValue, cFlashSize[ j ] ) then
          begin
            iFlashFull.FlashSize := j;
            iFlashFull.Load( F );
            break;
          end;
        end;
}
        iFlashFull.Load( F );
      end
      else if SameText (SigProperty, 'Notes' ) then
      begin
        iNotes.Load( F );
      end;
    end;
  end;
end;

