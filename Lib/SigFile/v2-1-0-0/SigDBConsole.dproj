				<Form>PreviewForm</Form>
			</DCCReference>
			<DCCReference Include="..\Printer\Gopage.pas">
				<Form>GoPageForm</Form>
			</DCCReference>
			<DCCReference Include="..\PendingActions\PendingActions.pas"/>
			<DCCReference Include="UnitNew.pas">
