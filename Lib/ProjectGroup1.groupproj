		</PropertyGroup>
		<ItemGroup>
			<Projects Include="SigNET.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="..\Integrity\IntegrityEditor.dproj">
				<Dependencies/>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<Default.Personality/>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="SigNET">
			<MSBuild Projects="SigNET.dproj"/>
		</Target>
		<Target Name="SigNET:Clean">
			<MSBuild Targets="Clean" Projects="SigNET.dproj"/>
		</Target>
		<Target Name="SigNET:Make">
