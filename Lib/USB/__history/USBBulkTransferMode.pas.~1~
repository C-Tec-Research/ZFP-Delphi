{ tUSBBulkTransfer }

procedure tUSBBulkTransfer.CancelRead;
begin
  CancelIO(fPipeRead);
  //Flush;
end;

procedure tUSBBulkTransfer.Close;
begin
  if IsOpen then
  begin
    CloseHandle(fPipeRead);
    CloseHandle(fPipeWrite);
    CloseHandle(fDevice);
    CloseHandle(fOverlapRead.hEvent);
    fDevice := INVALID_HANDLE_VALUE;
    fPipeRead := INVALID_HANDLE_VALUE;
    fPipeWrite := INVALID_HANDLE_VALUE;
  end;
end;

function tUSBBulkTransfer.CompleteRead( var BytesRead: DWord): boolean;
begin
{
function GetOverlappedResult(hFile: THandle; const lpOverlapped: TOverlapped;
  var lpNumberOfBytesTransferred: DWORD; bWait: BOOL): BOOL; stdcall;
}
  Result := GetOverlappedResult(fPipeRead, fOverlapRead, BytesRead, FALSE);
  if not Result then
  begin
    fLastError := GetLastError;
  end;
end;

constructor tUSBBulkTransfer.Create( pDeviceName : string );
begin
  inherited Create;
  fBufferSize := (64*1024);
  fDeviceName := pDeviceName;
  //fDefaultTimeout := (10 * 1000); // 10 seconds
  fDevice := INVALID_HANDLE_VALUE;
  fReadMaxTransferSize := 2048;
  fWriteMaxTransferSize := 2048;
  fUseWaitForSingleObject := TRUE;
end;

destructor tUSBBulkTransfer.Destroy;
begin
  Close;
  inherited;
end;

procedure tUSBBulkTransfer.Flush;
var
  iValue : array [0..2047] of byte;
  iBytesRead : DWord;
begin
  if IsOpen then
  begin
    //FlushFileBuffers( fPipeRead );
    repeat
      fOverLapRead.Offset := 0;
      fOverlapRead.OffsetHigh := 0;
      ReadFile( fPipeRead, iValue, 1, iBytesRead, @fOverlapRead);
    until iBytesRead = 0;
    //FlushFileBuffers( fPipeWrite );
  end;
end;

function tUSBBulkTransfer.GetByte( var iVal : byte ) : boolean;
var
  iBytesRead : DWord;
begin
  if (fByteReadError = ERROR_IO_PENDING) or (fByteReadError = ERROR_IO_INCOMPLETE) then
  begin
    if fUseWaitForSingleObject then
    begin
      fByteReadError := WaitForSingleObject(fOverlapRead.hEvent, 0);
      GetOverlappedResult( fPipeRead, fOverlapRead, iBytesRead, FALSE );
    end
    else
    begin
      GetOverlappedResult( fPipeRead, fOverlapRead, iBytesRead, FALSE );
      fByteReadError := GetLastError;
    end;
    Result := fByteReadError = NO_ERROR;
  end
  else if IsOpen then
  begin
    fOverLapRead.Offset := 0;
    fOverlapRead.OffsetHigh := 0;
    Result := ReadFile( fPipeRead, fByteReadBuffer, 1, iBytesRead, @fOverlapRead);
    fByteReadError := GetLastError;
  end
  else
  begin
    Result := FALSE;
  end;
  if Result then
  begin
    iVal := fByteReadBuffer[ 0 ];
  end;
end;

function tUSBBulkTransfer.GetOpen: boolean;
begin
  Result := fDevice <> INVALID_HANDLE_VALUE;
end;

procedure tUSBBulkTransfer.Open;
var
  hTmp : tHandle;
  acPipeName : string;
  len : Cardinal;
  iPChar : array[ 0..255] of char;
begin

  fByteReadError := NO_ERROR;
  //Timeout := DefaultTimeout;

  StrPCopy( iPChar, fDeviceName );
  hTmp := CreateFile( iPChar, GENERIC_READ or GENERIC_WRITE, FILE_SHARE_READ or FILE_SHARE_WRITE, nil, OPEN_EXISTING, 0, 0);
  if (hTmp <> INVALID_HANDLE_VALUE) then
  begin
    fDevice := hTmp;
    //
    // Create read pipe
    //
    acPipeName := fDeviceName + USBBULK_PIPE_READ_PATH;
    StrPCopy( iPChar, acPipeName );
    hTmp := CreateFile(iPChar, GENERIC_READ or GENERIC_WRITE, FILE_SHARE_READ or FILE_SHARE_WRITE, nil, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, 0);
    if (hTmp <> INVALID_HANDLE_VALUE) then
    begin
      fPipeRead := hTmp;
      //
      // Init overlay structure
      //
              // pConnInfo->OverlapRead; this line doesn't seem to do anything!
      fOverlapRead.Offset := 0;
      fOverlapRead.OffsetHigh := 0;
      fOverlapRead.hEvent := CreateEvent(nil, TRUE, FALSE, nil);
      //
      // Create write pipe
      //
      acPipeName := fDeviceName + USBBULK_PIPE_WRITE_PATH;
      StrPCopy( iPChar, acPipeName );
      hTmp := CreateFile(iPChar, GENERIC_READ or GENERIC_WRITE, FILE_SHARE_READ or FILE_SHARE_WRITE, nil, OPEN_EXISTING, 0, 0);
      if (hTmp <> INVALID_HANDLE_VALUE) then
      begin
        fPipeWrite := hTmp;
      end
      else
      begin
        CloseHandle(fPipeRead);
        CloseHandle(fDevice);
      end;
    end
    else
    begin
      CloseHandle(fDevice);
    end;
  end;
  if (hTmp = INVALID_HANDLE_VALUE) then
  begin
    fDevice := hTmp;
    fPipeRead := hTmp;
    fPipeWrite := hTmp;
  end
  else
  begin
    DeviceIoControl(fDevice, IOCTL_USB_BULK_GET_READ_TRANSFER_SIZE, nil, 0, @fReadMaxTransferSize, sizeof(fReadMaxTransferSize), Len, nil);
    DeviceIoControl(fDevice, IOCTL_USB_BULK_GET_WRITE_TRANSFER_SIZE, nil, 0, @fWriteMaxTransferSize, sizeof(fReadMaxTransferSize), Len, nil);

  end;
end;

function tUSBBulkTransfer.Read(var Value: array of byte; const BytesToRead : DWord;
  var BytesRead: DWord): boolean;
begin
{
function ReadFile(hFile: THandle; var Buffer; nNumberOfBytesToRead: DWORD;
  var lpNumberOfBytesRead: DWORD; lpOverlapped: POverlapped): BOOL; stdcall;
}
  if BytesToRead <= 0 then
  begin
    Result := TRUE;
  end
  else
  begin
    fOverLapRead.Offset := 0;
    fOverlapRead.OffsetHigh := 0;
    Result := ReadFile( fPipeRead, Value, BytesToRead, BytesRead, @fOverlapRead);
//    if not Result then
//    begin
      fLastError := GetLastError;
//    end;
  end;
end;

function tUSBBulkTransfer.ReadReady( var BytesRead : DWord ) : boolean;
begin
  fLastError := WaitForSingleObject(fOverlapRead.hEvent, 0);
  // Result := fLastError = NO_ERROR;
  GetOverlappedResult( fPipeRead, fOverlapRead, BytesRead, FALSE );
  Result := fLastError = NO_ERROR;
end;

function tUSBBulkTransfer.StartExchange(const TxBuffer: array of byte; const BytesToWrite : DWord;
  var BytesWritten: DWord; var RxBuffer: array of byte; const BytesToRead : DWord; var BytesRead : DWord): boolean;
begin
  // set up read part
  //fReadMaxTransferSize := BytesToRead;
  Result := Read( RxBuffer, BytesToRead, BytesRead );
  if Result or (fLastError = ERROR_IO_PENDING) then
  begin
    // buffers set up ready, so now send request
    Result := Write( TxBuffer, BytesToWrite, BytesWritten );
  end;
end;

function tUSBBulkTransfer.USBBULK_PIPE_READ_PATH: string;
begin
  Result := '\\pipe00';
end;

function tUSBBulkTransfer.USBBULK_PIPE_WRITE_PATH: string;
begin
  Result := '\\pipe01';
end;

function tUSBBulkTransfer.Write( const Value : array of byte; const BytesToWrite : DWord; var BytesWritten : DWord) : boolean;
begin
{
function WriteFile(hFile: THandle; const Buffer; nNumberOfBytesToWrite: DWORD;
  var lpNumberOfBytesWritten: DWORD; lpOverlapped: POverlapped): BOOL; stdcall;
}
  Result := WriteFile( fPipeWrite, Value, BytesToWrite, BytesWritten, nil );
  if Result then
  begin
    // success
    fLastError := NO_ERROR;
  end
  else
  begin
    fLastError := GetLastError;
  end;
end;

{ tUSBBulkTransferList }

function tUSBBulkTransferList.Add(const Value: tUSBBulkTransfer): integer;
begin
  Value.Name := NextName;
  Result := inherited Add( Value );
end;

procedure tUSBBulkTransferList.CheckInfo;
var
  // variables needed for device enumeration
  hDevList : HDEVINFO;
  DevData  : SP_DEVICE_INTERFACE_DATA;
  i : integer;
  succ : boolean;
  LastError : DWord;
  DeviceName : string;
  iDevice : tUSBBulkTransfer;
begin
  hDevList := SetupDiGetClassDevs(@fBulkGUID, nil, 0, DIGCF_DEVICEINTERFACE or DIGCF_PRESENT);
  if hDevList = HDEVINFO(INVALID_HANDLE_VALUE) then
  begin
    raise exception.Create('SetupDiGetClassDevs failed, err=' + IntToStr(GetLastError()));
  end;

  // Mark existing entries as 'checking
  for i := 0 to Count - 1 do
  begin
    Entry[ i ].Checking := TRUE;
  end;

  // enumerate device interfaces
  ZeroMemory(@DevData,sizeof(DevData));
  DevData.cbSize := sizeof(SP_DEVICE_INTERFACE_DATA);
  //pDeviceName := @_aDeviceName[0];
  for i := 0 to 127 do
  begin
    {
      TSetupDiEnumDeviceInterfaces = function(DeviceInfoSet: HDEVINFO;
        DeviceInfoData: PSPDevInfoData; const InterfaceClassGuid: TGUID;
        MemberIndex: DWORD; var DeviceInterfaceData: TSPDeviceInterfaceData): LongBool; stdcall;
    }
    succ := SetupDiEnumDeviceInterfaces(hDevList, nil, fBulkGUID, i, DevData);
    if succ then
    begin
      if (fRetrieveInfo(hDevList, DevData, DeviceName)) then
      begin
        iDevice := EntryByName[ DeviceName ];
        if assigned( iDevice ) then
        begin
          iDevice.Checking := FALSE;
        end
        else
        begin
          iDevice := tUSBBulkTransfer.Create( DeviceName );
          Add( iDevice );
        end;
      end
      else
      begin
        LastError := GetLastError();
        if LastError <> NO_ERROR then
        begin
          raise exception.Create( 'Unable to retrieve data - Error Code : ' + IntToStr( LastError ));
        end;
      end;
    end
    else
    begin
      {
        function GetLastError: DWORD; stdcall;
      }
      LastError := GetLastError();
      if (LastError = ERROR_NO_MORE_ITEMS) then
      begin
        break;
      end
      else
      begin
        // There are no device attached using the usb bulk driver
        SetupDiDestroyDeviceInfoList(hDevList);
        exit;
      end;
    end;
  end;
  // Remove any unconfirmed entries
  for i := 0 to Count - 1 do
  begin
    if Entry[ i ].Checking = TRUE then
    begin
      Items[ i ] := nil;
    end;
  end;
  Pack;
end;

(*********************************************************************
*
*       _CheckIDs
*)
function tUSBBulkTransferList.fCheckIDs(const sDevicePath : string) : boolean;
var
  iVendorId : U16;
  iProductId : U16;
begin

  iVendorId  := fGetVendorId(sDevicePath);
  iProductId := fGetProductId(sDevicePath);
  Result := (iVendorID = fVendorIDMain) and ( iProductID = fProductIDMain );
  if not Result then
  begin
    if fAllowDev then
    begin
      Result := (iVendorID = fVendorIDDev) and ( iProductID = fProductIDDev );
    end;
  end;
end;

constructor tUSBBulkTransferList.Create;
begin
  inherited Create( TRUE );
  fUSBMaxDevices := 32;
  {
    D1: LongWord;
    D2: Word;
    D3: Word;
    D4: array[0..7] of Byte;
  }
  with fBulkGUID do
  begin
    D1 := $54654e76;
    D2 := $dcf7;
    D3 := $4a7f;
    D4[ 0 ] := $87;
    D4[ 1 ] := $8a;
    D4[ 2 ] := $4e;
    D4[ 3 ] := $8f;
    D4[ 4 ] := $ca;
    D4[ 5 ] := $0a;
    D4[ 6 ] := $cc;
    D4[ 7 ] := $9a;
  end;
  fVendorIDMain := $283D;
  fProductIDMain := $1234;
  fVendorIDDev := $8765;
  fProductIDDev := $1234;
  fChildPrefix := 'USB Port';
end;

function tUSBBulkTransferList.GetEntry(const i: integer): tUSBBulkTransfer;
begin
  Result := Items[ i ] as tUSBBulkTransfer;
end;

function tUSBBulkTransferList.GetEntryByName(
  const index: string): tUSBBulkTransfer;
var
  i: Integer;
begin
  for i := 0 to Count - 1 do
  begin
    Result := Entry[ i ];
    if Result.DeviceName = index then
    begin
      exit; // found
    end;
  end;
  Result := nil;
end;

function tUSBBulkTransferList.GetNoDevices: integer;
begin
  Result := Count;
end;

function tUSBBulkTransferList.NextName: string;
var
  i : integer;
begin
  i := 0;
  repeat
    inc( i );
    Result := ChildPrefix + ' ' + IntToStr( i );
  until not assigned( EntryByName[ Result ] );
end;

(*********************************************************************
*
*       _GetProductId
*)
function tUSBBulkTransferList.fGetProductId(const s : string) : U16;
var
  p : integer;
begin
  p := Pos('pid_', s);
  if p > 0 then
  begin
    Result := HexToInt( Copy( s, p+4, 4 ) );
  end
  else
  begin
    Result := 0;
  end;
end;

(*********************************************************************
*
*       _GetVendorId
*)
function tUSBBulkTransferList.fGetVendorId(const s : string) : U16;
var
  p : integer;
begin
  p := Pos('vid_', s);
  if p > 0 then
  begin
    Result := HexToInt( Copy( s, p+4, 4 ) );
  end
  else
  begin
    Result := 0;
  end;
end;

function tUSBBulkTransferList.fRetrieveInfo(hDevList: hDEVINFO;
  var DevData: SP_DEVICE_INTERFACE_DATA; var DeviceName: string): boolean;
var
  // DevDetail : SP_INTERFACE_DEVICE_DETAIL_DATA;
  DevDetail : TSPDeviceInterfaceDetailData;
  ReqLen    : DWORD;
  succ      : boolean;
  iDevicePath : string;
  //i           : integer;
begin

  ReqLen     := 0;
  // get length of INTERFACE_DEVICE_DETAIL_DATA, allocate buffer
  // This function call returns the system error "buffer too small" (code 122).
  // We ignore this return code.
  {
    TSetupDiGetDeviceInterfaceDetailA = function(DeviceInfoSet: HDEVINFO;
      DeviceInterfaceData: PSPDeviceInterfaceData;
